{
	"$schema": "./node_modules/knip/schema.json",
	"treatConfigHintsAsErrors": true,
	"workspaces": {
		".": {
			"entry": [
				"scripts/*.mjs",
				"scripts/oxlint-plugin-orchbee/index.js",
				"scripts/oxlint-plugin-orchbee/vitest.config.ts",
				"scripts/style-contract/vitest.config.ts",
				"scripts/style-contract/__tests__/*.unit.test.ts",
				"vitest.config.ts"
			],
			"project": ["scripts/**/*.{js,mjs,ts}", "*.{js,mjs,ts}"]
		},
		"apps/*": {
			"entry": [
				"src/index.ts",
				"src/composition/entry.tsx",
				"src/**/*.unit.test.{ts,tsx}",
				"rsbuild.config.ts",
				"vitest.config.ts"
			],
			"project": ["src/**/*.{ts,tsx}", "*.ts"]
		},
		"packages/*": {
			"entry": [
				"src/index.ts",
				"src/**/*.unit.test.{ts,tsx}",
				"rslib.config.ts",
				"vitest.config.ts"
			],
			"project": ["src/**/*.{ts,tsx}", "*.ts"]
		},
		"packages/foundation": {
			"entry": [
				"src/index.ts!",
				"src/react/index.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rslib.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "*.ts"]
		},
		"packages/ui": {
			"entry": [
				"src/index.ts!",
				"src/components/index.ts!",
				"src/styles.ts!",
				"stories/**/*.stories.tsx!"
			],
			"ignoreDependencies": ["shadcn", "tailwindcss", "tw-animate-css"],
			"project": ["src/**/*.{ts,tsx}!", "stories/**/*.tsx!", "*.ts"]
		},
		"packages/workbench": {
			"entry": ["src/index.ts!", "src/styles.ts!", "stories/**/*.stories.tsx!", "scripts/*.mjs!"],
			"ignoreBinaries": ["java"],
			"project": ["src/**/*.{ts,tsx}!", "stories/**/*.tsx!", "scripts/*.mjs!", "*.ts"]
		},
		"packages/terminal-protocol": {
			"entry": [
				"src/index.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rslib.config.ts!",
				"vitest.config.ts!",
				"scripts/*.mjs!"
			],
			"ignoreBinaries": ["java"],
			"project": ["src/**/*.{ts,tsx}!", "scripts/*.mjs!", "*.ts"]
		},
		"packages/desktop-client-protocol": {
			"entry": [
				"src/index.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rslib.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "*.ts"]
		},
		"packages/workbench-client-protocol": {
			"entry": [
				"src/index.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rslib.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "*.ts"]
		},
		"packages/gateway-protocol": {
			"entry": [
				"src/index.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rslib.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "*.ts!"]
		},
		"packages/terminal": {
			"entry": [
				"src/index.ts",
				"src/projected/projected-terminal.ts!",
				"src/**/*.unit.test.{ts,tsx}",
				"rslib.config.ts",
				"vitest.config.ts"
			],
			"project": ["src/**/*.{ts,tsx}", "*.ts"]
		},
		"packages/tab-strip": {
			"entry": [
				"src/index.ts",
				"src/tab-strip/hooks/useTabStripActions.ts!",
				"src/**/*.unit.test.{ts,tsx}",
				"rslib.config.ts",
				"vitest.config.ts",
				"stories/**/*.stories.tsx"
			],
			"project": ["src/**/*.{ts,tsx}", "stories/**/*.tsx", "*.ts"]
		},
		"apps/web": {
			"entry": [
				"src/index.ts!",
				"src/composition/entry.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"src/**/*.system-fixture.ts!",
				"stories/**/*.stories.tsx!",
				"rsbuild.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "stories/**/*.tsx!", "*.ts"]
		},
		"apps/desktop": {
			"entry": [
				"scripts/*.mjs!",
				"src/index.ts!",
				"src/main/composition/entry.ts!",
				"src/preload/entry.ts!",
				"src/preload/index.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"system-tests/*.spec.ts!",
				"playwright.config.ts!",
				"rsbuild.config.ts!",
				"vitest.config.ts!"
			],
			"ignoreBinaries": ["java", "ps"],
			"ignoreDependencies": ["@playwright/test"],
			"project": [
				"scripts/*.mjs!",
				"src/**/*.{ts,tsx}!",
				"stories/**/*.tsx!",
				"system-tests/*.ts!",
				"*.ts!"
			]
		},
		"apps/gateway": {
			"entry": [
				"src/index.ts!",
				"src/composition/entry.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rsbuild.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "*.ts!"]
		},
		"apps/server": {
			"entry": [
				"src/index.ts!",
				"src/composition/entry.ts!",
				"src/**/*.unit.test.{ts,tsx}!",
				"rsbuild.config.ts!",
				"vitest.config.ts!"
			],
			"project": ["src/**/*.{ts,tsx}!", "*.ts!"]
		},
		"apps/storybook": {
			"entry": [
				".storybook/main.ts!",
				".storybook/preview.ts!",
				"rsbuild.config.ts!",
				"src/**/*.unit.test.{ts,tsx}!"
			],
			"ignoreDependencies": ["@orchbee/tab-strip", "@orchbee/ui", "@orchbee/workbench"],
			"project": [".storybook/*.ts!", "src/**/*.{ts,tsx}!", "*.ts"]
		},
		"apps/terminal-host": {
			"entry": ["scripts/*.mjs!"],
			"ignoreBinaries": ["zig"],
			"ignoreDependencies": ["@orchbee/terminal-protocol!"],
			"project": ["scripts/*.mjs!"]
		}
	}
}
