{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:keeper:message",
	"title": "OBKP Keeper message",
	"description": "One OBKP payload object in either direction. Duplicate members, nesting deeper than 32, integer spellings with a fraction or exponent, all-zero ids and times, holding order in a status page, the mark target's presence by state, message direction, and request pairing are decoder rules outside this schema; see schemas/keeper/README.md.",
	"oneOf": [
		{ "$ref": "#/$defs/hello" },
		{ "$ref": "#/$defs/hostRequest" },
		{ "$ref": "#/$defs/status" },
		{ "$ref": "#/$defs/hold" },
		{ "$ref": "#/$defs/holdProgram" },
		{ "$ref": "#/$defs/holdPty" },
		{ "$ref": "#/$defs/spawn" },
		{ "$ref": "#/$defs/reexec" },
		{ "$ref": "#/$defs/markRequest" },
		{ "$ref": "#/$defs/markedRequest" },
		{ "$ref": "#/$defs/claim" },
		{ "$ref": "#/$defs/release" },
		{ "$ref": "#/$defs/unknownRequest" },
		{ "$ref": "#/$defs/emptyResult" },
		{ "$ref": "#/$defs/statusResult" },
		{ "$ref": "#/$defs/spawnResult" },
		{ "$ref": "#/$defs/outcomeResult" },
		{ "$ref": "#/$defs/inspectResult" },
		{ "$ref": "#/$defs/inspectProgramResult" },
		{ "$ref": "#/$defs/inspectPtyResult" },
		{ "$ref": "#/$defs/refused" },
		{ "$ref": "#/$defs/unsupported" },
		{ "$ref": "#/$defs/exited" },
		{ "$ref": "#/$defs/event" }
	],
	"$defs": {
		"name": {
			"type": "string",
			"pattern": "^[a-z0-9-]{1,64}$"
		},
		"id": {
			"description": "A request id its connection has not used.",
			"type": "integer",
			"minimum": 1,
			"maximum": 4294967295
		},
		"time": {
			"description": "A FILETIME on Windows, or the start time in microseconds since the Unix epoch on macOS, as 16 lowercase hexadecimal digits, not all zero.",
			"type": "string",
			"pattern": "^[0-9a-f]{16}$"
		},
		"process": {
			"type": "object",
			"additionalProperties": false,
			"required": ["pid", "created"],
			"properties": {
				"pid": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
				"created": { "$ref": "#/$defs/time" }
			}
		},
		"randomId": {
			"description": "A holding id or mark id: 32 lowercase hexadecimal digits, not all zero.",
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"handle": {
			"description": "A handle value in the process that holds it: nonzero and below 2^32.",
			"type": "string",
			"pattern": "^0{8}[0-9a-f]{8}$"
		},
		"handles": {
			"type": "object",
			"additionalProperties": false,
			"required": ["job", "program", "console", "signal", "reference", "input", "output"],
			"properties": {
				"job": { "$ref": "#/$defs/handle" },
				"program": { "$ref": "#/$defs/handle" },
				"console": { "$ref": "#/$defs/handle" },
				"signal": { "$ref": "#/$defs/handle" },
				"reference": { "$ref": "#/$defs/handle" },
				"input": { "$ref": "#/$defs/handle" },
				"output": { "$ref": "#/$defs/handle" }
			}
		},
		"terminal": {
			"type": "object",
			"additionalProperties": false,
			"required": ["creationId", "hostEpoch", "terminalId"],
			"properties": {
				"creationId": { "$ref": "#/$defs/identity" },
				"hostEpoch": { "$ref": "#/$defs/identity" },
				"terminalId": { "$ref": "#/$defs/identity" }
			}
		},
		"facts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["terminal", "program", "console", "consoleBuild", "signalFormat", "launch"],
			"properties": {
				"terminal": { "$ref": "#/$defs/terminal" },
				"program": { "$ref": "#/$defs/process" },
				"console": { "$ref": "#/$defs/process" },
				"consoleBuild": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
				"signalFormat": { "type": "integer", "minimum": 1, "maximum": 65535 },
				"launch": { "$ref": "#/$defs/name" }
			}
		},
		"programHandles": {
			"description": "A background program's handles under programs: its Job, its process, and the read end of each captured stream.",
			"type": "object",
			"additionalProperties": false,
			"required": ["job", "process"],
			"properties": {
				"job": { "$ref": "#/$defs/handle" },
				"process": { "$ref": "#/$defs/handle" },
				"stdout": { "$ref": "#/$defs/handle" },
				"stderr": { "$ref": "#/$defs/handle" }
			}
		},
		"programFacts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["process", "programId", "label"],
			"properties": {
				"process": { "$ref": "#/$defs/process" },
				"programId": { "$ref": "#/$defs/identity" },
				"label": {
					"description": "The Worker's record of the program, returned unread.",
					"type": "string",
					"pattern": "^[A-Za-z0-9+/=]{1,2048}$"
				}
			}
		},
		"extensions": {
			"type": "object",
			"propertyNames": { "$ref": "#/$defs/name" }
		},
		"hello": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "role"],
			"properties": {
				"type": { "const": "hello" },
				"id": { "$ref": "#/$defs/id" },
				"role": {
					"description": "worker or host; the Keeper refuses any other name as wrong-role.",
					"$ref": "#/$defs/name"
				},
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"hostRequest": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "process"],
			"properties": {
				"type": { "enum": ["register-host", "unregister-host"] },
				"id": { "$ref": "#/$defs/id" },
				"process": { "$ref": "#/$defs/process" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"status": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id"],
			"properties": {
				"type": { "const": "status" },
				"id": { "$ref": "#/$defs/id" },
				"after": { "$ref": "#/$defs/randomId" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"hold": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "handles", "facts"],
			"properties": {
				"type": { "const": "hold" },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"handles": { "$ref": "#/$defs/handles" },
				"facts": { "$ref": "#/$defs/facts" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"holdProgram": {
			"description": "Under programs only; a Keeper that did not negotiate it answers unsupported.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "handles", "facts"],
			"properties": {
				"type": { "const": "hold-program" },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"handles": { "$ref": "#/$defs/programHandles" },
				"facts": { "$ref": "#/$defs/programFacts" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"slave": {
			"description": "A PTY slave's device path as ptsname reads it.",
			"type": "string",
			"pattern": "^/dev/[^\\u0000]+$",
			"maxLength": 128
		},
		"launchText": {
			"description": "Text that becomes a C string: nonempty and without a \\u0000.",
			"type": "string",
			"pattern": "^[^\\u0000]+$"
		},
		"ptyFacts": {
			"type": "object",
			"additionalProperties": false,
			"required": ["terminal", "leader", "slave", "launch"],
			"properties": {
				"terminal": { "$ref": "#/$defs/terminal" },
				"leader": { "$ref": "#/$defs/process" },
				"slave": { "$ref": "#/$defs/slave" },
				"launch": { "$ref": "#/$defs/name" }
			}
		},
		"launch": {
			"type": "object",
			"additionalProperties": false,
			"required": ["executable", "arguments", "environment", "candidates"],
			"properties": {
				"executable": { "$ref": "#/$defs/launchText" },
				"arguments": {
					"type": "array",
					"maxItems": 4096,
					"items": { "type": "string", "pattern": "^[^\\u0000]*$" }
				},
				"environment": {
					"type": "array",
					"maxItems": 4096,
					"items": { "type": "string", "pattern": "^[^\\u0000=]*=[^\\u0000]*$" }
				},
				"candidates": {
					"type": "array",
					"maxItems": 4096,
					"items": { "$ref": "#/$defs/launchText" }
				},
				"directory": { "$ref": "#/$defs/launchText" }
			}
		},
		"exitStatus": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["code"],
					"properties": { "code": { "type": "integer", "minimum": 0, "maximum": 255 } }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["signal"],
					"properties": { "signal": { "type": "integer", "minimum": 1, "maximum": 255 } }
				}
			]
		},
		"holdPty": {
			"description": "Under pty only; the message carries the master by SCM_RIGHTS.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "facts"],
			"properties": {
				"type": { "const": "hold-pty" },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"facts": { "$ref": "#/$defs/ptyFacts" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"spawn": {
			"description": "Under parent only; the message carries the master, the slave, and the standard input when input is true.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "input", "launch", "facts"],
			"properties": {
				"type": { "const": "spawn" },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"input": { "type": "boolean" },
				"launch": { "$ref": "#/$defs/launch" },
				"facts": {
					"type": "object",
					"additionalProperties": false,
					"required": ["terminal", "slave", "launch"],
					"properties": {
						"terminal": { "$ref": "#/$defs/terminal" },
						"slave": { "$ref": "#/$defs/slave" },
						"launch": { "$ref": "#/$defs/name" }
					}
				},
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"reexec": {
			"description": "Under reexec only; the Worker's request that the Keeper re-execute itself in place from program, a Terminal Host executable.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "program"],
			"properties": {
				"type": { "const": "reexec" },
				"id": { "$ref": "#/$defs/id" },
				"program": { "type": "string", "maxLength": 1024, "pattern": "^/[^\\u0000]*$" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"markRequest": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "for", "mark"],
			"properties": {
				"type": { "enum": ["mark", "assign"] },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"for": { "$ref": "#/$defs/process" },
				"mark": { "$ref": "#/$defs/randomId" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"markedRequest": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "mark"],
			"properties": {
				"type": { "enum": ["resume", "inspect", "decline"] },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"mark": { "$ref": "#/$defs/randomId" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"claim": {
			"description": "A terminal holding's claim names its terminal; a program holding's claim names none.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding", "mark", "program"],
			"properties": {
				"type": { "const": "claim" },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"mark": { "$ref": "#/$defs/randomId" },
				"program": { "$ref": "#/$defs/process" },
				"terminal": { "$ref": "#/$defs/terminal" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"release": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holding"],
			"properties": {
				"type": { "enum": ["release", "discard", "reap"] },
				"id": { "$ref": "#/$defs/id" },
				"holding": { "$ref": "#/$defs/randomId" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"unknownRequest": {
			"description": "A request type the Keeper does not know. Only type and id are read; other members belong to the newer contract.",
			"type": "object",
			"required": ["type", "id"],
			"properties": {
				"type": {
					"allOf": [
						{ "$ref": "#/$defs/name" },
						{
							"not": {
								"enum": [
									"hello",
									"register-host",
									"unregister-host",
									"status",
									"hold",
									"hold-program",
									"mark",
									"resume",
									"inspect",
									"claim",
									"decline",
									"release",
									"assign",
									"discard",
									"hold-pty",
									"spawn",
									"reap",
									"reexec",
									"refused",
									"unsupported"
								]
							}
						},
						{ "not": { "pattern": "-result$" } }
					]
				},
				"id": { "$ref": "#/$defs/id" }
			}
		},
		"emptyResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id"],
			"properties": {
				"type": {
					"enum": [
						"hello-result",
						"register-host-result",
						"unregister-host-result",
						"hold-result",
						"hold-program-result",
						"mark-result",
						"claim-result",
						"release-result",
						"assign-result",
						"discard-result",
						"hold-pty-result",
						"reap-result",
						"reexec-result"
					]
				},
				"id": { "$ref": "#/$defs/id" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"holdingEntry": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["holding", "owner", "state", "facts"],
					"properties": {
						"holding": { "$ref": "#/$defs/randomId" },
						"owner": { "$ref": "#/$defs/process" },
						"state": { "$ref": "#/$defs/holdingState" },
						"for": { "$ref": "#/$defs/process" },
						"facts": { "$ref": "#/$defs/facts" }
					}
				},
				{
					"description": "A program holding, listed only to a Worker that negotiated programs.",
					"type": "object",
					"additionalProperties": false,
					"required": ["holding", "owner", "state", "kind", "facts"],
					"properties": {
						"holding": { "$ref": "#/$defs/randomId" },
						"owner": { "$ref": "#/$defs/process" },
						"state": { "$ref": "#/$defs/holdingState" },
						"for": { "$ref": "#/$defs/process" },
						"kind": { "const": "program" },
						"facts": { "$ref": "#/$defs/programFacts" }
					}
				},
				{
					"description": "A PTY holding, listed only to a Worker that negotiated pty.",
					"type": "object",
					"additionalProperties": false,
					"required": ["holding", "owner", "state", "kind", "facts", "parented"],
					"properties": {
						"holding": { "$ref": "#/$defs/randomId" },
						"owner": { "$ref": "#/$defs/process" },
						"state": { "$ref": "#/$defs/holdingState" },
						"for": { "$ref": "#/$defs/process" },
						"kind": { "const": "pty" },
						"facts": { "$ref": "#/$defs/ptyFacts" },
						"parented": { "type": "boolean" },
						"ended": { "$ref": "#/$defs/exitStatus" }
					}
				}
			]
		},
		"holdingState": {
			"description": "held, quiesced, or orphaned; a receiver reads any other name as unknown.",
			"$ref": "#/$defs/name"
		},
		"hostEntry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["process", "ended"],
			"properties": {
				"process": { "$ref": "#/$defs/process" },
				"ended": { "type": "boolean" }
			}
		},
		"statusResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "holdings"],
			"properties": {
				"type": { "const": "status-result" },
				"id": { "$ref": "#/$defs/id" },
				"holdings": {
					"type": "array",
					"maxItems": 256,
					"items": { "$ref": "#/$defs/holdingEntry" }
				},
				"hosts": {
					"type": "array",
					"maxItems": 256,
					"items": { "$ref": "#/$defs/hostEntry" }
				},
				"next": { "$ref": "#/$defs/randomId" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"outcomeResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "outcome"],
			"properties": {
				"type": { "enum": ["resume-result", "decline-result"] },
				"id": { "$ref": "#/$defs/id" },
				"outcome": {
					"description": "resumed or claimed for resume, declined or claimed for decline; a receiver reads any other name as unknown.",
					"$ref": "#/$defs/name"
				},
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"inspectResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "handles", "facts"],
			"properties": {
				"type": { "const": "inspect-result" },
				"id": { "$ref": "#/$defs/id" },
				"handles": { "$ref": "#/$defs/handles" },
				"facts": { "$ref": "#/$defs/facts" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"inspectProgramResult": {
			"description": "inspect of a program holding: handles carries process where a terminal's carries program.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "handles", "facts"],
			"properties": {
				"type": { "const": "inspect-result" },
				"id": { "$ref": "#/$defs/id" },
				"handles": { "$ref": "#/$defs/programHandles" },
				"facts": { "$ref": "#/$defs/programFacts" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"inspectPtyResult": {
			"description": "A PTY holding's inspect-result; the message carries the master by SCM_RIGHTS.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "facts", "parented"],
			"properties": {
				"type": { "const": "inspect-result" },
				"id": { "$ref": "#/$defs/id" },
				"facts": { "$ref": "#/$defs/ptyFacts" },
				"parented": { "type": "boolean" },
				"ended": { "$ref": "#/$defs/exitStatus" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"spawnResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "leader"],
			"properties": {
				"type": { "const": "spawn-result" },
				"id": { "$ref": "#/$defs/id" },
				"leader": { "$ref": "#/$defs/process" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"refused": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "reason"],
			"properties": {
				"type": { "const": "refused" },
				"id": { "$ref": "#/$defs/id" },
				"reason": {
					"description": "not-registered, wrong-role, not-owner, not-target, unknown-holding, holding-exists, marked, stale-mark, identity-mismatch, capacity, draining, handle-failed, not-orphaned, spawn-failed, running, orphaned, busy, check-failed, or exec-failed; a receiver reads any other name as unknown.",
					"$ref": "#/$defs/name"
				},
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"unsupported": {
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "id", "request"],
			"properties": {
				"type": { "const": "unsupported" },
				"id": { "$ref": "#/$defs/id" },
				"request": { "$ref": "#/$defs/name" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		},
		"event": {
			"description": "Another frame from the Keeper without an id; a receiver ignores one it does not know.",
			"type": "object",
			"required": ["type"],
			"not": { "required": ["id"] },
			"properties": {
				"type": { "allOf": [{ "$ref": "#/$defs/name" }, { "not": { "const": "exited" } }] }
			}
		},
		"exited": {
			"description": "Under parent only: the parented leader of holding ended, and the Keeper keeps it unreaped until its owner's reap.",
			"type": "object",
			"additionalProperties": false,
			"required": ["type", "holding", "status"],
			"properties": {
				"type": { "const": "exited" },
				"holding": { "$ref": "#/$defs/randomId" },
				"status": { "$ref": "#/$defs/exitStatus" },
				"extensions": { "$ref": "#/$defs/extensions" }
			}
		}
	}
