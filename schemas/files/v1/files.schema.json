				},
				"warm": {
					"type": "boolean"
				},
				"stale": {
					"type": "boolean"
				}
			},
			"required": [
				"repository",
				"kind",
				"head",
				"operation",
				"counts",
				"truncated",
				"revision",
				"warm",
				"stale"
			],
			"additionalProperties": false
		},
		"scmSummary": {
			"type": "object",
			"properties": {
				"git": {
					"type": "object",
					"properties": {
						"state": {
							"enum": ["ok", "missing", "too-old"]
						},
						"version": {
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"pattern": "^[^\\u0000]*$"
						}
					},
					"required": ["state"],
					"additionalProperties": false
				},
				"repositories": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/scmRepository"
					},
					"maxItems": 256
				},
				"candidates": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/path"
					},
					"maxItems": 256
				},
				"unsafe": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/path"
					},
					"maxItems": 256
				},
				"repositoriesTruncated": {
					"type": "boolean"
				}
			},
			"required": ["git", "repositories", "candidates", "unsafe", "repositoriesTruncated"],
			"additionalProperties": false
		},
		"prompt": {
			"type": "object",
			"properties": {
				"id": {
					"$ref": "#/$defs/promptId"
				},
				"kind": {
					"enum": ["username", "password", "passphrase", "host-key", "editor"]
				},
				"text": {
					"type": "string",
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"repository": {
					"$ref": "#/$defs/path"
				},
				"path": {
					"$ref": "#/$defs/path"
				}
			},
			"required": ["id", "kind", "text", "repository"],
			"additionalProperties": false
		},
		"relaySnapshot": {
			"type": "object",
			"properties": {
				"prompts": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/prompt"
					},
					"maxItems": 16
				}
			},
			"required": ["prompts"],
			"additionalProperties": false
		},
		"relayUpdate": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "prompt"
						},
						"prompt": {
							"$ref": "#/$defs/prompt"
						}
					},
					"required": ["kind", "prompt"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "closed"
						},
						"id": {
							"$ref": "#/$defs/promptId"
						}
					},
					"required": ["kind", "id"],
					"additionalProperties": false
				}
			]
		}
	}
}
