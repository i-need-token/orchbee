					"additionalProperties": false,
					"properties": {
						"outcome": {
							"oneOf": [
								{
									"type": "object",
									"required": ["kind", "reservationId"],
									"additionalProperties": false,
									"properties": {
										"kind": {
											"const": "released"
										},
										"reservationId": {
											"$ref": "#/$defs/obapRequestId"
										}
									}
								},
								{
									"type": "object",
									"required": ["kind", "reason"],
									"additionalProperties": false,
									"properties": {
										"kind": {
											"const": "rejected"
										},
										"reason": {
											"enum": [
												"name-in-use",
												"presentation-busy",
												"capacity-exceeded",
												"binding-changed",
												"reservation-not-found",
												"candidate-unavailable",
												"candidate-ambiguous",
												"already-named",
												"not-ready",
												"read-denied",
												"manage-denied"
											]
										}
									}
								},
								{
									"$ref": "#/$defs/unavailableOutcome"
								}
							]
						}
					}
				}
			}
		}
	}
}
