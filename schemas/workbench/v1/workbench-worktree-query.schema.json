{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:workbench-worktree-query:v1",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/result"
		}
	],
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"label": {
			"type": "string",
			"minLength": 1,
			"maxLength": 512
		},
		"directoryPath": {
			"title": "WorkbenchDirectoryPath",
			"$comment": "The independent bindings additionally enforce the 4096-byte UTF-8 limit.",
			"type": "string",
			"minLength": 1,
			"maxLength": 4096,
			"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$"
		},
		"source": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace"
						},
						"workspaceId": {
							"$ref": "#/$defs/identity"
						}
					},
					"required": ["kind", "workspaceId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "directory"
						},
						"path": {
							"$ref": "#/$defs/directoryPath"
						}
					},
					"required": ["kind", "path"],
					"additionalProperties": false
				}
			]
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"querySource": {
			"type": "object",
			"properties": {
				"requestedPath": {
					"$ref": "#/$defs/directoryPath"
				},
				"repositoryRoot": {
					"$ref": "#/$defs/directoryPath"
				},
				"commonDirectory": {
					"$ref": "#/$defs/directoryPath"
				},
				"checkoutPath": {
					"$ref": "#/$defs/directoryPath"
				},
				"workspaceId": {
					"anyOf": [
						{
							"$ref": "#/$defs/identity"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": [
				"requestedPath",
				"repositoryRoot",
				"commonDirectory",
				"checkoutPath",
				"workspaceId"
			],
			"additionalProperties": false
		},
		"workspace": {
			"type": "object",
			"properties": {
				"projectId": {
					"anyOf": [
						{
							"$ref": "#/$defs/identity"
						},
						{
							"type": "null"
						}
					]
				},
				"workspaceId": {
					"$ref": "#/$defs/identity"
				},
				"label": {
					"$ref": "#/$defs/label"
				}
			},
			"required": ["projectId", "workspaceId", "label"],
			"additionalProperties": false
		},
		"checkout": {
			"type": "object",
			"properties": {
				"worktreePath": {
					"$ref": "#/$defs/directoryPath"
				},
				"head": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
						},
						{
							"type": "null"
						}
					]
				},
				"branch": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 12,
							"pattern": "^refs/heads/[^\\u0000]+$"
						},
						{
							"type": "null"
						}
					]
				},
				"bare": {
					"type": "boolean"
				},
				"detached": {
					"type": "boolean"
				},
				"locked": {
					"type": "boolean"
				},
				"prunable": {
					"type": "boolean"
				}
			},
			"required": ["worktreePath", "bare", "detached", "locked", "prunable"],
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"properties": {
							"bare": {
								"const": true
							}
						}
					},
					"then": {
						"properties": {
							"head": {
								"type": "null"
							},
							"branch": {
								"type": "null"
							},
							"detached": {
								"const": false
							}
						}
					},
					"else": {
						"required": ["head"],
						"properties": {
							"head": {
								"type": "string"
							}
						},
						"allOf": [
							{
								"if": {
									"properties": {
										"detached": {
											"const": true
										}
									}
								},
								"then": {
									"properties": {
										"branch": {
											"type": "null"
										}
									}
								},
								"else": {
									"required": ["branch"],
									"properties": {
										"branch": {
											"type": "string"
										}
									}
								}
							}
						]
					}
				}
			]
		},
		"entry": {
			"type": "object",
			"properties": {
				"checkout": {
					"$ref": "#/$defs/checkout"
				},
				"linked": {
					"type": "boolean"
				},
				"workspaces": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/workspace"
					}
				}
			},
			"required": ["checkout", "linked", "workspaces"],
			"additionalProperties": false
		},
		"failure": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-found"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "denied"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unsupported"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "source-changed"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "timeout"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "transport-loss"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "malformed-listing"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["server-busy", "worker-unavailable", "job-dead", "job-unknown"]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "git-failed"
						},
						"stage": {
							"enum": ["probe", "list"]
						},
						"status": {
							"anyOf": [
								{
									"type": "integer",
									"minimum": -2147483648,
									"maximum": 2147483647
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "stage", "status"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "owner-io"
						},
						"stage": {
							"anyOf": [
								{
									"enum": ["probe", "list"]
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "stage"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "too-large"
						},
						"origin": {
							"enum": ["git-probe", "git-list", "worker-result", "workbench-result"]
						}
					},
					"required": ["kind", "origin"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "spawn-unavailable"
						},
						"stage": {
							"enum": ["probe", "list"]
						}
					},
					"required": ["kind", "stage"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "spawn-failed"
						},
						"stage": {
							"enum": ["probe", "list"]
						}
					},
					"required": ["kind", "stage"],
					"additionalProperties": false
				}
			]
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "found"
						},
						"siteId": {
							"$ref": "#/$defs/identity"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"workerId": {
							"$ref": "#/$defs/identity"
						},
						"source": {
							"$ref": "#/$defs/querySource"
						},
						"entries": {
							"type": "array",
							"minItems": 1,
							"items": {
								"$ref": "#/$defs/entry"
							}
						}
					},
					"required": ["kind", "siteId", "workbenchRevision", "workerId", "source", "entries"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"$ref": "#/$defs/failure"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"request": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "workbench.worktree.query"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"siteId": {
					"$ref": "#/$defs/identity"
				},
				"source": {
					"$ref": "#/$defs/source"
				},
				"trustRepository": {
					"type": "boolean"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "siteId", "source", "trustRepository"],
			"additionalProperties": false
		},
		"result": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "workbench.worktree.query.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"outcome": {
					"$ref": "#/$defs/outcome"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"additionalProperties": false
		}
	}
}
