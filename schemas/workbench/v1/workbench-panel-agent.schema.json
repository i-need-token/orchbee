{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:workbench-panel-agent:v1",
	"$comment": "Bindings additionally enforce UTF-8 reference byte bounds, official source/reference eligibility, view consistency, unique Panel IDs and encoded limits. Windows Server validates provider path absoluteness before publication.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/result"
		}
	],
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"revision": {
			"type": "string",
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"maxLength": 20,
			"format": "orchbee-uint64"
		},
		"binding": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"workerId": {
					"$ref": "#/$defs/identity"
				},
				"terminalId": {
					"$ref": "#/$defs/identity"
				}
			},
			"required": ["workerId", "terminalId"]
		},
		"agent": {
			"type": "string",
			"minLength": 1,
			"not": {
				"pattern": "^[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]*$"
			}
		},
		"normalizedAgent": {
			"type": "string",
			"minLength": 1,
			"not": {
				"pattern": "^[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$(?![\\s\\S])"
			}
		},
		"state": {
			"enum": ["idle", "working", "blocked", "unknown"]
		},
		"report": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "state"
						},
						"source": {
							"type": "string"
						},
						"agent": {
							"$ref": "#/$defs/agent"
						},
						"state": {
							"$ref": "#/$defs/state"
						},
						"message": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						},
						"sequence": {
							"anyOf": [
								{
									"$ref": "#/$defs/revision"
								},
								{
									"type": "null"
								}
							]
						},
						"agentSessionId": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						},
						"agentSessionPath": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "source", "agent", "state"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "session"
						},
						"source": {
							"type": "string"
						},
						"agent": {
							"$ref": "#/$defs/agent"
						},
						"sequence": {
							"anyOf": [
								{
									"$ref": "#/$defs/revision"
								},
								{
									"type": "null"
								}
							]
						},
						"agentSessionId": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						},
						"agentSessionPath": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						},
						"sessionStartSource": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "source", "agent"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "clear"
						},
						"source": {
							"anyOf": [
								{
									"type": "string"
								},
								{
									"type": "null"
								}
							]
						},
						"sequence": {
							"anyOf": [
								{
									"$ref": "#/$defs/revision"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "release"
						},
						"source": {
							"type": "string"
						},
						"agent": {
							"$ref": "#/$defs/agent"
						},
						"sequence": {
							"anyOf": [
								{
									"$ref": "#/$defs/revision"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "source", "agent"]
				}
			]
		},
		"action": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "read"
						},
						"panelIds": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/identity"
							},
							"maxItems": 4,
							"uniqueItems": true
						}
					},
					"required": ["kind", "panelIds"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "report"
						},
						"panelId": {
							"$ref": "#/$defs/identity"
						},
						"expectedBinding": {
							"$ref": "#/$defs/binding"
						},
						"report": {
							"$ref": "#/$defs/report"
						}
					},
					"required": ["kind", "panelId", "expectedBinding", "report"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "binding", "afterSequence"],
					"properties": {
						"kind": {
							"const": "observe"
						},
						"binding": {
							"$ref": "#/$defs/terminalBinding"
						},
						"afterSequence": {
							"anyOf": [
								{
									"$ref": "#/$defs/revision"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "states"
						},
						"presentationIds": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/identity"
							},
							"maxItems": 64,
							"uniqueItems": true
						}
					},
					"required": ["kind", "presentationIds"]
				},
				{
					"type": "object",
					"required": ["kind", "binding"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "explain"
						},
						"binding": {
							"$ref": "#/$defs/terminalBinding"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "read-presentations"
						},
						"presentationIds": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/identity"
							},
							"maxItems": 4,
							"uniqueItems": true
						}
					},
					"required": ["kind", "presentationIds"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "report-presentation"
						},
						"panelId": {
							"$ref": "#/$defs/identity"
						},
						"expectedBinding": {
							"$ref": "#/$defs/binding"
						},
						"report": {
							"$ref": "#/$defs/report"
						},
						"presentationId": {
							"$ref": "#/$defs/identity"
						}
					},
					"required": ["kind", "panelId", "expectedBinding", "report", "presentationId"]
				}
			]
		},
		"reference": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["id", "path"]
				},
				"value": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"not": {
						"pattern": "[\\u0000-\\u001f\\u007f-\\u009f]"
					}
				}
			},
			"required": ["kind", "value"]
		},
		"session": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"source": {
					"type": "string"
				},
				"agent": {
					"$ref": "#/$defs/normalizedAgent"
				},
				"reference": {
					"$ref": "#/$defs/reference"
				}
			},
			"required": ["source", "agent", "reference"]
		},
		"view": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"agent": {
					"anyOf": [
						{
							"$ref": "#/$defs/normalizedAgent"
						},
						{
							"type": "null"
						}
					]
				},
				"state": {
					"$ref": "#/$defs/state"
				},
				"authoritySource": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"message": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"session": {
					"anyOf": [
						{
							"$ref": "#/$defs/session"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["agent", "state", "authoritySource", "message", "session"]
		},
		"row": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"panelId": {
					"$ref": "#/$defs/identity"
				},
				"binding": {
					"anyOf": [
						{
							"$ref": "#/$defs/binding"
						},
						{
							"type": "null"
						}
					]
				},
				"report": {
					"anyOf": [
						{
							"$ref": "#/$defs/view"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["panelId", "binding", "report"]
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "read"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"panels": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/row"
							},
							"maxItems": 4
						}
					},
					"required": ["kind", "workbenchRevision", "reportRevision", "panels"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "reported"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"panelId": {
							"$ref": "#/$defs/identity"
						},
						"binding": {
							"$ref": "#/$defs/binding"
						},
						"disposition": {
							"enum": ["applied", "ignored", "deferred"]
						},
						"changed": {
							"type": "boolean"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": [
						"kind",
						"workbenchRevision",
						"reportRevision",
						"panelId",
						"binding",
						"disposition",
						"changed",
						"view"
					]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"enum": [
								"denied",
								"unavailable",
								"site-mismatch",
								"invalid-request",
								"not-found",
								"unbound",
								"binding-changed",
								"source-limit",
								"history-limit",
								"resource-limit",
								"revision-exhausted",
								"clock-overflow",
								"result-too-large"
							]
						}
					},
					"required": ["kind", "reason"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "workbenchRevision", "reportRevision", "observation"],
					"properties": {
						"kind": {
							"const": "observed"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"observation": {
							"$ref": "#/$defs/semanticObservation"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "states"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"presentations": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/terminalStateRow"
							},
							"maxItems": 64,
							"uniqueItems": true
						}
					},
					"required": ["kind", "workbenchRevision", "reportRevision", "presentations"]
				},
				{
					"type": "object",
					"required": ["kind", "workbenchRevision", "reportRevision", "explanation"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "explained"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"explanation": {
							"$ref": "#/$defs/terminalExplanation"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "presentations-read"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"presentations": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/presentationRow"
							},
							"maxItems": 4
						}
					},
					"required": ["kind", "workbenchRevision", "reportRevision", "presentations"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "presentation-reported"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/revision"
						},
						"reportRevision": {
							"$ref": "#/$defs/revision"
						},
						"panelId": {
							"$ref": "#/$defs/identity"
						},
						"binding": {
							"$ref": "#/$defs/binding"
						},
						"disposition": {
							"enum": ["applied", "ignored", "deferred"]
						},
						"changed": {
							"type": "boolean"
						},
						"view": {
							"$ref": "#/$defs/view"
						},
						"presentationId": {
							"$ref": "#/$defs/identity"
						}
					},
					"required": [
						"kind",
						"workbenchRevision",
						"reportRevision",
						"panelId",
						"binding",
						"disposition",
						"changed",
						"view",
						"presentationId"
					]
				}
			]
		},
		"request": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench.panel-agent"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"siteId": {
					"$ref": "#/$defs/identity"
				},
				"action": {
					"$ref": "#/$defs/action"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "siteId", "action"]
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench.panel-agent.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"siteId": {
					"$ref": "#/$defs/identity"
				},
				"outcome": {
					"$ref": "#/$defs/outcome"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "siteId", "outcome"]
		},
		"terminalBinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/identity"
				},
				"generation": {
					"$ref": "#/$defs/identity"
				},
				"hostEpoch": {
					"$ref": "#/$defs/identity"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/identity"
				}
			}
		},
		"semanticChange": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sequence", "agent", "state"],
			"properties": {
				"sequence": {
					"allOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"not": {
								"const": "0"
							}
						}
					]
				},
				"agent": {
					"anyOf": [
						{
							"$ref": "#/$defs/normalizedAgent"
						},
						{
							"type": "null"
						}
					]
				},
				"state": {
					"$ref": "#/$defs/state"
				}
			}
		},
		"semanticObservation": {
			"type": "object",
			"additionalProperties": false,
			"required": ["binding", "sequence", "changes", "view"],
			"properties": {
				"binding": {
					"$ref": "#/$defs/terminalBinding"
				},
				"sequence": {
					"$ref": "#/$defs/revision"
				},
				"changes": {
					"type": "array",
					"maxItems": 128,
					"items": {
						"$ref": "#/$defs/semanticChange"
					}
				},
				"view": {
					"$ref": "#/$defs/view"
				}
			}
		},
		"terminalState": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"binding": {
					"$ref": "#/$defs/terminalBinding"
				},
				"sequence": {
					"$ref": "#/$defs/revision"
				},
				"agent": {
					"anyOf": [
						{
							"$ref": "#/$defs/normalizedAgent"
						},
						{
							"type": "null"
						}
					]
				},
				"state": {
					"$ref": "#/$defs/state"
				}
			},
			"required": ["binding", "sequence", "agent", "state"]
		},
		"terminalStateRow": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/identity"
				},
				"snapshot": {
					"anyOf": [
						{
							"$ref": "#/$defs/terminalState"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["presentationId", "snapshot"]
		},
		"screenRule": {
			"type": "object",
			"required": ["id", "priority", "region", "state"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"priority": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"region": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"state": {
					"$ref": "#/$defs/state"
				}
			}
		},
		"screenEvidence": {
			"type": "object",
			"required": [
				"contains",
				"regex",
				"lineRegex",
				"allCount",
				"anyCount",
				"notCount",
				"regionBytes",
				"regionPreview"
			],
			"additionalProperties": false,
			"properties": {
				"contains": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"type": "string",
						"maxLength": 512
					}
				},
				"regex": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"type": "string",
						"maxLength": 512
					}
				},
				"lineRegex": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"type": "string",
						"maxLength": 512
					}
				},
				"allCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 512
				},
				"anyCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 512
				},
				"notCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 512
				},
				"regionBytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65536
				},
				"regionPreview": {
					"type": "string",
					"maxLength": 243
				}
			}
		},
		"screenExplanation": {
			"type": "object",
			"required": [
				"agent",
				"state",
				"manifestSource",
				"manifestVersion",
				"matchedRule",
				"visibleIdle",
				"visibleBlocker",
				"visibleWorking",
				"screenDetectionSkipped",
				"screenDetectionSkipReason",
				"skipStateUpdate",
				"skippedUpdateReason",
				"fallbackReason",
				"evaluatedRules"
			],
			"additionalProperties": false,
			"properties": {
				"agent": {
					"enum": [
						"pi",
						"claude",
						"codex",
						"gemini",
						"cursor",
						"devin",
						"agy",
						"cline",
						"omp",
						"mastracode",
						"opencode",
						"copilot",
						"kimi",
						"kiro",
						"droid",
						"amp",
						"grok",
						"hermes",
						"kilo",
						"qodercli",
						"qwen",
						"letta",
						"maki",
						"muse"
					]
				},
				"state": {
					"$ref": "#/$defs/state"
				},
				"manifestSource": {
					"enum": ["bundled", "local-override", "remote-cache", null]
				},
				"manifestVersion": {
					"oneOf": [
						{
							"type": "string",
							"maxLength": 128
						},
						{
							"type": "null"
						}
					]
				},
				"matchedRule": {
					"oneOf": [
						{
							"$ref": "#/$defs/screenRule"
						},
						{
							"type": "null"
						}
					]
				},
				"visibleIdle": {
					"type": "boolean"
				},
				"visibleBlocker": {
					"type": "boolean"
				},
				"visibleWorking": {
					"type": "boolean"
				},
				"screenDetectionSkipped": {
					"type": "boolean"
				},
				"screenDetectionSkipReason": {
					"enum": ["full-lifecycle-hook-authority", null]
				},
				"skipStateUpdate": {
					"type": "boolean"
				},
				"skippedUpdateReason": {
					"oneOf": [
						{
							"type": "string",
							"pattern": "^matched-rule:.+"
						},
						{
							"type": "null"
						}
					]
				},
				"fallbackReason": {
					"enum": ["default-known-agent-idle-fallback", null]
				},
				"evaluatedRules": {
					"type": "array",
					"maxItems": 128,
					"items": {
						"type": "object",
						"required": ["rule", "matched", "evidence"],
						"additionalProperties": false,
						"properties": {
							"rule": {
								"$ref": "#/$defs/screenRule"
							},
							"matched": {
								"type": "boolean"
							},
							"evidence": {
								"$ref": "#/$defs/screenEvidence"
							}
						}
					}
				},
				"manifest": {
					"$ref": "#/$defs/manifestInfo"
				}
			}
		},
		"terminalExplanation": {
			"type": "object",
			"required": ["binding", "view", "explanation", "sample"],
			"additionalProperties": false,
			"properties": {
				"binding": {
					"$ref": "#/$defs/terminalBinding"
				},
				"view": {
					"$ref": "#/$defs/view"
				},
				"explanation": {
					"$ref": "#/$defs/screenExplanation"
				},
				"sample": {
					"oneOf": [
						{
							"type": "object",
							"required": [
								"frameSequence",
								"frameGeneration",
								"frameRevision",
								"rootPid",
								"agentPid"
							],
							"additionalProperties": false,
							"properties": {
								"frameSequence": {
									"allOf": [
										{
											"$ref": "#/$defs/revision"
										},
										{
											"not": {
												"const": "0"
											}
										}
									]
								},
								"frameGeneration": {
									"allOf": [
										{
											"$ref": "#/$defs/revision"
										},
										{
											"not": {
												"const": "0"
											}
										}
									]
								},
								"frameRevision": {
									"$ref": "#/$defs/revision"
								},
								"rootPid": {
									"type": "integer",
									"minimum": 1,
									"maximum": 4294967295
								},
								"agentPid": {
									"oneOf": [
										{
											"type": "integer",
											"minimum": 1,
											"maximum": 4294967295
										},
										{
											"type": "null"
										}
									]
								}
							}
						},
						{
							"type": "null"
						}
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"explanation": {
								"properties": {
									"screenDetectionSkipped": {
										"const": true
									}
								},
								"type": "object"
							}
						},
						"type": "object"
					},
					"then": {
						"properties": {
							"sample": {
								"type": "null"
							},
							"explanation": {
								"properties": {
									"manifestSource": {
										"type": "null"
									},
									"manifestVersion": {
										"type": "null"
									},
									"matchedRule": {
										"type": "null"
									},
									"skippedUpdateReason": {
										"type": "null"
									},
									"fallbackReason": {
										"type": "null"
									},
									"visibleIdle": {
										"const": false
									},
									"visibleBlocker": {
										"const": false
									},
									"visibleWorking": {
										"const": false
									},
									"skipStateUpdate": {
										"const": false
									},
									"screenDetectionSkipReason": {
										"const": "full-lifecycle-hook-authority"
									},
									"evaluatedRules": {
										"maxItems": 0,
										"type": "array"
									}
								},
								"type": "object"
							}
						},
						"type": "object"
					},
					"else": {
						"properties": {
							"sample": {
								"type": "object",
								"required": [
									"frameSequence",
									"frameGeneration",
									"frameRevision",
									"rootPid",
									"agentPid"
								],
								"additionalProperties": false,
								"properties": {
									"frameSequence": {
										"allOf": [
											{
												"$ref": "#/$defs/revision"
											},
											{
												"not": {
													"const": "0"
												}
											}
										]
									},
									"frameGeneration": {
										"allOf": [
											{
												"$ref": "#/$defs/revision"
											},
											{
												"not": {
													"const": "0"
												}
											}
										]
									},
									"frameRevision": {
										"$ref": "#/$defs/revision"
									},
									"rootPid": {
										"type": "integer",
										"minimum": 1,
										"maximum": 4294967295
									},
									"agentPid": {
										"oneOf": [
											{
												"type": "integer",
												"minimum": 1,
												"maximum": 4294967295
											},
											{
												"type": "null"
											}
										]
									}
								}
							},
							"explanation": {
								"properties": {
									"screenDetectionSkipReason": {
										"type": "null"
									}
								},
								"type": "object"
							}
						},
						"type": "object"
					}
				}
			]
		},
		"manifestInfo": {
			"type": "object",
			"required": [
				"source",
				"path",
				"cachedRemoteVersion",
				"localOverrideShadowingRemote",
				"warnings"
			],
			"additionalProperties": false,
			"properties": {
				"source": {
					"enum": ["bundled", "local-override", "remote-cache"]
				},
				"path": {
					"type": ["string", "null"],
					"minLength": 1,
					"maxLength": 32768
				},
				"cachedRemoteVersion": {
					"type": ["string", "null"],
					"maxLength": 128,
					"pattern": "^[0-9]+(?:\\.[0-9]+)*$"
				},
				"localOverrideShadowingRemote": {
					"type": "boolean"
				},
				"warnings": {
					"type": "array",
					"maxItems": 2,
					"items": {
						"type": "object",
						"required": ["source", "kind"],
						"additionalProperties": false,
						"properties": {
							"source": {
								"enum": ["local-override", "remote-cache"]
							},
							"kind": {
								"enum": [
									"unreadable",
									"not-regular",
									"too-large",
									"invalid-utf8",
									"invalid-manifest",
									"invalid-version",
									"older-than-bundled"
								]
							}
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"source": {
								"const": "bundled"
							}
						}
					},
					"then": {
						"properties": {
							"path": {
								"type": "null"
							}
						}
					},
					"else": {
						"properties": {
							"path": {
								"type": "string"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"localOverrideShadowingRemote": {
								"const": true
							}
						}
					},
					"then": {
						"properties": {
							"cachedRemoteVersion": {
								"type": "string"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"source": {
								"const": "remote-cache"
							}
						}
					},
					"then": {
						"properties": {
							"cachedRemoteVersion": {
								"type": "string"
							}
						}
					}
				}
			]
		},
		"presentationRow": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/identity"
				},
				"panel": {
					"$ref": "#/$defs/row"
				}
			},
			"required": ["presentationId", "panel"]
		}
	}
}
