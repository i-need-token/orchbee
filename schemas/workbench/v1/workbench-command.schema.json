{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:workbench-command:v1",
	"title": "Workbench requests and results",
	"oneOf": [
		{
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/snapshotReadIntent"
		},
		{
			"$ref": "#/$defs/command"
		},
		{
			"$ref": "#/$defs/snapshotResult"
		},
		{
			"$ref": "#/$defs/commandResult"
		},
		{
			"$ref": "#/$defs/tabCloseRead"
		},
		{
			"$ref": "#/$defs/tabCloseReadResult"
		},
		{
			"$ref": "#/$defs/tabCloseResume"
		},
		{
			"$ref": "#/$defs/tabCloseResumeResult"
		},
		{
			"$ref": "#/$defs/publicationRead"
		},
		{
			"$ref": "#/$defs/publicationResult"
		}
	],
	"$defs": {
		"action": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "project.create"
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						}
					},
					"required": ["kind", "label"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "project.rename"
						},
						"projectId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/projectId"
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						}
					},
					"required": ["kind", "projectId", "label"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace.create"
						},
						"projectId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/projectId"
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						}
					},
					"required": ["kind", "projectId", "label"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace.rename"
						},
						"projectId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/projectId"
						},
						"workspaceId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/workspaceId"
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						}
					},
					"required": ["kind", "projectId", "workspaceId", "label"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace.primary-directory.accept"
						},
						"projectId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/projectId"
						},
						"workspaceId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/workspaceId"
						},
						"path": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/directoryPath"
						}
					},
					"required": ["kind", "projectId", "workspaceId", "path"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab.rename"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "label"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab.create"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						},
						"geometry": {
							"$ref": "#/$defs/terminalGeometry"
						}
					},
					"required": ["kind", "terminalContextId", "label", "geometry"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel.split"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"direction": {
							"enum": ["above", "below", "left", "right"]
						},
						"label": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
						},
						"geometry": {
							"$ref": "#/$defs/terminalGeometry"
						}
					},
					"required": [
						"kind",
						"terminalContextId",
						"tabId",
						"panelId",
						"direction",
						"label",
						"geometry"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab.move"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"direction": {
							"enum": ["previous", "next", "first", "last"]
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "direction"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab.close"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel.close"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel.move"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"targetPanelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"direction": {
							"enum": ["above", "below", "left", "right"]
						}
					},
					"required": [
						"kind",
						"terminalContextId",
						"tabId",
						"panelId",
						"targetPanelId",
						"direction"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel.relocate"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"destination": {
							"$comment": "panel.relocate destination: `tab` inserts the moved leaf and the destination Tab's previous root as the children of a fresh root Split; `new-tab` appends a fresh Tab whose root is the moved leaf.",
							"oneOf": [
								{
									"type": "object",
									"properties": {
										"kind": {
											"const": "tab"
										},
										"tabId": {
											"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
										},
										"direction": {
											"enum": ["above", "below", "left", "right"]
										}
									},
									"required": ["kind", "tabId", "direction"],
									"additionalProperties": false
								},
								{
									"type": "object",
									"properties": {
										"kind": {
											"const": "new-tab"
										},
										"label": {
											"$ref": "urn:orchbee:schema:workbench:v1#/$defs/label"
										}
									},
									"required": ["kind", "label"],
									"additionalProperties": false
								}
							]
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "destination"],
					"additionalProperties": false
				}
			]
		},
		"terminalGeometry": {
			"$comment": "Semantic validation additionally requires columns * rows <= 262144, columns * cellPixelWidth <= 65535, and rows * cellPixelHeight <= 65535. The cellPixelWidth/cellPixelHeight pair must be either both positive (pixels known) or both zero (pixels unknown); a mixed pair is invalid.",
			"type": "object",
			"properties": {
				"columns": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"rows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"cellPixelWidth": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				},
				"cellPixelHeight": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				}
			},
			"required": ["columns", "rows", "cellPixelWidth", "cellPixelHeight"],
			"additionalProperties": false
		},
		"rejectionReason": {
			"enum": [
				"site-mismatch",
				"revision-mismatch",
				"project-unavailable",
				"workspace-unavailable",
				"workspace-directory-unavailable",
				"workspace-directory-conflict",
				"terminal-context-unavailable",
				"tab-unavailable",
				"panel-unavailable",
				"panel-not-leaf",
				"last-panel-in-tab",
				"same-tab",
				"resource-limit",
				"identity-exhausted",
				"revision-exhausted",
				"request-identity-conflict"
			]
		},
		"commandUnavailableReason": {
			"enum": [
				"request-ledger-full",
				"no-compatible-worker",
				"server-busy",
				"service-unavailable",
				"terminal-busy",
				"terminal-runtime-unavailable",
				"directory-unavailable"
			]
		},
		"snapshotUnavailableReason": {
			"enum": ["service-unavailable"]
		},
		"terminalUnavailableReason": {
			"enum": ["terminal-runtime-unavailable", "server-busy"]
		},
		"terminalFailureReason": {
			"enum": ["terminal-create-failed"]
		},
		"terminalOutcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "started"
						},
						"geometry": {
							"$ref": "#/$defs/terminalGeometry"
						}
					},
					"required": ["kind", "geometry"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"$ref": "#/$defs/terminalUnavailableReason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"$ref": "#/$defs/terminalFailureReason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "outcome-unknown"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				}
			]
		},
		"command": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "workbench.command"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/requestId"
				},
				"siteId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/siteId"
				},
				"expectedRevision": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
				},
				"action": {
					"$ref": "#/$defs/action"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "siteId", "expectedRevision", "action"],
			"additionalProperties": false
		},
		"commandOutcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "project-created"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"projectId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/projectId"
						}
					},
					"required": ["kind", "revision", "projectId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace-created"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"workspaceId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/workspaceId"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						}
					},
					"required": ["kind", "revision", "workspaceId", "terminalContextId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace-primary-directory-accepted"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"directoryId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/directoryId"
						},
						"workerId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/workerId"
						}
					},
					"required": ["kind", "revision", "directoryId", "workerId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "renamed"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						}
					},
					"required": ["kind", "revision"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab-create-pending"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"presentationId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
						}
					},
					"required": [
						"kind",
						"revision",
						"terminalContextId",
						"tabId",
						"panelId",
						"presentationId"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab-created"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"presentationId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
						},
						"terminalOutcome": {
							"$ref": "#/$defs/terminalOutcome"
						}
					},
					"required": [
						"kind",
						"revision",
						"terminalContextId",
						"tabId",
						"panelId",
						"presentationId",
						"terminalOutcome"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel-split-pending"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"newPanelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"splitId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/splitId"
						},
						"firstSlotId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelSlotId"
						},
						"secondSlotId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelSlotId"
						},
						"presentationId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
						}
					},
					"required": [
						"kind",
						"revision",
						"terminalContextId",
						"tabId",
						"panelId",
						"newPanelId",
						"splitId",
						"firstSlotId",
						"secondSlotId",
						"presentationId"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel-split-created"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"terminalContextId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
						},
						"panelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"newPanelId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
						},
						"splitId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/splitId"
						},
						"firstSlotId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelSlotId"
						},
						"secondSlotId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelSlotId"
						},
						"presentationId": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
						},
						"terminalOutcome": {
							"$ref": "#/$defs/terminalOutcome"
						}
					},
					"required": [
						"kind",
						"revision",
						"terminalContextId",
						"tabId",
						"panelId",
						"newPanelId",
						"splitId",
						"firstSlotId",
						"secondSlotId",
						"presentationId",
						"terminalOutcome"
					],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unchanged"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						}
					},
					"required": ["kind", "revision"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"revision": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
						"reason": {
							"$ref": "#/$defs/rejectionReason"
						}
					},
					"required": ["kind", "revision", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "denied"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
