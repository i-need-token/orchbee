{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:workbench-client-view:v1",
	"$comment": "Independent bindings enforce sequence bounds, Client ownership and selection, exact layout targets, cell containment, canonical neighbor ordering, node/identity limits and encoded layout envelope reservation. OBWP25/26 retain16KiB/64KiB; layout completion/result use27/28 at1MiB. Geometry is an ephemeral Client observation. Client ratio adjustments preserve selection, validate exact intent/revision and normalized signed delta, and use ordinary25/26 limits.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/result"
		}
	],
	"$defs": {
		"siteId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/siteId"
		},
		"requestId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/requestId"
		},
		"terminalContextId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/terminalContextId"
		},
		"tabId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
		},
		"panelId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
		},
		"revision": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"client": {
			"type": "object",
			"properties": {
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"heartbeat": {
					"$ref": "#/$defs/sequence"
				},
				"viewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"view": {
					"$ref": "#/$defs/view"
				},
				"availability": {
					"enum": ["current", "stale"]
				}
			},
			"required": ["clientId", "heartbeat", "viewRevision", "view", "availability"],
			"additionalProperties": false
		},
		"intent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "context"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						}
					},
					"required": ["kind", "terminalContextId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"enabled": {
							"type": "boolean"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "enabled"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "toggle-zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "focus-direction"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "direction"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "resize"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						},
						"amount": {
							"$ref": "#/$defs/resizeAmount"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "direction", "amount"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "set-split-ratio"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"path": {
							"$ref": "#/$defs/splitPath"
						},
						"ratio": {
							"$ref": "#/$defs/splitRatio"
						},
						"expectedSplit": {
							"type": "object",
							"additionalProperties": false,
							"required": ["splitId", "firstSlotId", "secondSlotId"],
							"properties": {
								"splitId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"firstSlotId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"secondSlotId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								}
							}
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "path", "ratio"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "agent-attention"
						},
						"sessionIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 128,
								"pattern": "^[A-Za-z0-9:._-]+$"
							}
						}
					},
					"required": ["kind", "sessionIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "selections"
						},
						"terminalContextIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 128,
							"uniqueItems": true,
							"items": {
								"$ref": "#/$defs/terminalContextId"
							}
						}
					},
					"required": ["kind", "terminalContextIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "viewports"
						},
						"panelIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 16,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"pattern": "^[0-9a-f]{32}$",
								"not": {
									"const": "00000000000000000000000000000000"
								}
							}
						}
					},
					"required": ["kind", "panelIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal-agent-attention"
						},
						"bindings": {
							"type": "array",
							"minItems": 1,
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"$ref": "#/$defs/physicalBinding"
							}
						}
					},
					"required": ["kind", "bindings"]
				}
			]
		},
		"control": {
			"type": "object",
			"properties": {
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"expectedViewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"minimumWorkbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"intent": {
					"$ref": "#/$defs/intent"
				}
			},
			"required": [
				"operationId",
				"clientId",
				"expectedViewRevision",
				"minimumWorkbenchRevision",
				"intent"
			],
			"additionalProperties": false
		},
		"reason": {
			"enum": [
				"busy",
				"stale-view",
				"target-unavailable",
				"projection-unavailable",
				"interrupted",
				"client-disconnected",
				"expired",
				"unsupported"
			]
		},
		"completion": {
			"type": "object",
			"properties": {
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "applied"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "rejected"
								},
								"reason": {
									"$ref": "#/$defs/reason"
								}
							},
							"required": ["kind", "reason"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "incomplete"
								},
								"reason": {
									"$ref": "#/$defs/reason"
								}
							},
							"required": ["kind", "reason"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "zoom-unchanged"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "zoom-toggled"
								},
								"previouslyZoomed": {
									"type": "boolean"
								}
							},
							"required": ["kind", "previouslyZoomed"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "layout-read"
								},
								"layout": {
									"$ref": "#/$defs/layout"
								}
							},
							"required": ["kind", "layout"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "direction-focused"
								},
								"panelId": {
									"$ref": "#/$defs/panelId"
								}
							},
							"required": ["kind", "panelId"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "direction-unchanged"
								},
								"layoutRevision": {
									"$ref": "#/$defs/revision"
								}
							},
							"required": ["kind", "layoutRevision"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "layout-adjusted"
								},
								"adjustment": {
									"$ref": "#/$defs/layoutAdjustment"
								}
							},
							"required": ["kind", "adjustment"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "attention-read"
								},
								"attention": {
									"$ref": "#/$defs/attentionSnapshot"
								}
							},
							"required": ["kind", "attention"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "navigation-read"
								},
								"navigation": {
									"$ref": "#/$defs/navigationSnapshot"
								}
							},
							"required": ["kind", "navigation"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "viewport-read"
								},
								"viewport": {
									"$ref": "#/$defs/viewportSnapshot"
								}
							},
							"required": ["kind", "viewport"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "terminal-attention-read"
								},
								"attention": {
									"$ref": "#/$defs/physicalAttentionSnapshot"
								}
							},
							"required": ["kind", "attention"],
							"additionalProperties": false
						}
					]
				}
			},
			"required": ["operationId", "outcome"],
			"additionalProperties": false
		},
		"status": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "queued"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "delivered"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "applied"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "incomplete"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						},
						"view": {
							"anyOf": [
								{
									"$ref": "#/$defs/view"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "reason", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-unchanged"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-toggled"
						},
						"view": {
							"$ref": "#/$defs/view"
						},
						"previouslyZoomed": {
							"type": "boolean"
						}
					},
					"required": ["kind", "view", "previouslyZoomed"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout-read"
						},
						"layout": {
							"$ref": "#/$defs/layout"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "layout", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "direction-focused"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "panelId", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "direction-unchanged"
						},
						"layoutRevision": {
							"$ref": "#/$defs/revision"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "layoutRevision", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout-adjusted"
						},
						"adjustment": {
							"$ref": "#/$defs/layoutAdjustment"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "adjustment", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "attention-read"
						},
						"attention": {
							"$ref": "#/$defs/attentionSnapshot"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "attention", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "navigation-read"
						},
						"navigation": {
							"$ref": "#/$defs/navigationSnapshot"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "navigation", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "viewport-read"
						},
						"viewport": {
							"$ref": "#/$defs/viewportSnapshot"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "viewport", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "terminal-attention-read"
						},
						"attention": {
							"$ref": "#/$defs/physicalAttentionSnapshot"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "attention", "view"],
					"additionalProperties": false
				}
			]
		},
		"operation": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "#/$defs/control"
				},
				"status": {
					"$ref": "#/$defs/status"
				}
			},
			"required": ["command", "status"],
			"additionalProperties": false
		},
		"action": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "synchronize"
						},
						"heartbeat": {
							"$ref": "#/$defs/sequence"
						},
						"viewRevision": {
							"$ref": "#/$defs/sequence"
						},
						"view": {
							"$ref": "#/$defs/view"
						},
						"completion": {
							"anyOf": [
								{
									"$ref": "#/$defs/completion"
								},
								{
