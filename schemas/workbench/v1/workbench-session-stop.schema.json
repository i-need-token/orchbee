{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:workbench-session-stop:v1",
	"$comment": "Bindings additionally enforce the 16 KiB request and result caps.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/result"
		}
	],
	"$defs": {
		"requestId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/requestId"
		},
		"sessionId": {
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/sessionId"
		},
		"stopId": {
			"description": "The identity `server status` reads the stop under.",
			"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
		},
		"request": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "workbench.session-stop"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"sessionId": {
					"$ref": "#/$defs/sessionId"
				},
				"stopId": {
					"$ref": "#/$defs/stopId"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "stopId"],
			"additionalProperties": false
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"enum": ["recorded", "busy", "unmanaged", "denied"]
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"enum": ["session-mismatch"]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"result": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "workbench.session-stop.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"outcome": {
					"$ref": "#/$defs/outcome"
				}
			},
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"additionalProperties": false
		}
	}
}
