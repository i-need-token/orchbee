{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://orchbee.dev/schemas/workbench/v1/user-preferences.schema.json",
	"title": "Shared device preferences",
	"description": "Closed v1 values, reset patches and one-exchange requests. Additional semantic admission: UTF-8 byte limits (512-byte profile names, 32 KiB executable/argument, 1 MiB catalog and 2 MiB envelope), Unicode scalar validity, trimmed names, unique profile IDs, selected-profile membership and localized-name marker only on system-default. Storage/application semantics are owned by the Workbench schema README.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/response"
		},
		{
			"$ref": "#/$defs/values"
		}
	],
	"$defs": {
		"colorThemeId": {
			"description": "A lowercase kebab-case color-theme id. Any well-formed id is admitted; a consumer resolves one it does not ship to the Orchbee theme of the slot's polarity.",
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
		},
		"values": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"locale": {
					"type": "string",
					"enum": ["system", "en-US", "zh-CN"]
				},
				"applicationTheme": {
					"type": "string",
					"enum": ["system", "light", "dark"]
				},
				"lightTheme": {
					"$ref": "#/$defs/colorThemeId"
				},
				"darkTheme": {
					"$ref": "#/$defs/colorThemeId"
				},
				"tuiColorSource": {
					"description": "Where the terminal Client takes its interface colors: the active theme slot, or the host terminal's own colors. The graphical Client ignores it.",
					"type": "string",
					"enum": ["theme", "terminal"]
				},
				"terminalDisplayTheme": {
					"type": "string",
					"enum": ["theme", "host", "custom"]
				},
				"customForeground": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}$"
				},
				"customBackground": {
					"type": "string",
					"pattern": "^#[0-9a-f]{6}$"
				},
				"copyOnSelect": {
					"type": "boolean"
				},
				"trimTrailingBlankRowsForAgents": {
					"type": "boolean"
				},
				"resumeAgentsOnRestore": {
					"type": "boolean"
				},
				"agentNotificationMode": {
					"type": "string",
					"enum": ["never", "hidden"]
				},
				"completionReminderMode": {
					"type": "string",
					"enum": ["never", "unfocused", "always"]
				},
				"completionReminderMinimumSeconds": {
					"type": "integer",
					"minimum": 1,
					"maximum": 3600
				},
				"soundEnabled": {
					"type": "boolean"
				},
				"scrollbackBytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 1000000000
				},
				"launchProfiles": {
					"$ref": "#/$defs/launchProfiles"
				}
			},
			"required": [
				"locale",
				"applicationTheme",
				"lightTheme",
				"darkTheme",
				"tuiColorSource",
				"terminalDisplayTheme",
				"customForeground",
				"customBackground",
				"copyOnSelect",
				"trimTrailingBlankRowsForAgents",
				"resumeAgentsOnRestore",
				"agentNotificationMode",
				"completionReminderMode",
				"completionReminderMinimumSeconds",
				"soundEnabled",
				"scrollbackBytes",
				"launchProfiles"
			],
			"default": {
				"locale": "system",
				"applicationTheme": "system",
				"lightTheme": "orchbee-light",
				"darkTheme": "orchbee-dark",
				"tuiColorSource": "theme",
				"terminalDisplayTheme": "theme",
				"customForeground": "#141414",
				"customBackground": "#fcfcfc",
				"copyOnSelect": false,
				"trimTrailingBlankRowsForAgents": true,
				"resumeAgentsOnRestore": true,
				"agentNotificationMode": "never",
				"completionReminderMode": "never",
				"completionReminderMinimumSeconds": 5,
				"soundEnabled": false,
				"scrollbackBytes": 10000000,
				"launchProfiles": {
					"version": 1,
					"defaultProfileId": "system-default",
					"profiles": [
						{
							"id": "system-default",
							"name": null,
							"command": {
								"kind": "system-shell",
								"login": false
							}
						}
					]
				}
			}
		},
		"patch": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"locale": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/locale"
						},
						{
							"type": "null"
						}
					]
				},
				"applicationTheme": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/applicationTheme"
						},
						{
							"type": "null"
						}
					]
				},
				"lightTheme": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/lightTheme"
						},
						{
							"type": "null"
						}
					]
				},
				"darkTheme": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/darkTheme"
						},
						{
							"type": "null"
						}
					]
				},
				"tuiColorSource": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/tuiColorSource"
						},
						{
							"type": "null"
						}
					]
				},
				"terminalDisplayTheme": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/terminalDisplayTheme"
						},
						{
							"type": "null"
						}
					]
				},
				"customForeground": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/customForeground"
						},
						{
							"type": "null"
						}
					]
				},
				"customBackground": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/customBackground"
						},
						{
							"type": "null"
						}
					]
				},
				"copyOnSelect": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/copyOnSelect"
						},
						{
							"type": "null"
						}
					]
				},
				"trimTrailingBlankRowsForAgents": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/trimTrailingBlankRowsForAgents"
						},
						{
							"type": "null"
						}
					]
				},
				"resumeAgentsOnRestore": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/resumeAgentsOnRestore"
						},
						{
							"type": "null"
						}
					]
				},
				"agentNotificationMode": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/agentNotificationMode"
						},
						{
							"type": "null"
						}
					]
				},
				"completionReminderMode": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/completionReminderMode"
						},
						{
							"type": "null"
						}
					]
				},
				"completionReminderMinimumSeconds": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/completionReminderMinimumSeconds"
						},
						{
							"type": "null"
						}
					]
				},
				"soundEnabled": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/soundEnabled"
						},
						{
							"type": "null"
						}
					]
				},
				"scrollbackBytes": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/scrollbackBytes"
						},
						{
							"type": "null"
						}
					]
				},
				"launchProfiles": {
					"anyOf": [
						{
							"$ref": "#/$defs/values/properties/launchProfiles"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": []
		},
		"snapshot": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"source": {
					"type": "string",
					"pattern": "^(missing|unreadable|[0-9a-f]{64})$"
				},
				"values": {
					"$ref": "#/$defs/values"
				},
				"claimed": {
					"type": "array",
					"items": {
						"type": "string",
						"enum": [
							"locale",
							"applicationTheme",
							"lightTheme",
							"darkTheme",
							"tuiColorSource",
							"terminalDisplayTheme",
							"customForeground",
							"customBackground",
							"copyOnSelect",
							"trimTrailingBlankRowsForAgents",
							"resumeAgentsOnRestore",
							"agentNotificationMode",
							"completionReminderMode",
							"completionReminderMinimumSeconds",
							"soundEnabled",
							"scrollbackBytes",
							"launchProfiles"
						]
					},
					"maxItems": 17,
					"uniqueItems": true
				}
			},
			"required": ["source", "values", "claimed"]
		},
		"request": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"operation": {
							"const": "read"
						}
					},
					"required": ["operation"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"operation": {
							"const": "update"
						},
						"source": {
							"type": "string",
							"pattern": "^(missing|unreadable|[0-9a-f]{64})$"
						},
						"changes": {
							"allOf": [
								{
									"$ref": "#/$defs/patch"
								}
							],
							"minProperties": 1,
							"type": "object"
						}
					},
					"required": ["operation", "source", "changes"],
					"allOf": [
						{
							"if": {
								"properties": {
									"source": {
										"const": "unreadable"
									}
								}
							},
							"then": {
								"properties": {
									"changes": {
										"type": "object",
										"required": [
											"locale",
											"applicationTheme",
											"lightTheme",
											"darkTheme",
											"tuiColorSource",
											"terminalDisplayTheme",
											"customForeground",
											"customBackground",
											"copyOnSelect",
											"trimTrailingBlankRowsForAgents",
											"resumeAgentsOnRestore",
											"agentNotificationMode",
											"completionReminderMode",
											"completionReminderMinimumSeconds",
											"soundEnabled",
											"scrollbackBytes",
											"launchProfiles"
										],
										"properties": {
											"locale": {
												"type": "null"
											},
											"applicationTheme": {
												"type": "null"
											},
											"lightTheme": {
												"type": "null"
											},
											"darkTheme": {
												"type": "null"
											},
											"tuiColorSource": {
												"type": "null"
											},
											"terminalDisplayTheme": {
												"type": "null"
											},
											"customForeground": {
												"type": "null"
											},
											"customBackground": {
												"type": "null"
											},
											"copyOnSelect": {
												"type": "null"
											},
											"trimTrailingBlankRowsForAgents": {
												"type": "null"
											},
											"resumeAgentsOnRestore": {
												"type": "null"
											},
											"agentNotificationMode": {
												"type": "null"
											},
											"completionReminderMode": {
												"type": "null"
											},
											"completionReminderMinimumSeconds": {
												"type": "null"
											},
											"soundEnabled": {
												"type": "null"
											},
											"scrollbackBytes": {
												"type": "null"
											},
											"launchProfiles": {
												"type": "null"
											}
										}
									}
								}
							}
						}
					]
				}
			]
		},
		"response": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "snapshot"
						},
						"snapshot": {
							"$ref": "#/$defs/snapshot"
						},
						"changed": {
							"type": "boolean"
						}
					},
					"required": ["kind", "snapshot", "changed"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "refused"
						},
						"reason": {
							"type": "string",
							"enum": [
								"invalid-request",
								"invalid-changes",
								"invalid-source",
								"unavailable",
								"busy",
								"source-changed",
								"write-failed"
							]
						}
					},
					"required": ["kind", "reason"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "outcome-unknown"
						}
					},
					"required": ["kind"]
				}
			]
		},
		"launchProfiles": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"version": {
					"const": 1
				},
				"defaultProfileId": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128,
					"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
				},
				"profiles": {
					"type": "array",
					"minItems": 1,
					"maxItems": 64,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"properties": {
							"id": {
								"type": "string",
								"minLength": 1,
								"maxLength": 128,
								"pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
							},
							"name": {
								"anyOf": [
									{
										"type": "string",
										"minLength": 1,
										"maxLength": 512,
										"pattern": "^[^\\u0000]*$"
									},
									{
										"type": "null"
									}
								]
							},
							"command": {
								"oneOf": [
									{
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"kind": {
												"const": "system-shell"
											},
											"login": {
												"type": "boolean"
											}
										},
										"required": ["kind", "login"]
									},
									{
										"type": "object",
										"additionalProperties": false,
										"properties": {
											"kind": {
												"const": "custom-executable"
											},
											"executable": {
												"type": "string",
												"minLength": 1,
												"maxLength": 32768,
												"pattern": "^[^\\u0000]*$"
											},
											"arguments": {
												"type": "array",
												"maxItems": 128,
												"items": {
													"type": "string",
													"minLength": 0,
													"maxLength": 32768,
													"pattern": "^[^\\u0000]*$"
												}
											}
										},
										"required": ["kind", "executable", "arguments"]
									}
								]
							}
						},
						"required": ["id", "name", "command"]
					}
				}
			},
			"required": ["version", "defaultProfileId", "profiles"]
		}
	}
}
