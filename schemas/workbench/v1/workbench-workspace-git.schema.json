{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"title": "Workspace local Git observation",
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "siteId", "workspaceId"],
			"properties": {
				"kind": {
					"const": "workbench.workspace-git"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"siteId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"workspaceId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				}
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "siteId", "workspaceId", "outcome"],
			"properties": {
				"kind": {
					"const": "workbench.workspace-git.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"siteId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"workspaceId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "workbenchRevision", "branch", "divergence"],
							"properties": {
								"kind": {
									"const": "observed"
								},
								"workbenchRevision": {
									"type": "string",
									"pattern": "^(0|[1-9][0-9]{0,19})$"
								},
								"branch": {
									"type": ["string", "null"],
									"minLength": 1,
									"maxLength": 1024
								},
								"divergence": {
									"oneOf": [
										{
											"type": "object",
											"additionalProperties": false,
											"required": ["ahead", "behind"],
											"properties": {
												"ahead": {
													"type": "integer",
													"minimum": 0,
													"maximum": 4294967295
												},
												"behind": {
													"type": "integer",
													"minimum": 0,
													"maximum": 4294967295
												}
											}
										},
										{
											"type": "null"
										}
									]
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "reason"],
							"properties": {
								"kind": {
									"const": "failed"
								},
								"reason": {
									"enum": [
										"denied",
										"unavailable",
										"not-found",
										"source-changed",
										"timeout",
										"malformed"
									]
								}
							}
						}
					]
				}
			}
		}
	]
}
