{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://orchbee.dev/schemas/workbench/v1/workbench-settings.schema.json",
	"title": "Site-scoped shared user settings",
	"description": "Matched native cohorts use the shared preference grammar and a 2 MiB request/result budget. Save confirms persistence; live client application is a separate observation. Launch-profile semantic bounds are inherited from the shared preferences contract.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/response"
		}
	],
	"$defs": {
		"source": {
			"type": "string",
			"pattern": "^(?:missing|[0-9a-f]{64})$"
		},
		"changes": {
			"type": "object",
			"minProperties": 1,
			"allOf": [
				{
					"$ref": "https://orchbee.dev/schemas/workbench/v1/user-preferences.schema.json#/$defs/patch"
				}
			]
		},
		"request": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "siteId", "operation"],
			"properties": {
				"kind": {
					"const": "workbench.settings"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"type": "string",
					"minLength": 32,
					"maxLength": 32,
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"siteId": {
					"type": "string",
					"minLength": 32,
					"maxLength": 32,
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"operation": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind"],
							"properties": {
								"kind": {
									"const": "open"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "source", "changes"],
							"properties": {
								"kind": {
									"const": "save"
								},
								"source": {
									"$ref": "#/$defs/source"
								},
								"changes": {
									"$ref": "#/$defs/changes"
								}
							}
						}
					]
				}
			}
		},
		"response": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "siteId", "outcome"],
			"properties": {
				"kind": {
					"const": "workbench.settings.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"type": "string",
					"minLength": 32,
					"maxLength": 32,
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"siteId": {
					"type": "string",
					"minLength": 32,
					"maxLength": 32,
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "snapshot"],
							"properties": {
								"kind": {
									"const": "opened"
								},
								"snapshot": {
									"$ref": "https://orchbee.dev/schemas/workbench/v1/user-preferences.schema.json#/$defs/snapshot"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "snapshot", "changed"],
							"properties": {
								"kind": {
									"const": "saved"
								},
								"snapshot": {
									"$ref": "https://orchbee.dev/schemas/workbench/v1/user-preferences.schema.json#/$defs/snapshot"
								},
								"changed": {
									"type": "boolean"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind"],
							"properties": {
								"kind": {
									"const": "outcome-unknown"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "reason"],
							"properties": {
								"kind": {
									"const": "refused"
								},
								"reason": {
									"enum": [
										"denied",
										"unavailable",
										"site-mismatch",
										"busy",
										"source-changed",
										"invalid-source",
										"invalid-changes",
										"write-failed",
										"response-too-large"
									]
								}
							}
						}
					]
				}
			}
		}
	}
}
