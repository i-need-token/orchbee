{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://orchbee.dev/schemas/workbench/v1/workbench-configuration.schema.json",
	"title": "Session configuration publication",
	"$comment": "Bindings additionally enforce 256 KiB encoded frames, Unicode scalar strings and UTF-8 byte bounds; JSON Schema maxLength remains a code-point bound.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/result"
		}
	],
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"diagnostic": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "string",
					"minLength": 1,
					"maxLength": 128,
					"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
				}
			]
		},
		"configurationDiagnostic": {
			"type": "object",
			"required": ["field", "reason", "disposition"],
			"additionalProperties": false,
			"properties": {
				"field": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256,
					"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$",
					"$comment": "Bindings additionally enforce the 256 UTF-8 byte limit."
				},
				"reason": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64,
					"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
				},
				"disposition": {
					"enum": ["defaulted", "disabled", "ignored"]
				}
			}
		},
		"configurationDiagnostics": {
			"type": "object",
			"required": ["items", "omittedCount"],
			"additionalProperties": false,
			"properties": {
				"items": {
					"type": "array",
					"maxItems": 128,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/configurationDiagnostic"
					},
					"$comment": "Bindings additionally require strict ascending (field, reason) order."
				},
				"omittedCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65536
				}
			}
		},
		"snapshot": {
			"type": "object",
			"required": [
				"revision",
				"diagnostics",
				"keysProfile",
				"manifestCheck",
				"restartRequired",
				"defaultShell",
				"shellMode",
				"windowTitle",
				"notificationProfile",
				"agentSidebarProfile",
				"spacesSidebarProfile",
				"themeName"
			],
			"additionalProperties": false,
			"properties": {
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"maxLength": 20,
					"format": "orchbee-uint64"
				},
				"diagnostics": {
					"$ref": "#/$defs/configurationDiagnostics"
				},
				"keysProfile": {
					"type": "string",
					"minLength": 1,
					"maxLength": 65536
				},
				"manifestCheck": {
					"type": "boolean"
				},
				"restartRequired": {
					"type": "array",
					"maxItems": 3,
					"uniqueItems": true,
					"items": {
						"enum": ["terminal.default_shell", "terminal.shell_mode"]
					}
				},
				"defaultShell": {
					"type": "string",
					"maxLength": 4096,
					"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
					"$comment": "Bindings additionally enforce the 4096 UTF-8 byte limit and Unicode scalar strings."
				},
				"shellMode": {
					"enum": ["auto", "login", "non_login"]
				},
				"windowTitle": {
					"type": "string",
					"maxLength": 4096
				},
				"notificationProfile": {
					"type": "string",
					"minLength": 1,
					"maxLength": 16384,
					"$comment": "Bindings additionally enforce the 16 KiB UTF-8 byte limit."
				},
				"agentSidebarProfile": {
					"type": "string",
					"minLength": 1,
					"maxLength": 32768
				},
				"spacesSidebarProfile": {
					"type": "string",
					"minLength": 1,
					"maxLength": 32768
				},
				"themeName": {
					"enum": ["terminal-native", "one-light", "one-dark"]
				}
			}
		},
		"request": {
			"type": "object",
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "action"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench.configuration"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"sessionId": {
					"$ref": "#/$defs/identity"
				},
				"action": {
					"enum": ["current", "reload"]
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "outcome"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench.configuration.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"sessionId": {
					"$ref": "#/$defs/identity"
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"required": ["kind", "snapshot"],
							"additionalProperties": false,
							"properties": {
								"kind": {
									"const": "current"
								},
								"snapshot": {
									"$ref": "#/$defs/snapshot"
								}
							}
						},
						{
							"type": "object",
							"required": ["kind", "snapshot", "changed"],
							"additionalProperties": false,
							"properties": {
								"kind": {
									"const": "reloaded"
								},
								"snapshot": {
									"$ref": "#/$defs/snapshot"
								},
								"changed": {
									"type": "boolean"
								}
							}
						},
						{
							"type": "object",
							"required": ["kind", "reason", "field", "detail"],
							"additionalProperties": false,
							"properties": {
								"kind": {
									"const": "failed"
								},
								"reason": {
									"enum": [
										"denied",
										"unavailable",
										"session-mismatch",
										"busy",
										"load-failed",
										"revision-exhausted"
									]
								},
								"field": {
									"$ref": "#/$defs/diagnostic"
								},
								"detail": {
									"$ref": "#/$defs/diagnostic"
								}
							},
							"allOf": [
								{
									"oneOf": [
										{
											"properties": {
												"field": {
													"type": "null"
												},
												"detail": {
													"type": "null"
												}
											}
										},
										{
											"properties": {
												"field": {
													"type": "string"
												},
												"detail": {
													"type": "string"
												},
												"reason": {
													"const": "load-failed"
												}
											}
										}
									]
								}
							]
						}
					]
				}
			}
		}
	}
}
