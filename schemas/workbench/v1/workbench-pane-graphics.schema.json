							]
						},
						"offset": {
							"type": "integer",
							"minimum": 0,
							"maximum": 4294967295,
							"multipleOf": 4
						},
						"maximumBytes": {
							"type": "integer",
							"minimum": 4,
							"maximum": 262144,
