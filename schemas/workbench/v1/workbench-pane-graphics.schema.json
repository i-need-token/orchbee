{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:workbench-pane-graphics:v1",
	"$comment": "OBWP57/58 bounds requests at 24MiB and results at 512KiB before allocation. Rust and TypeScript additionally enforce decoded channel lengths, pixel and resident budgets, damage bounds, resource ordering, unique layers and exact chunk completion. PNG bytes are decoded only by the admitted Host. File frames additionally require the producer private-root lease. No renderer or file directory is inferred from protocol availability.",
	"oneOf": [
		{
			"$ref": "#/$defs/request"
		},
		{
			"$ref": "#/$defs/result"
		}
	],
	"$defs": {
		"layerId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 80,
			"pattern": "^[A-Za-z0-9_.-]+$"
		},
		"placement": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"viewportColumn": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"viewportRow": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"gridColumns": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				},
				"gridRows": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				}
			},
			"required": ["viewportColumn", "viewportRow", "gridColumns", "gridRows"]
		},
		"target": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"panelId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
				},
				"presentationId": {
					"oneOf": [
						{
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["panelId", "presentationId"]
		},
		"resolved": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"panelId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
				},
				"presentationId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
				}
			},
			"required": ["panelId", "presentationId"]
		},
		"setFrame": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "png"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
