						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 44,
							"maxLength": 699052,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "rgb"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 4,
							"maxLength": 699052,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "rgba"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 4,
							"maxLength": 699052,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "bgra"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 4,
							"maxLength": 699052,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				}
			]
		},
		"streamFrame": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "png"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 44,
							"maxLength": 22369624,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
