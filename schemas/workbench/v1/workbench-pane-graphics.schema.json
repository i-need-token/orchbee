					"minimum": 1,
					"maximum": 4096
				},
				"placement": {
					"$ref": "#/$defs/placement"
				},
				"resourceRevision": {
					"allOf": [
						{
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/revision"
						},
