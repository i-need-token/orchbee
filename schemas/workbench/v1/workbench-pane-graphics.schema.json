						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 4,
							"maxLength": 22369624,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "rgba"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 4,
							"maxLength": 22369624,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"format": {
							"const": "bgra"
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"dataBase64": {
							"type": "string",
							"minLength": 4,
							"maxLength": 22369624,
							"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}[AEIMQUYcgkosw048]=|[A-Za-z0-9+/][AQgw]==)?$"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["format", "width", "height", "dataBase64", "placement"]
				}
			]
		},
		"streamImage": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "inline"
						},
						"image": {
							"$ref": "#/$defs/streamFrame"
						}
					},
					"required": ["kind", "image"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "file"
						},
						"format": {
							"enum": ["rgba", "bgra"]
						},
						"width": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"height": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"path": {
							"$ref": "urn:orchbee:schema:workbench:v1#/$defs/directoryPath"
						},
						"placement": {
							"$ref": "#/$defs/placement"
						}
					},
					"required": ["kind", "format", "width", "height", "path", "placement"]
				}
			]
		},
		"damage": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"x": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				},
				"y": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				}
			},
			"required": ["x", "y", "width", "height"]
		},
		"capabilities": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"transport": {
					"enum": ["cell-raster", "kitty", "sixel"]
				},
				"cellPixels": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"width": {
									"type": "integer",
									"minimum": 1,
									"maximum": 65535
								},
								"height": {
									"type": "integer",
									"minimum": 1,
									"maximum": 65535
								}
							},
							"required": ["width", "height"]
						},
						{
							"type": "null"
						}
					]
				},
				"pixelMouse": {
					"type": "boolean"
				}
			},
			"required": ["transport", "cellPixels", "pixelMouse"],
			"allOf": [
				{
					"if": {
						"properties": {
							"pixelMouse": {
								"const": true
							}
						},
						"required": ["pixelMouse"]
					},
					"then": {
						"properties": {
							"transport": {
								"enum": ["kitty", "sixel"]
							},
							"cellPixels": {
								"type": "object"
							}
						}
					}
				}
			]
		},
		"layer": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"layerId": {
					"$ref": "#/$defs/layerId"
				},
				"zIndex": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"width": {
