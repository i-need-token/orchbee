{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://orchbee.dev/schemas/workbench/v1/workbench-current-directory.schema.json",
	"title": "Workspace current directory read",
	"$comment": "Rust and TypeScript additionally enforce the 4096-byte UTF-8 directory limit and the 26 KiB result budget.",
	"$defs": {
		"panel": {
			"$comment": "Absent, the read is about the Workspace's first terminal. Present, it names a Panel of the Workspace and the Presentation the asking Client shows in it.",
			"type": "object",
			"additionalProperties": false,
			"required": ["panelId", "presentationId"],
			"properties": {
				"panelId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"presentationId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				}
			}
		}
	},
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "workspaceId"],
			"properties": {
				"kind": {
					"const": "workbench.current-directory"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"sessionId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"workspaceId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"panel": {
					"$ref": "#/$defs/panel"
				}
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "workspaceId", "outcome"],
			"properties": {
				"kind": {
					"const": "workbench.current-directory.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"sessionId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"workspaceId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/identity"
				},
				"panel": {
					"$ref": "#/$defs/panel"
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "directory"],
							"properties": {
								"kind": {
									"const": "observed"
								},
								"directory": {
									"$ref": "urn:orchbee:schema:workbench:v1#/$defs/directoryPath"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "reason"],
							"properties": {
								"kind": {
									"const": "failed"
								},
								"reason": {
									"enum": ["denied", "not-found", "unavailable"]
								}
							}
						}
					]
				}
			}
		}
	]
}
