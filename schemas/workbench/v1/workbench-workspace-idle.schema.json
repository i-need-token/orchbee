{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://orchbee.dev/schemas/workbench/v1/workbench-workspace-idle.schema.json",
	"title": "Workspace idle read",
	"$defs": {
		"member": {
			"type": "object",
			"additionalProperties": false,
			"required": ["tabId", "panelId", "presentationId", "reason"],
			"properties": {
				"tabId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/tabId"
				},
				"panelId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/panelId"
				},
				"presentationId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/presentationId"
				},
				"reason": {
					"$comment": "running: the shell reported a running command, or a program other than the shell holds the console. unknown: the evidence could not be read in time, or did not tell.",
					"enum": ["running", "unknown"]
				}
			}
		}
	},
	"oneOf": [
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "workspaceId"],
			"properties": {
				"kind": {
					"const": "workbench.workspace-idle"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/requestId"
				},
				"sessionId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/sessionId"
				},
				"workspaceId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/workspaceId"
				}
			}
		},
		{
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "sessionId", "workspaceId", "outcome"],
			"properties": {
				"kind": {
					"const": "workbench.workspace-idle.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/requestId"
				},
				"sessionId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/sessionId"
				},
				"workspaceId": {
					"$ref": "urn:orchbee:schema:workbench:v1#/$defs/workspaceId"
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind"],
							"properties": {
								"kind": {
									"const": "idle"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "members"],
							"properties": {
								"kind": {
									"const": "busy"
								},
								"members": {
									"$comment": "Distinct Presentations, in the order a Close of the Workspace captures them.",
									"type": "array",
									"minItems": 1,
									"maxItems": 4096,
									"items": {
										"$ref": "#/$defs/member"
									}
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "reason"],
							"properties": {
								"kind": {
									"const": "failed"
								},
								"reason": {
									"enum": ["denied", "not-found", "unavailable"]
								}
							}
						}
					]
				}
			}
		}
	]
}
