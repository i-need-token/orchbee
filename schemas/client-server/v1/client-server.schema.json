{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:client-server:v1",
	"title": "Orchbee Client-Server terminal-control contract version 1",
	"oneOf": [
		{ "$ref": "#/$defs/terminalCreate" },
		{ "$ref": "#/$defs/terminalCreateResult" },
		{ "$ref": "#/$defs/terminalStart" },
		{ "$ref": "#/$defs/terminalStartResult" }
	],
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": { "const": "00000000000000000000000000000000" }
		},
		"requestId": {
			"title": "ClientServerRequestId",
			"$ref": "#/$defs/identity"
		},
		"workerId": {
			"title": "WorkerId",
			"$ref": "#/$defs/identity"
		},
		"cwd": {
			"title": "Absolute POSIX working directory intent",
			"type": "string",
			"minLength": 1,
			"maxLength": 4096,
			"pattern": "^/[^\\u0000]*$",
			"$comment": "The authoritative 4096 limit is UTF-8 encoded bytes; schema maxLength is an additional necessary code-point bound."
		},
		"geometry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["columns", "rows", "cellPixelWidth", "cellPixelHeight"],
			"properties": {
				"columns": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"rows": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"cellPixelWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"cellPixelHeight": { "type": "integer", "minimum": 1, "maximum": 4096 }
			},
			"$comment": "The semantic contract additionally requires columns*rows <= 262144, columns*cellPixelWidth <= 65535, and rows*cellPixelHeight <= 65535."
		},
		"workerConstraint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "workerId"],
			"properties": {
				"kind": { "const": "exact" },
				"workerId": { "$ref": "#/$defs/workerId" }
			}
		},
		"immediateStartMode": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "geometry"],
			"properties": {
				"kind": { "const": "immediate" },
				"geometry": { "$ref": "#/$defs/geometry" }
			}
		},
		"deferredStartMode": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": { "const": "deferred" }
			}
		},
		"startMode": {
			"oneOf": [{ "$ref": "#/$defs/immediateStartMode" }, { "$ref": "#/$defs/deferredStartMode" }]
		},
		"terminalCreate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "workerConstraint", "cwd", "startMode"],
			"properties": {
				"kind": { "const": "terminal.create" },
				"protocolVersion": { "const": 1 },
				"requestId": { "$ref": "#/$defs/requestId" },
				"workerConstraint": {
					"oneOf": [{ "type": "null" }, { "$ref": "#/$defs/workerConstraint" }]
				},
				"cwd": {
					"oneOf": [{ "type": "null" }, { "$ref": "#/$defs/cwd" }]
				},
				"startMode": { "$ref": "#/$defs/startMode" }
			}
		},
		"terminalStart": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "terminalCreateRequestId", "geometry"],
			"properties": {
				"kind": { "const": "terminal.start" },
				"protocolVersion": { "const": 1 },
				"requestId": { "$ref": "#/$defs/requestId" },
				"terminalCreateRequestId": { "$ref": "#/$defs/requestId" },
				"geometry": { "$ref": "#/$defs/geometry" }
			},
			"$comment": "requestId and terminalCreateRequestId must be distinct decoded identities."
		},
		"createAcceptedState": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": { "kind": { "const": "awaiting-start" } }
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "geometry"],
					"properties": {
						"kind": { "const": "started" },
						"geometry": { "$ref": "#/$defs/geometry" }
					}
				}
			]
		},
		"createRejectedReason": {
			"enum": [
				"not-authorized",
				"worker-constraint-unsatisfied",
				"cwd-not-accepted",
				"request-id-conflict"
			]
		},
		"createUnavailableReason": {
			"enum": ["no-compatible-worker", "terminal-runtime-unavailable", "server-busy"]
		},
		"createOutcome": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "state"],
					"properties": {
						"kind": { "const": "accepted" },
						"state": { "$ref": "#/$defs/createAcceptedState" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": { "const": "rejected" },
						"reason": { "$ref": "#/$defs/createRejectedReason" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": { "const": "unavailable" },
						"reason": { "$ref": "#/$defs/createUnavailableReason" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": { "const": "failed" },
						"reason": { "const": "terminal-create-failed" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": { "kind": { "const": "outcome-unknown" } }
				}
			]
		},
		"terminalCreateResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"properties": {
				"kind": { "const": "terminal.create.result" },
				"protocolVersion": { "const": 1 },
				"requestId": { "$ref": "#/$defs/requestId" },
				"outcome": { "$ref": "#/$defs/createOutcome" }
			}
		},
		"startTransition": {
			"enum": ["started", "already-started"]
		},
		"startRejectedReason": {
			"enum": [
				"not-authorized",
				"terminal-create-unavailable",
				"terminal-not-awaiting-start",
				"geometry-conflict",
				"request-id-conflict"
			]
		},
		"startUnavailableReason": {
			"enum": ["terminal-runtime-unavailable", "server-busy"]
		},
		"startOutcome": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "geometry", "transition"],
					"properties": {
						"kind": { "const": "accepted" },
						"geometry": { "$ref": "#/$defs/geometry" },
						"transition": { "$ref": "#/$defs/startTransition" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": { "const": "rejected" },
						"reason": { "$ref": "#/$defs/startRejectedReason" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": { "const": "unavailable" },
						"reason": { "$ref": "#/$defs/startUnavailableReason" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": { "const": "failed" },
						"reason": { "const": "terminal-start-failed" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": { "kind": { "const": "outcome-unknown" } }
				}
			]
		},
		"terminalStartResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"properties": {
				"kind": { "const": "terminal.start.result" },
				"protocolVersion": { "const": 1 },
				"requestId": { "$ref": "#/$defs/requestId" },
				"outcome": { "$ref": "#/$defs/startOutcome" }
			}
		}
	}
}
