{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "urn:orchbee:schema:client-server:v2",
	"title": "Orchbee Client-Server terminal-control contract version 2",
	"$comment": "JSON numeric values refine through finite IEEE 754 binary64 safe integers before protocol and geometry bounds are applied; canonical encoding emits ordinary integer tokens.",
	"oneOf": [
		{
			"$ref": "#/$defs/terminalCreate"
		},
		{
			"$ref": "#/$defs/terminalCreateResult"
		},
		{
			"$ref": "#/$defs/terminalStart"
		},
		{
			"$ref": "#/$defs/terminalStartResult"
		},
		{
			"$ref": "#/$defs/terminalViewer"
		},
		{
			"$ref": "#/$defs/terminalViewerResult"
		},
		{
			"$ref": "#/$defs/terminalControl"
		},
		{
			"$ref": "#/$defs/terminalControlResult"
		},
		{
			"$ref": "#/$defs/terminalOpen"
		},
		{
			"$ref": "#/$defs/terminalOpenResult"
		},
		{
			"$ref": "#/$defs/terminalSendResult"
		},
		{
			"$ref": "#/$defs/terminalLaunchRead"
		},
		{
			"$ref": "#/$defs/terminalLaunchReadResult"
		}
	],
	"$defs": {
		"identity": {
			"type": "string",
			"minLength": 32,
			"maxLength": 32,
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"requestId": {
			"title": "ClientServerRequestId",
			"$ref": "#/$defs/identity"
		},
		"siteId": {
			"title": "SiteId",
			"$ref": "#/$defs/identity"
		},
		"workerId": {
			"title": "WorkerId",
			"$ref": "#/$defs/identity"
		},
		"terminalId": {
			"title": "TerminalId",
			"$ref": "#/$defs/identity"
		},
		"viewerId": {
			"title": "ViewerId",
			"$ref": "#/$defs/identity"
		},
		"controllerId": {
			"title": "ControllerId",
			"$ref": "#/$defs/identity"
		},
		"presentationId": {
			"title": "PresentationId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "PanelId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "TabId",
			"$ref": "#/$defs/identity"
		},
		"terminalContextId": {
			"title": "TerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"cwd": {
			"title": "Absolute local-platform working directory intent",
			"type": "string",
			"minLength": 1,
			"maxLength": 4096,
			"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$",
			"$comment": "The authoritative 4096 limit is UTF-8 encoded bytes; schema maxLength is an additional necessary code-point bound."
		},
		"geometry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["columns", "rows", "cellPixelWidth", "cellPixelHeight"],
			"properties": {
				"columns": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"rows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"cellPixelWidth": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				},
				"cellPixelHeight": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				}
			},
			"$comment": "The semantic contract additionally requires columns*rows <= 262144, columns*cellPixelWidth <= 65535, and rows*cellPixelHeight <= 65535. The cellPixelWidth/cellPixelHeight pair must be either both positive (pixels known) or both zero (pixels unknown); a mixed pair is invalid."
		},
		"workerConstraint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "workerId"],
			"properties": {
				"kind": {
					"const": "exact"
				},
				"workerId": {
					"$ref": "#/$defs/workerId"
				}
			}
		},
		"immediateStartMode": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "geometry"],
			"properties": {
				"kind": {
					"const": "immediate"
				},
				"geometry": {
					"$ref": "#/$defs/geometry"
				}
			}
		},
		"deferredStartMode": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "deferred"
				}
			}
		},
		"startMode": {
			"oneOf": [
				{
					"$ref": "#/$defs/immediateStartMode"
				},
				{
					"$ref": "#/$defs/deferredStartMode"
				}
			]
		},
		"terminalCreate": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "workerConstraint", "cwd", "startMode"],
			"properties": {
				"kind": {
					"const": "terminal.create"
				},
				"protocolVersion": {
					"const": 2
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"workerConstraint": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/workerConstraint"
						}
					]
				},
				"cwd": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/cwd"
						}
					]
				},
				"startMode": {
					"$ref": "#/$defs/startMode"
				},
				"launch": {
					"oneOf": [
						{
							"$ref": "#/$defs/launchSelection"
						},
						{
							"type": "null"
						}
					]
				},
				"environment": {
					"$ref": "#/$defs/launchEnvironment"
				},
				"pluginEnvironment": {
					"$ref": "#/$defs/pluginTerminalEnvironment"
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["pluginEnvironment"]
					},
					"then": {
						"required": ["launch"],
						"properties": {
							"launch": {
								"$ref": "#/$defs/launchSelection"
							}
						}
					}
				}
			]
		},
		"terminalStart": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "terminalCreateRequestId", "geometry"],
			"properties": {
				"kind": {
					"const": "terminal.start"
				},
				"protocolVersion": {
					"const": 2
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"terminalCreateRequestId": {
					"$ref": "#/$defs/requestId"
				},
				"geometry": {
					"$ref": "#/$defs/geometry"
				}
			},
			"$comment": "requestId and terminalCreateRequestId must be distinct decoded identities."
		},
		"createAcceptedState": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "awaiting-start"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "geometry"],
					"properties": {
						"kind": {
							"const": "started"
						},
						"geometry": {
							"$ref": "#/$defs/geometry"
						}
					}
				}
			]
		},
		"createRejectedReason": {
			"enum": ["not-authorized", "worker-constraint-unsatisfied", "cwd-not-accepted"]
		},
		"createUnavailableReason": {
			"enum": ["no-compatible-worker", "terminal-runtime-unavailable", "server-busy"]
		},
		"createOutcome": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "state"],
					"properties": {
						"kind": {
							"const": "accepted"
						},
						"state": {
							"$ref": "#/$defs/createAcceptedState"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/createRejectedReason"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"$ref": "#/$defs/createUnavailableReason"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"const": "terminal-create-failed"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "outcome-unknown"
						}
					}
				}
			]
		},
		"terminalCreateResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"properties": {
				"kind": {
					"const": "terminal.create.result"
				},
				"protocolVersion": {
					"const": 2
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"outcome": {
					"$ref": "#/$defs/createOutcome"
				}
			}
		},
		"startTransition": {
			"enum": ["started", "already-started"]
		},
		"startRejectedReason": {
			"enum": [
				"not-authorized",
				"terminal-create-unavailable",
				"terminal-not-awaiting-start",
				"geometry-conflict"
			]
		},
		"startUnavailableReason": {
			"enum": ["terminal-runtime-unavailable", "server-busy"]
		},
		"startOutcome": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "geometry", "transition"],
					"properties": {
						"kind": {
							"const": "accepted"
						},
						"geometry": {
							"$ref": "#/$defs/geometry"
						},
						"transition": {
							"$ref": "#/$defs/startTransition"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/startRejectedReason"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"$ref": "#/$defs/startUnavailableReason"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"const": "terminal-start-failed"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "outcome-unknown"
						}
					}
				}
			]
		},
		"terminalStartResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"properties": {
				"kind": {
					"const": "terminal.start.result"
				},
				"protocolVersion": {
					"const": 2
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"outcome": {
					"$ref": "#/$defs/startOutcome"
				}
			}
		},
		"projectionUnsigned": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]{0,19})$",
			"$comment": "Canonical decimal u64 text; semantic validation additionally rejects values above 18446744073709551615."
		},
		"projectionPositive": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$",
			"$comment": "Canonical positive u64 text; semantic validation additionally rejects values above 18446744073709551615."
		},
		"selectionViewportPoint": {
			"type": "object",
			"additionalProperties": false,
			"required": ["column", "row"],
			"properties": {
				"column": { "type": "integer", "minimum": 0, "maximum": 4095 },
				"row": { "type": "integer", "minimum": 0, "maximum": 4095 }
			}
		},
		"selectionGesturePosition": {
			"type": "object",
			"additionalProperties": false,
			"required": ["x", "y"],
			"properties": {
				"x": { "type": "integer", "minimum": -65535, "maximum": 65535 },
				"y": { "type": "integer", "minimum": -65535, "maximum": 65535 }
			}
		},
		"selectionGestureGeometry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cellWidth", "columns", "paddingLeft", "screenHeight"],
			"properties": {
				"cellWidth": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"columns": { "type": "integer", "minimum": 1, "maximum": 4096 },
				"paddingLeft": { "type": "integer", "minimum": 0, "maximum": 65535 },
				"screenHeight": { "type": "integer", "minimum": 1, "maximum": 65535 }
			}
		},
		"viewerAction": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "terminalCreateRequestId"],
					"properties": {
						"kind": {
							"const": "attach"
						},
						"terminalCreateRequestId": {
							"$ref": "#/$defs/requestId"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "siteId", "workerId", "terminalId"],
					"properties": {
						"kind": {
							"const": "attach-binding"
						},
						"siteId": {
							"$ref": "#/$defs/siteId"
						},
						"workerId": {
							"$ref": "#/$defs/workerId"
						},
						"terminalId": {
							"$ref": "#/$defs/terminalId"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId"],
					"properties": {
						"kind": {
							"const": "poll"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId", "sequence", "generation", "revision"],
					"properties": {
						"kind": {
							"const": "frame-applied"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"sequence": {
							"$ref": "#/$defs/projectionPositive"
						},
						"generation": {
							"$ref": "#/$defs/projectionPositive"
						},
						"revision": {
							"$ref": "#/$defs/projectionUnsigned"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId", "sequence", "reason"],
					"properties": {
						"kind": {
							"const": "need-snapshot"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"sequence": {
							"$ref": "#/$defs/projectionPositive"
						},
						"reason": {
							"enum": [
								"activity-stale",
								"base-mismatch",
								"decoder-rejected",
								"dimensions-mismatch",
								"generation-mismatch",
								"identity-mismatch",
								"sequence-gap",
								"store-reset"
							]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"attachmentId",
						"startRow",
						"rowCount",
						"revision",
						"generation",
						"requestSequence",
						"maximumBytes"
					],
					"properties": {
						"kind": {
							"const": "read-rows"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"startRow": {
							"$ref": "#/$defs/projectionUnsigned"
						},
						"rowCount": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"revision": {
							"$ref": "#/$defs/projectionUnsigned"
						},
						"generation": {
							"$ref": "#/$defs/projectionPositive"
						},
						"requestSequence": {
							"$ref": "#/$defs/projectionPositive"
						},
						"maximumBytes": {
							"type": "integer",
							"minimum": 112,
							"maximum": 8388608
						},
						"detail": {
							"enum": ["text", "render"]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId", "demand"],
					"properties": {
						"kind": {
							"const": "set-projection-demand"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"demand": {
							"enum": ["active", "paused"]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId", "demand"],
					"properties": {
						"kind": {
							"const": "set-history-demand"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"demand": {
							"enum": ["following-bottom", "viewing-history"]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"attachmentId",
						"origin",
						"rowCount",
						"revision",
						"generation",
						"requestSequence",
						"maximumBytes"
					],
					"properties": {
						"kind": {
							"const": "read-viewport-rows"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"origin": {
							"oneOf": [
								{
									"type": "object",
									"additionalProperties": false,
									"required": ["kind", "rowsBefore"],
									"properties": {
										"kind": {
											"const": "tail"
										},
										"rowsBefore": {
											"type": "integer",
											"minimum": 0,
											"maximum": 4294967295
										}
									}
								},
								{
									"type": "object",
									"additionalProperties": false,
									"required": ["kind", "delta"],
									"properties": {
										"kind": {
											"const": "committed"
										},
										"delta": {
											"type": "integer",
											"minimum": -2147483648,
											"maximum": 2147483647
										}
									}
								}
							]
						},
						"rowCount": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						"revision": {
							"$ref": "#/$defs/projectionUnsigned"
						},
						"generation": {
							"$ref": "#/$defs/projectionPositive"
						},
						"requestSequence": {
							"$ref": "#/$defs/projectionPositive"
						},
						"maximumBytes": {
							"type": "integer",
							"minimum": 112,
							"maximum": 8388608
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId", "requestSequence", "generation", "revision"],
					"properties": {
						"kind": {
							"const": "rows-applied"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"requestSequence": {
							"$ref": "#/$defs/projectionPositive"
						},
						"generation": {
							"$ref": "#/$defs/projectionPositive"
						},
						"revision": {
							"$ref": "#/$defs/projectionUnsigned"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "attachmentId", "sequence", "generation", "revision"],
					"properties": {
						"kind": {
							"const": "history-observed"
						},
						"attachmentId": {
							"$ref": "#/$defs/viewerId"
						},
						"sequence": {
							"$ref": "#/$defs/projectionPositive"
						},
						"generation": {
							"$ref": "#/$defs/projectionPositive"
						},
						"revision": {
							"$ref": "#/$defs/projectionUnsigned"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"attachmentId",
						"generation",
						"action",
						"clickCount",
						"point",
						"position",
						"selectOutput"
					],
					"properties": {
						"kind": { "const": "selection-gesture" },
						"attachmentId": { "$ref": "#/$defs/viewerId" },
						"generation": { "$ref": "#/$defs/projectionPositive" },
						"action": { "const": "start" },
						"clickCount": { "type": "integer", "minimum": 1, "maximum": 3 },
						"point": { "$ref": "#/$defs/selectionViewportPoint" },
						"position": { "$ref": "#/$defs/selectionGesturePosition" },
						"selectOutput": { "type": "boolean" }
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"attachmentId",
						"generation",
						"action",
						"geometry",
						"point",
						"position",
						"rectangle"
					],
					"properties": {
