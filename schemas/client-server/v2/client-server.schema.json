		"launchBoundTo": {
			"type": "object",
			"additionalProperties": false,
			"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/presentationId"
				},
				"panelId": {
					"$ref": "#/$defs/panelId"
				},
				"tabId": {
					"$ref": "#/$defs/tabId"
				},
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				}
			}
		},
		"launchRoute": {
			"type": "object",
			"additionalProperties": false,
			"required": ["terminalId", "workerId", "boundTo"],
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/terminalId"
				},
				"workerId": {
					"$ref": "#/$defs/workerId"
				},
				"boundTo": {
					"$ref": "#/$defs/launchBoundTo"
				}
			}
		},
		"launchState": {
			"enum": [
				"creating",
				"awaiting-start",
				"starting",
				"started",
				"unknown",
				"unavailable",
				"not-tracked"
			]
		},
		"launchFact": {
			"type": "object",
			"additionalProperties": false,
			"required": ["state", "workerGeneration", "createOutcome", "geometry"],
			"properties": {
				"state": {
					"$ref": "#/$defs/launchState"
				},
				"workerGeneration": {
					"oneOf": [
						{
							"$ref": "#/$defs/projectionPositive"
						},
						{
							"type": "null"
						}
					]
				},
				"createOutcome": {
					"oneOf": [
						{
							"$ref": "#/$defs/createOutcome"
						},
						{
							"type": "null"
						}
					]
				},
				"geometry": {
					"oneOf": [
						{
							"$ref": "#/$defs/geometry"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "not-tracked"
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"workerGeneration": {
								"type": "null"
							},
							"createOutcome": {
								"type": "null"
							},
							"geometry": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"const": "creating"
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"workerGeneration": {
								"$ref": "#/$defs/projectionPositive"
							},
							"createOutcome": {
								"type": "null"
							},
							"geometry": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"const": "started"
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"workerGeneration": {
								"$ref": "#/$defs/projectionPositive"
							},
							"createOutcome": {
								"$ref": "#/$defs/createOutcome"
							},
							"geometry": {
								"$ref": "#/$defs/geometry"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"enum": ["awaiting-start", "starting", "unknown", "unavailable"]
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"workerGeneration": {
								"$ref": "#/$defs/projectionPositive"
							},
							"createOutcome": {
								"$ref": "#/$defs/createOutcome"
							},
							"geometry": {
								"type": "null"
							}
						}
					}
				}
			],
			"$comment": "workerGeneration is non-null exactly for tracked states, geometry exactly for started, and createOutcome for every tracked state except creating."
		},
		"launchReadUnavailableReason": {
			"enum": ["server-busy"]
		},
		"launchReadOutcome": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "siteId", "workbenchRevision", "terminal", "launch"],
					"properties": {
						"kind": {
							"const": "found"
						},
						"siteId": {
							"$ref": "#/$defs/siteId"
						},
						"workbenchRevision": {
							"$ref": "#/$defs/projectionUnsigned"
						},
						"terminal": {
							"$ref": "#/$defs/launchRoute"
						},
						"launch": {
							"$ref": "#/$defs/launchFact"
						},
						"launchProfile": {
							"oneOf": [
								{
									"$ref": "#/$defs/launchProfile"
								},
								{
									"type": "null"
								}
							]
						},
						"launchSelection": {
							"$ref": "#/$defs/launchSelection"
						}
					},
					"allOf": [
						{
							"if": {
								"required": ["launch"],
								"properties": {
									"launch": {
										"type": "object",
										"required": ["state"],
										"properties": {
											"state": {
												"const": "not-tracked"
											}
										}
									}
								}
							},
							"then": {
								"properties": {
									"launchSelection": false
								}
							}
						}
					]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"const": "not-found"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"$ref": "#/$defs/launchReadUnavailableReason"
						}
					}
				}
			]
		},
		"terminalLaunchReadResult": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "outcome"],
			"properties": {
				"kind": {
					"const": "terminal.launch.read.result"
				},
				"protocolVersion": {
					"const": 2
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"outcome": {
					"$ref": "#/$defs/launchReadOutcome"
				}
			}
		},
		"launchSelection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["exec", "args"],
			"properties": {
				"exec": {
					"title": "Absolute local-platform working directory intent",
					"type": "string",
					"minLength": 1,
					"maxLength": 30720,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$",
					"$comment": "The combined executable/arguments bound is 30720 UTF-8 bytes and 30720 worst-case escaped JSON string-content bytes; code-point limits are necessary but not sufficient."
				},
				"args": {
					"type": "array",
					"maxItems": 128,
					"items": {
						"type": "string",
						"pattern": "^[^\\u0000]*$",
						"maxLength": 30720
					}
				}
			},
			"$comment": "Executable and arguments together are at most 30720 UTF-8 bytes and worst-case JSON string-content bytes, enforced by the binding."
		},
		"launchEnvironment": {
			"type": "array",
			"maxItems": 32,
			"items": {
				"type": "array",
				"minItems": 2,
				"maxItems": 2,
				"prefixItems": [
					{
						"type": "string",
						"minLength": 1,
						"maxLength": 128,
						"pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
						"not": {
							"pattern": "^(?:[Oo][Rr][Cc][Hh][Bb][Ee][Ee]_|[Tt][Ee][Rr][Mm]$|[Cc][Oo][Ll][Oo][Rr][Tt][Ee][Rr][Mm]$|[Tt][Ee][Rr][Mm]_[Pp][Rr][Oo][Gg][Rr][Aa][Mm]$)"
						}
					},
					{
						"type": "string",
						"pattern": "^[^\\u0000]*$",
						"maxLength": 1023
					}
				],
				"items": false
			},
			"$comment": "Names are unique ignoring ASCII case; combined UTF-8 name/value bytes <=1024. Binding refinements enforce both."
		},
		"launchProfile": {
			"type": "object",
			"additionalProperties": false,
			"required": ["profileId", "catalogRevision"],
			"properties": {
				"profileId": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"catalogRevision": {
					"$ref": "#/$defs/projectionUnsigned"
				}
			}
		},
		"sendProgress": {
			"type": "object",
			"additionalProperties": false,
			"required": ["recordsAccepted", "firstStoppedRecord", "acceptedEncodedBytes"],
			"properties": {
				"recordsAccepted": {
					"type": "integer",
					"minimum": 0,
					"maximum": 64
				},
				"firstStoppedRecord": {
					"type": "integer",
					"minimum": 0,
					"maximum": 64
				},
				"acceptedEncodedBytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 67108864
				}
			},
			"$comment": "recordsAccepted <= firstStoppedRecord. Accepted outcome requires nonzero equal count/index; nonzero count requires cleanup other than not-needed. Binding checks cross-field relations."
		},
		"pluginTerminalEnvironment": {
			"type": "array",
			"minItems": 7,
			"maxItems": 10,
			"items": {
				"type": "array",
				"minItems": 2,
				"maxItems": 2,
				"prefixItems": [
					{
						"enum": [
							"ORCHBEE_PLUGIN_ID",
							"ORCHBEE_PLUGIN_ROOT",
							"ORCHBEE_PLUGIN_ENTRYPOINT_ID",
							"ORCHBEE_PLUGIN_CONFIG_DIR",
							"ORCHBEE_PLUGIN_STATE_DIR",
							"ORCHBEE_PLUGIN_CONTEXT_JSON",
							"ORCHBEE_BIN_PATH",
							"ORCHBEE_WORKSPACE_ID",
							"ORCHBEE_TAB_ID",
							"ORCHBEE_PANE_ID"
						]
					},
					{
						"type": "string",
						"minLength": 1,
						"maxLength": 24576,
						"not": {
							"pattern": "\u0000"
						}
					}
				]
			},
			"allOf": [
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PLUGIN_ID"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PLUGIN_ROOT"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PLUGIN_ENTRYPOINT_ID"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PLUGIN_CONFIG_DIR"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PLUGIN_STATE_DIR"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PLUGIN_CONTEXT_JSON"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_BIN_PATH"
							}
						]
					},
					"minContains": 1,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_WORKSPACE_ID"
							}
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_TAB_ID"
							}
						]
					},
					"minContains": 0,
					"maxContains": 1
				},
				{
					"contains": {
						"type": "array",
						"prefixItems": [
							{
								"const": "ORCHBEE_PANE_ID"
							}
						]
					},
					"minContains": 0,
					"maxContains": 1
				}
			]
		}
	}
}
