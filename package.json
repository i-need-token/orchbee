{
	"name": "orchbee",
	"private": true,
	"type": "module",
	"scripts": {
		"lint": "oxlint .",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"test": "pnpm test:lint-rules && pnpm -r test",
		"test:lint-rules": "vitest run --config scripts/oxlint-plugin-orchbee/vitest.config.ts",
		"audit:ghostty-panel": "node scripts/check-ghostty-panel-manifest.mjs && node scripts/generate-ghostty-nerd-font-constraints.mjs --check",
		"generate:ghostty-panel-data": "node scripts/generate-ghostty-nerd-font-constraints.mjs"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"engines": {
		"node": ">=22"
	}
}
