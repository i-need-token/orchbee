{
	"name": "orchbee",
	"private": true,
	"type": "module",
	"scripts": {
		"desktop": "pnpm --filter @orchbee/web... build && pnpm --parallel --filter @orchbee/web --filter @orchbee/desktop dev",
		"desktop:build": "pnpm --filter @orchbee/web... build && pnpm --filter @orchbee/desktop... build",
		"desktop:package:dev": "pnpm --filter @orchbee/desktop package:dev",
		"desktop:package:local": "pnpm --filter @orchbee/desktop package:local",
		"desktop:package:release": "pnpm --filter @orchbee/desktop package:release",
		"web": "pnpm --filter @orchbee/web dev",
		"web:build": "pnpm --filter @orchbee/web... build",
		"storybook": "pnpm --filter @orchbee/storybook dev",
		"storybook:build": "pnpm --filter \"./packages/*\" build && pnpm --filter @orchbee/storybook build",
		"verify": "node scripts/run-checks.mjs verify",
		"verify:changed": "node scripts/run-checks.mjs verify --changed-since",
		"lint": "pnpm lint:code && pnpm lint:rust && pnpm lint:documentation && pnpm lint:styles && pnpm lint:storage && pnpm lint:dependencies && pnpm lint:projects && pnpm lint:experience",
		"lint:code": "oxlint . --quiet --format=agent",
		"lint:code:warnings": "oxlint . --format=agent",
		"lint:rust": "node scripts/run-rust-workspace.mjs lint",
		"lint:documentation": "node scripts/documentation-pairing.mjs check",
		"lint:styles": "node scripts/check-style-contract.mjs",
		"lint:storage": "node scripts/storage-contract.mjs",
		"lint:dependencies": "knip --strict",
		"lint:projects": "node scripts/check-project-contracts.mjs",
		"lint:experience": "node scripts/experience-catalog.mjs check",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write . && pnpm -r --if-present format && node scripts/run-rust-workspace.mjs format",
		"format:check": "oxfmt --check . && pnpm -r --if-present format:check && node scripts/run-rust-workspace.mjs format:check",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm --filter \"./packages/*\" build && pnpm --filter \"./apps/*\" build && node scripts/run-rust-workspace.mjs build",
		"test": "node scripts/run-checks.mjs test",
		"test:check-output": "node scripts/run-checks.mjs test:check-output",
		"test:rust-runner": "node --test scripts/run-rust-workspace.test.mjs",
		"test:lint-rules": "vitest run --config scripts/oxlint-plugin-orchbee/vitest.config.ts",
		"test:documentation-pairing": "node scripts/run-checks.mjs test:documentation-pairing",
		"test:ghostty-source": "node scripts/run-checks.mjs test:ghostty-source",
		"test:style-contract": "vitest run --config scripts/style-contract/vitest.config.ts",
		"test:storage-contract": "vitest run --config scripts/storage-contract/vitest.config.ts",
		"test:experience-contract": "vitest run --config scripts/experience-catalog/vitest.config.ts",
		"test:stage-native-site": "node scripts/run-checks.mjs test:stage-native-site",
		"test:tla": "node scripts/tla/run-models.mjs --all",
		"test:tla:changed": "node scripts/tla/run-models.mjs --cache-dir .tools/tla-cache --changed-since",
		"test:tla:inventory": "node scripts/run-checks.mjs test:tla:inventory",
		"test:tla:tooling": "node scripts/tla/run-models.mjs --models tla-verification-execution && node --test scripts/tla/model-cache-cli.test.mjs",
		"test:exports": "pnpm -r --if-present test:exports",
		"experience:list": "node scripts/experience-catalog.mjs list",
		"experience:find": "node scripts/experience-catalog.mjs find",
		"experience:show": "node scripts/experience-catalog.mjs show",
		"docs:confirm-pairing": "node scripts/documentation-pairing.mjs confirm",
		"generate:design-token-inventory": "node scripts/generate-design-token-inventory.mjs",
		"generate:tailwind-token-compat": "node scripts/generate-tailwind-token-compat.mjs",
		"audit:ghostty-panel": "node scripts/check-ghostty-panel-manifest.mjs && node scripts/generate-ghostty-nerd-font-constraints.mjs --check && node scripts/generate-ghostty-sprite-raster.mjs --check",
		"generate:ghostty-panel-data": "node scripts/generate-ghostty-nerd-font-constraints.mjs && node scripts/generate-ghostty-sprite-raster.mjs"
	},
	"devDependencies": {
		"knip": "catalog:",
		"oxc-parser": "catalog:",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"postcss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.11.0"
}
