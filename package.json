{
	"name": "orchbee",
	"private": true,
	"type": "module",
	"scripts": {
		"verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:exports",
		"lint": "pnpm lint:code && pnpm lint:dependencies && pnpm lint:projects",
		"lint:code": "oxlint .",
		"lint:dependencies": "knip --strict",
		"lint:projects": "node scripts/check-project-contracts.mjs",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"test": "pnpm test:lint-rules && pnpm -r test",
		"test:lint-rules": "vitest run --config scripts/oxlint-plugin-orchbee/vitest.config.ts",
		"test:exports": "pnpm -r --if-present test:exports",
		"build:ghostty-wasm": "node scripts/build-ghostty-wasm.mjs",
		"audit:ghostty-panel": "node scripts/check-ghostty-panel-manifest.mjs && node scripts/generate-ghostty-nerd-font-constraints.mjs --check",
		"generate:ghostty-panel-data": "node scripts/generate-ghostty-nerd-font-constraints.mjs"
	},
	"devDependencies": {
		"knip": "catalog:",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.11.0"
}
