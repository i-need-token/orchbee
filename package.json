{
	"name": "orchbee",
	"private": true,
	"type": "module",
	"scripts": {
		"web": "pnpm --filter @orchbee/web dev",
		"web:build": "pnpm --filter @orchbee/web... build",
		"storybook": "pnpm --filter @orchbee/storybook dev",
		"storybook:build": "pnpm --filter @orchbee/storybook... build",
		"verify": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm test:exports",
		"lint": "pnpm lint:code && pnpm lint:styles && pnpm lint:storage && pnpm lint:dependencies && pnpm lint:projects",
		"lint:code": "oxlint .",
		"lint:styles": "node scripts/check-style-contract.mjs",
		"lint:storage": "node scripts/storage-contract.mjs",
		"lint:dependencies": "knip --strict",
		"lint:projects": "node scripts/check-project-contracts.mjs",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write .",
		"format:check": "oxfmt --check .",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"test": "pnpm test:lint-rules && pnpm test:style-contract && pnpm test:storage-contract && pnpm -r test",
		"test:lint-rules": "vitest run --config scripts/oxlint-plugin-orchbee/vitest.config.ts",
		"test:style-contract": "vitest run --config scripts/style-contract/vitest.config.ts",
		"test:storage-contract": "vitest run --config scripts/storage-contract/vitest.config.ts",
		"test:exports": "pnpm -r --if-present test:exports",
		"generate:design-token-inventory": "node scripts/generate-design-token-inventory.mjs",
		"generate:tailwind-token-compat": "node scripts/generate-tailwind-token-compat.mjs",
		"build:ghostty-wasm": "node scripts/build-ghostty-wasm.mjs",
		"audit:ghostty-panel": "node scripts/check-ghostty-panel-manifest.mjs && node scripts/generate-ghostty-nerd-font-constraints.mjs --check",
		"generate:ghostty-panel-data": "node scripts/generate-ghostty-nerd-font-constraints.mjs"
	},
	"devDependencies": {
		"knip": "catalog:",
		"oxc-parser": "catalog:",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"postcss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.11.0"
}
