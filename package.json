{
	"name": "orchbee",
	"private": true,
	"type": "module",
	"scripts": {
		"desktop": "pnpm --filter @orchbee/server... build && pnpm --filter @orchbee/gateway... build && pnpm --filter @orchbee/web... build && pnpm --filter @orchbee/cli... build && pnpm --parallel --filter @orchbee/web --filter @orchbee/desktop dev",
		"desktop:build": "pnpm --filter @orchbee/server... build && pnpm --filter @orchbee/gateway... build && pnpm --filter @orchbee/web... build && pnpm --filter @orchbee/cli... build && pnpm --filter @orchbee/desktop... build",
		"desktop:package:dev": "pnpm --filter @orchbee/desktop package:dev",
		"desktop:package:local": "pnpm --filter @orchbee/desktop package:local",
		"desktop:package:release": "pnpm --filter @orchbee/desktop package:release",
		"release:ssh-environment:prepare": "pnpm --filter @orchbee/ssh-environment-protocol build && node scripts/prepare-ssh-environment-release.mjs",
		"release:ssh-environment:finalize": "pnpm --filter @orchbee/ssh-environment-protocol build && node scripts/finalize-ssh-environment-release.mjs",
		"web": "pnpm --filter @orchbee/web dev",
		"web:build": "pnpm --filter @orchbee/web... build",
		"storybook": "pnpm --filter @orchbee/storybook dev",
		"storybook:build": "pnpm --filter @orchbee/storybook... build",
		"verify": "pnpm format:check && pnpm lint && pnpm test:tla:inventory && pnpm build && pnpm typecheck && pnpm test && pnpm test:exports",
		"lint": "pnpm lint:code && pnpm lint:documentation && pnpm lint:styles && pnpm lint:storage && pnpm lint:dependencies && pnpm lint:projects && pnpm lint:experience",
		"lint:code": "oxlint . --quiet --format=agent",
		"lint:code:warnings": "oxlint . --format=agent",
		"lint:documentation": "node scripts/documentation-pairing.mjs check",
		"lint:styles": "node scripts/check-style-contract.mjs",
		"lint:storage": "node scripts/storage-contract.mjs",
		"lint:dependencies": "knip --strict",
		"lint:projects": "node scripts/check-project-contracts.mjs",
		"lint:experience": "node scripts/experience-catalog.mjs check",
		"lint:fix": "oxlint --fix .",
		"format": "oxfmt --write . && pnpm -r --if-present format",
		"format:check": "oxfmt --check . && pnpm -r --if-present format:check",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"test": "pnpm test:lint-rules && pnpm test:documentation-pairing && pnpm test:style-contract && pnpm test:storage-contract && pnpm test:experience-contract && pnpm test:ssh-environment-release && pnpm -r test && pnpm -r --if-present test:cross",
		"test:lint-rules": "vitest run --config scripts/oxlint-plugin-orchbee/vitest.config.ts",
		"test:documentation-pairing": "node --test scripts/documentation-pairing.test.mjs",
		"test:style-contract": "vitest run --config scripts/style-contract/vitest.config.ts",
		"test:storage-contract": "vitest run --config scripts/storage-contract/vitest.config.ts",
		"test:experience-contract": "vitest run --config scripts/experience-catalog/vitest.config.ts",
		"test:ssh-environment-release": "pnpm --filter @orchbee/ssh-environment-protocol build && node --test scripts/ssh-environment-release.test.mjs",
		"test:tla": "node scripts/tla/run-models.mjs --all",
		"test:tla:changed": "node scripts/tla/run-models.mjs --changed-since",
		"test:tla:inventory": "node --test scripts/tla/model-inventory.test.mjs && node scripts/tla/check-inventory.mjs",
		"test:exports": "pnpm -r --if-present test:exports",
		"experience:list": "node scripts/experience-catalog.mjs list",
		"experience:find": "node scripts/experience-catalog.mjs find",
		"experience:show": "node scripts/experience-catalog.mjs show",
		"docs:confirm-pairing": "node scripts/documentation-pairing.mjs confirm",
		"generate:design-token-inventory": "node scripts/generate-design-token-inventory.mjs",
		"generate:tailwind-token-compat": "node scripts/generate-tailwind-token-compat.mjs",
		"audit:ghostty-panel": "node scripts/check-ghostty-panel-manifest.mjs && node scripts/generate-ghostty-nerd-font-constraints.mjs --check && node scripts/generate-ghostty-sprite-raster.mjs --check",
		"generate:ghostty-panel-data": "node scripts/generate-ghostty-nerd-font-constraints.mjs && node scripts/generate-ghostty-sprite-raster.mjs"
	},
	"devDependencies": {
		"@orchbee/ssh-environment-protocol": "workspace:^",
		"knip": "catalog:",
		"oxc-parser": "catalog:",
		"oxfmt": "^0.58.0",
		"oxlint": "^1.73.0",
		"postcss": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"zod": "catalog:"
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "pnpm@11.11.0"
}
