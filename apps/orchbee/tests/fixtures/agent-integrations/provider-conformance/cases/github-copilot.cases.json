					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.marketplace.current"}}
				]
			},
			"expect": {
				"snapshot": {"state": "conflict", "issue": null, "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:141-144"]
		},
