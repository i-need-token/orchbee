				"capsule": "ready",
				"commands": [
					{"argv": ["plugins", "list", "--kind", "plugin", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.plugins.enabled"}},
					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "failed"}}
				]
			},
			"expect": {
				"snapshot": {"state": "unknown", "issue": "inspection-failed", "availability": "available", "managementMode": "managed-local"},
				"commands": [["plugins", "list", "--kind", "plugin", "--json"], ["plugins", "marketplace", "list", "--json"]]
			},
			"anchors": ["create-adapters:456-468", "cli-adapter:70-83"]
		},
		{
			"id": "github-copilot.inspect.bare-array-plugins-rejected",
			"operation": "inspect",
			"class": "shared",
			"covers": ["unreadable"],
			"dims": {"parse": "array-not-record"},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/copilot",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugins", "list", "--kind", "plugin", "--json"], "result": {"kind": "completed", "stdout": "[]"}},
					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.marketplace.current"}}
				]
			},
			"expect": {
				"snapshot": {"state": "unknown", "issue": "inspection-failed", "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:113-116,196-203"],
			"notes": "Copilot plugins read MUST be an object with .plugins[]; a bare array is rejected (contrast claude which requires the bare array)."
		},
