{
	"provider": "github-copilot",
	"executableName": "copilot",
	"readSlots": 2,
	"dimensions": "{marketplace ∈ absent|current|legacy|foreign} × pluginPresent × enabled × ownership(installedFrom); plugins read is an OBJECT with .plugins[] (matched on name==='${PLUGIN_NAME}', source==='live-marketplace:orchbee-local', installedFrom→root classification); marketplace entries matched on name==='${MARKETPLACE}' with source prefix 'Local: '",
	"cases": [
		{
			"id": "github-copilot.inspect.enabled-current",
			"operation": "inspect",
			"class": "shared",
			"covers": ["current", "two-read-slots"],
			"dims": {"marketplace": "current", "pluginPresent": true, "enabled": true, "installedFromOwnership": "current"},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/copilot",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugins", "list", "--kind", "plugin", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.plugins.enabled"}},
					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.marketplace.current"}}
				]
			},
			"expect": {
				"snapshot": {"state": "enabled", "issue": null, "availability": "available", "managementMode": "managed-local"},
				"commands": [["plugins", "list", "--kind", "plugin", "--json"], ["plugins", "marketplace", "list", "--json"]]
			},
			"anchors": ["state-parsers:108-151", "create-adapters:445-468"]
		},
		{
			"id": "github-copilot.inspect.disabled-current",
			"operation": "inspect",
			"class": "shared",
			"covers": ["disabled"],
			"dims": {"marketplace": "current", "pluginPresent": true, "enabled": false},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/copilot",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugins", "list", "--kind", "plugin", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.plugins.disabled"}},
					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.marketplace.current"}}
				]
			},
			"expect": {
				"snapshot": {"state": "disabled", "issue": null, "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:148-150"]
		},
		{
			"id": "github-copilot.inspect.not-installed",
			"operation": "inspect",
			"class": "shared",
			"covers": ["not-installed"],
			"dims": {"marketplace": "absent", "pluginPresent": false},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/copilot",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugins", "list", "--kind", "plugin", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.plugins.empty"}},
					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.marketplace.absent"}}
				]
			},
			"expect": {
				"snapshot": {"state": "not-installed", "issue": null, "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:129-135"]
		},
		{
			"id": "github-copilot.inspect.not-installed-legacy-marketplace",
			"operation": "inspect",
			"class": "shared",
			"covers": ["update-required", "partial-shape"],
			"dims": {"marketplace": "legacy", "pluginPresent": false},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/copilot",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugins", "list", "--kind", "plugin", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.plugins.empty"}},
					{"argv": ["plugins", "marketplace", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@copilot.marketplace.legacy"}}
				]
			},
			"expect": {
				"snapshot": {"state": "update-required", "issue": null, "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:129-134"],
			"notes": "Copilot-specific: plugin absent + LEGACY marketplace → update-required (stale marketplace cleanup is still owed); marketplace absent → not-installed."
		},
		{
			"id": "github-copilot.inspect.unreadable-first-read",
			"operation": "inspect",
			"class": "shared",
			"covers": ["unreadable", "two-read-slots"],
			"dims": {"firstRead": "failed"},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/copilot",
				"capsule": "ready",
