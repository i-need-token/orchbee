{
	"provider": "grok",
	"executableName": "grok",
	"readSlots": 1,
	"dimensions": "pluginPresent × source basename==='bundle' × ownership(dirname(source)) ∈ {current,legacy,foreign} × versionMatch × enabled-or-status; plugin matched on name==='${PLUGIN_NAME}'; enabled boolean wins over status; status ∈ {disabled→disabled, enabled|installed→enabled}; anything else → inspection-failed",
	"cases": [
		{
			"id": "grok.inspect.enabled-current",
			"operation": "inspect",
			"class": "shared",
			"covers": ["current"],
			"dims": {"pluginPresent": true, "ownership": "current", "versionMatch": true, "enabled": true},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/grok",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugin", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@grok.plugins.enabled"}}
				]
			},
			"expect": {
				"snapshot": {"state": "enabled", "issue": null, "availability": "available", "managementMode": "managed-local"},
				"commands": [["plugin", "list", "--json"]]
			},
			"anchors": ["state-parsers:75-106", "create-adapters:426-437"]
		},
		{
			"id": "grok.inspect.disabled-boolean",
			"operation": "inspect",
			"class": "shared",
			"covers": ["disabled", "disabled-path"],
			"dims": {"pluginPresent": true, "ownership": "current", "enabled": false},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/grok",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugin", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@grok.plugins.disabledBoolean"}}
				]
			},
			"expect": {
				"snapshot": {"state": "disabled", "issue": null, "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:96-99"]
		},
		{
			"id": "grok.inspect.disabled-status",
			"operation": "inspect",
			"class": "shared",
			"covers": ["disabled", "disabled-path"],
			"dims": {"pluginPresent": true, "ownership": "current", "status": "disabled"},
			"given": {
				"managementMode": "managed-local",
				"exe": "/usr/bin/grok",
				"capsule": "ready",
				"commands": [
					{"argv": ["plugin", "list", "--json"], "result": {"kind": "completed", "stdoutJson": "@grok.plugins.disabledStatus"}}
				]
			},
			"expect": {
				"snapshot": {"state": "disabled", "issue": null, "availability": "available", "managementMode": "managed-local"}
			},
			"anchors": ["state-parsers:100-101"],
			"notes": "Grok's disabled state has TWO wire shapes (enabled:false OR status:'disabled'); both must classify disabled — the enable path is a real 'plugin enable', not a no-op."
		},
		{
			"id": "grok.inspect.installed-status-enabled",
			"operation": "inspect",
			"class": "shared",
			"covers": ["current"],
