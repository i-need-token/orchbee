{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.update",
	"title": "Windows native release update result",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "operation", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.update"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "local-installation"
				}
			}
		},
		"operation": {
			"enum": ["update", "channel-set"]
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"channel",
				"phase",
				"channelSaved",
				"configPath",
				"releasePath",
				"reused",
				"activated",
				"releaseVersion",
				"buildId",
				"cleanupPending",
				"error",
				"interrupted",
				"configurationFailure"
			],
			"properties": {
				"channel": {
					"enum": ["stable", "preview", null]
				},
				"phase": {
					"enum": [
						"configuration",
						"source",
						"manifest",
						"download",
						"verify",
						"publish",
						"activate",
						"complete"
					]
				},
				"channelSaved": {
					"type": "boolean"
				},
				"configPath": {
					"type": ["string", "null"]
				},
				"releasePath": {
					"type": ["string", "null"]
				},
				"reused": {
					"type": "boolean"
				},
				"activated": {
					"type": "boolean"
				},
				"releaseVersion": {
					"type": ["string", "null"]
				},
				"buildId": {
					"type": ["string", "null"]
				},
				"cleanupPending": {
					"type": ["string", "null"]
				},
				"error": {
					"enum": [
						null,
						"non-release-build",
						"configuration",
						"source-unconfigured",
						"source-invalid",
						"signing-keys-unavailable",
						"signature-untrusted",
						"signature-invalid",
						"manifest-invalid",
						"download",
						"checksum",
						"storage",
						"install-location",
						"busy",
						"cohort-invalid",
						"smoke-failed",
						"activation",
						"activation-unknown",
						"cancelled",
						"timeout",
						"physical-unknown",
						"internal",
						"download-unavailable"
					]
				},
				"interrupted": {
					"type": "boolean"
				},
				"configurationFailure": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/configurationFailure"
						}
					]
				}
			},
			"if": {
				"properties": {
					"activated": {
						"const": true
					}
				}
			},
			"then": {
				"properties": {
					"releasePath": {
						"type": "string",
						"minLength": 1
					},
					"phase": {
						"const": "complete"
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"channelSaved": {
								"const": true
							}
						}
					},
					"then": {
						"properties": {
							"configPath": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"error": {
								"const": "configuration"
							}
						},
						"required": ["error"]
					},
					"then": {
						"properties": {
							"configurationFailure": {
								"type": "object"
							}
						}
					},
					"else": {
						"properties": {
							"configurationFailure": {
								"type": "null"
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"configurationFailure": {
			"type": "object",
			"required": ["field", "reason"],
			"additionalProperties": false,
			"properties": {
				"field": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256,
					"pattern": "^(?:[A-Z][A-Z0-9_]*|[a-z][a-z0-9_]*(?:[.\\[][^\\u0000-\\u001f\\u007f-\\u009f]*)?)$"
				},
				"reason": {
					"enum": [
						"invalid-path",
						"missing",
						"io-error",
						"not-file",
						"too-large",
						"invalid-utf8",
						"invalid-toml",
						"unknown-key",
						"wrong-type",
						"invalid-value",
						"invalid-mode",
						"value-too-long",
						"invalid-channel",
						"unknown-profile",
						"unclosed-brace",
						"unknown-token",
						"unmatched-brace",
						"invalid-binding",
						"reserved-binding",
						"unsafe-binding",
						"duplicate-binding",
						"too-many-bindings",
						"invalid-layout",
						"invalid-color",
						"invalid-token",
						"invalid-rules",
						"invalid-agent",
						"invalid-delay",
						"too-many-agents",
						"source-query-failed",
						"source-query-interrupted",
						"read-only",
						"file-in-use",
						"locked",
						"changed"
					]
				},
				"line": {
					"type": "integer",
					"minimum": 1
				},
				"column": {
					"type": "integer",
					"minimum": 1
				}
			},
			"if": {
				"properties": {
					"reason": {
						"enum": ["invalid-toml", "invalid-utf8"]
					}
				},
				"required": ["reason"]
			},
			"then": {
				"required": ["line", "column"]
			},
			"else": {
				"not": {
					"anyOf": [
						{
							"required": ["line"]
						},
						{
							"required": ["column"]
						}
					]
				}
			}
		}
	}
}
