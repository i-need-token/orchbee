{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.link-activate",
	"title": "orchbee.terminal.link-activate",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.link-activate"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"terminal",
				"contentRevision",
				"contentGeneration",
				"hostEpoch",
				"origin",
				"offsetFromBottom",
				"viewportStartRow",
				"kind",
				"url",
				"regions",
				"handled",
				"activation"
			],
			"properties": {
				"terminal": {
					"$ref": "#/$defs/terminal"
				},
				"contentRevision": {
					"$ref": "#/$defs/decimal"
				},
				"contentGeneration": {
					"$ref": "#/$defs/positiveDecimal"
				},
				"hostEpoch": {
					"$ref": "#/$defs/id"
				},
				"origin": {
					"$ref": "#/$defs/point"
				},
				"offsetFromBottom": {
					"$ref": "#/$defs/decimal"
				},
				"viewportStartRow": {
					"$ref": "#/$defs/decimal"
				},
				"kind": {
					"enum": ["none", "plain-text", "explicit"]
				},
				"url": {
					"type": ["string", "null"],
					"maxLength": 8388608
				},
				"regions": {
					"type": "array",
					"maxItems": 8192,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["row", "startCol", "endCol"],
						"properties": {
							"row": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"startCol": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"endCol": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				},
				"handled": {
					"type": "boolean"
				},
				"activation": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state"],
							"properties": {
								"state": {
									"const": "no-link"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state"],
							"properties": {
								"state": {
									"const": "no-handler"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": [
								"state",
								"operationId",
								"pluginId",
								"handlerId",
								"actionId",
								"worker",
								"jobId",
								"existing"
							],
							"properties": {
								"state": {
									"const": "started"
								},
								"operationId": {
									"$ref": "#/$defs/id"
								},
								"pluginId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9._:-]+$"
								},
								"handlerId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9_:-]+$"
								},
								"actionId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9_:-]+$"
								},
								"worker": {
									"type": "object",
									"additionalProperties": false,
									"required": ["workerId", "generation"],
									"properties": {
										"workerId": {
											"$ref": "#/$defs/id"
										},
										"generation": {
											"$ref": "#/$defs/positiveDecimal"
										}
									}
								},
								"jobId": {
									"$ref": "#/$defs/id"
								},
								"existing": {
									"type": "boolean"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state", "operationId", "pluginId", "handlerId", "actionId", "reason"],
							"properties": {
								"state": {
									"const": "failed"
								},
								"operationId": {
									"$ref": "#/$defs/id"
								},
								"pluginId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9._:-]+$"
								},
								"handlerId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9_:-]+$"
								},
								"actionId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9_:-]+$"
								},
								"reason": {
									"enum": [
										"session-mismatch",
										"denied",
										"unavailable",
										"worker-changed",
										"invalid-intent",
										"not-found",
										"ambiguous",
										"disabled",
										"source-unavailable",
										"unsupported",
										"busy",
										"conflict",
										"physical-unknown"
									]
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state", "operationId", "pluginId", "handlerId", "actionId", "worker"],
							"properties": {
								"state": {
									"const": "unknown"
								},
								"operationId": {
									"$ref": "#/$defs/id"
								},
								"pluginId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9._:-]+$"
								},
								"handlerId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9_:-]+$"
								},
								"actionId": {
									"type": "string",
									"minLength": 1,
									"maxLength": 120,
									"pattern": "^[a-zA-Z0-9_:-]+$"
								},
								"worker": {
									"oneOf": [
										{
											"type": "object",
											"additionalProperties": false,
											"required": ["workerId", "generation"],
											"properties": {
												"workerId": {
													"$ref": "#/$defs/id"
												},
												"generation": {
													"$ref": "#/$defs/positiveDecimal"
												}
											}
										},
										{
											"type": "null"
										}
									]
								}
							}
						}
					]
				}
			},
			"if": {
				"properties": {
					"kind": {
						"const": "none"
					}
				}
			},
			"then": {
				"properties": {
					"url": {
						"type": "null"
					},
					"regions": {
						"maxItems": 0
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"kind": {
								"const": "explicit"
							}
						}
					},
					"then": {
						"properties": {
							"url": {
								"type": "string"
							},
							"regions": {
								"maxItems": 0
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"kind": {
								"const": "plain-text"
							}
						}
					},
					"then": {
						"properties": {
							"url": {
								"type": "string",
								"pattern": "^https?://"
							},
							"regions": {
								"minItems": 1
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"activation": {
								"properties": {
									"state": {
										"const": "started"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"handled": {
								"const": true
							}
						}
					},
					"else": {
						"properties": {
							"handled": {
								"const": false
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"activation": {
								"properties": {
									"state": {
										"const": "no-link"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"kind": {
								"const": "none"
							}
						}
					},
					"else": {
						"properties": {
							"url": {
								"type": "string"
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "sessionId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"point": {
			"type": "object",
			"required": ["row", "col"],
			"additionalProperties": false,
			"properties": {
				"row": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"col": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			}
		}
	}
}
