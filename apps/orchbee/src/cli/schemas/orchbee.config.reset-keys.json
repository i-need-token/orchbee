{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.config.reset-keys",
	"title": "Offline Windows keybinding reset result",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.config.reset-keys"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "local-configuration"
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["state", "path", "backupPath", "error", "recoveryRequired"],
			"properties": {
				"state": {
					"enum": ["missing", "no-keys", "reset", "failed"]
				},
				"path": {
					"type": ["string", "null"],
					"maxLength": 8192
				},
				"backupPath": {
					"type": ["string", "null"],
					"maxLength": 8192
				},
				"error": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["field", "reason"],
							"properties": {
								"field": {
									"type": "string",
									"minLength": 1,
									"maxLength": 64
								},
								"reason": {
									"type": "string",
									"minLength": 1,
									"maxLength": 64
								}
							}
						}
					]
				},
				"recoveryRequired": {
					"type": "boolean"
				}
			},
			"if": {
				"properties": {
					"state": {
						"enum": ["missing", "no-keys"]
					}
				}
			},
			"then": {
				"properties": {
					"backupPath": {
						"type": "null"
					},
					"error": {
						"type": "null"
					},
					"recoveryRequired": {
						"const": false
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "reset"
							}
						}
					},
					"then": {
						"properties": {
							"path": {
								"type": "string",
								"minLength": 1
							},
							"backupPath": {
								"type": "string",
								"minLength": 1
							},
							"error": {
								"type": "null"
							},
							"recoveryRequired": {
								"const": false
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"const": "failed"
							}
						}
					},
					"then": {
						"properties": {
							"error": {
								"type": "object",
								"additionalProperties": false,
								"required": ["field", "reason"],
								"properties": {
									"field": {
										"type": "string",
										"minLength": 1,
										"maxLength": 64
									},
									"reason": {
										"type": "string",
										"minLength": 1,
										"maxLength": 64
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"recoveryRequired": {
								"const": true
							}
						}
					},
					"then": {
						"properties": {
							"state": {
								"const": "failed"
							},
							"path": {
								"type": "string",
								"minLength": 1
							},
							"backupPath": {
								"type": "string",
								"minLength": 1
							}
						}
					}
				}
			]
		}
	}
}
