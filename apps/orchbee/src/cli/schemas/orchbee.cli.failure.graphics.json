{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.graphics",
	"type": "object",
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.cli.failure.graphics"
		},
		"version": {
			"const": 1
		},
		"failure": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"ambiguous",
						"cancelled",
						"check-failed",
						"denied",
						"incompatible",
						"internal-failure",
						"invalid-identifier",
						"invalid-usage",
						"not-found",
						"outcome-unknown",
						"output-too-large",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"connection-capacity",
						"timeout",
						"transport-loss"
					]
				},
				"details": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "graphics"
						}
					},
					"required": ["stage"]
				}
			},
			"required": ["kind", "details"]
		}
	},
	"required": ["schema", "version", "failure"]
}
