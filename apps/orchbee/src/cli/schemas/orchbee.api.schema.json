{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.api.schema",
	"title": "orchbee api schema envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.api.schema"
		},
		"version": {
			"const": 26
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "embedded"
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"oneOf": [
				{
					"required": ["schema"]
				},
				{
					"required": ["schemas"]
				}
			],
			"properties": {
				"schema": {
					"type": "object",
					"required": ["schemaId", "document"],
					"additionalProperties": false,
					"properties": {
						"schemaId": {
							"$ref": "#/$defs/schemaId"
						},
						"document": {
							"type": "object"
						}
					}
				},
				"schemas": {
					"type": "object",
					"required": [
						"orchbee.agent.doctor",
						"orchbee.agent.explain",
						"orchbee.agent.get",
						"orchbee.agent.integration.mutation",
						"orchbee.agent.integration.plan",
						"orchbee.agent.integrations",
						"orchbee.agent.list",
						"orchbee.agent.names",
						"orchbee.agent.prompt",
						"orchbee.agent.rename",
						"orchbee.agent.resolve",
						"orchbee.agent.start",
						"orchbee.agent.wait",
						"orchbee.api.schema",
						"orchbee.api.snapshot",
						"orchbee.cli.failure",
						"orchbee.cli.failure.agent",
						"orchbee.cli.failure.agent-names",
						"orchbee.cli.failure.agent-prompt",
						"orchbee.cli.failure.agent-runtime",
						"orchbee.cli.failure.agent-start",
						"orchbee.cli.failure.close",
						"orchbee.cli.failure.launch-profile",
						"orchbee.cli.failure.process-info",
						"orchbee.cli.failure.source",
						"orchbee.cli.failure.worktree",
						"orchbee.config.check",
						"orchbee.launch-profile.get",
						"orchbee.launch-profile.list",
						"orchbee.mutation.result",
						"orchbee.panel.current",
						"orchbee.panel.get",
						"orchbee.panel.list",
						"orchbee.panel.process-info",
						"orchbee.project.get",
						"orchbee.project.list",
						"orchbee.project.rename",
						"orchbee.site.diagnose",
						"orchbee.site.diagnose.windows",
						"orchbee.site.start",
						"orchbee.site.stop",
						"orchbee.status",
						"orchbee.tab.get",
						"orchbee.tab.list",
						"orchbee.terminal.get",
						"orchbee.terminal.history",
						"orchbee.terminal.list",
						"orchbee.terminal.read",
						"orchbee.terminal.send",
						"orchbee.terminal.wait-output",
						"orchbee.workspace.close-status",
						"orchbee.workspace.get",
						"orchbee.workspace.list",
						"orchbee.worktree.list",
						"orchbee.worktree.operation",
						"orchbee.worktree.query",
						"orchbee.workspace.group-close",
						"orchbee.client.view",
						"orchbee.client.control",
						"orchbee.cli.failure.client-control",
						"orchbee.cli.failure.schema-export"
					],
					"propertyNames": {
						"$ref": "#/$defs/schemaId"
					},
					"additionalProperties": {
						"type": "object"
					}
				}
			}
		}
	},
	"$defs": {
		"schemaId": {
			"enum": [
				"orchbee.agent.doctor",
				"orchbee.agent.explain",
				"orchbee.agent.get",
				"orchbee.agent.integration.mutation",
				"orchbee.agent.integration.plan",
				"orchbee.agent.integrations",
				"orchbee.agent.list",
				"orchbee.agent.names",
				"orchbee.agent.prompt",
				"orchbee.agent.rename",
				"orchbee.agent.resolve",
				"orchbee.agent.start",
				"orchbee.agent.wait",
				"orchbee.api.schema",
				"orchbee.api.snapshot",
				"orchbee.cli.failure",
				"orchbee.cli.failure.agent",
				"orchbee.cli.failure.agent-names",
				"orchbee.cli.failure.agent-prompt",
				"orchbee.cli.failure.agent-runtime",
				"orchbee.cli.failure.agent-start",
				"orchbee.cli.failure.close",
				"orchbee.cli.failure.launch-profile",
				"orchbee.cli.failure.process-info",
				"orchbee.cli.failure.source",
				"orchbee.cli.failure.worktree",
				"orchbee.config.check",
				"orchbee.launch-profile.get",
				"orchbee.launch-profile.list",
				"orchbee.mutation.result",
				"orchbee.panel.current",
				"orchbee.panel.get",
				"orchbee.panel.list",
				"orchbee.panel.process-info",
				"orchbee.project.get",
				"orchbee.project.list",
				"orchbee.project.rename",
				"orchbee.site.diagnose",
				"orchbee.site.diagnose.windows",
				"orchbee.site.start",
				"orchbee.site.stop",
				"orchbee.status",
				"orchbee.tab.get",
				"orchbee.tab.list",
				"orchbee.terminal.get",
				"orchbee.terminal.history",
				"orchbee.terminal.list",
				"orchbee.terminal.read",
				"orchbee.terminal.send",
				"orchbee.terminal.wait-output",
				"orchbee.workspace.close-status",
				"orchbee.workspace.get",
				"orchbee.workspace.list",
				"orchbee.worktree.list",
				"orchbee.worktree.operation",
				"orchbee.worktree.query",
				"orchbee.workspace.group-close",
				"orchbee.client.view",
				"orchbee.client.control",
				"orchbee.cli.failure.client-control",
				"orchbee.cli.failure.schema-export",
				"orchbee.panel.layout"
			]
		}
	}
}
