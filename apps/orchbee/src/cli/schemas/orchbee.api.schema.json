{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.api.schema",
	"title": "orchbee api schema envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "orchbee.api.schema" },
		"version": { "const": 1 },
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "embedded" }
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"oneOf": [{ "required": ["schema"] }, { "required": ["schemas"] }],
			"properties": {
				"schema": {
					"type": "object",
					"required": ["schemaId", "document"],
					"additionalProperties": false,
					"properties": {
						"schemaId": { "$ref": "#/$defs/schemaId" },
						"document": { "type": "object" }
					}
				},
				"schemas": {
					"type": "object",
					"required": [
						"orchbee.api.schema",
						"orchbee.api.snapshot",
						"orchbee.cli.failure",
						"orchbee.config.check",
						"orchbee.mutation.result",
						"orchbee.panel.get",
						"orchbee.panel.list",
						"orchbee.project.get",
						"orchbee.project.list",
						"orchbee.status",
						"orchbee.tab.get",
						"orchbee.tab.list",
						"orchbee.terminal.get",
						"orchbee.terminal.history",
						"orchbee.terminal.list",
						"orchbee.terminal.read",
						"orchbee.workspace.get",
						"orchbee.workspace.list"
					],
					"propertyNames": { "$ref": "#/$defs/schemaId" },
					"additionalProperties": { "type": "object" }
				}
			}
		}
	},
	"$defs": {
		"schemaId": {
			"enum": [
				"orchbee.api.schema",
				"orchbee.api.snapshot",
				"orchbee.cli.failure",
				"orchbee.config.check",
				"orchbee.mutation.result",
				"orchbee.panel.get",
				"orchbee.panel.list",
				"orchbee.project.get",
				"orchbee.project.list",
				"orchbee.status",
				"orchbee.tab.get",
				"orchbee.tab.list",
				"orchbee.terminal.get",
				"orchbee.terminal.history",
				"orchbee.terminal.list",
				"orchbee.terminal.read",
				"orchbee.workspace.get",
				"orchbee.workspace.list"
			]
		}
	}
}
