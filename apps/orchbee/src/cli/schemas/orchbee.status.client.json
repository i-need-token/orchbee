{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.status.client",
	"title": "Windows runtime client metadata",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.status.client"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"$ref": "#/$defs/client"
		}
	},
	"$defs": {
		"path": {
			"oneOf": [
				{
					"type": "object",
					"required": ["path"],
					"additionalProperties": false,
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["pathUtf16"],
					"additionalProperties": false,
					"properties": {
						"pathUtf16": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			]
		},
		"protocols": {
			"type": "object",
			"required": ["admission", "terminal"],
			"additionalProperties": false,
			"properties": {
				"admission": {
					"const": 1
				},
				"terminal": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"cohort": {
			"oneOf": [
				{
					"type": "object",
					"required": ["state", "identity"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "available"
						},
						"identity": {
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						}
					}
				},
				{
					"type": "object",
					"required": ["state", "reason", "diagnostic"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["missing", "invalid", "denied", "timed-out", "io-error"]
						},
						"diagnostic": {
							"$ref": "#/$defs/cohortDiagnostic"
						}
					}
				}
			]
		},
		"cohortDiagnostic": {
			"type": "object",
			"required": ["ioKind", "osError"],
			"additionalProperties": false,
			"properties": {
				"ioKind": {
					"enum": [
						"not-found",
						"permission-denied",
						"invalid-input",
						"invalid-data",
						"timed-out",
						"unsupported",
						"interrupted",
						"unexpected-eof",
						"would-block",
						"out-of-memory",
						"other"
					]
				},
				"osError": {
					"oneOf": [
						{
							"type": "integer",
							"minimum": -2147483648,
							"maximum": 2147483647
						},
						{
							"type": "null"
						}
					]
				},
				"missingArtifact": {
					"type": "string",
					"pattern": "^(?:orchbee|ob-(?:dev|test)-[0-9a-f]{16})(?:\\.exe|-server\\.exe|-worker\\.exe|-terminal-host\\.exe)$"
				}
			}
		},
		"client": {
			"type": "object",
			"required": [
				"version",
				"platform",
				"architecture",
				"buildProfile",
				"delivery",
				"updateChannel",
				"executable",
				"protocols",
				"cohort",
				"installation"
			],
			"additionalProperties": false,
			"properties": {
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64,
					"pattern": "^[!-~]+$"
				},
				"platform": {
					"const": "windows"
				},
				"architecture": {
					"type": "string",
					"minLength": 1
				},
				"buildProfile": {
					"enum": ["debug", "release"]
				},
				"delivery": {
					"enum": ["development-cohort", "native-release", "unknown"]
				},
				"updateChannel": {
					"enum": ["stable", "preview", null]
				},
				"executable": {
					"$ref": "#/$defs/path"
				},
				"protocols": {
					"$ref": "#/$defs/protocols"
				},
				"cohort": {
					"$ref": "#/$defs/cohort"
				},
				"installation": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state"],
							"properties": {
								"state": {
									"enum": ["development", "unavailable"]
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state", "channel", "version", "buildId", "manifestSha256"],
							"properties": {
								"state": {
									"const": "verified"
								},
								"channel": {
									"enum": ["stable", "preview"]
								},
								"version": {
									"type": "string",
									"pattern": "^[A-Za-z0-9._+-]{1,96}$"
								},
								"buildId": {
									"type": "string",
									"pattern": "^[A-Za-z0-9._+-]{1,96}$"
								},
								"manifestSha256": {
									"type": "string",
									"pattern": "^[a-f0-9]{64}$"
								}
							}
						}
					]
				}
			},
			"if": {
				"properties": {
					"installation": {
						"properties": {
							"state": {
								"const": "development"
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"delivery": {
						"const": "development-cohort"
					},
					"updateChannel": {
						"const": null
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"installation": {
								"properties": {
									"state": {
										"const": "unavailable"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"delivery": {
								"const": "unknown"
							},
							"updateChannel": {
								"const": null
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"installation": {
								"required": ["channel"],
								"properties": {
									"state": {
										"const": "verified"
									},
									"channel": {
										"const": "stable"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"delivery": {
								"const": "native-release"
							},
							"updateChannel": {
								"const": "stable"
							},
							"cohort": {
								"properties": {
									"state": {
										"const": "available"
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"installation": {
								"required": ["channel"],
								"properties": {
									"state": {
										"const": "verified"
									},
									"channel": {
										"const": "preview"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"delivery": {
								"const": "native-release"
							},
							"updateChannel": {
								"const": "preview"
							},
							"cohort": {
								"properties": {
									"state": {
										"const": "available"
									}
								}
							}
						}
					}
				}
			]
		}
	}
}
