{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.status.client",
	"title": "Windows runtime client metadata",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.status.client"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": [
				"version",
				"platform",
				"architecture",
				"buildProfile",
				"delivery",
				"updateChannel",
				"executable",
				"protocols",
				"cohort"
			],
			"additionalProperties": false,
			"properties": {
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64,
					"pattern": "^[!-~]+$"
				},
				"platform": {
					"const": "windows"
				},
				"architecture": {
					"type": "string",
					"minLength": 1
				},
				"buildProfile": {
					"enum": ["debug", "release"]
				},
				"delivery": {
					"const": "development-cohort"
				},
				"updateChannel": {
					"type": "null"
				},
				"executable": {
					"$ref": "#/$defs/path"
				},
				"protocols": {
					"$ref": "#/$defs/protocols"
				},
				"cohort": {
					"$ref": "#/$defs/cohort"
				}
			}
		}
	},
	"$defs": {
		"path": {
			"oneOf": [
				{
					"type": "object",
					"required": ["path"],
					"additionalProperties": false,
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["pathUtf16"],
					"additionalProperties": false,
					"properties": {
						"pathUtf16": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			]
		},
		"protocols": {
			"type": "object",
			"required": ["admission", "terminal"],
			"additionalProperties": false,
			"properties": {
				"admission": {
					"const": 1
				},
				"terminal": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"cohort": {
			"oneOf": [
				{
					"type": "object",
					"required": ["state", "identity"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "available"
						},
						"identity": {
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						}
					}
				},
				{
					"type": "object",
					"required": ["state", "reason"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["missing", "invalid", "denied", "timed-out", "io-error"]
						}
					}
				}
			]
		}
	}
}
