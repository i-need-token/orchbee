						{
							"$ref": "#/$defs/session_path"
						},
						{
							"type": "null"
						}
					]
				},
				"server": {
					"oneOf": [
						{
							"type": "object",
							"required": ["state", "reason"],
							"additionalProperties": false,
							"properties": {
								"state": {
									"const": "not-running"
								},
								"reason": {
