		"runtimeFacts": {
			"type": "object",
			"required": [
				"complete",
				"scope",
				"runtimeBase",
				"runtimeDirectory",
				"marker",
				"locks",
				"endpoints",
				"hostScope",
				"unrecognizedRecords",
				"advisories"
			],
			"additionalProperties": false,
			"properties": {
				"complete": {
					"type": "boolean"
				},
				"scope": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^orchbee-native-[0-9]+$"
						},
						{
							"type": "string",
							"pattern": "^(?!\\.)(?!.*\\.$)[A-Za-z0-9._-]{1,64}$"
						}
					]
				},
				"runtimeBase": {
					"$ref": "#/$defs/runtime_row"
				},
				"runtimeDirectory": {
					"$ref": "#/$defs/runtime_row"
				},
				"marker": {
					"$ref": "#/$defs/runtime_row"
				},
				"locks": {
					"type": "object",
					"required": ["activation", "sessionLifetime"],
					"additionalProperties": false,
					"properties": {
						"activation": {
							"$ref": "#/$defs/runtime_row"
						},
						"sessionLifetime": {
							"$ref": "#/$defs/runtime_row"
						}
					}
				},
				"endpoints": {
					"type": "object",
					"required": ["client", "worker", "clientPending", "agentObservation", "hostEndpoint"],
					"additionalProperties": false,
					"properties": {
						"client": {
							"$ref": "#/$defs/runtime_row"
						},
						"worker": {
							"$ref": "#/$defs/runtime_row"
						},
						"clientPending": {
							"$ref": "#/$defs/runtime_row"
						},
						"agentObservation": {
							"$ref": "#/$defs/runtime_row"
						},
						"hostEndpoint": {
							"$ref": "#/$defs/runtime_row"
						}
					}
				},
				"hostScope": {
					"oneOf": [
						{
							"$ref": "#/$defs/runtime_row"
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"unrecognizedRecords": {
					"oneOf": [
						{
							"$ref": "#/$defs/runtime_unrecognizedRecords"
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"advisories": {
					"type": "array",
					"items": {
						"enum": [
							"recovery-blocked",
							"activation-recorded",
							"socket-residue",
							"pipe-name-present",
							"unrecognized-records"
						]
					}
				},
				"blockingProcess": {
					"type": "object",
					"required": ["role", "program", "processId"],
					"additionalProperties": false,
					"properties": {
						"role": {
							"enum": ["server", "worker", "terminal-host"]
						},
						"program": {
							"type": "string",
							"pattern": "^(?:orchbee|ob-(?:dev|test)-[0-9a-f]{16})-(?:server|worker|terminal-host)(?:\\.exe)?$"
						},
						"processId": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4294967295
						}
					}
				}
			}
		},
		"runtimeCheck": {
			"type": "object",
			"required": ["status", "reason", "details"],
