							"$ref": "#/$defs/sessionFacts"
						},
						{
							"$ref": "#/$defs/sessionRefusal"
						}
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"reason": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "not-applicable"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"reason": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "warning"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"reason": {
