						},
						{
							"type": "object",
							"required": ["state", "restartKeepsTerminals", "processes"],
							"additionalProperties": false,
							"properties": {
								"state": {
									"const": "running"
								},
								"restartKeepsTerminals": {
									"type": ["boolean", "null"]
								},
								"processes": {
									"type": "array",
									"minItems": 1,
									"maxItems": 258,
									"items": {
										"$ref": "#/$defs/session_process"
									}
								}
							}
						}
					]
				},
				"clientVersion": {
					"$ref": "#/$defs/session_version"
				}
			}
		},
