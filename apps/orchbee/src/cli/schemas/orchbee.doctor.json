									"environment-mismatch",
									"fingerprint-mismatch",
									"incompatible",
									"timed-out",
									"denied",
									"protocol-invalid",
									"transport-loss",
									"service-unavailable",
									"connection-capacity",
									"check-failed",
									"internal-failure"
