		"sessionFacts": {
			"type": "object",
			"required": ["scope", "runtimeDirectory", "endpoint", "server", "clientVersion"],
			"additionalProperties": false,
			"properties": {
				"scope": {
					"type": "string",
					"pattern": "^(?!\\.)(?!.*\\.$)[A-Za-z0-9._-]{1,64}$"
				},
				"runtimeDirectory": {
					"$ref": "#/$defs/session_path"
				},
				"endpoint": {
