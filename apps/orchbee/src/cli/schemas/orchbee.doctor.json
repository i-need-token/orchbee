								"else": {
									"not": {
										"anyOf": [
											{
												"required": ["path"]
											},
											{
												"required": ["line"]
											},
											{
												"required": ["column"]
											}
										]
									}
								},
								"oneOf": [
									{
										"properties": {
											"field": {
												"const": "file"
											},
											"reason": {
												"enum": [
													"invalid-path",
													"missing",
													"io-error",
													"not-file",
													"too-large",
													"invalid-utf8",
													"invalid-toml"
												]
											}
										}
									},
									{
										"properties": {
											"field": {
												"enum": ["ORCHBEE_CONFIG_FILE", "ORCHBEE_HOME", "USERPROFILE", "HOME"]
											},
											"reason": {
												"const": "invalid-path"
											}
										}
									}
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"details": {
								"properties": {
									"diagnostics": {
										"maxItems": 0
									},
									"diagnosticsOmitted": {
										"const": 0
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "warning"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"details": {
								"anyOf": [
									{
										"properties": {
											"diagnostics": {
												"minItems": 1
											}
										}
									},
									{
										"properties": {
											"diagnosticsOmitted": {
												"minimum": 1
											}
										}
									}
								]
							}
						}
					}
				}
			]
		},
