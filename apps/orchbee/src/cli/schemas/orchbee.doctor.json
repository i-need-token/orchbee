{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.doctor",
	"title": "orchbee doctor envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.doctor"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["ok", "checks"],
			"additionalProperties": false,
			"properties": {
				"ok": {
					"type": "boolean"
				},
				"checks": {
					"type": "object",
					"required": ["installation", "settings", "records", "runtime", "session"],
					"additionalProperties": false,
					"properties": {
						"installation": {
							"oneOf": [
								{
									"$ref": "#/$defs/installationCheck"
								},
								{
									"$ref": "#/$defs/unsupported"
								}
							]
						},
						"settings": {
							"oneOf": [
								{
									"$ref": "#/$defs/settingsCheck"
								},
								{
									"$ref": "#/$defs/unsupported"
								}
							]
						},
						"records": {
							"oneOf": [
								{
									"$ref": "#/$defs/recordsCheck"
								},
								{
									"$ref": "#/$defs/unsupported"
								}
							]
						},
						"runtime": {
							"oneOf": [
								{
									"$ref": "#/$defs/runtimeCheck"
								},
								{
									"$ref": "#/$defs/unsupported"
								}
							]
						},
						"session": {
							"oneOf": [
								{
									"$ref": "#/$defs/sessionCheck"
								},
								{
									"$ref": "#/$defs/unsupported"
								}
							]
						}
					}
				}
			}
		}
	},
	"$defs": {
		"installation_path": {
			"oneOf": [
				{
					"type": "object",
					"required": ["path"],
					"additionalProperties": false,
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["pathUtf16"],
					"additionalProperties": false,
					"properties": {
						"pathUtf16": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			]
		},
		"installation_protocols": {
			"type": "object",
			"required": ["admission", "terminal"],
			"additionalProperties": false,
			"properties": {
				"admission": {
					"const": 1
				},
				"terminal": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"installation_cohort": {
			"oneOf": [
				{
					"type": "object",
					"required": ["state", "identity"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "available"
						},
						"identity": {
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						}
					}
				},
				{
					"type": "object",
					"required": ["state", "reason", "diagnostic"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["missing", "invalid", "denied", "timed-out", "io-error"]
						},
						"diagnostic": {
							"$ref": "#/$defs/installation_cohortDiagnostic"
						}
					}
				}
			]
		},
		"installation_cohortDiagnostic": {
			"type": "object",
			"required": ["ioKind", "osError"],
			"additionalProperties": false,
			"properties": {
				"ioKind": {
					"enum": [
						"not-found",
						"permission-denied",
						"invalid-input",
						"invalid-data",
						"timed-out",
						"unsupported",
						"interrupted",
						"unexpected-eof",
						"would-block",
						"out-of-memory",
						"other"
					]
				},
				"osError": {
					"oneOf": [
						{
							"type": "integer",
							"minimum": -2147483648,
							"maximum": 2147483647
						},
						{
							"type": "null"
						}
					]
				},
				"missingArtifact": {
					"type": "string",
					"pattern": "^(?:orchbee|ob-(?:dev|test)-[0-9a-f]{16})(?:\\.exe|-server\\.exe|-worker\\.exe|-terminal-host\\.exe)$"
				}
			}
		},
		"installation_client": {
			"type": "object",
			"required": [
				"version",
				"platform",
				"architecture",
				"buildProfile",
				"delivery",
				"updateChannel",
				"executable",
				"protocols",
				"cohort",
				"installation"
			],
			"additionalProperties": false,
			"properties": {
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64,
					"pattern": "^[!-~]+$"
				},
				"platform": {
					"const": "windows"
				},
				"architecture": {
					"type": "string",
					"minLength": 1
				},
				"buildProfile": {
					"enum": ["debug", "release"]
				},
				"delivery": {
					"enum": ["development-cohort", "native-release", "unknown"]
				},
				"updateChannel": {
					"enum": ["stable", "preview", null]
				},
				"executable": {
					"$ref": "#/$defs/installation_path"
				},
				"protocols": {
					"$ref": "#/$defs/installation_protocols"
				},
				"cohort": {
					"$ref": "#/$defs/installation_cohort"
				},
				"installation": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state"],
							"properties": {
								"state": {
									"enum": ["development", "unavailable"]
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["state", "channel", "version", "buildId", "manifestSha256"],
							"properties": {
								"state": {
									"const": "verified"
								},
								"channel": {
									"enum": ["stable", "preview"]
								},
								"version": {
									"type": "string",
									"pattern": "^[A-Za-z0-9._+-]{1,96}$"
								},
								"buildId": {
									"type": "string",
									"pattern": "^[A-Za-z0-9._+-]{1,96}$"
								},
								"manifestSha256": {
									"type": "string",
									"pattern": "^[a-f0-9]{64}$"
								}
							}
						}
					]
				}
			},
			"if": {
				"properties": {
					"installation": {
						"properties": {
							"state": {
								"const": "development"
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"delivery": {
						"const": "development-cohort"
					},
					"updateChannel": {
						"const": null
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"installation": {
								"properties": {
									"state": {
										"const": "unavailable"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"delivery": {
								"const": "unknown"
							},
							"updateChannel": {
								"const": null
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"installation": {
								"required": ["channel"],
								"properties": {
									"state": {
										"const": "verified"
									},
									"channel": {
										"const": "stable"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"delivery": {
								"const": "native-release"
							},
							"updateChannel": {
								"const": "stable"
							},
							"cohort": {
								"properties": {
									"state": {
										"const": "available"
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"installation": {
								"required": ["channel"],
								"properties": {
									"state": {
										"const": "verified"
									},
									"channel": {
										"const": "preview"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"delivery": {
								"const": "native-release"
							},
							"updateChannel": {
								"const": "preview"
							},
							"cohort": {
								"properties": {
									"state": {
										"const": "available"
									}
								}
							}
						}
					}
				}
			]
		},
		"session_path": {
			"oneOf": [
				{
					"type": "object",
					"required": ["path"],
					"additionalProperties": false,
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["pathUtf16"],
					"additionalProperties": false,
					"properties": {
						"pathUtf16": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			]
		},
		"session_version": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[!-~]+$"
		},
		"session_process": {
			"type": "object",
			"required": ["role", "version", "processId", "state", "terminals"],
			"additionalProperties": false,
			"properties": {
				"role": {
					"enum": ["server", "worker", "terminal-host", "unknown"]
				},
				"version": {
					"$ref": "#/$defs/session_version"
				},
				"processId": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"state": {
					"enum": ["ready", "draining", "stopping", "unknown"]
				},
				"terminals": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				}
			}
		},
		"runtime_unrecognizedRecords": {
			"type": "object",
			"required": ["state", "reason", "records"],
			"additionalProperties": false,
			"properties": {
				"state": {
					"enum": ["known", "uninspectable"]
				},
				"reason": {
					"anyOf": [
						{
							"enum": [
								"denied",
								"io-error",
								"invalid-path",
								"parent-unavailable",
								"deadline",
								"observation-limit"
							]
						},
						{
							"type": "null"
						}
					]
				},
				"records": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/runtime_unrecognizedRecord"
					}
				}
			},
			"if": {
				"properties": {
					"state": {
						"const": "known"
					}
				}
			},
			"then": {
				"properties": {
					"reason": {
						"type": "null"
					}
				}
			},
			"else": {
				"properties": {
					"reason": {
						"type": "string"
					},
					"records": {
						"maxItems": 0
					}
				}
			}
		},
		"runtime_unrecognizedRecord": {
			"type": "object",
			"required": ["record", "reason", "path", "pathUtf16"],
			"additionalProperties": false,
			"properties": {
				"record": {
					"enum": ["catalog-record"]
				},
				"reason": {
					"enum": ["unreadable", "letter-case"]
				},
				"path": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1
						},
						{
							"type": "null"
						}
					]
				},
				"pathUtf16": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"runtime_row": {
			"type": "object",
			"required": [
				"state",
				"reason",
				"kind",
				"ownerMatch",
				"mode",
				"size",
				"linkCount",
				"path",
				"pathBytesHex",
				"private",
				"pathUtf16",
				"activation",
				"stopRequestId"
			],
			"additionalProperties": false,
			"properties": {
				"state": {
					"anyOf": [
						{
							"enum": ["known", "absent", "unsafe", "uninspectable", "free", "held"]
						},
						{
							"enum": ["known", "absent", "uninspectable", "free", "held", "unsafe"]
						}
					]
				},
				"reason": {
					"oneOf": [
						{
							"anyOf": [
								{
									"anyOf": [
										{
											"enum": [
												"symlink",
												"invalid-kind",
												"foreign-owner",
												"invalid-mode",
												"invalid-size",
												"invalid-link-count",
												"invalid-lock",
												"denied",
												"io-error",
												"invalid-path",
												"identity-changed",
												"unsafe-parent",
												"parent-unavailable",
												"deadline"
											]
										},
										{
											"enum": [
												"denied",
												"io-error",
												"invalid-path",
												"parent-unavailable",
												"deadline",
												"observation-limit"
											]
										}
									]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"kind": {
					"oneOf": [
						{
							"anyOf": [
								{
									"enum": ["socket", "regular", "directory", "symlink", "other"]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"ownerMatch": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "boolean"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"mode": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "string",
									"pattern": "^[0-7]{4,}$"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"size": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"linkCount": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"path": {
					"oneOf": [
						{
							"anyOf": [
								{
									"anyOf": [
										{
											"type": "string",
											"minLength": 1
										},
										{
											"type": "string"
										}
									]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"pathBytesHex": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "string",
									"pattern": "^([0-9a-f]{2})+$"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"private": {
					"oneOf": [
						{
							"anyOf": [
								{
									"const": true
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"pathUtf16": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "array",
									"items": {
										"type": "integer",
										"minimum": 0,
										"maximum": 65535
									}
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"activation": {
					"oneOf": [
						{
							"anyOf": [
								{
									"enum": ["active", "stopped"]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"stopRequestId": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "string",
									"pattern": "^(?!0{32}$)[0-9a-f]{32}$"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"activation": {
								"const": "stopped"
							}
						}
					},
					"then": {
						"properties": {
							"stopRequestId": {
								"type": "string",
								"pattern": "^(?!0{32}$)[0-9a-f]{32}$"
							}
						}
					}
				}
			]
		},
		"installationFacts": {
			"$ref": "#/$defs/installation_client"
		},
		"installationCheck": {
			"type": "object",
			"required": ["status", "reason", "details"],
			"additionalProperties": false,
			"properties": {
				"status": {
					"enum": ["pass", "warning", "fail"]
				},
				"reason": true,
				"details": {
					"$ref": "#/$defs/installationFacts"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"reason": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "warning"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"reason": {
								"const": "delivery-unknown"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "fail"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"reason": {
								"enum": ["missing", "invalid", "denied", "timed-out", "io-error"]
							}
						}
					}
				}
			]
		},
		"settingsCheck": {
			"type": "object",
			"required": ["status", "reason", "details"],
			"additionalProperties": false,
			"properties": {
				"status": {
					"enum": ["pass", "warning", "fail"]
				},
				"reason": true,
				"details": {
					"type": "object"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
