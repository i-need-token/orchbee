											"missing",
											"io-error",
											"not-file",
											"too-large",
											"invalid-utf8",
											"invalid-toml"
										]
									},
									"path": {
										"type": "string",
										"minLength": 1,
										"maxLength": 4096
									},
									"line": {
										"type": "integer",
										"minimum": 1
									},
									"column": {
										"type": "integer",
										"minimum": 1
									}
								},
								"if": {
