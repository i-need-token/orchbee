{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.client.view",
	"title": "Native Client view observation",
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.client.view"
		},
		"version": {
			"const": 1
		},
		"result": {
			"type": "object",
			"properties": {
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/requestId"
				},
				"sessionId": {
					"$ref": "#/$defs/sessionId"
				},
				"outcome": {
					"$ref": "#/$defs/outcome"
				}
			},
			"required": ["protocolVersion", "requestId", "sessionId", "outcome"],
			"additionalProperties": false
		}
	},
	"required": ["schema", "version", "result"],
	"additionalProperties": false,
	"$defs": {
		"sessionId": {
			"title": "SessionId",
			"$ref": "#/$defs/identity"
		},
		"requestId": {
			"title": "WorkbenchRequestId",
			"$ref": "#/$defs/identity"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"maximized": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "maximized", "panelCount"],
			"additionalProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"client": {
			"type": "object",
			"properties": {
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"heartbeat": {
					"$ref": "#/$defs/sequence"
				},
				"viewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"view": {
					"$ref": "#/$defs/view"
				},
				"availability": {
					"enum": ["current", "stale"]
				}
			},
			"required": ["clientId", "heartbeat", "viewRevision", "view", "availability"],
			"additionalProperties": false
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "listed"
						},
						"clients": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/client"
							},
							"maxItems": 32
						}
					},
					"required": ["kind", "clients"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "found"
						},
						"client": {
							"$ref": "#/$defs/client"
						}
					},
					"required": ["kind", "client"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-found"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "denied"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": [
								"client-unavailable",
								"server-busy",
								"receipt-capacity",
								"unsupported",
								"sequence-exhausted"
							]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		}
	}
}
