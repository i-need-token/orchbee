{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.popup.result",
	"title": "Native Windows independent terminal popup receipt",
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.popup.result"
		},
		"version": {
			"const": 1
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sessionId", "operationId", "observation", "wait"],
			"properties": {
				"sessionId": {
					"anyOf": [
						{
							"$ref": "#/$defs/sessionId"
						},
						{
							"type": "null"
						}
					]
				},
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"observation": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "server"
								},
								"reply": {
									"type": "object",
									"properties": {
										"protocolVersion": {
											"const": 1
										},
										"requestId": {
											"$ref": "#/$defs/requestId"
										},
										"sessionId": {
											"$ref": "#/$defs/sessionId"
										},
										"outcome": {
											"$ref": "#/$defs/outcome"
										}
									},
									"required": ["protocolVersion", "requestId", "sessionId", "outcome"],
									"additionalProperties": false
								}
							},
							"required": ["kind", "reply"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "unknown"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "not-submitted"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "unobserved"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						}
					]
				},
				"wait": {
					"anyOf": [
						{
							"enum": ["detached", "timed-out", "cancelled", "transport-lost", "observation-failed"]
						},
						{
							"type": "null"
						}
					]
				}
			},
			"allOf": [
				{
					"type": ["object", "null"],
					"properties": {
						"observation": {
							"type": ["object", "null"],
							"properties": {
								"reply": {
									"type": ["object", "null"],
									"properties": {
										"outcome": {
											"type": ["object", "null"],
											"properties": {
												"operation": {
													"type": ["object", "null"],
													"properties": {
														"command": {
															"type": "object",
															"properties": {
																"intent": {
																	"type": "object",
																	"properties": {
																		"kind": {
																			"enum": ["popup-open", "popup-close"]
																		}
																	},
																	"required": ["kind"]
																}
															}
														}
													}
												}
											}
										}
									}
								}
							}
						}
					}
				}
			]
		}
	},
	"required": ["schema", "version", "result"],
	"additionalProperties": false,
	"$defs": {
		"sessionId": {
			"title": "SessionId",
			"$ref": "#/$defs/identity"
		},
		"requestId": {
			"title": "WorkbenchRequestId",
			"$ref": "#/$defs/identity"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"intent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "popup-open"
						},
						"spec": {
							"$ref": "#/$defs/popupSpec"
						}
					},
					"required": ["kind", "spec"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "popup-close"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				}
			]
		},
		"control": {
			"type": "object",
			"properties": {
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"expectedViewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"minimumWorkbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"intent": {
					"$ref": "#/$defs/intent"
				}
			},
			"required": [
				"operationId",
				"clientId",
				"expectedViewRevision",
				"minimumWorkbenchRevision",
				"intent"
			],
			"additionalProperties": false
		},
		"reason": {
			"enum": [
				"busy",
				"modal-open",
				"insufficient-space",
				"stale-view",
				"target-unavailable",
				"projection-unavailable",
				"interrupted",
				"client-disconnected",
				"expired",
				"unsupported"
			]
		},
		"status": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "queued"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "delivered"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "incomplete"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						},
						"view": {
							"anyOf": [
								{
									"$ref": "#/$defs/view"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "reason", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "popup-opened"
						},
						"popupId": {
							"$ref": "#/$defs/requestId"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "popupId", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "popup-closed"
						},
						"hadPopup": {
							"type": "boolean"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "hadPopup", "view"],
					"additionalProperties": false
				}
			]
		},
		"operation": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "#/$defs/control"
				},
				"status": {
					"$ref": "#/$defs/status"
				}
			},
			"required": ["command", "status"],
			"additionalProperties": false
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "operation"
						},
						"operation": {
							"$ref": "#/$defs/operation"
						}
					},
					"required": ["kind", "operation"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-found"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "conflict"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "denied"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": [
								"client-unavailable",
								"server-busy",
								"receipt-capacity",
								"unsupported",
								"sequence-exhausted"
							]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"scrollMetrics": {
			"type": "object",
			"properties": {
				"offsetFromBottom": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64"
				},
				"maxOffsetFromBottom": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64"
				},
				"viewportRows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				}
			},
			"required": ["offsetFromBottom", "maxOffsetFromBottom", "viewportRows"],
			"additionalProperties": false
		},
		"viewportSource": {
			"type": "object",
			"properties": {
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"attachmentId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64",
					"not": {
						"const": "0"
					}
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64"
				},
				"columns": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"alternateScreen": {
					"type": "boolean"
				},
				"totalRows": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64"
				},
				"startRow": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64"
				}
			},
			"required": [
				"hostEpoch",
				"attachmentId",
				"generation",
				"revision",
				"columns",
				"alternateScreen",
				"totalRows",
				"startRow"
			],
			"additionalProperties": false
		},
		"viewportObservation": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["not-attached", "frame-unavailable"]
						}
					},
					"required": ["state", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"state": {
							"const": "pending"
						},
						"phase": {
							"enum": ["entering", "awaiting-window", "recovering"]
						}
					},
					"required": ["state", "phase"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"state": {
							"const": "observed"
						},
						"mode": {
							"enum": ["live", "history"]
						},
						"source": {
							"$ref": "#/$defs/viewportSource"
						},
						"scroll": {
							"$ref": "#/$defs/scrollMetrics"
						}
					},
					"required": ["state", "mode", "source", "scroll"],
					"additionalProperties": false
				}
			]
		},
		"presentationSelection": {
			"oneOf": [
				{
					"$ref": "#/$defs/boundPresentationSelection"
				},
				{
					"$ref": "#/$defs/unboundPresentationSelection"
				}
			]
		},
		"boundPresentationSelection": {
			"type": "object",
			"properties": {
				"presentationId": {
					"title": "WorkbenchPanelId",
					"$ref": "#/$defs/identity"
				},
				"binding": {
					"type": "object",
					"properties": {
						"workerId": {
							"title": "WorkbenchPanelId",
							"$ref": "#/$defs/identity"
						},
						"terminalId": {
							"title": "WorkbenchPanelId",
							"$ref": "#/$defs/identity"
						}
					},
					"required": ["workerId", "terminalId"],
					"additionalProperties": false
				},
				"attachmentGeneration": {
					"title": "WorkbenchRevision",
					"type": "string",
					"minLength": 1,
					"maxLength": 20,
					"pattern": "^(?:0|[1-9][0-9]{0,19})$",
					"format": "orchbee-uint64"
				},
				"incarnation": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				},
				"viewport": {
					"$ref": "#/$defs/viewportObservation"
				}
			},
			"required": ["presentationId", "binding", "attachmentGeneration", "incarnation", "viewport"],
			"additionalProperties": false
		},
		"unboundPresentationSelection": {
			"type": "object",
			"properties": {
				"presentationId": {
					"title": "WorkbenchPanelId",
					"$ref": "#/$defs/identity"
				},
				"selectionGeneration": {
					"$ref": "#/$defs/selectionGeneration"
				}
			},
			"required": ["presentationId", "selectionGeneration"],
			"additionalProperties": false
		},
		"selectionGeneration": {
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]{1}|1844674407370955161[0-4]|18446744073709551615)(?![\\s\\S])"
		},
		"popupSize": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "cells"
						},
						"value": {
							"type": "integer",
							"minimum": 0,
							"maximum": 65535
						}
					},
					"required": ["kind", "value"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "percent"
						},
						"value": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100
						}
					},
					"required": ["kind", "value"],
					"additionalProperties": false
				}
			]
		},
		"popupSelector": {
			"type": "object",
			"properties": {
				"pluginId": {
					"type": "string",
					"pattern": "^[A-Za-z0-9._:-]{1,120}$"
				},
				"entrypointId": {
					"type": "string",
					"pattern": "^[A-Za-z0-9_:-]{1,120}$"
				}
			},
			"required": ["pluginId", "entrypointId"],
			"additionalProperties": false
		},
		"popupContext": {
			"type": "object",
			"additionalProperties": false,
			"required": [],
			"properties": {
				"workspaceId": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"workspaceLabel": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"workspaceCwd": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"tabId": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"tabLabel": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"focusedPanelId": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"focusedPanelCwd": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"focusedPanelAgent": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"focusedPanelStatus": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"selectedText": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 8192,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"invocationSource": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"correlationId": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"clickedUrl": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"linkHandlerId": {
					"anyOf": [
						{
							"type": "string",
							"maxLength": 4096,
							"pattern": "^[^\\u0000]*$"
						},
						{
							"type": "null"
						}
					]
				},
				"worktree": {
					"anyOf": [
						{
							"$ref": "#/$defs/worktreeContext"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"worktreeContext": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"workerId",
				"repositoryRoot",
				"commonDirectory",
				"repositoryName",
				"checkoutPath",
				"linked"
			],
			"properties": {
				"workerId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"repositoryRoot": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])",
					"not": {
						"pattern": "\u0000"
					}
				},
				"commonDirectory": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])",
					"not": {
						"pattern": "\u0000"
					}
				},
				"repositoryName": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"not": {
						"pattern": "\u0000"
					}
				},
				"checkoutPath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])",
					"not": {
						"pattern": "\u0000"
					}
				},
				"linked": {
					"type": "boolean"
				}
			}
		},
		"popupEnvironment": {
			"type": "array",
			"maxItems": 32,
			"items": {
				"type": "array",
				"prefixItems": [
					{
						"type": "string",
						"pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$",
						"not": {
							"pattern": "^[Oo][Rr][Cc][Hh][Bb][Ee][Ee]_"
						},
						"allOf": [
							{
								"not": {
									"pattern": "^(?:[Tt][Ee][Rr][Mm]|[Cc][Oo][Ll][Oo][Rr][Tt][Ee][Rr][Mm]|[Tt][Ee][Rr][Mm]_[Pp][Rr][Oo][Gg][Rr][Aa][Mm])$"
								}
							}
						]
					},
					{
						"type": "string",
						"pattern": "^[^\\u0000]*$"
					}
				],
				"minItems": 2,
				"maxItems": 2,
				"items": false
			}
		},
		"popupDirectoryPath": {
			"title": "WorkbenchDirectoryPath",
			"type": "string",
			"minLength": 1,
			"maxLength": 4096,
			"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$"
		},
		"popupSource": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"$ref": "#/$defs/tabId"
				},
				"member": {
					"$ref": "#/$defs/presentationSelection"
				},
				"panelId": {
					"$ref": "#/$defs/panelId"
				}
			},
			"required": ["terminalContextId", "tabId", "member", "panelId"],
			"additionalProperties": false
		},
		"popupSpec": {
			"type": "object",
			"properties": {
				"selector": {
					"$ref": "#/$defs/popupSelector"
				},
				"source": {
					"$ref": "#/$defs/popupSource"
				},
				"context": {
					"$ref": "#/$defs/popupContext"
				},
				"cwd": {
					"anyOf": [
						{
							"$ref": "#/$defs/popupDirectoryPath"
						},
						{
							"type": "null"
						}
					]
				},
				"environment": {
					"$ref": "#/$defs/popupEnvironment"
				},
				"width": {
					"anyOf": [
						{
							"$ref": "#/$defs/popupSize"
						},
						{
							"type": "null"
						}
					]
				},
				"height": {
					"anyOf": [
						{
							"$ref": "#/$defs/popupSize"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["selector", "source", "context", "cwd", "environment", "width", "height"],
			"additionalProperties": false
		}
	}
}
