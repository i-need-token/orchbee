														"$ref": "#/$defs/sendFailure/$defs/doctorStageDetails"
													},
													{
														"$ref": "#/$defs/sendFailure/$defs/runtimeStatusStageDetails"
													},
													{
														"$ref": "#/$defs/sendFailure/$defs/currentPanelStageDetails"
													}
												]
											}
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"failure": {
										"properties": {
											"kind": {
												"const": "denied"
											}
										},
										"required": ["kind"]
									}
								}
							},
							"then": {
								"properties": {
									"failure": {
										"properties": {
											"details": {
												"$ref": "#/$defs/sendFailure/$defs/cohortStageDetails"
											}
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"failure": {
										"properties": {
											"kind": {
												"const": "internal-failure"
											}
										},
										"required": ["kind"]
									}
								}
							},
							"then": {
								"properties": {
									"failure": {
										"properties": {
											"details": {
												"oneOf": [
													{
														"$ref": "#/$defs/sendFailure/$defs/activationStageDetails"
													},
													{
														"$ref": "#/$defs/sendFailure/$defs/cohortStageDetails"
													}
												]
											}
										}
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"failure": {
										"properties": {
											"kind": {
												"const": "invalid-usage"
											}
										},
										"required": ["kind"]
									}
								}
							},
							"then": {
								"properties": {
									"failure": {
										"not": {
											"required": ["details"]
										}
									}
								}
							}
						}
					]
				}
			}
		},
		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		},
		"launchReservation": {
			"type": "object",
			"required": [
				"reservationId",
				"name",
				"providerId",
				"binding",
				"remainingMs",
				"settleRemainingMs"
			],
			"additionalProperties": false,
			"properties": {
				"reservationId": {
					"$ref": "#/$defs/obapRequestId"
				},
				"name": {
					"$ref": "#/$defs/agentName"
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"binding": {
					"$ref": "#/$defs/launchBinding"
				},
				"remainingMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 300000
				},
				"settleRemainingMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3000
				}
			}
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		}
	}
}
