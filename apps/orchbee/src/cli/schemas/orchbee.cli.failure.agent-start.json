		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		},
		"launchReservation": {
			"type": "object",
			"required": [
				"reservationId",
				"name",
				"providerId",
				"binding",
				"remainingMs",
				"settleRemainingMs"
			],
			"additionalProperties": false,
			"properties": {
				"reservationId": {
					"$ref": "#/$defs/obapRequestId"
				},
				"name": {
					"$ref": "#/$defs/agentName"
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"binding": {
					"$ref": "#/$defs/launchBinding"
				},
				"remainingMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 300000
				},
				"settleRemainingMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3000
				}
			}
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"$comment": "Request identity: exactly 32 lowercase hexadecimal characters and never the zero sentinel; the nonzero rule is a semantic invariant enforced by each binding."
		}
	}
