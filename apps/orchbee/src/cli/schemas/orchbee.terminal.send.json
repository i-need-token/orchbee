{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.send",
	"title": "orchbee terminal send result envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.send"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/sendSource"
		},
		"result": {
			"type": "object",
			"required": [
				"action",
				"requestId",
				"siteId",
				"workerId",
				"terminalId",
				"inputStatus",
				"cleanupStatus",
				"payloadKind",
				"records",
				"recordsAccepted",
				"firstStoppedRecord",
				"acceptedEncodedBytes"
			],
			"additionalProperties": false,
			"properties": {
				"action": {
					"const": "terminal.send"
				},
				"requestId": {
					"$ref": "#/$defs/id"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"payloadKind": {
					"enum": ["text", "key", "bytes", "paste", "sequence"]
				},
				"recordBytes": {
					"type": "integer",
					"minimum": 1,
					"maximum": 1048576
				},
				"inputStatus": {
					"enum": ["accepted", "not-submitted", "rejected", "unknown", "partial-accepted"]
				},
				"cleanupStatus": {
					"enum": ["not-needed", "confirmed", "unconfirmed"]
				},
				"reason": {
					"enum": [
						"host-input-backpressure",
						"host-input-invalid",
						"host-input-limit-exceeded",
						"host-input-unavailable",
						"host-protocol-fault",
						"host-rejected",
						"host-unavailable",
						"server-busy",
						"stale-host-epoch",
						"stale-worker-generation",
						"terminal-runtime-unavailable",
						"terminal-unavailable",
						"worker-unavailable",
						"input-budget-exhausted"
					]
				},
				"target": {
					"type": "object",
					"required": ["workerGeneration", "hostEpoch", "hostTerminalId"],
					"additionalProperties": false,
					"properties": {
						"workerGeneration": {
							"type": "string",
							"pattern": "^[1-9][0-9]*$"
						},
						"hostEpoch": {
							"$ref": "#/$defs/id"
						},
						"hostTerminalId": {
							"$ref": "#/$defs/id"
						}
					}
				},
				"records": {
					"type": "integer",
					"minimum": 1,
					"maximum": 64
				},
				"recordsAccepted": {
					"type": "integer",
					"minimum": 0,
					"maximum": 64
				},
				"firstStoppedRecord": {
					"type": "integer",
					"minimum": 0,
					"maximum": 64
				},
				"acceptedEncodedBytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 67108864
				}
			},
			"if": {
				"properties": {
					"inputStatus": {
						"enum": ["not-submitted", "rejected", "partial-accepted"]
					}
				},
				"required": ["inputStatus"]
			},
			"then": {
				"required": ["reason"]
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"inputStatus": {
								"enum": ["accepted", "unknown"]
							}
						},
						"required": ["inputStatus"]
					},
					"then": {
						"required": ["target"]
					}
				},
				{
					"if": {
						"properties": {
							"cleanupStatus": {
								"enum": ["confirmed", "unconfirmed"]
							}
						},
						"required": ["cleanupStatus"]
					},
					"then": {
						"required": ["target"]
					}
				},
				{
					"if": {
						"properties": {
							"payloadKind": {
								"enum": ["text", "bytes", "paste"]
							}
						},
						"required": ["payloadKind"]
					},
					"then": {
						"required": ["recordBytes"]
					}
				},
				{
					"if": {
						"properties": {
							"inputStatus": {
								"const": "partial-accepted"
							}
						}
					},
					"then": {
						"required": ["target"],
						"properties": {
							"recordsAccepted": {
								"minimum": 1
							},
							"cleanupStatus": {
								"enum": ["confirmed", "unconfirmed"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"inputStatus": {
								"const": "accepted"
							}
						}
					},
					"then": {
						"properties": {
							"recordsAccepted": {
								"minimum": 1
							},
							"cleanupStatus": {
								"enum": ["confirmed", "unconfirmed"]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"inputStatus": {
								"const": "unknown"
							}
						}
					},
					"then": {
						"properties": {
							"cleanupStatus": {
								"enum": ["not-needed", "unconfirmed"]
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"sendSource": {
			"type": "object",
			"required": ["kind", "siteId", "requestId", "snapshotRevision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal.send"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"requestId": {
					"$ref": "#/$defs/id"
				},
				"snapshotRevision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		}
	}
}
