{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.list",
	"title": "orchbee terminal list envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.list"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": ["terminals"],
			"additionalProperties": false,
			"properties": {
				"terminals": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/terminal"
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo", "observation"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				},
				"observation": {
					"oneOf": [
						{
							"$ref": "#/$defs/observed"
						},
						{
							"$ref": "#/$defs/frameUnavailable"
						},
						{
							"$ref": "#/$defs/notSampled"
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				}
			}
		},
		"observed": {
			"type": "object",
			"required": ["kind", "title", "cwd", "agent", "state"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "observed"
				},
				"title": {
					"type": ["string", "null"]
				},
				"cwd": {
					"type": ["string", "null"]
				},
				"agent": {
					"type": ["string", "null"]
				},
				"state": {
					"$ref": "#/$defs/agentState"
				}
			}
		},
		"frameUnavailable": {
			"type": "object",
			"required": ["kind", "agent", "state"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "frame-unavailable"
				},
				"agent": {
					"type": ["string", "null"]
				},
				"state": {
					"$ref": "#/$defs/agentState"
				}
			}
		},
		"notSampled": {
			"description": "Observations are best effort. A row is not sampled beyond the 64-row prefix, when its observation did not finish before the deadline, or when it could not be verified against the snapshot whose rows the result returns.",
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "not-sampled"
				}
			}
		},
		"agentState": {
			"enum": ["idle", "working", "blocked", "done", "error", "unknown", null]
		},
		"unsupported": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "unsupported"
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "sessionId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		}
	}
}
