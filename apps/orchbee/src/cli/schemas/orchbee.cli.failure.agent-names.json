{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.agent-names",
	"title": "orchbee Agent names failure envelope",
	"type": "object",
	"required": ["schema", "version", "failure"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.cli.failure.agent-names"
		},
		"version": {
			"const": 1
		},
		"failure": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"cancelled",
						"denied",
						"internal-failure",
						"not-found",
						"outcome-unknown",
						"output-too-large",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"timeout",
						"transport-loss",
						"ambiguous"
					]
				},
				"details": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "agent-names"
						},
						"reason": {
							"enum": [
								"not-found",
								"read-denied",
								"manage-denied",
								"name-in-use",
								"session-not-found",
								"session-ended",
								"name-not-found",
								"capacity-exceeded",
								"reply-not-confirmed",
								"ambiguous-target",
								"launch-pending"
							]
						},
						"operation": {
							"enum": ["names", "resolve", "rename", "clear-name"]
						},
						"requestId": {
							"$ref": "#/$defs/obapRequestId"
						},
						"conflictTarget": {
							"$ref": "#/$defs/nameTarget"
						}
					}
				}
			}
		},
		"source": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-names"
				},
				"requestId": {
					"$ref": "#/$defs/obapRequestId"
				}
			}
		}
	},
	"$defs": {
		"sessionId": {
			"$ref": "#/$defs/opaqueIdentity"
		},
		"opaqueIdentity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._:-]{1,128}$"
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"nameTarget": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind", "sessionId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "session"
						},
						"sessionId": {
							"$ref": "#/$defs/sessionId"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "binding"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal"
						},
						"binding": {
							"$ref": "#/$defs/launchBinding"
						}
					}
				}
			]
		},
		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		}
	},
	"if": {
		"properties": {
			"failure": {
				"properties": {
					"details": {
						"required": ["conflictTarget"]
					}
				},
				"required": ["details"]
			}
		},
		"required": ["failure"]
	},
	"then": {
		"properties": {
			"failure": {
				"required": ["details"],
				"properties": {
					"kind": {
						"const": "rejected"
					},
					"details": {
						"required": ["stage", "reason", "conflictTarget"],
						"properties": {
							"reason": {
								"const": "name-in-use"
							},
							"conflictSessionId": false
						}
					}
				}
			}
		}
	}
}
