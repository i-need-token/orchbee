{
	"$id": "orchbee.events.wait",
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$defs": {
		"publicPanel_d0": {
			"title": "SessionId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d1": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"publicPanel_d2": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"publicPanel_d3": {
			"type": "object",
			"properties": {
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/publicPanel_d4"
				},
				"sessionId": {
					"$ref": "#/$defs/publicPanel_d0"
				},
				"outcome": {
					"$ref": "#/$defs/publicPanel_d5"
				}
			},
			"required": ["protocolVersion", "requestId", "sessionId", "outcome"],
			"additionalProperties": false
		},
		"publicPanel_d4": {
			"title": "WorkbenchRequestId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d5": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "opened"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						},
						"cursor": {
							"$ref": "#/$defs/publicPanel_d6"
						},
						"existing": {
							"type": "boolean"
						}
					},
					"required": ["kind", "subscriptionId", "cursor", "existing"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "events"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						},
						"cursor": {
							"$ref": "#/$defs/publicPanel_d6"
						},
						"events": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/publicPanel_d7"
							},
							"minItems": 0,
							"maxItems": 32
						},
						"gap": {
							"anyOf": [
								{
									"$ref": "#/$defs/publicPanel_d66"
								},
								{
									"type": "null"
								}
							]
						},
						"more": {
							"type": "boolean"
						}
					},
					"required": ["kind", "subscriptionId", "cursor", "events", "gap", "more"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "matched"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						},
						"cursor": {
							"$ref": "#/$defs/publicPanel_d6"
						},
						"event": {
							"$ref": "#/$defs/publicPanel_d7"
						}
					},
					"required": ["kind", "subscriptionId", "cursor", "event"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "timed-out"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						},
						"cursor": {
							"$ref": "#/$defs/publicPanel_d6"
						}
					},
					"required": ["kind", "subscriptionId", "cursor"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "gap"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						},
						"cursor": {
							"$ref": "#/$defs/publicPanel_d6"
						},
						"gap": {
							"$ref": "#/$defs/publicPanel_d66"
						}
					},
					"required": ["kind", "subscriptionId", "cursor", "gap"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "closed"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						}
					},
					"required": ["kind", "subscriptionId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"enum": [
								"denied",
								"invalid-intent",
								"invalid-regex",
								"session-mismatch",
								"unavailable",
								"busy",
								"conflict",
								"not-found",
								"cursor-epoch",
								"cursor-ahead",
								"source-changed",
								"source-unavailable",
								"physical-unknown",
								"revision-exhausted"
							]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"publicPanel_d6": {
			"type": "object",
			"properties": {
				"epoch": {
					"$ref": "#/$defs/publicPanel_d4"
				},
				"sequence": {
					"$ref": "#/$defs/publicPanel_d2"
				}
			},
			"required": ["epoch", "sequence"],
			"additionalProperties": false
		},
		"publicPanel_d7": {
			"type": "object",
			"properties": {
				"workspaceId": {
					"anyOf": [
						{
							"$ref": "#/$defs/publicPanel_d8"
						},
						{
							"type": "null"
						}
					]
				},
				"position": {
					"$ref": "#/$defs/publicPanel_d9"
				},
				"workbenchRevision": {
					"$ref": "#/$defs/publicPanel_d2"
				},
				"event": {
					"enum": [
						"workspace.created",
						"workspace.updated",
						"workspace.metadata_updated",
						"workspace.renamed",
						"workspace.moved",
						"workspace.reordered",
						"workspace.closed",
						"workspace.focused",
						"worktree.created",
						"worktree.opened",
						"worktree.removed",
						"tab.created",
						"tab.closed",
						"tab.focused",
						"tab.renamed",
						"tab.moved",
						"panel.created",
						"panel.closed",
						"panel.updated",
						"panel.focused",
						"panel.moved",
						"panel.exited",
						"panel.agent_detected",
						"panel.agent_status_changed",
						"panel.output_changed",
						"panel.output_matched",
						"panel.scroll_changed",
						"layout.updated"
					]
				},
				"data": {
					"$ref": "#/$defs/publicPanel_d10"
				}
			},
			"required": ["workspaceId", "position", "workbenchRevision", "event", "data"],
			"additionalProperties": false
		},
		"publicPanel_d8": {
			"title": "WorkbenchWorkspaceId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d9": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "journal"
						},
						"cursor": {
							"$ref": "#/$defs/publicPanel_d6"
						}
					},
					"required": ["kind", "cursor"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "probe"
						},
						"subscriptionId": {
							"$ref": "#/$defs/publicPanel_d4"
						},
						"sequence": {
							"$ref": "#/$defs/publicPanel_d2"
						}
					},
					"required": ["kind", "subscriptionId", "sequence"],
					"additionalProperties": false
				}
			]
		},
		"publicPanel_d10": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace"
						},
						"workspace": {
							"$ref": "#/$defs/publicPanel_d12"
						}
					},
					"required": ["kind", "workspace"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace-order"
						},
						"workspaceIds": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/publicPanel_d8"
							},
							"minItems": 0,
							"maxItems": 4096,
							"uniqueItems": true
						}
					},
					"required": ["kind", "workspaceIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "workspace-metadata"
						},
						"workspaceId": {
							"$ref": "#/$defs/publicPanel_d8"
						},
						"tokens": {
							"$ref": "#/$defs/publicPanel_d16"
						}
					},
					"required": ["kind", "workspaceId", "tokens"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab"
						},
						"terminalContextId": {
							"$ref": "#/$defs/publicPanel_d15"
						},
						"tabId": {
							"$ref": "#/$defs/publicPanel_d19"
						},
						"label": {
							"$ref": "#/$defs/publicPanel_d13"
						},
						"index": {
							"type": "integer",
							"minimum": 0,
							"maximum": 4294967295
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "label", "index"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "pane"
						},
						"pane": {
							"$ref": "#/$defs/publicPanel_d20"
						}
					},
					"required": ["kind", "pane"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout"
						},
						"terminalContextId": {
							"$ref": "#/$defs/publicPanel_d15"
						},
						"tabId": {
							"$ref": "#/$defs/publicPanel_d19"
						},
						"root": {
							"$ref": "#/$defs/publicPanel_d26"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "root"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "worktree"
						},
						"result": {
							"$ref": "#/$defs/publicPanel_d34"
						}
					},
					"required": ["kind", "result"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "client"
						},
						"clientId": {
							"$ref": "#/$defs/publicPanel_d50"
						},
						"view": {
							"$ref": "#/$defs/publicPanel_d51"
						},
						"workspaceId": {
							"anyOf": [
								{
									"$ref": "#/$defs/publicPanel_d8"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "clientId", "view", "workspaceId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "agent"
						},
						"pane": {
							"$ref": "#/$defs/publicPanel_d20"
						},
						"report": {
							"$ref": "#/$defs/publicPanel_d58"
						},
						"exited": {
							"const": false
						}
					},
					"required": ["kind", "pane", "report", "exited"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "output"
						},
						"pane": {
							"$ref": "#/$defs/publicPanel_d20"
						},
						"contentGeneration": {
							"$ref": "#/$defs/publicPanel_d2"
						},
						"contentRevision": {
							"$ref": "#/$defs/publicPanel_d2"
						},
						"matchedLine": {
							"anyOf": [
								{
									"type": "string",
									"maxLength": 65536,
									"pattern": "^[^\\u0000]*$"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "pane", "contentGeneration", "contentRevision", "matchedLine"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "exited"
						},
						"pane": {
							"$ref": "#/$defs/publicPanel_d20"
						},
						"lifecycleRevision": {
							"$ref": "#/$defs/publicPanel_d2"
						}
					},
					"required": ["kind", "pane", "lifecycleRevision"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "scroll"
						},
						"clientId": {
							"$ref": "#/$defs/publicPanel_d50"
						},
						"pane": {
							"$ref": "#/$defs/publicPanel_d20"
						},
						"observation": {
							"$ref": "#/$defs/publicPanel_d63"
						}
					},
					"required": ["kind", "clientId", "pane", "observation"],
					"additionalProperties": false
				}
			]
		},
		"publicPanel_d11": {
			"title": "WorkbenchProjectId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d12": {
			"type": "object",
			"additionalProperties": false,
			"required": ["label", "primaryDirectoryId", "terminalContextId", "workspaceId", "projectId"],
			"properties": {
				"automaticLabel": {
					"type": "boolean"
				},
				"label": {
					"$ref": "#/$defs/publicPanel_d13"
				},
				"primaryDirectoryId": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/publicPanel_d14"
						}
					]
				},
				"terminalContextId": {
					"$ref": "#/$defs/publicPanel_d15"
				},
				"workspaceId": {
					"$ref": "#/$defs/publicPanel_d8"
				},
				"projectId": {
					"oneOf": [
						{
							"$ref": "#/$defs/publicPanel_d11"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"publicPanel_d13": {
			"type": "string",
			"minLength": 1,
			"maxLength": 512
		},
		"publicPanel_d14": {
			"title": "WorkbenchDirectoryId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d15": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d16": {
			"type": "object",
			"maxProperties": 32,
			"propertyNames": {
				"$ref": "#/$defs/publicPanel_d17"
			},
			"additionalProperties": {
				"$ref": "#/$defs/publicPanel_d18"
			}
		},
		"publicPanel_d17": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9_-]{1,32}$(?![\\s\\S])"
		},
		"publicPanel_d18": {
			"type": "string",
			"minLength": 1,
			"maxLength": 80,
			"not": {
				"pattern": "[^\\u0020-\\u007e\\u00a0-\\uD7FF\\uE000-\\uFFFF𐀀-􏿿]"
			},
			"allOf": [
				{
					"not": {
						"pattern": "^[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$"
					}
				}
			]
		},
		"publicPanel_d19": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d20": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/publicPanel_d15"
				},
				"tabId": {
					"$ref": "#/$defs/publicPanel_d19"
				},
				"panelId": {
					"$ref": "#/$defs/publicPanel_d21"
				},
				"presentationId": {
					"$ref": "#/$defs/publicPanel_d22"
				},
				"binding": {
					"anyOf": [
						{
							"$ref": "#/$defs/publicPanel_d23"
						},
						{
							"type": "null"
						}
					]
				},
				"label": {
					"$ref": "#/$defs/publicPanel_d13"
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "presentationId", "binding", "label"],
			"additionalProperties": false
		},
		"publicPanel_d21": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d22": {
			"title": "TerminalPresentationId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d23": {
			"type": "object",
			"additionalProperties": false,
			"required": ["terminalId", "workerId"],
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/publicPanel_d24"
				},
				"workerId": {
					"$ref": "#/$defs/publicPanel_d25"
				}
			}
		},
		"publicPanel_d24": {
			"title": "TerminalId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d25": {
			"title": "WorkerId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d26": {
			"oneOf": [
				{
					"$ref": "#/$defs/publicPanel_d27"
				},
				{
					"$ref": "#/$defs/publicPanel_d30"
				}
			]
		},
		"publicPanel_d27": {
			"type": "object",
			"additionalProperties": false,
			"required": ["childPresentations", "kind", "panelId", "primaryPresentation"],
			"properties": {
				"childPresentations": {
					"type": "array",
					"maxItems": 16,
					"items": {
						"$ref": "#/$defs/publicPanel_d28"
					}
				},
				"kind": {
					"const": "panel"
				},
				"rightClick": {
					"enum": ["orchbee", "panel"]
				},
				"panelId": {
					"$ref": "#/$defs/publicPanel_d21"
				},
				"primaryPresentation": {
					"$ref": "#/$defs/publicPanel_d28"
				}
			}
		},
		"publicPanel_d28": {
			"type": "object",
			"additionalProperties": false,
			"required": ["binding", "label", "presentationId"],
			"properties": {
				"customLabel": {
					"$ref": "#/$defs/publicPanel_d29"
				},
				"binding": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/publicPanel_d23"
						}
					]
				},
				"label": {
					"$ref": "#/$defs/publicPanel_d13"
				},
				"presentationId": {
					"$ref": "#/$defs/publicPanel_d22"
				}
			}
		},
		"publicPanel_d29": {
			"type": "string",
			"minLength": 1,
			"maxLength": 512,
			"pattern": "^[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?(?![\\s\\S])"
		},
		"publicPanel_d30": {
			"type": "object",
			"additionalProperties": false,
			"required": ["children", "kind", "orientation", "splitId"],
			"properties": {
				"children": {
					"type": "array",
					"minItems": 2,
					"maxItems": 2,
					"items": {
						"$ref": "#/$defs/publicPanel_d31"
					}
				},
				"kind": {
					"const": "split"
				},
				"orientation": {
					"enum": ["horizontal", "vertical"]
				},
				"splitId": {
					"$ref": "#/$defs/publicPanel_d33"
				}
			}
		},
		"publicPanel_d31": {
			"type": "object",
			"additionalProperties": false,
			"required": ["node", "slotId"],
			"properties": {
				"node": {
					"$ref": "#/$defs/publicPanel_d26"
				},
				"slotId": {
					"$ref": "#/$defs/publicPanel_d32"
				}
			}
		},
		"publicPanel_d32": {
			"title": "WorkbenchPanelSlotId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d33": {
			"title": "WorkbenchSplitId",
			"$ref": "#/$defs/publicPanel_d1"
		},
		"publicPanel_d34": {
			"type": "object",
			"properties": {
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/publicPanel_d35"
				},
				"operationId": {
					"$ref": "#/$defs/publicPanel_d35"
				},
				"outcome": {
					"$ref": "#/$defs/publicPanel_d36"
				}
			},
