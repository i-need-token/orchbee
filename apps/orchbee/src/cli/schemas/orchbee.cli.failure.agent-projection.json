{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.agent-projection",
	"title": "orchbee CLI Agent projection failure envelope",
	"type": "object",
	"required": ["schema", "version", "failure"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.cli.failure.agent-projection"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/agentProjectionSource"
		},
		"failure": {
			"type": "object",
			"required": ["kind", "details"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"ambiguous",
						"cancelled",
						"check-failed",
						"denied",
						"incompatible",
						"internal-failure",
						"invalid-identifier",
						"invalid-usage",
						"not-found",
						"outcome-unknown",
						"output-too-large",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"session-capacity",
						"timeout",
						"transport-loss"
					]
				},
				"details": {
					"$ref": "#/$defs/agentProjectionFailureDetails"
				}
			}
		}
	},
	"$defs": {
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"decimalU64String": {
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"agentProjectionSource": {
			"type": "object",
			"required": ["kind", "siteId", "workbenchRevision", "reportRevision", "canonicalRevision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-projection"
				},
				"siteId": {
					"$ref": "#/$defs/hexId"
				},
				"workbenchRevision": {
					"$ref": "#/$defs/decimalU64String"
				},
				"reportRevision": {
					"$ref": "#/$defs/decimalU64String"
				},
				"canonicalRevision": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			}
		},
		"agentLaunchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"generation": {
					"$ref": "#/$defs/hexId"
				},
				"hostEpoch": {
					"$ref": "#/$defs/hexId"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"agentProjectionCandidate": {
			"type": "object",
			"required": ["selector", "sessionId", "panelId", "binding"],
			"additionalProperties": false,
			"properties": {
				"selector": {
					"type": "string",
					"pattern": "^@agent:(?:[1-9]|[1-9][0-9]|[1-9][0-9]{2}|[1-3][0-9]{3}|40[0-8][0-9]|409[0-6])$"
				},
				"sessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"oneOf": [
						{
							"$ref": "#/$defs/hexId"
						},
						{
							"type": "null"
						}
					]
				},
				"binding": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentLaunchBinding"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"agentProjectionFailureDetails": {
			"type": "object",
			"required": ["stage", "reason"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-projection"
				},
				"reason": {
					"enum": [
						"unavailable",
						"denied",
						"changed",
						"invalid",
						"too-large",
						"timeout",
						"cancelled",
						"cursor-restart",
						"target-not-found",
						"target-ambiguous"
					]
				},
				"selector": {
					"type": "string"
				},
				"candidates": {
					"type": "array",
					"maxItems": 16,
					"items": {
						"$ref": "#/$defs/agentProjectionCandidate"
					}
				}
			}
		}
	}
}
