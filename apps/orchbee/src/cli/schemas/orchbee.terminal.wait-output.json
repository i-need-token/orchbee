{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.wait-output",
	"title": "orchbee terminal wait-output envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.wait-output"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": ["terminal", "matched", "match", "observed", "selection", "after"],
			"additionalProperties": false,
			"properties": {
				"terminal": {
					"$ref": "#/$defs/terminal"
				},
				"matched": {
					"const": true
				},
				"match": {
					"$ref": "#/$defs/match"
				},
				"observed": {
					"$ref": "#/$defs/observed"
				},
				"selection": {
					"anyOf": [
						{
							"type": "object",
							"required": ["source", "lines"],
							"additionalProperties": false,
							"properties": {
								"source": {
									"enum": ["visible", "recent", "recent-unwrapped", "detection"]
								},
								"lines": {
									"type": ["integer", "null"],
									"minimum": 0,
									"maximum": 1000
								}
							}
						},
						{
							"type": "null"
						}
					]
				},
				"after": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^o1:[0-9a-f]{32}:[0-9a-f]{32}:[1-9][0-9]*:[1-9][0-9]*:[0-9]+:[0-9]+$"
						},
						{
							"type": "null"
						}
					]
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				}
			}
		},
		"match": {
			"type": "object",
			"required": [
				"excerpt",
				"excerptTruncated",
				"excerptOffset",
				"matchOffset",
				"rowStart",
				"rowEnd",
				"revision",
				"generation",
				"patternKind",
				"matchLength",
				"matched",
				"matchedTruncated",
				"startsMidLine",
				"endsMidLine"
			],
			"additionalProperties": false,
			"properties": {
				"excerpt": {
					"type": "string"
				},
				"excerptTruncated": {
					"type": "boolean"
				},
				"excerptOffset": {
					"$ref": "#/$defs/decimal"
				},
				"matchOffset": {
					"$ref": "#/$defs/decimal"
				},
				"rowStart": {
					"$ref": "#/$defs/decimal"
				},
				"rowEnd": {
					"$ref": "#/$defs/decimal"
				},
				"revision": {
					"$ref": "#/$defs/decimal"
				},
				"generation": {
					"$ref": "#/$defs/positiveDecimal"
				},
				"patternKind": {
					"enum": ["literal", "regex"]
				},
				"matchLength": {
					"anyOf": [
						{
							"$ref": "#/$defs/decimal"
						},
						{
							"type": "null"
						}
					]
				},
				"matched": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"matchedTruncated": {
					"anyOf": [
						{
							"type": "boolean"
						},
						{
							"type": "null"
						}
					]
				},
				"startsMidLine": {
					"anyOf": [
						{
							"type": "boolean"
						},
						{
							"type": "null"
						}
					]
				},
				"endsMidLine": {
					"anyOf": [
						{
							"type": "boolean"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"if": {
				"properties": {
					"patternKind": {
						"const": "regex"
					}
				}
			},
			"then": {
				"properties": {
					"matchLength": {
						"$ref": "#/$defs/decimal"
					},
					"matched": {
						"type": "string"
					},
					"matchedTruncated": {
						"type": "boolean"
					},
					"startsMidLine": {
						"type": "boolean"
					},
					"endsMidLine": {
						"type": "boolean"
					}
				}
			},
			"else": {
				"properties": {
					"matchLength": {
						"type": "null"
					},
					"matched": {
						"type": "null"
					},
					"matchedTruncated": {
						"type": "null"
					},
					"startsMidLine": {
						"type": "null"
					},
					"endsMidLine": {
						"type": "null"
					}
				}
			}
		},
		"observed": {
			"type": "object",
			"required": [
				"attachmentId",
				"hostEpoch",
				"completedObservations",
				"windowStart",
				"windowRows",
				"windowTruncated",
				"totalRows",
				"requestedRows",
				"timeoutMs",
				"elapsedMs"
			],
			"additionalProperties": false,
			"properties": {
				"attachmentId": {
					"$ref": "#/$defs/id"
				},
				"hostEpoch": {
					"$ref": "#/$defs/id"
				},
				"completedObservations": {
					"type": "integer",
					"minimum": 0
				},
				"windowStart": {
					"$ref": "#/$defs/decimal"
				},
				"windowRows": {
					"$ref": "#/$defs/decimal"
				},
				"windowTruncated": {
					"type": "boolean"
				},
				"totalRows": {
					"$ref": "#/$defs/decimal"
				},
				"requestedRows": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"timeoutMs": {
					"type": ["integer", "null"],
					"minimum": 1,
					"maximum": 3600000
				},
				"elapsedMs": {
					"type": "integer",
					"minimum": 0
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "sessionId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		}
	}
}
