{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.status",
	"title": "orchbee status envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.status"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": ["session", "counts", "worker", "server"],
			"additionalProperties": false,
			"properties": {
				"session": {
					"type": "object",
					"required": ["reachable", "sessionId", "revision"],
					"additionalProperties": false,
					"properties": {
						"reachable": {
							"const": true
						},
						"sessionId": {
							"$ref": "#/$defs/id"
						},
						"revision": {
							"type": "string",
							"pattern": "^(0|[1-9][0-9]*)$"
						}
					}
				},
				"counts": {
					"type": "object",
					"required": ["projects", "workspaces", "tabs", "panels", "boundTerminals"],
					"additionalProperties": false,
					"properties": {
						"projects": {
							"type": "integer",
							"minimum": 0
						},
						"workspaces": {
							"type": "integer",
							"minimum": 0
						},
						"tabs": {
							"type": "integer",
							"minimum": 0
						},
						"panels": {
							"type": "integer",
							"minimum": 0
						},
						"boundTerminals": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				"worker": {
					"type": "object",
					"required": ["status", "reason"],
					"additionalProperties": false,
					"properties": {
						"status": {
							"const": "unknown"
						},
						"reason": {
							"const": "not-in-workbench-snapshot"
						}
					}
				},
				"terminalRuntime": {
					"description": "The Session's terminal-runtime state, absent from a Server without that read.",
					"enum": ["serving", "reconnecting", "given-up"]
				},
				"server": {
					"oneOf": [
						{
							"type": "object",
							"required": ["restartKeepsTerminals", "processes"],
							"additionalProperties": false,
							"properties": {
								"restartKeepsTerminals": {
									"type": ["boolean", "null"]
								},
								"processes": {
									"type": "array",
									"minItems": 1,
									"maxItems": 258,
									"items": {
										"$ref": "#/$defs/process"
									}
								}
							}
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				}
			}
		}
	},
	"$defs": {
		"version": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[!-~]+$"
		},
		"process": {
			"type": "object",
			"required": ["role", "version", "processId", "state", "terminals"],
			"additionalProperties": false,
			"properties": {
				"role": {
					"enum": ["server", "worker", "terminal-host", "unknown"]
				},
				"version": {
					"$ref": "#/$defs/version"
				},
				"processId": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"state": {
					"enum": ["ready", "draining", "stopping", "unknown"]
				},
				"terminals": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				}
			}
		},
		"unsupported": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "unsupported"
				}
			},
			"required": ["kind"],
			"additionalProperties": false
		},
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "sessionId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		}
	}
}
