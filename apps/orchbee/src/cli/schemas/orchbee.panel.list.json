{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.list",
	"title": "orchbee panel list envelope",
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "sessionId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"queryClient": {
			"type": "object",
			"properties": {
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"viewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"operationIds": {
					"type": "array",
					"minItems": 0,
					"maxItems": 262144,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/id"
					}
				},
				"view": {
					"$ref": "#/$defs/view"
				}
			},
			"required": ["clientId", "viewRevision", "operationIds", "view"],
			"additionalProperties": false
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"agentActivity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"agentClientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/agentHexId"
				},
				"operationId": {
					"$ref": "#/$defs/agentHexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/agentSafeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"error",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"if": {
				"properties": {
					"state": {
						"const": "current"
					}
				}
			},
			"then": {
				"properties": {
					"seen": {
						"type": "boolean"
					},
					"stateChangeRevision": {
						"$ref": "#/$defs/agentSafeInteger"
					}
				}
			},
			"else": {
				"properties": {
					"seen": {
						"type": "null"
					},
					"stateChangeRevision": {
						"type": "null"
					}
				}
			}
		},
		"agentExecutionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/agentOpaqueId"
				}
			}
		},
		"agentFidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"agentFreshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"agentHexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"agentObservation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/agentFidelity"
				},
				"freshness": {
					"$ref": "#/$defs/agentFreshness"
				},
				"generation": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"source": {
					"$ref": "#/$defs/agentObservationSource"
				}
			}
		},
		"agentObservationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"agentOpaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"agentPositiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"agentPresentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/agentOpaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/agentHexId"
				},
				"visibility": {
					"$ref": "#/$defs/agentVisibility"
				}
			}
		},
		"agentProviderId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"agentSafeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"agentSemanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/agentPositiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentActivity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/agentTurnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentActivity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"agentSessionSummary": {
			"type": "object",
			"required": [
				"executionLocation",
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"presentationAttachments",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"executionLocation": {
					"$ref": "#/$defs/agentExecutionLocation"
				},
				"lifecycle": {
					"const": "live"
				},
				"observation": {
					"$ref": "#/$defs/agentObservation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentOpaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"presentationAttachments": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/agentPresentationAttachment"
					}
				},
				"providerId": {
					"$ref": "#/$defs/agentProviderId"
				},
				"sessionId": {
					"$ref": "#/$defs/agentOpaqueId"
				},
				"status": {
					"$ref": "#/$defs/agentSemanticStatus"
				}
			}
		},
		"agentTurnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"agentVisibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"workbenchAgents": {
			"type": "object",
			"required": ["revision", "requestIds", "sessions"],
			"additionalProperties": false,
			"properties": {
				"revision": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"requestIds": {
					"type": "array",
					"minItems": 1,
					"maxItems": 12,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/agentHexId"
					}
				},
				"sessions": {
					"type": "array",
					"maxItems": 512,
					"items": {
						"type": "object",
						"required": ["session", "client"],
						"additionalProperties": false,
						"properties": {
							"session": {
								"$ref": "#/$defs/agentSessionSummary"
							},
							"client": {
								"oneOf": [
									{
										"$ref": "#/$defs/agentClientView"
									},
									{
										"type": "null"
									},
									{
										"$ref": "#/$defs/unsupported"
									}
								]
							}
						}
					}
				}
			}
		},
		"terminalProcessId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"terminalProcessPositiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminalProcessTerminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"workerId": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/terminalProcessId"
						},
						"panelId": {
							"$ref": "#/$defs/terminalProcessId"
						},
						"tabId": {
							"$ref": "#/$defs/terminalProcessId"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalProcessId"
						}
					}
				}
			}
		},
		"terminalProcessProcess": {
			"type": "object",
			"required": [
				"pid",
				"parentPid",
				"creationTime",
				"image",
				"commandLine",
				"currentDirectory",
				"argv",
				"providerId"
			],
			"additionalProperties": false,
			"properties": {
				"pid": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"parentPid": {
					"oneOf": [
						{
							"type": "integer",
							"minimum": 1,
							"maximum": 4294967295
						},
						{
							"type": "null"
						}
					]
				},
				"creationTime": {
					"$ref": "#/$defs/terminalProcessPositiveDecimal"
				},
				"image": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"commandLine": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"currentDirectory": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"argv": {
					"type": ["array", "null"],
					"maxItems": 4096,
					"items": {
						"type": "string",
						"maxLength": 4096,
						"pattern": "^[^\\u0000]*$"
					}
				},
				"providerId": {
					"type": ["string", "null"],
					"pattern": "^[0-9A-Za-z._:-]{1,128}$"
				}
			}
		},
		"terminalProcessSource": {
			"type": "object",
			"required": [
				"kind",
				"sessionId",
				"snapshotRevision",
				"requestId",
				"hostRequestId",
				"hostEpoch",
				"attachmentId",
				"hostTerminalId"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal-process-query"
				},
				"sessionId": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"snapshotRevision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"requestId": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"hostRequestId": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"hostEpoch": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"attachmentId": {
					"$ref": "#/$defs/terminalProcessId"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/terminalProcessId"
				}
			}
		},
		"terminalObservation": {
			"oneOf": [
				{
					"type": "object",
					"required": ["state"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unbound"
						}
					}
				},
				{
					"type": "object",
					"required": ["state", "reason"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"reason": {
							"const": "terminal-unavailable"
						}
					}
				},
				{
					"type": "object",
					"required": ["state", "frame", "processes"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "observed"
						},
						"frame": {
							"type": "object",
							"required": [
								"hostEpoch",
								"attachmentId",
								"sequence",
								"generation",
								"revision",
								"columns",
								"rows",
								"alternateScreen",
								"scrollbackRows",
								"title",
								"currentDirectory"
							],
							"additionalProperties": false,
							"properties": {
								"hostEpoch": {
									"$ref": "#/$defs/terminalProcessId"
								},
								"attachmentId": {
									"$ref": "#/$defs/terminalProcessId"
								},
								"sequence": {
									"type": "string",
									"pattern": "^[1-9][0-9]{0,19}$",
									"format": "orchbee-uint64"
								},
								"generation": {
									"type": "string",
									"pattern": "^[1-9][0-9]{0,19}$",
									"format": "orchbee-uint64"
								},
								"revision": {
									"type": "string",
									"pattern": "^(0|[1-9][0-9]{0,19})$",
									"format": "orchbee-uint64"
								},
								"columns": {
									"type": "integer",
									"minimum": 1,
									"maximum": 4096
								},
								"rows": {
									"type": "integer",
									"minimum": 1,
									"maximum": 4096
								},
								"alternateScreen": {
									"type": "boolean"
								},
								"scrollbackRows": {
									"type": "string",
									"pattern": "^(0|[1-9][0-9]{0,19})$",
									"format": "orchbee-uint64"
								},
								"title": {
									"type": ["string", "null"],
									"maxLength": 16384
								},
								"currentDirectory": {
									"type": ["string", "null"],
									"maxLength": 16384
								}
							}
						},
						"processes": {
							"oneOf": [
								{
									"type": "object",
									"required": ["state", "source", "result"],
									"additionalProperties": false,
									"properties": {
										"state": {
											"const": "observed"
										},
										"source": {
											"$ref": "#/$defs/terminalProcessSource"
										},
										"result": {
											"type": "object",
											"required": ["terminal", "scope", "rootPid", "processes", "foreground"],
											"additionalProperties": false,
											"properties": {
												"terminal": {
													"$ref": "#/$defs/terminalProcessTerminal"
												},
												"scope": {
													"const": "windows-job"
												},
												"rootPid": {
													"type": "integer",
													"minimum": 1,
													"maximum": 4294967295
												},
												"processes": {
													"type": "array",
													"maxItems": 64,
													"items": {
														"$ref": "#/$defs/terminalProcessProcess"
													}
												},
												"foreground": {
													"type": "object",
													"required": ["kind", "pid", "providerId"],
													"additionalProperties": false,
													"properties": {
														"kind": {
															"enum": ["agent-chain", "root", "ambiguous", "unavailable"]
														},
														"pid": {
															"type": ["integer", "null"],
															"minimum": 1,
															"maximum": 4294967295
														},
														"providerId": {
															"type": ["string", "null"],
															"pattern": "^[0-9A-Za-z._:-]{1,128}$"
														}
													},
													"oneOf": [
														{
															"properties": {
																"kind": {
																	"const": "agent-chain"
																},
																"pid": {
																	"type": "integer"
																},
																"providerId": {
																	"type": "string"
																}
															}
														},
														{
															"properties": {
																"kind": {
																	"const": "root"
																},
																"pid": {
																	"type": "integer"
																},
																"providerId": {
