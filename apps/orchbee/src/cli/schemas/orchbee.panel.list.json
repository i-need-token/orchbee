{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.list",
	"title": "orchbee panel list envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.panel.list"
		},
		"version": {
			"const": 4
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": ["panels"],
			"additionalProperties": false,
			"properties": {
				"panels": {
					"type": "array",
					"items": {
						"type": "object",
						"required": [
							"panelId",
							"rightClick",
							"tabId",
							"terminalContextId",
							"primaryPresentationId",
							"presentationCount",
							"primaryTerminalId",
							"workspaceId",
							"label",
							"customLabel",
							"displayLabel"
						],
						"additionalProperties": false,
						"properties": {
							"panelId": {
								"$ref": "#/$defs/id"
							},
							"rightClick": {
								"enum": ["orchbee", "panel"]
							},
							"tabId": {
								"$ref": "#/$defs/id"
							},
							"terminalContextId": {
								"$ref": "#/$defs/id"
							},
							"primaryPresentationId": {
								"$ref": "#/$defs/id"
							},
							"presentationCount": {
								"type": "integer",
								"minimum": 1
							},
							"primaryTerminalId": {
								"anyOf": [
									{
										"$ref": "#/$defs/id"
									},
									{
										"type": "null"
									}
								]
							},
							"workspaceId": {
								"anyOf": [
									{
										"$ref": "#/$defs/id"
									},
									{
										"type": "null"
									}
								]
							},
							"label": {
								"type": "string"
							},
							"customLabel": {
								"type": ["string", "null"]
							},
							"displayLabel": {
								"type": "string"
							},
							"focused": {
								"type": "boolean"
							}
						}
					}
				},
				"client": {
					"$ref": "#/$defs/queryClient"
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["client"],
						"type": "object"
					},
					"then": {
						"properties": {
							"panels": {
								"items": {
									"required": ["focused"],
									"type": "object"
								},
								"type": "array"
							}
						},
						"type": "object"
					},
					"else": {
						"properties": {
							"panels": {
								"items": {
									"not": {
										"anyOf": [
											{
												"required": ["focused"],
												"type": "object"
											}
										]
									},
									"type": "object"
								},
								"type": "array"
							}
						},
						"type": "object"
					}
				}
			]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"queryClient": {
			"type": "object",
			"properties": {
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"viewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"operationIds": {
					"type": "array",
					"minItems": 1,
					"maxItems": 8,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/id"
					}
				},
				"view": {
					"$ref": "#/$defs/view"
				}
			},
			"required": ["clientId", "viewRevision", "operationIds", "view"],
			"additionalProperties": false
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		}
	}
}
