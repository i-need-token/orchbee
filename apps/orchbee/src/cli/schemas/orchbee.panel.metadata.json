{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.metadata",
	"$defs": {
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"revision": {
			"type": "string",
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"maxLength": 20,
			"format": "orchbee-uint64"
		},
		"binding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["workerId", "terminalId"],
			"properties": {
				"workerId": {
					"$ref": "#/$defs/identity"
				},
				"terminalId": {
					"$ref": "#/$defs/identity"
				}
			}
		},
		"reported": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"workbenchRevision",
				"metadataRevision",
				"panelId",
				"binding",
				"disposition"
			],
			"properties": {
				"kind": {
					"const": "reported"
				},
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"metadataRevision": {
					"$ref": "#/$defs/revision"
				},
				"panelId": {
					"$ref": "#/$defs/identity"
				},
				"binding": {
					"$ref": "#/$defs/binding"
				},
				"disposition": {
					"enum": ["applied", "stale"]
				}
			}
		},
		"failed": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "reason"],
			"properties": {
				"kind": {
					"const": "failed"
				},
				"reason": {
					"enum": [
						"invalid-request",
						"site-mismatch",
						"not-found",
						"unbound",
						"binding-changed",
						"denied",
						"unavailable",
						"token-limit",
						"source-limit",
						"resource-limit",
						"revision-exhausted",
						"deadline-overflow",
						"result-too-large"
					]
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "protocolVersion", "requestId", "siteId", "outcome"],
			"properties": {
				"kind": {
					"const": "workbench.panel-metadata.result"
				},
				"protocolVersion": {
					"const": 1
				},
				"requestId": {
					"$ref": "#/$defs/identity"
				},
				"siteId": {
					"$ref": "#/$defs/identity"
				},
				"outcome": {
					"oneOf": [
						{
							"$ref": "#/$defs/reported"
						},
						{
							"$ref": "#/$defs/failed"
						},
						{
							"$ref": "#/$defs/presentationReported"
						}
					]
				}
			}
		},
		"presentationReported": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"kind",
				"workbenchRevision",
				"metadataRevision",
				"panelId",
				"binding",
				"disposition",
				"presentationId"
			],
			"properties": {
				"kind": {
					"const": "presentation-reported"
				},
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"metadataRevision": {
					"$ref": "#/$defs/revision"
				},
				"panelId": {
					"$ref": "#/$defs/identity"
				},
				"binding": {
					"$ref": "#/$defs/binding"
				},
				"disposition": {
					"enum": ["applied", "stale"]
				},
				"presentationId": {
					"$ref": "#/$defs/identity"
				}
			}
		}
	},
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.panel.metadata"
		},
		"version": {
			"const": 1
		},
		"requestId": {
			"$ref": "#/$defs/identity"
		},
		"siteId": {
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"$ref": "#/$defs/identity"
		},
		"interrupted": {
			"type": "boolean"
		},
		"cleanupFailed": {
			"type": "boolean"
		},
		"observation": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "server"
						},
						"reply": {
							"$ref": "#/$defs/result"
						}
					},
					"required": ["kind", "reply"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"reason": {
							"enum": [
								"request-write",
								"response-read",
								"response-deadline",
								"response-correlation",
								"response-protocol"
							]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"presentationId": {
			"anyOf": [
				{
					"$ref": "#/$defs/identity"
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": [
		"schema",
		"version",
		"requestId",
		"siteId",
		"panelId",
		"interrupted",
		"cleanupFailed",
		"observation",
		"presentationId"
	],
	"additionalProperties": false
}
