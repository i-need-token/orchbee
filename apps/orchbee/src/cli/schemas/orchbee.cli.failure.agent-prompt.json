{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.agent-prompt",
	"title": "orchbee.cli.failure.agent-prompt",
	"type": "object",
	"required": ["schema", "version", "failure"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.cli.failure.agent-prompt"
		},
		"version": {
			"const": 1
		},
		"source": {
			"oneOf": [
				{
					"$ref": "#/$defs/sendSource"
				},
				{
					"$ref": "#/$defs/agentReadSource"
				}
			]
		},
		"failure": {}
	},
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"sendReceipt": {
			"title": "orchbee terminal send result envelope",
			"type": "object",
			"required": ["schema", "version", "source", "result"],
			"additionalProperties": false,
			"properties": {
				"schema": {
					"const": "orchbee.terminal.send"
				},
				"version": {
					"const": 1
				},
				"source": {
					"$ref": "#/$defs/sendReceipt/$defs/sendSource"
				},
				"result": {
					"type": "object",
					"required": [
						"action",
						"requestId",
						"siteId",
						"workerId",
						"terminalId",
						"inputStatus",
						"cleanupStatus",
						"payloadKind",
						"records",
						"recordsAccepted",
						"firstStoppedRecord",
						"acceptedEncodedBytes"
					],
					"additionalProperties": false,
					"properties": {
						"action": {
							"const": "terminal.send"
						},
						"requestId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"siteId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"workerId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"terminalId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"payloadKind": {
							"enum": ["text", "key", "bytes", "paste", "sequence"]
						},
						"recordBytes": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1048576
						},
						"inputStatus": {
							"enum": ["accepted", "not-submitted", "rejected", "unknown", "partial-accepted"]
						},
						"cleanupStatus": {
							"enum": ["not-needed", "confirmed", "unconfirmed"]
						},
						"reason": {
							"enum": [
								"host-input-backpressure",
								"host-input-invalid",
								"host-input-limit-exceeded",
								"host-input-unavailable",
								"host-protocol-fault",
								"host-rejected",
								"host-unavailable",
								"server-busy",
								"stale-host-epoch",
								"stale-worker-generation",
								"terminal-runtime-unavailable",
								"terminal-unavailable",
								"worker-unavailable",
								"input-budget-exhausted"
							]
						},
						"target": {
							"type": "object",
							"required": ["workerGeneration", "hostEpoch", "hostTerminalId"],
							"additionalProperties": false,
							"properties": {
								"workerGeneration": {
									"type": "string",
									"pattern": "^[1-9][0-9]*$"
								},
								"hostEpoch": {
									"$ref": "#/$defs/sendReceipt/$defs/id"
								},
								"hostTerminalId": {
									"$ref": "#/$defs/sendReceipt/$defs/id"
								}
							}
						},
						"records": {
							"type": "integer",
							"minimum": 1,
							"maximum": 64
						},
						"recordsAccepted": {
							"type": "integer",
							"minimum": 0,
							"maximum": 64
						},
						"firstStoppedRecord": {
							"type": "integer",
							"minimum": 0,
							"maximum": 64
						},
						"acceptedEncodedBytes": {
							"type": "integer",
							"minimum": 0,
							"maximum": 67108864
						}
					},
					"if": {
						"properties": {
							"inputStatus": {
								"enum": ["not-submitted", "rejected", "partial-accepted"]
							}
						},
						"required": ["inputStatus"]
					},
					"then": {
						"required": ["reason"]
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"inputStatus": {
										"enum": ["accepted", "unknown"]
									}
								},
								"required": ["inputStatus"]
							},
							"then": {
								"required": ["target"]
							}
						},
						{
							"if": {
								"properties": {
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								},
								"required": ["cleanupStatus"]
							},
							"then": {
								"required": ["target"]
							}
						},
						{
							"if": {
								"properties": {
									"payloadKind": {
										"enum": ["text", "bytes", "paste"]
									}
								},
								"required": ["payloadKind"]
							},
							"then": {
								"required": ["recordBytes"]
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "partial-accepted"
									}
								}
							},
							"then": {
								"required": ["target"],
								"properties": {
									"recordsAccepted": {
										"minimum": 1
									},
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "accepted"
									}
								}
							},
							"then": {
								"properties": {
									"recordsAccepted": {
										"minimum": 1
									},
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "unknown"
									}
								}
							},
							"then": {
								"properties": {
									"cleanupStatus": {
										"enum": ["not-needed", "unconfirmed"]
									}
								}
							}
						}
					]
				}
			},
			"$defs": {
				"id": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"sendSource": {
					"type": "object",
					"required": ["kind", "siteId", "requestId", "snapshotRevision"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal.send"
						},
						"siteId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"requestId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"snapshotRevision": {
							"type": "string",
							"pattern": "^(0|[1-9][0-9]*)$"
						}
					}
				}
			}
		},
		"sendSource": {
			"type": "object",
			"required": ["kind", "siteId", "requestId", "snapshotRevision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal.send"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"requestId": {
					"$ref": "#/$defs/id"
				},
				"snapshotRevision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"canonicalFailure": {
			"type": "object",
			"required": ["kind", "details"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"rejected",
						"not-found",
						"cancelled",
						"timeout",
						"service-unavailable",
						"transport-loss",
						"protocol-invalid",
						"internal-failure",
						"denied"
					]
				},
				"details": {
					"type": "object",
					"required": ["stage", "reason"],
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "agent-prompt"
						},
						"reason": {
							"enum": [
								"agent-blocked",
								"agent-launch-pending",
								"agent-not-ready",
								"cancelled",
								"signal-finalization-failed",
								"interrupted",
								"wait-deadline",
								"prompt-stalled",
								"read-deadline",
								"wait-read-failed",
								"session-ended",
								"history-lost",
								"cursor-invalid",
								"client-read-failed"
							]
						},
						"sessionId": {
							"$ref": "#/$defs/opaqueId"
						},
						"submission": {
							"$ref": "#/$defs/sendReceipt"
						},
						"clientId": {
							"$ref": "#/$defs/hexId"
						}
					}
				}
			}
		},
		"physical_terminalBinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/physical_identity"
				},
				"generation": {
					"$ref": "#/$defs/physical_identity"
				},
				"hostEpoch": {
					"$ref": "#/$defs/physical_identity"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/physical_identity"
				}
			}
		},
		"physical_identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"terminalTarget": {
			"type": "object",
			"required": ["kind", "binding"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal"
				},
				"binding": {
					"$ref": "#/$defs/physical_terminalBinding"
				}
			}
		},
		"terminalFailure": {
			"type": "object",
			"required": ["kind", "details"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"cancelled",
						"denied",
						"internal-failure",
						"not-found",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"timeout",
						"transport-loss",
						"output-too-large"
					]
				},
				"details": {
					"type": "object",
					"required": ["stage", "reason", "target", "submission"],
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "agent-prompt"
						},
						"reason": {
							"enum": [
								"history-lost",
								"cursor-invalid",
								"binding-changed",
								"read-failed",
								"read-deadline",
								"wait-deadline",
								"effect-deadline",
								"interrupted",
								"client-observation-unavailable",
								"canonical-condition-required",
								"agent-not-running",
								"revision-ahead",
								"agent-identity-changed",
								"agent-blocked",
								"agent-runtime-ambiguous",
								"agent-provider-mismatch",
								"agent-provider-unsupported",
								"output-too-large",
								"wait-read-failed",
								"cancelled",
								"signal-finalization-failed"
							]
						},
						"target": {
							"$ref": "#/$defs/terminalTarget"
						},
						"submission": {
							"$ref": "#/$defs/sendReceipt"
						}
					}
				}
			}
		}
	},
	"if": {
		"properties": {
			"failure": {
				"properties": {
					"details": {
						"required": ["target"]
					}
				},
				"required": ["details"]
			}
		},
		"required": ["failure"]
	},
	"then": {
		"required": ["source"],
		"properties": {
			"failure": {
				"$ref": "#/$defs/terminalFailure"
			},
			"source": {
				"$ref": "#/$defs/sendSource"
			}
		}
	},
	"else": {
		"properties": {
			"failure": {
				"$ref": "#/$defs/canonicalFailure"
			}
		}
	}
}
