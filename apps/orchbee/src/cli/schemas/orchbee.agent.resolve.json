{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.resolve",
	"title": "orchbee agent resolve envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.resolve"
		},
		"version": {
			"enum": [1, 2, 3]
		},
		"source": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-names"
				},
				"requestId": {
					"$ref": "#/$defs/obapRequestId"
				}
			}
		},
		"result": {
			"anyOf": [
				{
					"type": "object",
					"required": ["kind", "sessionId", "resolvedBy"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "resolved"
						},
						"sessionId": {
							"$ref": "#/$defs/sessionId"
						},
						"resolvedBy": {
							"enum": ["session-id", "name", "presentation"]
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "target", "resolvedBy"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "resolved-target"
						},
						"target": {
							"$ref": "#/$defs/nameTarget"
						},
						"resolvedBy": {
							"enum": ["session-id", "name", "presentation"]
						}
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"target": {
										"properties": {
											"kind": {
												"const": "terminal"
											}
										}
									}
								}
							},
							"then": {
								"properties": {
									"resolvedBy": {
										"enum": ["name", "presentation"]
									}
								}
							}
						}
					]
				}
			]
		}
	},
	"$defs": {
		"agentName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]{0,31}$"
		},
		"sessionId": {
			"$ref": "#/$defs/opaqueIdentity"
		},
		"opaqueIdentity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._:-]{1,128}$"
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"$comment": "Request identity: exactly 32 lowercase hexadecimal characters and never the zero sentinel; the nonzero rule is a semantic invariant enforced by each binding."
		},
		"nameTarget": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind", "sessionId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "session"
						},
						"sessionId": {
							"$ref": "#/$defs/sessionId"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "binding"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal"
						},
						"binding": {
							"$ref": "#/$defs/launchBinding"
						}
					}
				}
			]
		},
		"namedTarget": {
			"type": "object",
			"required": ["name", "target"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"$ref": "#/$defs/agentName"
				},
				"target": {
					"$ref": "#/$defs/nameTarget"
				}
			}
		},
		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"const": 1
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"resolvedBy": {
								"enum": ["session-id", "name"]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"const": 3
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"anyOf": [
							{
								"type": "object",
								"required": ["kind", "target", "resolvedBy"],
								"additionalProperties": false,
								"properties": {
									"kind": {
										"const": "resolved-target"
									},
									"target": {
										"$ref": "#/$defs/nameTarget"
									},
									"resolvedBy": {
										"enum": ["session-id", "name", "presentation"]
									}
								},
								"allOf": [
									{
										"if": {
											"properties": {
												"target": {
													"properties": {
														"kind": {
															"const": "terminal"
														}
													}
												}
											}
										},
										"then": {
											"properties": {
												"resolvedBy": {
													"enum": ["name", "presentation"]
												}
											}
										}
									}
								]
							}
						]
					}
				}
			},
			"else": {
				"properties": {
					"result": {
						"anyOf": [
							{
								"type": "object",
								"required": ["kind", "sessionId", "resolvedBy"],
								"additionalProperties": false,
								"properties": {
									"kind": {
										"const": "resolved"
									},
									"sessionId": {
										"$ref": "#/$defs/sessionId"
									},
									"resolvedBy": {
										"enum": ["session-id", "name", "presentation"]
									}
								}
							}
						]
					}
				}
			}
		}
	]
}
