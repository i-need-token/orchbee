{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.resolve",
	"title": "orchbee agent resolve envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.resolve"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-names"
				},
				"requestId": {
					"$ref": "#/$defs/obapRequestId"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["kind", "target", "resolvedBy"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "resolved-target"
				},
				"target": {
					"$ref": "#/$defs/nameTarget"
				},
				"resolvedBy": {
					"enum": ["session-id", "name", "presentation"]
				}
			},
			"if": {
				"properties": {
					"target": {
						"properties": {
							"kind": {
								"const": "terminal"
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"resolvedBy": {
						"enum": ["name", "presentation"]
					}
				}
			}
		}
	},
	"$defs": {
		"sessionId": {
			"$ref": "#/$defs/opaqueIdentity"
		},
		"opaqueIdentity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._:-]{1,128}$"
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"nameTarget": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind", "sessionId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "session"
						},
						"sessionId": {
							"$ref": "#/$defs/sessionId"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "binding"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal"
						},
						"binding": {
							"$ref": "#/$defs/launchBinding"
						}
					}
				}
			]
		},
		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		}
	}
}
