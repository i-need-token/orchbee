{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.get",
	"title": "orchbee agent get envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.get"
		},
		"version": {
			"enum": [1, 2, 3, 4, 5, 6]
		},
		"source": {
			"$ref": "#/$defs/agentReadSource"
		},
		"result": {
			"type": "object",
			"required": ["kind", "revision", "session"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "found"
				},
				"revision": {
					"$ref": "#/$defs/safeInteger"
				},
				"session": {
					"$ref": "#/$defs/sessionDetail"
				},
				"client": {
					"$ref": "#/$defs/clientView"
				},
				"runtime": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "unavailable"
								},
								"reason": {
									"enum": ["session-ended", "unbound", "ambiguous-primary", "binding-changed"]
								}
							},
							"required": ["kind", "reason"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "observed"
								},
								"source": {
									"$ref": "#/$defs/runtimeProcess_source"
								},
								"processInfo": {
									"type": "object",
									"required": ["terminal", "scope", "rootPid", "processes", "foreground"],
									"additionalProperties": false,
									"properties": {
										"terminal": {
											"$ref": "#/$defs/runtimeProcess_terminal"
										},
										"scope": {
											"const": "windows-job"
										},
										"rootPid": {
											"type": "integer",
											"minimum": 1,
											"maximum": 4294967295
										},
										"processes": {
											"type": "array",
											"maxItems": 64,
											"items": {
												"$ref": "#/$defs/runtimeProcess_process"
											}
										},
										"foreground": {
											"type": "object",
											"required": ["kind", "pid", "providerId"],
											"additionalProperties": false,
											"properties": {
												"kind": {
													"enum": ["agent-chain", "root", "ambiguous", "unavailable"]
												},
												"pid": {
													"type": ["integer", "null"],
													"minimum": 1,
													"maximum": 4294967295
												},
												"providerId": {
													"type": ["string", "null"],
													"pattern": "^[0-9A-Za-z._:-]{1,128}$"
												}
											},
											"oneOf": [
												{
													"properties": {
														"kind": {
															"const": "agent-chain"
														},
														"pid": {
															"type": "integer"
														},
														"providerId": {
															"type": "string"
														}
													}
												},
												{
													"properties": {
														"kind": {
															"const": "root"
														},
														"pid": {
															"type": "integer"
														},
														"providerId": {
															"type": "null"
														}
													}
												},
												{
													"properties": {
														"kind": {
															"const": "ambiguous"
														},
														"pid": {
															"type": "null"
														},
														"providerId": {
															"type": "null"
														}
													}
												},
												{
													"properties": {
														"kind": {
															"const": "unavailable"
														},
														"pid": {
															"type": "null"
														},
														"providerId": {
															"type": "null"
														}
													}
												}
											]
										}
									}
								},
								"promptReady": {
									"type": "boolean"
								}
							},
							"required": ["kind", "source", "processInfo", "promptReady"],
							"additionalProperties": false
						}
					]
				},
				"management": {
					"type": "object",
					"required": ["source", "revision", "state"],
					"additionalProperties": false,
					"properties": {
						"source": {
							"$ref": "#/$defs/agentReadSource"
						},
						"revision": {
							"$ref": "#/$defs/safeInteger"
						},
						"state": {
							"$ref": "#/$defs/managed_agentManagement"
						}
					}
				}
			}
		}
	},
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"capability": {
			"enum": [
				"activity",
				"approvals",
				"authentication",
				"progress",
				"questions",
				"sessionLifecycle",
				"subagents",
				"turnLifecycle"
			]
		},
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"visibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"fidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"freshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"turnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"attentionKind": {
			"enum": ["approval", "authentication", "question", "unclassified"]
		},
		"outcomeKind": {
			"enum": ["canceled", "failed", "interrupted", "succeeded"]
		},
		"lifecycle": {
			"enum": ["ended", "live"]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				}
			}
		},
		"turnState": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activity", "phase", "turnId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "active"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						},
						"turnId": {
							"$ref": "#/$defs/opaqueId"
						}
					}
				}
			]
		},
		"attentionRequest": {
			"type": "object",
			"required": ["actionPath", "kind", "requestId", "turnId"],
			"additionalProperties": false,
			"properties": {
				"actionPath": {
					"const": "navigate-only"
				},
				"kind": {
					"$ref": "#/$defs/attentionKind"
				},
				"requestId": {
					"$ref": "#/$defs/opaqueId"
				},
				"turnId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"turnOutcome": {
			"type": "object",
			"required": ["eventId", "kind", "turnId"],
			"additionalProperties": false,
			"properties": {
				"eventId": {
					"$ref": "#/$defs/opaqueId"
				},
				"kind": {
					"$ref": "#/$defs/outcomeKind"
				},
				"turnId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/positiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"sessionDetail": {
			"type": "object",
			"required": ["snapshot", "status"],
			"additionalProperties": false,
			"properties": {
				"snapshot": {
					"type": "object",
					"required": [
						"activityHint",
						"capabilities",
						"executionLocation",
						"lastOutcome",
						"lifecycle",
						"observation",
						"parentSessionId",
						"pendingRequests",
						"presentationAttachments",
						"providerId",
						"sessionId",
						"turn"
					],
					"additionalProperties": false,
					"properties": {
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"capabilities": {
							"type": "array",
							"maxItems": 10,
							"items": {
								"$ref": "#/$defs/capability"
							},
							"uniqueItems": true
						},
						"executionLocation": {
							"$ref": "#/$defs/executionLocation"
						},
						"lastOutcome": {
							"oneOf": [
								{
									"$ref": "#/$defs/turnOutcome"
								},
								{
									"type": "null"
								}
							]
						},
						"lifecycle": {
							"$ref": "#/$defs/lifecycle"
						},
						"observation": {
							"$ref": "#/$defs/observation"
						},
						"parentSessionId": {
							"oneOf": [
								{
									"$ref": "#/$defs/opaqueId"
								},
								{
									"type": "null"
								}
							]
						},
						"pendingRequests": {
							"type": "array",
							"maxItems": 128,
							"items": {
								"$ref": "#/$defs/attentionRequest"
							}
						},
						"presentationAttachments": {
							"type": "array",
							"maxItems": 32,
							"items": {
								"$ref": "#/$defs/presentationAttachment"
							}
						},
						"providerId": {
							"$ref": "#/$defs/providerId"
						},
						"sessionId": {
							"$ref": "#/$defs/opaqueId"
						},
						"turn": {
							"$ref": "#/$defs/turnState"
						}
					}
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				}
			}
		},
		"clientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/hexId"
				},
				"operationId": {
					"$ref": "#/$defs/hexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/safeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/safeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "current"
							}
						}
					},
					"then": {
						"properties": {
							"seen": {
								"type": "boolean"
							},
							"stateChangeRevision": {
								"$ref": "#/$defs/safeInteger"
							}
						}
					},
					"else": {
						"properties": {
							"seen": {
								"type": "null"
							},
							"stateChangeRevision": {
								"type": "null"
							}
						}
					}
				}
			]
		},
		"runtimeProcess_id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"runtimeProcess_positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"runtimeProcess_terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"workerId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/runtimeProcess_id"
						},
						"panelId": {
							"$ref": "#/$defs/runtimeProcess_id"
						},
						"tabId": {
							"$ref": "#/$defs/runtimeProcess_id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/runtimeProcess_id"
						}
					}
				}
			}
		},
		"runtimeProcess_snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"siteId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"runtimeProcess_process": {
			"type": "object",
			"required": [
				"pid",
				"parentPid",
				"creationTime",
				"image",
				"commandLine",
				"currentDirectory",
				"argv",
				"providerId"
			],
			"additionalProperties": false,
			"properties": {
				"pid": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"parentPid": {
					"oneOf": [
						{
							"type": "integer",
							"minimum": 1,
							"maximum": 4294967295
						},
						{
							"type": "null"
						}
					]
				},
				"creationTime": {
					"$ref": "#/$defs/runtimeProcess_positiveDecimal"
				},
				"image": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"commandLine": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"currentDirectory": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"argv": {
					"type": ["array", "null"],
					"maxItems": 4096,
					"items": {
						"type": "string",
						"maxLength": 4096,
						"pattern": "^[^\\u0000]*$"
					}
				},
				"providerId": {
					"type": ["string", "null"],
					"pattern": "^[0-9A-Za-z._:-]{1,128}$"
				}
			}
		},
		"runtimeProcess_source": {
			"type": "object",
			"required": [
				"kind",
				"siteId",
				"snapshotRevision",
				"requestId",
				"hostRequestId",
				"hostEpoch",
				"attachmentId",
				"hostTerminalId"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal-process-query"
				},
				"siteId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"snapshotRevision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"requestId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"hostRequestId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"hostEpoch": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"attachmentId": {
					"$ref": "#/$defs/runtimeProcess_id"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/runtimeProcess_id"
				}
			}
		},
		"managed_agentManagement": {
			"oneOf": [
				{
					"type": "object",
					"required": ["phase"],
					"additionalProperties": false,
					"properties": {
						"phase": {
							"const": "unmanaged"
						}
					}
				},
				{
					"type": "object",
					"required": ["phase", "reservation", "blocked"],
					"additionalProperties": false,
					"properties": {
						"phase": {
							"const": "pending"
						},
						"reservation": {
							"$ref": "#/$defs/managed_launchReservation"
						},
						"blocked": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"required": ["phase", "reservationId", "providerId", "binding"],
					"additionalProperties": false,
					"properties": {
						"phase": {
							"const": "active"
						},
						"reservationId": {
							"$ref": "#/$defs/managed_obapRequestId"
						},
						"providerId": {
							"$ref": "#/$defs/managed_providerId"
						},
						"binding": {
							"$ref": "#/$defs/managed_launchBinding"
						}
					}
				}
			]
		},
		"managed_launchReservation": {
			"type": "object",
			"required": [
				"reservationId",
				"name",
				"providerId",
				"binding",
				"remainingMs",
				"settleRemainingMs"
			],
			"additionalProperties": false,
			"properties": {
				"reservationId": {
					"$ref": "#/$defs/managed_obapRequestId"
				},
				"name": {
					"$ref": "#/$defs/managed_agentName"
				},
				"providerId": {
					"$ref": "#/$defs/managed_providerId"
				},
				"binding": {
					"$ref": "#/$defs/managed_launchBinding"
				},
				"remainingMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 300000
				},
				"settleRemainingMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3000
				}
			}
		},
		"managed_obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"$comment": "Request identity: exactly 32 lowercase hexadecimal characters and never the zero sentinel; the nonzero rule is a semantic invariant enforced by each binding."
		},
		"managed_agentName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]{0,31}$"
		},
		"managed_providerId": {
			"type": "string",
			"pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
			"maxLength": 64
		},
		"managed_launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"enum": [2, 4, 6]
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"required": ["client"]
					}
				}
			},
			"else": {
				"properties": {
					"result": {
						"not": {
							"required": ["client"]
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"enum": [3, 4, 5, 6]
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"required": ["runtime"]
					}
				}
			},
			"else": {
				"properties": {
					"result": {
						"not": {
							"required": ["runtime"]
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"enum": [5, 6]
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"required": ["management"]
					}
				}
			},
			"else": {
				"properties": {
					"result": {
						"not": {
							"required": ["management"]
						}
					}
				}
			}
		}
	]
}
