{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.workspace.get",
	"title": "orchbee workspace get envelope",
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"queryClient": {
			"type": "object",
			"properties": {
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"viewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"operationIds": {
					"type": "array",
					"minItems": 1,
					"maxItems": 8,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/id"
					}
				},
				"view": {
					"$ref": "#/$defs/view"
				}
			},
			"required": ["clientId", "viewRevision", "operationIds", "view"],
			"additionalProperties": false
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"agentActivity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"agentClientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/agentHexId"
				},
				"operationId": {
					"$ref": "#/$defs/agentHexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/agentSafeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"error",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"if": {
				"properties": {
					"state": {
						"const": "current"
					}
				}
			},
			"then": {
				"properties": {
					"seen": {
						"type": "boolean"
					},
					"stateChangeRevision": {
						"$ref": "#/$defs/agentSafeInteger"
					}
				}
			},
			"else": {
				"properties": {
					"seen": {
						"type": "null"
					},
					"stateChangeRevision": {
						"type": "null"
					}
				}
			}
		},
		"agentExecutionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/agentOpaqueId"
				}
			}
		},
		"agentFidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"agentFreshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"agentHexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"agentObservation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/agentFidelity"
				},
				"freshness": {
					"$ref": "#/$defs/agentFreshness"
				},
				"generation": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"source": {
					"$ref": "#/$defs/agentObservationSource"
				}
			}
		},
		"agentObservationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"agentOpaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"agentPositiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"agentPresentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/agentOpaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/agentHexId"
				},
				"visibility": {
					"$ref": "#/$defs/agentVisibility"
				}
			}
		},
		"agentProviderId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"agentSafeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"agentSemanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/agentPositiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentActivity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/agentTurnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentActivity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"agentSessionSummary": {
			"type": "object",
			"required": [
				"executionLocation",
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"presentationAttachments",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"executionLocation": {
					"$ref": "#/$defs/agentExecutionLocation"
				},
				"lifecycle": {
					"const": "live"
				},
				"observation": {
					"$ref": "#/$defs/agentObservation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentOpaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"presentationAttachments": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/agentPresentationAttachment"
					}
				},
				"providerId": {
					"$ref": "#/$defs/agentProviderId"
				},
				"sessionId": {
					"$ref": "#/$defs/agentOpaqueId"
				},
				"status": {
					"$ref": "#/$defs/agentSemanticStatus"
				}
			}
		},
		"agentTurnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"agentVisibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"workbenchAgents": {
			"type": "object",
			"required": ["revision", "requestIds", "sessions"],
			"additionalProperties": false,
			"properties": {
				"revision": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"requestIds": {
					"type": "array",
					"minItems": 1,
					"maxItems": 12,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/agentHexId"
					}
				},
				"sessions": {
					"type": "array",
					"maxItems": 512,
					"items": {
						"type": "object",
						"required": ["session", "client"],
						"additionalProperties": false,
						"properties": {
							"session": {
								"$ref": "#/$defs/agentSessionSummary"
							},
							"client": {
								"oneOf": [
									{
										"$ref": "#/$defs/agentClientView"
									},
									{
										"type": "null"
									},
									{
										"$ref": "#/$defs/unsupported"
									}
								]
							}
						}
					}
				}
			}
		},
		"worktreeDirectoryPath": {
			"title": "WorkbenchDirectoryPath",
			"type": "string",
			"minLength": 1,
			"maxLength": 4096,
			"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$"
		},
		"worktreeUnavailableReason": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unsupported"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["server-busy", "worker-unavailable", "job-dead", "job-unknown"]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "git-failed"
						},
						"stage": {
							"enum": ["probe", "list"]
						},
						"status": {
							"anyOf": [
								{
									"type": "integer",
									"minimum": -2147483648,
									"maximum": 2147483647
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "stage", "status"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "owner-io"
						},
						"stage": {
							"anyOf": [
								{
									"enum": ["probe", "list"]
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "stage"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "too-large"
						},
						"origin": {
							"enum": ["git-probe", "git-list", "worker-result", "workbench-result"]
						}
					},
					"required": ["kind", "origin"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "spawn-unavailable"
						},
						"stage": {
							"enum": ["probe", "list"]
						}
					},
					"required": ["kind", "stage"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "spawn-failed"
						},
						"stage": {
							"enum": ["probe", "list"]
						}
					},
					"required": ["kind", "stage"],
					"additionalProperties": false
				}
			]
		},
		"workspaceWorktree": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"repositoryRoot": {
					"$ref": "#/$defs/worktreeDirectoryPath"
				},
				"commonDirectory": {
					"$ref": "#/$defs/worktreeDirectoryPath"
				},
				"repositoryName": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				},
				"checkoutPath": {
					"$ref": "#/$defs/worktreeDirectoryPath"
				},
				"linked": {
					"type": "boolean"
				}
			},
			"required": [
				"workerId",
				"repositoryRoot",
				"commonDirectory",
				"repositoryName",
				"checkoutPath",
				"linked"
			]
		},
		"worktreeObservation": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "no-directory"
						}
					},
					"required": ["state"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"requestId": {
							"$ref": "#/$defs/id"
						},
						"reason": {
							"$ref": "#/$defs/worktreeUnavailableReason"
						}
					},
					"required": ["state", "requestId", "reason"]
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "observed"
						},
						"source": {
							"type": "object",
							"additionalProperties": false,
							"properties": {
								"kind": {
									"const": "worktree-query"
								},
								"requestId": {
									"$ref": "#/$defs/id"
								},
								"siteId": {
									"$ref": "#/$defs/id"
								},
								"workbenchRevision": {
									"$ref": "#/$defs/revision"
								}
							},
							"required": ["kind", "requestId", "siteId", "workbenchRevision"]
						}
					},
					"required": ["state", "source"]
				}
			]
		},
		"metadataKey": {
			"type": "string",
			"pattern": "^[a-zA-Z0-9_-]{1,32}$(?![\\s\\S])"
		},
		"metadataValue": {
			"type": "string",
			"minLength": 1,
			"maxLength": 80,
			"not": {
				"pattern": "[^\\u0020-\\u007e\\u00a0-\\uD7FF\\uE000-\\uFFFF𐀀-􏿿]"
			},
			"allOf": [
				{
					"not": {
						"pattern": "^[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$"
					}
				}
			]
		},
		"metadataTokens": {
			"type": "object",
			"maxProperties": 32,
			"propertyNames": {
				"$ref": "#/$defs/metadataKey"
			},
			"additionalProperties": {
				"$ref": "#/$defs/metadataValue"
			}
		},
		"metadataSource": {
			"type": "object",
			"properties": {
				"siteId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"workbenchRevision": {
					"type": "string",
					"pattern": "^(?:0|[1-9][0-9]{0,19})$",
					"maxLength": 20,
					"format": "orchbee-uint64"
				},
				"metadataRevision": {
					"type": "string",
					"pattern": "^(?:0|[1-9][0-9]{0,19})$",
					"maxLength": 20,
					"format": "orchbee-uint64"
				},
				"requestIds": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": {
						"type": "string",
						"pattern": "^[0-9a-f]{32}$",
						"not": {
							"const": "00000000000000000000000000000000"
						}
					}
				}
			},
			"required": ["siteId", "workbenchRevision", "metadataRevision", "requestIds"],
			"additionalProperties": false
		},
		"unsupported": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "unsupported"
				}
			},
			"required": ["kind"],
			"additionalProperties": false
		}
	},
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.workspace.get"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": ["workspace", "client", "agents", "metadataSource"],
			"additionalProperties": false,
			"properties": {
				"workspace": {
					"type": "object",
					"required": [
						"workspaceId",
						"label",
						"projectId",
						"primaryDirectoryId",
						"terminalContextId",
						"tabs",
						"number",
						"panelCount",
						"tabCount",
						"focused",
						"activeTabId",
						"agentSessionIds",
						"agentStatus",
						"worktree",
						"worktreeObservation",
						"tokens"
					],
					"additionalProperties": false,
					"properties": {
						"workspaceId": {
							"$ref": "#/$defs/id"
						},
						"label": {
