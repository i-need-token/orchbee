{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.workspace.close-status",
	"title": "orchbee workspace close-status result envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.workspace.close-status"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/source"
		},
		"result": {
			"oneOf": [{ "$ref": "#/$defs/notClosing" }, { "$ref": "#/$defs/available" }]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"revision": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"generation": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"notClosing": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "not-closing"
				}
			}
		},
		"available": {
			"type": "object",
			"required": [
				"kind",
				"closeRequestId",
				"projectId",
				"workspaceId",
				"terminalContextId",
				"attemptGeneration",
				"status",
				"counts",
				"members"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "available"
				},
				"closeRequestId": {
					"$ref": "#/$defs/id"
				},
				"projectId": {
					"$ref": "#/$defs/id"
				},
				"workspaceId": {
					"$ref": "#/$defs/id"
				},
				"terminalContextId": {
					"$ref": "#/$defs/id"
				},
				"attemptGeneration": {
					"$ref": "#/$defs/generation"
				},
				"status": {
					"$ref": "#/$defs/scopeStatus"
				},
				"counts": {
					"type": "object",
					"required": [
						"closing",
						"cleanupBlocked",
						"outcomeUnknown",
						"disposedAwaitingPublication"
					],
					"additionalProperties": false,
					"properties": {
						"closing": { "type": "integer", "minimum": 0 },
						"cleanupBlocked": { "type": "integer", "minimum": 0 },
						"outcomeUnknown": { "type": "integer", "minimum": 0 },
						"disposedAwaitingPublication": {
							"type": "integer",
							"minimum": 0
						}
					}
				},
				"members": {
					"type": "array",
					"maxItems": 4096,
					"items": {
						"type": "object",
						"required": ["tabId", "panelId", "presentationId", "status"],
						"additionalProperties": false,
						"properties": {
							"tabId": {
								"$ref": "#/$defs/id"
							},
							"panelId": {
								"$ref": "#/$defs/id"
							},
							"presentationId": {
								"$ref": "#/$defs/id"
							},
							"status": {
								"$ref": "#/$defs/memberStatus"
							}
						}
					}
				}
			}
		},
		"scopeStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"properties": {
						"kind": { "const": "closing" },
						"phase": {
							"$ref": "#/$defs/closingPhase"
						}
					},
					"required": ["phase"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "cleanup-blocked" },
						"reason": {
							"$ref": "#/$defs/blockedReason"
						},
						"resumable": { "type": "boolean" }
					},
					"required": ["reason", "resumable"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "outcome-unknown" },
						"phase": {
							"$ref": "#/$defs/unknownPhase"
						},
						"reason": {
							"$ref": "#/$defs/unknownReason"
						}
					},
					"required": ["phase", "reason"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "disposed-awaiting-publication" },
						"reason": {
							"$ref": "#/$defs/publicationReason"
						},
						"resumable": { "type": "boolean" }
					},
					"required": ["reason", "resumable"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "closed" },
						"revision": {
							"$ref": "#/$defs/revision"
						}
					},
					"required": ["revision"],
					"additionalProperties": false
				}
			]
		},
		"memberStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"properties": {
						"kind": { "const": "closing" },
						"phase": {
							"$ref": "#/$defs/closingPhase"
						}
					},
					"required": ["phase"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "cleanup-blocked" },
						"reason": {
							"$ref": "#/$defs/blockedReason"
						},
						"resumable": { "type": "boolean" }
					},
					"required": ["reason", "resumable"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "outcome-unknown" },
						"phase": {
							"$ref": "#/$defs/unknownPhase"
						},
						"reason": {
							"$ref": "#/$defs/unknownReason"
						}
					},
					"required": ["phase", "reason"],
					"additionalProperties": false
				},
				{
					"properties": {
						"kind": { "const": "disposed-awaiting-publication" },
						"reason": {
							"$ref": "#/$defs/publicationReason"
						},
						"resumable": { "type": "boolean" }
					},
					"required": ["reason", "resumable"],
					"additionalProperties": false
				}
			]
		},
		"closingPhase": {
			"enum": ["queued", "waiting-grace", "waiting-outcome", "disposing"]
		},
		"unknownPhase": {
			"enum": ["terminate", "force", "dispose"]
		},
		"blockedReason": {
			"enum": [
				"worker-unavailable",
				"host-refused",
				"cleanup-incomplete",
				"inventory-incomplete",
				"identity-conflict",
				"continuation-budget-exhausted",
				"resume-generation-exhausted"
			]
		},
		"unknownReason": {
			"enum": ["transport-lost", "deadline", "invalid-response"]
		},
		"publicationReason": {
			"enum": ["target-cleanup-pending", "preparing", "preparation-failed", "authority-retired"]
		},
		"source": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"$ref": "#/$defs/revision"
				}
			}
		}
	}
}
