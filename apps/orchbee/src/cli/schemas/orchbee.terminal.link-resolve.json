{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.link-resolve",
	"title": "orchbee.terminal.link-resolve",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.link-resolve"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"terminal",
				"contentRevision",
				"contentGeneration",
				"hostEpoch",
				"origin",
				"offsetFromBottom",
				"viewportStartRow",
				"kind",
				"url",
				"regions"
			],
			"properties": {
				"terminal": {
					"$ref": "#/$defs/terminal"
				},
				"contentRevision": {
					"$ref": "#/$defs/decimal"
				},
				"contentGeneration": {
					"$ref": "#/$defs/positiveDecimal"
				},
				"hostEpoch": {
					"$ref": "#/$defs/id"
				},
				"origin": {
					"$ref": "#/$defs/point"
				},
				"offsetFromBottom": {
					"$ref": "#/$defs/decimal"
				},
				"viewportStartRow": {
					"$ref": "#/$defs/decimal"
				},
				"kind": {
					"enum": ["none", "plain-text", "explicit"]
				},
				"url": {
					"type": ["string", "null"],
					"maxLength": 8388608
				},
				"regions": {
					"type": "array",
					"maxItems": 8192,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["row", "startCol", "endCol"],
						"properties": {
							"row": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"startCol": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							},
							"endCol": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"kind": {
								"const": "none"
							}
						}
					},
					"then": {
						"properties": {
							"url": {
								"type": "null"
							},
							"regions": {
								"maxItems": 0
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"kind": {
								"const": "explicit"
							}
						}
					},
					"then": {
						"properties": {
							"url": {
								"type": "string"
							},
							"regions": {
								"maxItems": 0
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"kind": {
								"const": "plain-text"
							}
						}
					},
					"then": {
						"properties": {
							"url": {
								"type": "string",
								"pattern": "^https?://"
							},
							"regions": {
								"minItems": 1
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"point": {
			"type": "object",
			"required": ["row", "col"],
			"additionalProperties": false,
			"properties": {
				"row": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"col": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			}
		}
	}
}
