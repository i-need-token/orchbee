{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.integrations",
	"title": "orchbee agent integration list envelope",
	"description": "Historical closed provider envelopes and the current canonical public provider vocabulary.",
	"$defs": {
		"publicProvider_item": {
			"type": "object",
			"required": ["integrationId", "availability", "managementMode", "state", "issue"],
			"additionalProperties": false,
			"properties": {
				"integrationId": {
					"enum": [
						"claude-code",
						"codex",
						"grok",
						"opencode",
						"kilo",
						"cursor",
						"qodercli",
						"antigravity",
						"mastracode",
						"droid",
						"kimi",
						"letta",
						"devin",
						"hermes",
						"pi",
						"omp",
						"gemini",
						"github-copilot",
						"cline",
						"qwen-code"
					]
				},
				"availability": {
					"enum": ["available", "not-found", "unknown"]
				},
				"managementMode": {
					"enum": ["managed-local", "manual-only"]
				},
				"state": {
					"enum": ["conflict", "disabled", "enabled", "not-installed", "update-required", "unknown"]
				},
				"issue": {
					"enum": [
						"inspection-failed",
						"manual-action-required",
						"unsupported-platform",
						"unsupported-version",
						null
					]
				}
			}
		},
		"publicProvider_capsule": {
			"type": "object",
			"required": ["state", "source", "payloadSha256"],
			"additionalProperties": false,
			"properties": {
				"state": {
					"enum": ["ready", "not-ready", "source-absent", "binding-failed"]
				},
				"source": {
					"enum": ["cohort-sidecar", "adapter-source-override", "absent"]
				},
				"bindingFailure": {
					"const": true
				},
				"rootPath": {
					"type": "string",
					"minLength": 1
				},
				"rootPathBytesHex": {
					"type": "string",
					"pattern": "^([0-9a-f]{2})+$"
				},
				"payloadSha256": {
					"type": "string",
					"pattern": "^[0-9a-f]{64}$"
				}
			}
		}
	},
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.integrations"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-inspection"
				}
			}
		},
		"result": {
			"type": "object",
			"required": [
				"complete",
				"capsule",
				"integrations",
				"outdatedOnly",
				"inspectedCount",
				"unresolvedProviderIds",
				"blockedProviderIds"
			],
			"additionalProperties": false,
			"properties": {
				"complete": {
					"type": "boolean"
				},
				"capsule": {
					"$ref": "#/$defs/publicProvider_capsule"
				},
				"integrations": {
					"type": "array",
					"maxItems": 20,
					"items": {
						"$ref": "#/$defs/publicProvider_item"
					}
				},
				"outdatedOnly": {
					"type": "boolean"
				},
				"inspectedCount": {
					"type": "integer",
					"minimum": 1,
					"maximum": 20
				},
				"unresolvedProviderIds": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/publicProvider_item/properties/integrationId"
					}
				},
				"blockedProviderIds": {
					"type": "array",
					"maxItems": 20,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/publicProvider_item/properties/integrationId"
					}
				}
			}
		}
	}
}
