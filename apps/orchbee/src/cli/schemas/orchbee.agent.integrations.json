{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.integrations",
	"title": "orchbee agent integration list envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.integrations"
		},
		"version": {
			"enum": [1, 2]
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-inspection"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["complete", "capsule", "integrations"],
			"additionalProperties": false,
			"properties": {
				"complete": {
					"type": "boolean"
				},
				"capsule": {
					"$ref": "#/$defs/capsule"
				},
				"integrations": {
					"type": "array",
					"maxItems": 13,
					"items": {
						"$ref": "#/$defs/item"
					}
				},
				"outdatedOnly": {
					"const": true
				},
				"inspectedCount": {
					"type": "integer",
					"minimum": 1,
					"maximum": 11
				},
				"unresolvedProviderIds": {
					"type": "array",
					"maxItems": 13,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/item/properties/integrationId"
					}
				},
				"blockedProviderIds": {
					"type": "array",
					"maxItems": 13,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/item/properties/integrationId"
					}
				}
			}
		}
	},
	"$defs": {
		"item": {
			"type": "object",
			"required": ["integrationId", "availability", "managementMode", "state", "issue"],
			"additionalProperties": false,
			"properties": {
				"integrationId": {
					"enum": [
						"claude-code",
						"codex",
						"grok",
						"opencode",
						"kilo",
						"cursor",
						"qodercli",
						"pi",
						"omp",
						"gemini",
						"github-copilot",
						"cline",
						"qwen-code"
					]
				},
				"availability": {
					"enum": ["available", "not-found", "unknown"]
				},
				"managementMode": {
					"enum": ["managed-local", "manual-only"]
				},
				"state": {
					"enum": [
						"conflict",
						"disabled",
						"enabled",
						"not-installed",
						"stale-side",
						"update-required",
						"unknown"
					]
				},
				"issue": {
					"enum": [
						"capsule-unsupported-version",
						"inspection-failed",
						"manual-action-required",
						"unsupported-platform",
						"unsupported-version",
						null
					]
				}
			}
		},
		"capsule": {
			"type": "object",
			"required": ["state", "source", "supportedPayloadVersion"],
			"additionalProperties": false,
			"properties": {
				"state": {
					"enum": ["ready", "not-ready", "unsupported-version", "source-absent", "binding-failed"]
				},
				"source": {
					"enum": ["cohort-sidecar", "adapter-source-override", "absent"]
				},
				"supportedPayloadVersion": {
					"type": "string",
					"minLength": 1
				},
				"declaredPayloadVersion": {
					"type": "string",
					"minLength": 1
				},
				"unsupportedPayloadVersion": {
					"type": "string",
					"minLength": 1
				},
				"bindingFailure": {
					"const": true
				},
				"rootPath": {
					"type": "string",
					"minLength": 1
				},
				"rootPathBytesHex": {
					"type": "string",
					"pattern": "^([0-9a-f]{2})+$"
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"const": 2
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"required": [
							"outdatedOnly",
							"inspectedCount",
							"unresolvedProviderIds",
							"blockedProviderIds"
						],
						"properties": {
							"integrations": {
								"items": {
									"properties": {
										"state": {
											"const": "update-required"
										}
									}
								}
							}
						}
					}
				}
			},
			"else": {
				"properties": {
					"result": {
						"not": {
							"anyOf": [
								{
									"required": ["outdatedOnly"]
								},
								{
									"required": ["inspectedCount"]
								},
								{
									"required": ["unresolvedProviderIds"]
								},
								{
									"required": ["blockedProviderIds"]
								}
							]
						}
					}
				}
			}
		}
	]
}
