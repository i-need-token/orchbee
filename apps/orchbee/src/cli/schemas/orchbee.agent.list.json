{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.list",
	"title": "orchbee agent list envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.list"
		},
		"version": {
			"enum": [1, 2]
		},
		"source": {
			"$ref": "#/$defs/agentReadSource"
		},
		"result": {
			"type": "object",
			"required": ["kind", "revision", "items", "nextCursor"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "listed"
				},
				"revision": {
					"$ref": "#/$defs/safeInteger"
				},
				"items": {
					"type": "array",
					"maxItems": 100,
					"items": {
						"$ref": "#/$defs/sessionSummary"
					}
				},
				"nextCursor": {
					"oneOf": [
						{
							"$ref": "#/$defs/cursor"
						},
						{
							"type": "null"
						}
					]
				},
				"clientId": {
					"$ref": "#/$defs/hexId"
				}
			}
		}
	},
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"cursor": {
			"type": "string",
			"pattern": "^v1\\.[A-Za-z0-9_-]{59}\\.[A-Za-z0-9_-]{43}$"
		},
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"visibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"fidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"freshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"turnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"lifecycle": {
			"enum": ["ended", "live"]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				}
			}
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/positiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"sessionSummary": {
			"type": "object",
			"required": [
				"executionLocation",
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"presentationAttachments",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"executionLocation": {
					"$ref": "#/$defs/executionLocation"
				},
				"lifecycle": {
					"$ref": "#/$defs/lifecycle"
				},
				"observation": {
					"$ref": "#/$defs/observation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"presentationAttachments": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/presentationAttachment"
					}
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				},
				"client": {
					"$ref": "#/$defs/clientView"
				}
			}
		},
		"clientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/hexId"
				},
				"operationId": {
					"$ref": "#/$defs/hexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/safeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/safeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "current"
							}
						}
					},
					"then": {
						"properties": {
							"seen": {
								"type": "boolean"
							},
							"stateChangeRevision": {
								"$ref": "#/$defs/safeInteger"
							}
						}
					},
					"else": {
						"properties": {
							"seen": {
								"type": "null"
							},
							"stateChangeRevision": {
								"type": "null"
							}
						}
					}
				}
			]
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"const": 2
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"required": ["clientId"],
						"properties": {
							"items": {
								"items": {
									"required": ["client"]
								}
							}
						}
					}
				}
			},
			"else": {
				"properties": {
					"result": {
						"not": {
							"required": ["clientId"]
						},
						"properties": {
							"items": {
								"items": {
									"not": {
										"required": ["client"]
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
