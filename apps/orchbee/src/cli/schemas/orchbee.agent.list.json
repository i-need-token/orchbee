{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.list",
	"title": "orchbee agent list envelope",
	"$comment": "Version 1 preserves the non-Windows canonical list. Windows version 2 is the bounded joined Agent projection; client facets stay separate from semantic status.",
	"oneOf": [
		{
			"type": "object",
			"required": ["schema", "version", "source", "result"],
			"additionalProperties": false,
			"properties": {
				"schema": {
					"const": "orchbee.agent.list"
				},
				"version": {
					"const": 1
				},
				"source": {
					"$ref": "#/$defs/agentReadSource"
				},
				"result": {
					"type": "object",
					"required": ["kind", "revision", "items", "nextCursor"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "listed"
						},
						"revision": {
							"$ref": "#/$defs/safeInteger"
						},
						"items": {
							"type": "array",
							"maxItems": 100,
							"items": {
								"allOf": [
									{
										"$ref": "#/$defs/legacyAgentState_sessionSummary"
									},
									{
										"not": {
											"required": ["client"]
										}
									}
								]
							}
						},
						"nextCursor": {
							"oneOf": [
								{
									"$ref": "#/$defs/cursor"
								},
								{
									"type": "null"
								}
							]
						}
					}
				}
			}
		},
		{
			"type": "object",
			"required": ["schema", "version", "source", "result"],
			"additionalProperties": false,
			"properties": {
				"schema": {
					"const": "orchbee.agent.list"
				},
				"version": {
					"const": 2
				},
				"source": {
					"$ref": "#/$defs/agentProjectionSource"
				},
				"result": {
					"type": "object",
					"required": ["kind", "revision", "items", "nextCursor"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "listed"
						},
						"revision": {
							"$ref": "#/$defs/safeInteger"
						},
						"items": {
							"type": "array",
							"maxItems": 100,
							"items": {
								"$ref": "#/$defs/agentProjectionRow"
							}
						},
						"nextCursor": {
							"oneOf": [
								{
									"$ref": "#/$defs/projectionCursor"
								},
								{
									"type": "null"
								}
							]
						},
						"clientId": {
							"$ref": "#/$defs/hexId"
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"result": {
								"required": ["clientId"]
							}
						}
					},
					"then": {
						"properties": {
							"result": {
								"properties": {
									"items": {
										"items": {
											"required": ["client"]
										}
									}
								}
							}
						}
					},
					"else": {
						"properties": {
							"result": {
								"not": {
									"required": ["clientId"]
								},
								"properties": {
									"items": {
										"items": {
											"not": {
												"required": ["client"]
											}
										}
									}
								}
							}
						}
					}
				}
			]
		}
	],
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"cursor": {
			"type": "string",
			"pattern": "^v1\\.[A-Za-z0-9_-]{59}\\.[A-Za-z0-9_-]{43}$"
		},
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"visibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"fidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"freshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"turnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"lifecycle": {
			"enum": ["ended", "live"]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				}
			}
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/positiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"sessionSummary": {
			"type": "object",
			"required": [
				"executionLocation",
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"presentationAttachments",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"executionLocation": {
					"$ref": "#/$defs/executionLocation"
				},
				"lifecycle": {
					"$ref": "#/$defs/lifecycle"
				},
				"observation": {
					"$ref": "#/$defs/observation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"presentationAttachments": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/presentationAttachment"
					}
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				},
				"client": {
					"$ref": "#/$defs/clientView"
				}
			}
		},
		"clientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/hexId"
				},
				"operationId": {
					"$ref": "#/$defs/hexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/safeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/safeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"error",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "current"
							}
						}
					},
					"then": {
						"properties": {
							"seen": {
								"type": "boolean"
							},
							"stateChangeRevision": {
								"$ref": "#/$defs/safeInteger"
							}
						}
					},
					"else": {
						"properties": {
							"seen": {
								"type": "null"
							},
							"stateChangeRevision": {
								"type": "null"
							}
						}
					}
				}
			]
		},
		"legacyAgentState_clientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/hexId"
				},
				"operationId": {
					"$ref": "#/$defs/hexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/safeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/safeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "current"
							}
						}
					},
					"then": {
						"properties": {
							"seen": {
								"type": "boolean"
							},
							"stateChangeRevision": {
								"$ref": "#/$defs/safeInteger"
							}
						}
					},
					"else": {
						"properties": {
							"seen": {
								"type": "null"
							},
							"stateChangeRevision": {
								"type": "null"
							}
						}
					}
				}
			]
		},
		"legacyAgentState_sessionSummary": {
			"type": "object",
			"required": [
				"executionLocation",
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"presentationAttachments",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"executionLocation": {
					"$ref": "#/$defs/executionLocation"
				},
				"lifecycle": {
					"$ref": "#/$defs/lifecycle"
				},
				"observation": {
					"$ref": "#/$defs/observation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"presentationAttachments": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/presentationAttachment"
					}
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				},
				"client": {
					"$ref": "#/$defs/legacyAgentState_clientView"
				}
			}
		},
		"agentProjectionSource": {
			"type": "object",
			"required": ["kind", "siteId", "workbenchRevision", "reportRevision", "canonicalRevision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-projection"
				},
				"siteId": {
					"$ref": "#/$defs/hexId"
				},
				"workbenchRevision": {
					"$ref": "#/$defs/decimalU64String"
				},
				"reportRevision": {
					"$ref": "#/$defs/decimalU64String"
				},
				"canonicalRevision": {
					"$ref": "#/$defs/safeInteger"
				}
			}
		},
		"decimalU64String": {
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"projectionCursor": {
			"type": "string",
			"maxLength": 1024,
			"pattern": "^u1\\.[A-Za-z0-9_-]+$"
		},
		"projectionCanonicalSummary": {
			"allOf": [
				{
					"$ref": "#/$defs/sessionSummary"
				},
				{
					"not": {
						"required": ["client"]
					}
				}
			]
		},
		"agentProjectionTerminal": {
			"type": "object",
			"required": ["binding", "provider", "state", "sequence"],
			"additionalProperties": false,
			"properties": {
				"binding": {
					"$ref": "#/$defs/agentLaunchBinding"
				},
				"provider": {
					"type": "string",
					"minLength": 1
				},
				"state": {
					"$ref": "#/$defs/panelAgentState"
				},
				"sequence": {
					"$ref": "#/$defs/decimalU64String"
				}
			}
		},
		"agentLaunchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"hostEpoch": {
					"$ref": "#/$defs/hexId"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"panelAgentState": {
			"enum": ["done", "error", "idle", "blocked", "working", "unknown"]
		},
		"agentProjectionPlacement": {
			"type": "object",
			"required": [
				"panelId",
				"presentationId",
				"terminalId",
				"terminalContextId",
				"workspaceId",
				"tabId"
			],
			"additionalProperties": false,
			"properties": {
				"panelId": {
					"$ref": "#/$defs/hexId"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"terminalId": {
					"$ref": "#/$defs/hexId"
				},
				"terminalContextId": {
					"$ref": "#/$defs/hexId"
				},
				"workspaceId": {
					"oneOf": [
						{
							"$ref": "#/$defs/hexId"
						},
						{
							"type": "null"
						}
					]
				},
				"tabId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"terminalClientRevision": {
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"terminalClientPhase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"terminalClientSelection": {
			"type": "object",
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false,
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/hexId"
				},
				"tabId": {
					"oneOf": [
						{
							"$ref": "#/$defs/hexId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"oneOf": [
						{
							"$ref": "#/$defs/hexId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			}
		},
		"terminalClientView": {
			"type": "object",
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false,
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/terminalClientRevision"
				},
				"phase": {
					"$ref": "#/$defs/terminalClientPhase"
				},
				"selection": {
					"oneOf": [
						{
							"$ref": "#/$defs/terminalClientSelection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"oneOf": [
						{
							"$ref": "#/$defs/terminalClientRevision"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"terminalClientProjection": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"view",
				"reportRevision",
				"sequence",
				"seen",
				"status",
				"outerFocused"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/hexId"
				},
				"operationId": {
					"$ref": "#/$defs/hexId"
				},
				"view": {
					"$ref": "#/$defs/terminalClientView"
				},
				"reportRevision": {
					"$ref": "#/$defs/terminalClientRevision"
				},
				"sequence": {
					"oneOf": [
						{
							"$ref": "#/$defs/terminalClientRevision"
						},
						{
							"type": "null"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [null, "idle", "done", "error", "working", "blocked", "unknown"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				}
			}
		},
		"agentProjectionClient": {
			"type": "object",
			"required": ["canonical", "terminal"],
			"additionalProperties": false,
			"properties": {
				"canonical": {
					"oneOf": [
						{
							"$ref": "#/$defs/clientView"
						},
						{
							"type": "null"
						}
					]
				},
				"terminal": {
					"oneOf": [
						{
							"$ref": "#/$defs/terminalClientProjection"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"agentProjectionRow": {
			"type": "object",
			"required": [
				"ordinal",
				"provider",
				"status",
				"source",
				"canonical",
				"terminal",
				"placement",
				"cwd"
			],
			"additionalProperties": false,
			"properties": {
				"ordinal": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"provider": {
					"type": "string",
					"minLength": 1
				},
				"status": {
					"enum": ["unknown", "idle", "working", "blocked", "done", "error", "ended"]
				},
				"source": {
					"enum": ["canonical", "terminal", "both"]
				},
				"canonical": {
					"oneOf": [
						{
							"$ref": "#/$defs/projectionCanonicalSummary"
						},
						{
							"type": "null"
						}
					]
				},
				"terminal": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentProjectionTerminal"
						},
						{
							"type": "null"
						}
					]
				},
				"placement": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentProjectionPlacement"
						},
						{
							"type": "null"
						}
					]
				},
				"cwd": {
					"type": ["string", "null"]
				},
				"client": {
					"$ref": "#/$defs/agentProjectionClient"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"source": {
								"const": "canonical"
							}
						}
					},
					"then": {
						"properties": {
							"canonical": {
								"$ref": "#/$defs/projectionCanonicalSummary"
							},
							"terminal": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"source": {
								"const": "terminal"
							}
						}
					},
					"then": {
						"required": ["placement"],
						"properties": {
							"canonical": {
								"type": "null"
							},
							"terminal": {
								"$ref": "#/$defs/agentProjectionTerminal"
							},
							"placement": {
								"$ref": "#/$defs/agentProjectionPlacement"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"source": {
								"const": "both"
							}
						}
					},
					"then": {
						"required": ["placement"],
						"properties": {
							"canonical": {
								"$ref": "#/$defs/projectionCanonicalSummary"
							},
							"terminal": {
								"$ref": "#/$defs/agentProjectionTerminal"
							},
							"placement": {
								"$ref": "#/$defs/agentProjectionPlacement"
							}
						}
					}
				}
			]
		}
	}
}
