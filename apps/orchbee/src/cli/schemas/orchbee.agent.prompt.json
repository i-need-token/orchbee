{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.prompt",
	"title": "orchbee.agent.prompt",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.prompt"
		},
		"version": {
			"enum": [2, 3, 4]
		},
		"source": {
			"$ref": "#/$defs/sendSource"
		},
		"result": {
			"type": "object",
			"required": ["sessionId", "submission", "observation", "wait"],
			"additionalProperties": false,
			"properties": {
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"submission": {
					"$ref": "#/$defs/sendReceipt"
				},
				"observation": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"required": ["source", "revision", "session"],
							"additionalProperties": false,
							"properties": {
								"source": {
									"$ref": "#/$defs/agentReadSource"
								},
								"revision": {
									"$ref": "#/$defs/safeInteger"
								},
								"session": {
									"$ref": "#/$defs/sessionDetail"
								}
							}
						}
					]
				},
				"wait": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"required": [
								"matchedConditions",
								"timeoutMs",
								"observations",
								"elapsedMs",
								"activityObserved"
							],
							"additionalProperties": false,
							"properties": {
								"matchedConditions": {
									"type": "array",
									"minItems": 1,
									"maxItems": 14,
									"uniqueItems": true,
									"items": {
										"$ref": "#/$defs/waitCondition"
									}
								},
								"timeoutMs": {
									"type": ["integer", "null"],
									"minimum": 1,
									"maximum": 3600000
								},
								"observations": {
									"type": "integer",
									"minimum": 1
								},
								"elapsedMs": {
									"type": "integer",
									"minimum": 0
								},
								"activityObserved": {
									"const": true
								}
							}
						}
					]
				},
				"matchedChange": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"properties": {
								"source": {
									"$ref": "#/$defs/agentReadSource"
								},
								"change": {
									"$ref": "#/$defs/change"
								}
							},
							"required": ["source", "change"],
							"additionalProperties": false
						}
					]
				},
				"client": {
					"$ref": "#/$defs/clientView"
				}
			}
		}
	},
	"$defs": {
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"attentionKind": {
			"enum": ["approval", "authentication", "question", "unclassified"]
		},
		"attentionRequest": {
			"type": "object",
			"required": ["actionPath", "kind", "requestId", "turnId"],
			"additionalProperties": false,
			"properties": {
				"actionPath": {
					"const": "navigate-only"
				},
				"kind": {
					"$ref": "#/$defs/attentionKind"
				},
				"requestId": {
					"$ref": "#/$defs/opaqueId"
				},
				"turnId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"capability": {
			"enum": [
				"activity",
				"approvals",
				"authentication",
				"progress",
				"questions",
				"sessionLifecycle",
				"subagents",
				"turnLifecycle"
			]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"fidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"freshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"lifecycle": {
			"enum": ["ended", "live"]
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				}
			}
		},
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"outcomeKind": {
			"enum": ["canceled", "failed", "interrupted", "succeeded"]
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/positiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"sendReceipt": {
			"type": "object",
			"required": ["schema", "version", "source", "result"],
			"additionalProperties": false,
			"properties": {
				"schema": {
					"const": "orchbee.terminal.send"
				},
				"version": {
					"const": 1
				},
				"source": {
					"$ref": "#/$defs/sendSource"
				},
				"result": {
					"type": "object",
					"required": [
						"action",
						"requestId",
						"siteId",
						"workerId",
						"terminalId",
						"inputStatus",
						"cleanupStatus",
						"payloadKind",
						"records",
						"recordsAccepted",
						"firstStoppedRecord",
						"acceptedEncodedBytes"
					],
					"additionalProperties": false,
					"properties": {
						"action": {
							"const": "terminal.send"
						},
						"requestId": {
							"$ref": "#/$defs/id"
						},
						"siteId": {
							"$ref": "#/$defs/id"
						},
						"workerId": {
							"$ref": "#/$defs/id"
						},
						"terminalId": {
							"$ref": "#/$defs/id"
						},
						"payloadKind": {
							"enum": ["text", "key", "bytes", "paste", "sequence"]
						},
						"recordBytes": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1048576
						},
						"inputStatus": {
							"enum": ["accepted", "not-submitted", "rejected", "unknown", "partial-accepted"]
						},
						"cleanupStatus": {
							"enum": ["not-needed", "confirmed", "unconfirmed"]
						},
						"reason": {
							"enum": [
								"host-input-backpressure",
								"host-input-invalid",
								"host-input-limit-exceeded",
								"host-input-unavailable",
								"host-protocol-fault",
								"host-rejected",
								"host-unavailable",
								"server-busy",
								"stale-host-epoch",
								"stale-worker-generation",
								"terminal-runtime-unavailable",
								"terminal-unavailable",
								"worker-unavailable",
								"input-budget-exhausted"
							]
						},
						"target": {
							"type": "object",
							"required": ["workerGeneration", "hostEpoch", "hostTerminalId"],
							"additionalProperties": false,
							"properties": {
								"workerGeneration": {
									"type": "string",
									"pattern": "^[1-9][0-9]*$"
								},
								"hostEpoch": {
									"$ref": "#/$defs/id"
								},
								"hostTerminalId": {
									"$ref": "#/$defs/id"
								}
							}
						},
						"records": {
							"type": "integer",
							"minimum": 1,
							"maximum": 64
						},
						"recordsAccepted": {
							"type": "integer",
							"minimum": 0,
							"maximum": 64
						},
						"firstStoppedRecord": {
							"type": "integer",
							"minimum": 0,
							"maximum": 64
						},
						"acceptedEncodedBytes": {
							"type": "integer",
							"minimum": 0,
							"maximum": 67108864
						}
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"inputStatus": {
										"enum": ["not-submitted", "rejected", "partial-accepted"]
									}
								},
								"required": ["inputStatus"]
							},
							"then": {
								"required": ["reason"]
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"enum": ["accepted", "unknown"]
									}
								},
								"required": ["inputStatus"]
							},
							"then": {
								"required": ["target"]
							}
						},
						{
							"if": {
								"properties": {
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								},
								"required": ["cleanupStatus"]
							},
							"then": {
								"required": ["target"]
							}
						},
						{
							"if": {
								"properties": {
									"payloadKind": {
										"enum": ["text", "bytes", "paste"]
									}
								},
								"required": ["payloadKind"]
							},
							"then": {
								"required": ["recordBytes"]
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "partial-accepted"
									}
								}
							},
							"then": {
								"required": ["target"],
								"properties": {
									"recordsAccepted": {
										"minimum": 1
									},
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "accepted"
									}
								}
							},
							"then": {
								"properties": {
									"recordsAccepted": {
										"minimum": 1
									},
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "unknown"
									}
								}
							},
							"then": {
								"properties": {
									"cleanupStatus": {
										"enum": ["not-needed", "unconfirmed"]
									}
								}
							}
						}
					]
				}
			}
		},
		"sendSource": {
			"type": "object",
			"required": ["kind", "siteId", "requestId", "snapshotRevision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal.send"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"requestId": {
					"$ref": "#/$defs/id"
				},
				"snapshotRevision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"sessionDetail": {
			"type": "object",
			"required": ["snapshot", "status"],
			"additionalProperties": false,
			"properties": {
				"snapshot": {
					"type": "object",
					"required": [
						"activityHint",
						"capabilities",
						"executionLocation",
						"lastOutcome",
						"lifecycle",
						"observation",
						"parentSessionId",
						"pendingRequests",
						"presentationAttachments",
						"providerId",
						"sessionId",
						"turn"
					],
					"additionalProperties": false,
					"properties": {
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"capabilities": {
							"type": "array",
							"maxItems": 10,
							"items": {
								"$ref": "#/$defs/capability"
							},
							"uniqueItems": true
						},
						"executionLocation": {
							"$ref": "#/$defs/executionLocation"
						},
						"lastOutcome": {
							"oneOf": [
								{
									"$ref": "#/$defs/turnOutcome"
								},
								{
									"type": "null"
								}
							]
						},
						"lifecycle": {
							"$ref": "#/$defs/lifecycle"
						},
						"observation": {
							"$ref": "#/$defs/observation"
						},
						"parentSessionId": {
							"oneOf": [
								{
									"$ref": "#/$defs/opaqueId"
								},
								{
									"type": "null"
								}
							]
						},
						"pendingRequests": {
							"type": "array",
							"maxItems": 128,
							"items": {
								"$ref": "#/$defs/attentionRequest"
							}
						},
						"presentationAttachments": {
							"type": "array",
							"maxItems": 32,
							"items": {
								"$ref": "#/$defs/presentationAttachment"
							}
						},
						"providerId": {
							"$ref": "#/$defs/providerId"
						},
						"sessionId": {
							"$ref": "#/$defs/opaqueId"
						},
						"turn": {
							"$ref": "#/$defs/turnState"
						}
					}
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				}
			}
		},
		"turnOutcome": {
			"type": "object",
			"required": ["eventId", "kind", "turnId"],
			"additionalProperties": false,
			"properties": {
				"eventId": {
					"$ref": "#/$defs/opaqueId"
				},
				"kind": {
					"$ref": "#/$defs/outcomeKind"
				},
				"turnId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"turnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"turnState": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activity", "phase", "turnId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "active"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						},
						"turnId": {
							"$ref": "#/$defs/opaqueId"
						}
					}
				}
			]
		},
		"visibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"waitCondition": {
			"enum": [
				"needs-attention",
				"failed",
				"succeeded",
				"canceled",
				"interrupted",
				"working",
				"idle",
				"unknown",
				"ended",
				"fresh",
				"stale",
				"disconnected",
				"blocked",
				"done"
			]
		},
		"change": {
			"type": "object",
			"required": ["revision", "transition", "session"],
			"additionalProperties": false,
			"properties": {
				"revision": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9007199254740991
				},
				"transition": {
					"enum": [
						"session-observed",
						"turn-started",
						"turn-activity-changed",
						"limited-activity-observed",
						"attention-requested",
						"attention-resolved",
						"turn-finished",
						"session-idle-observed",
						"observation-became-stale",
						"observation-reconnected",
						"presentation-attached",
						"presentation-visibility-changed",
						"presentation-detached",
						"session-ended"
					]
				},
				"session": {
					"$ref": "#/$defs/changeSession"
				}
			}
		},
		"changeSession": {
			"type": "object",
			"required": [
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"lifecycle": {
					"$ref": "#/$defs/lifecycle"
				},
				"observation": {
					"$ref": "#/$defs/observation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				}
			}
		},
		"clientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/hexId"
				},
				"operationId": {
					"$ref": "#/$defs/hexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
