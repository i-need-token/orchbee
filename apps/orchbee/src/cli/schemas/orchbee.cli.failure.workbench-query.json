{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.workbench-query",
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.cli.failure.workbench-query"
		},
		"version": {
			"const": 2
		},
		"failure": {
			"type": "object",
			"properties": {
				"kind": {
					"enum": ["protocol-invalid", "rejected"]
				},
				"details": {
					"type": "object",
					"required": ["stage", "reason"],
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "workbench-query"
						},
						"reason": {
							"enum": [
								"agent-capacity",
								"agent-page-invalid",
								"agent-revision-changed",
								"workbench-changed",
								"client-changed",
								"metadata-changed"
							]
						}
					}
				}
			},
			"required": ["kind", "details"],
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"properties": {
							"details": {
								"properties": {
									"reason": {
										"const": "agent-page-invalid"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"kind": {
								"const": "protocol-invalid"
							}
						}
					},
					"else": {
						"properties": {
							"kind": {
								"const": "rejected"
							}
						}
					}
				}
			]
		}
	},
	"required": ["schema", "version", "failure"],
	"additionalProperties": false
}
