{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.workspace.list",
	"title": "orchbee workspace list envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "orchbee.workspace.list" },
		"version": { "const": 1 },
		"source": { "$ref": "#/$defs/snapshotSource" },
		"result": {
			"type": "object",
			"required": ["workspaces"],
			"additionalProperties": false,
			"properties": {
				"workspaces": {
					"type": "array",
					"items": { "$ref": "#/$defs/workspace" }
				}
			}
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
		"workspace": {
			"type": "object",
			"required": ["workspaceId", "label", "projectId", "primaryDirectoryId", "terminalContextId"],
			"additionalProperties": false,
			"properties": {
				"workspaceId": { "$ref": "#/$defs/id" },
				"label": { "type": "string" },
				"projectId": { "$ref": "#/$defs/id" },
				"primaryDirectoryId": {
					"anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
				},
				"terminalContextId": { "$ref": "#/$defs/id" }
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "workbench-snapshot" },
				"siteId": { "$ref": "#/$defs/id" },
				"revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
			}
		}
	}
}
