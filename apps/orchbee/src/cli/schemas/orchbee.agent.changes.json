{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.changes",
	"title": "Bounded Agent changes",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.changes"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/agentReadSource"
		},
		"result": {
			"oneOf": [
				{
					"type": "object",
					"required": [
						"kind",
						"changes",
						"cursor",
						"observedThroughRevision",
						"runtimeRevision",
						"hasMore"
					],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "changes"
						},
						"changes": {
							"type": "array",
							"minItems": 1,
							"maxItems": 100,
							"items": {
								"$ref": "#/$defs/change"
							}
						},
						"cursor": {
							"$ref": "#/$defs/changesCursor"
						},
						"observedThroughRevision": {
							"$ref": "#/$defs/safeInteger"
						},
						"runtimeRevision": {
							"$ref": "#/$defs/safeInteger"
						},
						"hasMore": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "cursor", "revision"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "current"
						},
						"cursor": {
							"$ref": "#/$defs/changesCursor"
						},
						"revision": {
							"$ref": "#/$defs/safeInteger"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "cursor", "revision"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "reset-required"
						},
						"cursor": {
							"$ref": "#/$defs/changesCursor"
						},
						"revision": {
							"$ref": "#/$defs/safeInteger"
						}
					}
				}
			]
		}
	},
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"cursor": {
			"type": "string",
			"pattern": "^v1\\.[A-Za-z0-9_-]{59}\\.[A-Za-z0-9_-]{43}$"
		},
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"visibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"fidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"freshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"turnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"lifecycle": {
			"enum": ["ended", "live"]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				}
			}
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/positiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"changeSession": {
			"type": "object",
			"required": [
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"lifecycle": {
					"$ref": "#/$defs/lifecycle"
				},
				"observation": {
					"$ref": "#/$defs/observation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				}
			}
		},
		"change": {
			"type": "object",
			"required": ["revision", "transition", "session"],
			"additionalProperties": false,
			"properties": {
				"revision": {
					"type": "integer",
					"minimum": 1,
					"maximum": 9007199254740991
				},
				"transition": {
					"enum": [
						"session-observed",
						"turn-started",
						"turn-activity-changed",
						"limited-activity-observed",
						"attention-requested",
						"attention-resolved",
						"turn-finished",
						"session-idle-observed",
						"observation-became-stale",
						"observation-reconnected",
						"presentation-attached",
						"presentation-visibility-changed",
						"presentation-detached",
						"session-ended"
					]
				},
				"session": {
					"$ref": "#/$defs/changeSession"
				}
			}
		},
		"changesCursor": {
			"$ref": "#/$defs/cursor"
		}
	}
}
