{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.layout",
	"title": "Native Client Panel layout observation",
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.panel.layout"
		},
		"version": {
			"const": 1
		},
		"sessionId": {
			"anyOf": [
				{
					"$ref": "#/$defs/sessionId"
				},
				{
					"type": "null"
				}
			]
		},
		"operationId": {
			"$ref": "#/$defs/requestId"
		},
		"observation": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "server"
						},
						"reply": {
							"type": "object",
							"properties": {
								"protocolVersion": {
									"const": 1
								},
								"requestId": {
									"$ref": "#/$defs/requestId"
								},
								"sessionId": {
									"$ref": "#/$defs/sessionId"
								},
								"outcome": {
									"$ref": "#/$defs/outcome"
								}
							},
							"required": ["protocolVersion", "requestId", "sessionId", "outcome"],
							"additionalProperties": false
						}
					},
					"required": ["kind", "reply"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unknown"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-submitted"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unobserved"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				}
			]
		},
		"wait": {
			"anyOf": [
				{
					"enum": ["detached", "timed-out", "cancelled", "transport-lost", "observation-failed"]
				},
				{
					"type": "null"
				}
			]
		},
		"query": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"enum": ["layout", "edges"]
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "neighbor"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						}
					},
					"required": ["kind", "direction"],
					"additionalProperties": false
				}
			]
		},
		"projection": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "neighbor"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						},
						"sourceAvailable": {
							"type": "boolean"
						},
						"neighborPanelId": {
							"oneOf": [
								{
									"type": "null"
								},
								{
									"$ref": "#/$defs/panelId"
								}
							]
						}
					},
					"required": ["kind", "direction", "sourceAvailable", "neighborPanelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "edges"
						},
						"sourceAvailable": {
							"type": "boolean"
						},
						"left": {
							"type": ["boolean", "null"]
						},
						"right": {
							"type": ["boolean", "null"]
						},
						"up": {
							"type": ["boolean", "null"]
						},
						"down": {
							"type": ["boolean", "null"]
						}
					},
					"required": ["kind", "sourceAvailable", "left", "right", "up", "down"],
					"additionalProperties": false
				}
			]
		}
	},
	"required": [
		"schema",
		"version",
		"sessionId",
		"operationId",
		"observation",
		"wait",
		"query",
		"projection"
	],
	"additionalProperties": false,
	"$defs": {
		"sessionId": {
			"title": "SessionId",
			"$ref": "#/$defs/identity"
		},
		"requestId": {
			"title": "WorkbenchRequestId",
			"$ref": "#/$defs/identity"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"intent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "context"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						}
					},
					"required": ["kind", "terminalContextId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"enabled": {
							"type": "boolean"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "enabled"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "toggle-zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "focus-direction"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "direction"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "resize"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						},
						"amount": {
							"$ref": "#/$defs/resizeAmount"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "direction", "amount"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "set-split-ratio"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"path": {
							"$ref": "#/$defs/splitPath"
						},
						"ratio": {
							"$ref": "#/$defs/splitRatio"
						},
						"expectedSplit": {
							"type": "object",
							"additionalProperties": false,
							"required": ["splitId", "firstSlotId", "secondSlotId"],
							"properties": {
								"splitId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"firstSlotId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"secondSlotId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								}
							}
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "path", "ratio"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "agent-attention"
						},
						"sessionIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 128,
								"pattern": "^[A-Za-z0-9:._-]+$"
							}
						}
					},
					"required": ["kind", "sessionIds"],
					"additionalProperties": false
				}
			]
		},
		"control": {
			"type": "object",
			"properties": {
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"expectedViewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"minimumWorkbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"intent": {
					"$ref": "#/$defs/intent"
				}
			},
			"required": [
				"operationId",
				"clientId",
				"expectedViewRevision",
				"minimumWorkbenchRevision",
				"intent"
			],
			"additionalProperties": false
		},
		"reason": {
			"enum": [
				"busy",
				"modal-open",
				"insufficient-space",
				"stale-view",
				"target-unavailable",
				"projection-unavailable",
				"interrupted",
				"client-disconnected",
				"expired",
				"unsupported"
			]
		},
		"status": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "queued"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "delivered"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "applied"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "incomplete"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						},
						"view": {
							"anyOf": [
								{
									"$ref": "#/$defs/view"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "reason", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-unchanged"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-toggled"
						},
						"view": {
							"$ref": "#/$defs/view"
						},
						"previouslyZoomed": {
							"type": "boolean"
						}
					},
					"required": ["kind", "view", "previouslyZoomed"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout-read"
						},
						"layout": {
							"$ref": "#/$defs/layout"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "layout", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "direction-focused"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "panelId", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "direction-unchanged"
						},
						"layoutRevision": {
							"$ref": "#/$defs/revision"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "layoutRevision", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout-adjusted"
						},
						"adjustment": {
							"$ref": "#/$defs/layoutAdjustment"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "adjustment", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "attention-read"
						},
						"attention": {
							"$ref": "#/$defs/attentionSnapshot"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "attention", "view"],
					"additionalProperties": false
				}
			]
		},
		"operation": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "#/$defs/control"
				},
				"status": {
					"$ref": "#/$defs/status"
				}
			},
			"required": ["command", "status"],
			"additionalProperties": false
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "operation"
						},
						"operation": {
							"$ref": "#/$defs/operation"
						}
					},
					"required": ["kind", "operation"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-found"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "conflict"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "denied"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": [
								"client-unavailable",
								"server-busy",
								"receipt-capacity",
								"unsupported",
								"sequence-exhausted"
							]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"cellRect": {
			"type": "object",
			"properties": {
				"x": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"y": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"width": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"height": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["x", "y", "width", "height"],
			"additionalProperties": false
		},
		"panelArea": {
			"type": "object",
			"properties": {
				"panelId": {
					"$ref": "#/$defs/panelId"
				},
				"unzoomed": {
					"anyOf": [
						{
							"$ref": "#/$defs/cellRect"
						},
						{
							"type": "null"
						}
					]
				},
				"terminal": {
					"anyOf": [
						{
							"$ref": "#/$defs/cellRect"
						},
						{
							"type": "null"
						}
					]
				},
				"displayed": {
					"anyOf": [
						{
							"$ref": "#/$defs/cellRect"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["panelId", "unzoomed", "terminal", "displayed"],
			"additionalProperties": false
		},
		"splitArea": {
			"type": "object",
			"properties": {
				"splitId": {
					"$ref": "#/$defs/splitId"
				},
				"firstSlotId": {
					"$ref": "#/$defs/panelSlotId"
				},
				"secondSlotId": {
					"$ref": "#/$defs/panelSlotId"
				},
				"orientation": {
					"enum": ["horizontal", "vertical"]
				},
				"ratio": {
