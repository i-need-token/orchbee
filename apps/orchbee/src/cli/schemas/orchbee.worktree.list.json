{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.worktree.list",
	"title": "orchbee worktree list envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.worktree.list"
		},
		"version": {
			"const": 2
		},
		"source": {
			"$ref": "#/$defs/worktreeListSource"
		},
		"result": {
			"type": "object",
			"required": ["directoryId", "path", "worktrees"],
			"additionalProperties": false,
			"properties": {
				"directoryId": {
					"$ref": "#/$defs/id"
				},
				"path": {
					"type": "string",
					"minLength": 1
				},
				"worktrees": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/worktree"
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"worktree": {
			"type": "object",
			"required": ["head", "bare", "detached", "locked", "prunable"],
			"additionalProperties": false,
			"properties": {
				"worktreePath": {
					"type": "string",
					"minLength": 1
				},
				"worktreePathBytesHex": {
					"type": "string",
					"pattern": "^([0-9a-f]{2})+$"
				},
				"head": {
					"type": ["string", "null"],
					"pattern": "^[0-9a-f]{40}$|^[0-9a-f]{64}$"
				},
				"branch": {
					"type": ["string", "null"],
					"minLength": 1
				},
				"branchBytesHex": {
					"type": "string",
					"pattern": "^([0-9a-f]{2})+$"
				},
				"bare": {
					"type": "boolean"
				},
				"detached": {
					"type": "boolean"
				},
				"locked": {
					"type": "boolean"
				},
				"prunable": {
					"type": "boolean"
				}
			},
			"allOf": [
				{
					"oneOf": [
						{
							"required": ["worktreePath"]
						},
						{
							"required": ["worktreePathBytesHex"]
						}
					]
				},
				{
					"oneOf": [
						{
							"required": ["branch"]
						},
						{
							"required": ["branchBytesHex"]
						}
					]
				},
				{
					"if": {
						"properties": {
							"bare": {
								"const": true
							}
						},
						"required": ["bare"]
					},
					"then": {
						"properties": {
							"head": {
								"const": null
							},
							"branch": {
								"const": null
							},
							"detached": {
								"const": false
							}
						}
					},
					"else": {
						"properties": {
							"head": {
								"type": "string"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"detached": {
								"const": true
							}
						},
						"required": ["detached"]
					},
					"then": {
						"properties": {
							"branch": {
								"const": null
							}
						}
					}
				}
			]
		},
		"worktreeListSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "worktree-list"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		}
	}
}
