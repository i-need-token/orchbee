{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.rename",
	"title": "orchbee agent rename envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.rename"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-names"
				},
				"requestId": {
					"$ref": "#/$defs/obapRequestId"
				}
			}
		},
		"result": {
			"anyOf": [
				{
					"type": "object",
					"required": ["kind", "target", "name", "previousName"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "assigned-target"
						},
						"target": {
							"$ref": "#/$defs/nameTarget"
						},
						"name": {
							"$ref": "#/$defs/agentName"
						},
						"previousName": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentName"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "target", "name"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unchanged-target"
						},
						"target": {
							"$ref": "#/$defs/nameTarget"
						},
						"name": {
							"$ref": "#/$defs/agentName"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "target", "name"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "released-target"
						},
						"target": {
							"$ref": "#/$defs/nameTarget"
						},
						"name": {
							"$ref": "#/$defs/agentName"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "target"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unchanged-target"
						},
						"target": {
							"$ref": "#/$defs/nameTarget"
						}
					}
				}
			]
		}
	},
	"$defs": {
		"agentName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]{0,31}$"
		},
		"sessionId": {
			"$ref": "#/$defs/opaqueIdentity"
		},
		"opaqueIdentity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._:-]{1,128}$"
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"nameTarget": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind", "sessionId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "session"
						},
						"sessionId": {
							"$ref": "#/$defs/sessionId"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "binding"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal"
						},
						"binding": {
							"$ref": "#/$defs/launchBinding"
						}
					}
				}
			]
		},
		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		}
	}
}
