{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.get",
	"title": "orchbee panel get envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.panel.get"
		},
		"version": {
			"const": 5
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": ["panel"],
			"additionalProperties": false,
			"properties": {
				"panel": {
					"type": "object",
					"required": [
						"panelId",
						"rightClick",
						"tabId",
						"context",
						"slotPath",
						"primaryPresentation",
						"childPresentations"
					],
					"additionalProperties": false,
					"properties": {
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"rightClick": {
							"enum": ["orchbee", "panel"]
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"context": {
							"$ref": "#/$defs/context"
						},
						"slotPath": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/id"
							}
						},
						"primaryPresentation": {
							"$ref": "#/$defs/presentation"
						},
						"childPresentations": {
							"type": "array",
							"items": {
								"$ref": "#/$defs/presentation"
							}
						},
						"focused": {
							"type": "boolean"
						},
						"agentSessionIds": {
							"type": "array",
							"maxItems": 512,
							"uniqueItems": true,
							"items": {
								"$ref": "#/$defs/agentOpaqueId"
							}
						},
						"agentStatus": {
							"enum": [null, "blocked", "done", "working", "idle", "unknown"]
						}
					}
				},
				"client": {
					"$ref": "#/$defs/queryClient"
				},
				"agents": {
					"$ref": "#/$defs/workbenchAgents"
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["client"],
						"type": "object"
					},
					"then": {
						"properties": {
							"panel": {
								"required": ["focused"],
								"type": "object"
							}
						},
						"type": "object"
					},
					"else": {
						"properties": {
							"panel": {
								"not": {
									"anyOf": [
										{
											"required": ["focused"],
											"type": "object"
										}
									]
								},
								"type": "object"
							}
						},
						"type": "object"
					}
				},
				{
					"if": {
						"type": "object",
						"required": ["agents"]
					},
					"then": {
						"type": "object",
						"properties": {
							"panel": {
								"type": "object",
								"required": ["agentStatus", "agentSessionIds"]
							}
						}
					},
					"else": {
						"type": "object",
						"properties": {
							"panel": {
								"type": "object",
								"not": {
									"anyOf": [
										{
											"required": ["agentStatus"]
										},
										{
											"required": ["agentSessionIds"]
										}
									]
								}
							}
						}
					}
				},
				{
					"if": {
						"type": "object",
						"required": ["client"]
					},
					"then": {
						"type": "object",
						"properties": {
							"agents": {
								"type": "object",
								"properties": {
									"sessions": {
										"type": "array",
										"items": {
											"type": "object",
											"required": ["client"]
										}
									}
								}
							}
						}
					},
					"else": {
						"type": "object",
						"properties": {
							"agents": {
								"type": "object",
								"properties": {
									"sessions": {
										"type": "array",
										"items": {
											"type": "object",
											"not": {
												"required": ["client"]
											}
										}
									}
								}
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"context": {
			"type": "object",
			"required": ["kind", "terminalContextId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": ["standalone", "workspace"]
				},
				"terminalContextId": {
					"$ref": "#/$defs/id"
				},
				"workspaceId": {
					"$ref": "#/$defs/id"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"kind": {
								"const": "workspace"
							}
						},
						"required": ["kind"]
					},
					"then": {
						"required": ["workspaceId"]
					}
				},
				{
					"if": {
						"properties": {
							"kind": {
								"const": "standalone"
							}
						},
						"required": ["kind"]
					},
					"then": {
						"not": {
							"required": ["workspaceId"]
						}
					}
				}
			]
		},
		"presentation": {
			"type": "object",
			"required": ["presentationId", "label", "binding", "customLabel", "displayLabel"],
			"additionalProperties": false,
			"properties": {
				"displayLabel": {
					"type": "string"
				},
				"customLabel": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 512,
							"pattern": "^[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000](?:[\\s\\S]*[^\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000])?(?![\\s\\S])"
						},
						{
							"type": "null"
						}
					]
				},
				"presentationId": {
					"$ref": "#/$defs/id"
				},
				"label": {
					"type": "string"
				},
				"binding": {
					"anyOf": [
						{
							"type": "object",
							"required": ["terminalId", "workerId"],
							"additionalProperties": false,
							"properties": {
								"terminalId": {
									"$ref": "#/$defs/id"
								},
								"workerId": {
									"$ref": "#/$defs/id"
								}
							}
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"queryClient": {
			"type": "object",
			"properties": {
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"viewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"operationIds": {
					"type": "array",
					"minItems": 1,
					"maxItems": 8,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/id"
					}
				},
				"view": {
					"$ref": "#/$defs/view"
				}
			},
			"required": ["clientId", "viewRevision", "operationIds", "view"],
			"additionalProperties": false
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"agentActivity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"agentClientView": {
			"type": "object",
			"required": [
				"clientId",
				"operationId",
				"phase",
				"outerFocused",
				"focused",
				"attentionRevision",
				"state",
				"stateChangeRevision",
				"seen",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"clientId": {
					"$ref": "#/$defs/agentHexId"
				},
				"operationId": {
					"$ref": "#/$defs/agentHexId"
				},
				"phase": {
					"enum": ["starting", "ready", "busy", "unavailable"]
				},
				"outerFocused": {
					"type": ["boolean", "null"]
				},
				"focused": {
					"type": "boolean"
				},
				"attentionRevision": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"state": {
					"enum": ["current", "missing", "stale"]
				},
				"stateChangeRevision": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/agentSafeInteger"
						}
					]
				},
				"seen": {
					"type": ["boolean", "null"]
				},
				"status": {
					"enum": [
						null,
						"idle",
						"done",
						"blocked",
						"working",
						"unknown",
						"ended",
						"stale",
						"disconnected"
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "current"
							}
						}
					},
					"then": {
						"properties": {
							"seen": {
								"type": "boolean"
							},
							"stateChangeRevision": {
								"$ref": "#/$defs/agentSafeInteger"
							}
						}
					},
					"else": {
						"properties": {
							"seen": {
								"type": "null"
							},
							"stateChangeRevision": {
								"type": "null"
							}
						}
					}
				}
			]
		},
		"agentExecutionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/agentOpaqueId"
				}
			}
		},
		"agentFidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"agentFreshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"agentHexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"agentObservation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/agentFidelity"
				},
				"freshness": {
					"$ref": "#/$defs/agentFreshness"
				},
				"generation": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"source": {
					"$ref": "#/$defs/agentObservationSource"
				}
			}
		},
		"agentObservationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"agentOpaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"agentPositiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"agentPresentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/agentOpaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/agentHexId"
				},
				"visibility": {
					"$ref": "#/$defs/agentVisibility"
				}
			}
		},
		"agentProviderId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"agentSafeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"agentSemanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/agentPositiveInteger"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					}
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentActivity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/agentTurnPhase"
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					}
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/agentActivity"
								},
								{
									"type": "null"
								}
							]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					}
				}
			]
		},
		"agentSessionSummary": {
			"type": "object",
			"required": [
				"executionLocation",
				"lifecycle",
				"observation",
				"parentSessionId",
				"pendingRequestCount",
				"presentationAttachments",
				"providerId",
				"sessionId",
				"status"
			],
			"additionalProperties": false,
			"properties": {
				"executionLocation": {
					"$ref": "#/$defs/agentExecutionLocation"
				},
				"lifecycle": {
					"const": "live"
				},
				"observation": {
					"$ref": "#/$defs/agentObservation"
				},
				"parentSessionId": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentOpaqueId"
						},
						{
							"type": "null"
						}
					]
				},
				"pendingRequestCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 128
				},
				"presentationAttachments": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"$ref": "#/$defs/agentPresentationAttachment"
					}
				},
				"providerId": {
					"$ref": "#/$defs/agentProviderId"
				},
				"sessionId": {
					"$ref": "#/$defs/agentOpaqueId"
				},
				"status": {
					"$ref": "#/$defs/agentSemanticStatus"
				}
			}
		},
		"agentTurnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"agentVisibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"workbenchAgents": {
			"type": "object",
			"required": ["revision", "requestIds", "sessions"],
			"additionalProperties": false,
			"properties": {
				"revision": {
					"$ref": "#/$defs/agentSafeInteger"
				},
				"requestIds": {
					"type": "array",
					"minItems": 1,
					"maxItems": 12,
					"uniqueItems": true,
					"items": {
						"$ref": "#/$defs/agentHexId"
					}
				},
				"sessions": {
					"type": "array",
					"maxItems": 512,
					"items": {
						"type": "object",
						"required": ["session"],
						"additionalProperties": false,
						"properties": {
							"session": {
								"$ref": "#/$defs/agentSessionSummary"
							},
							"client": {
								"$ref": "#/$defs/agentClientView"
							}
						}
					}
				}
			}
		}
	}
}
