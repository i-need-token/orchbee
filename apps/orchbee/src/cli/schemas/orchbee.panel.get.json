{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.get",
	"title": "orchbee panel get envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "orchbee.panel.get" },
		"version": { "const": 1 },
		"source": { "$ref": "#/$defs/snapshotSource" },
		"result": {
			"type": "object",
			"required": ["panel"],
			"additionalProperties": false,
			"properties": {
				"panel": {
					"type": "object",
					"required": [
						"panelId",
						"tabId",
						"context",
						"slotPath",
						"primaryPresentation",
						"childPresentations"
					],
					"additionalProperties": false,
					"properties": {
						"panelId": { "$ref": "#/$defs/id" },
						"tabId": { "$ref": "#/$defs/id" },
						"context": { "$ref": "#/$defs/context" },
						"slotPath": {
							"type": "array",
							"items": { "$ref": "#/$defs/id" }
						},
						"primaryPresentation": { "$ref": "#/$defs/presentation" },
						"childPresentations": {
							"type": "array",
							"items": { "$ref": "#/$defs/presentation" }
						}
					}
				}
			}
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
		"context": {
			"type": "object",
			"required": ["kind", "terminalContextId"],
			"additionalProperties": false,
			"properties": {
				"kind": { "enum": ["standalone", "workspace"] },
				"terminalContextId": { "$ref": "#/$defs/id" },
				"workspaceId": { "$ref": "#/$defs/id" }
			},
			"allOf": [
				{
					"if": {
						"properties": { "kind": { "const": "workspace" } },
						"required": ["kind"]
					},
					"then": { "required": ["workspaceId"] }
				},
				{
					"if": {
						"properties": { "kind": { "const": "standalone" } },
						"required": ["kind"]
					},
					"then": { "not": { "required": ["workspaceId"] } }
				}
			]
		},
		"presentation": {
			"type": "object",
			"required": ["presentationId", "label", "binding"],
			"additionalProperties": false,
			"properties": {
				"presentationId": { "$ref": "#/$defs/id" },
				"label": { "type": "string" },
				"binding": {
					"anyOf": [
						{
							"type": "object",
							"required": ["terminalId", "workerId"],
							"additionalProperties": false,
							"properties": {
								"terminalId": { "$ref": "#/$defs/id" },
								"workerId": { "$ref": "#/$defs/id" }
							}
						},
						{ "type": "null" }
					]
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "workbench-snapshot" },
				"siteId": { "$ref": "#/$defs/id" },
				"revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
			}
		}
	}
}
