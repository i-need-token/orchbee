{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.project.get",
	"title": "orchbee project get envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "orchbee.project.get" },
		"version": { "const": 1 },
		"source": { "$ref": "#/$defs/snapshotSource" },
		"result": {
			"type": "object",
			"required": ["project"],
			"additionalProperties": false,
			"properties": {
				"project": {
					"type": "object",
					"required": ["projectId", "label", "directories", "workspaces"],
					"additionalProperties": false,
					"properties": {
						"projectId": { "$ref": "#/$defs/id" },
						"label": { "type": "string" },
						"directories": {
							"type": "array",
							"items": {
								"type": "object",
								"required": ["directoryId", "workerId", "path"],
								"additionalProperties": false,
								"properties": {
									"directoryId": { "$ref": "#/$defs/id" },
									"workerId": { "$ref": "#/$defs/id" },
									"path": { "type": "string" }
								}
							}
						},
						"workspaces": {
							"type": "array",
							"items": {
								"type": "object",
								"required": ["workspaceId", "label"],
								"additionalProperties": false,
								"properties": {
									"workspaceId": { "$ref": "#/$defs/id" },
									"label": { "type": "string" }
								}
							}
						}
					}
				}
			}
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "workbench-snapshot" },
				"siteId": { "$ref": "#/$defs/id" },
				"revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
			}
		}
	}
}
