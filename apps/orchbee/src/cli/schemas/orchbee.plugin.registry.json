						}
					}
				},
				"action": {
					"type": "object",
					"additionalProperties": false,
					"required": ["id", "title", "description", "contexts", "platforms", "command"],
					"properties": {
						"id": {
							"$ref": "#/$defs/v2/$defs/localId"
						},
						"title": {
							"type": "string",
