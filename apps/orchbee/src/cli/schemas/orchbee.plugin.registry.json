							"type": "boolean"
						},
						"manifest": {
							"$ref": "#/$defs/v2/$defs/manifest"
						},
						"warning": {
							"anyOf": [
								{
									"type": "null"
								},
								{
									"$ref": "#/$defs/v2/$defs/error"
								}
							]
						},
						"source": {
							"anyOf": [
								{
									"type": "null"
								},
								{
									"$ref": "#/$defs/v2/$defs/managedSource"
								}
							]
						}
					}
				},
				"catalog": {
					"type": "object",
					"additionalProperties": false,
					"required": ["revision", "changed", "plugins"],
					"properties": {
						"revision": {
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						"changed": {
							"type": "boolean"
						},
						"plugins": {
							"type": "array",
							"maxItems": 32,
							"items": {
								"$ref": "#/$defs/v2/$defs/entry"
							}
						}
					}
				},
				"result": {
					"oneOf": [
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "catalog"],
							"properties": {
								"kind": {
									"const": "catalog"
								},
								"catalog": {
									"$ref": "#/$defs/v2/$defs/catalog"
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "pluginId", "path"],
							"properties": {
								"kind": {
									"const": "directory"
								},
								"pluginId": {
									"$ref": "#/$defs/v2/$defs/id"
								},
								"path": {
									"type": "string",
									"minLength": 1,
									"maxLength": 4096
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "revision", "actions"],
							"properties": {
								"kind": {
									"const": "actions"
								},
								"revision": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								},
								"actions": {
									"type": "array",
									"maxItems": 2048,
									"items": {
										"type": "object",
										"additionalProperties": false,
										"required": ["pluginId", "action"],
										"properties": {
											"pluginId": {
												"$ref": "#/$defs/v2/$defs/id"
											},
											"action": {
												"$ref": "#/$defs/v2/$defs/action"
											}
										}
									}
								}
							}
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["kind", "reason"],
							"properties": {
								"kind": {
									"const": "failed"
								},
								"reason": {
									"$ref": "#/$defs/v2/$defs/error"
								}
							}
						}
					]
				},
				"managedSource": {
					"type": "object",
					"additionalProperties": false,
					"required": ["github", "requestedRef", "resolvedCommit", "installationId"],
					"properties": {
						"github": {
							"type": "object",
							"additionalProperties": false,
							"required": ["repository", "subdir"],
							"properties": {
								"repository": {
									"type": "string",
									"minLength": 3,
									"maxLength": 241
								},
								"subdir": {
									"type": ["string", "null"],
									"maxLength": 1024
								}
							}
						},
						"requestedRef": {
							"type": ["string", "null"],
							"minLength": 1,
							"maxLength": 240
						},
						"resolvedCommit": {
							"type": "string",
							"pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
						},
						"installationId": {
							"type": "string",
							"pattern": "^(?!0{32}$)[a-f0-9]{32}$"
						}
					}
				}
			}
		}
	}
}
