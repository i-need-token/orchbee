	"description": "Structural spec contract. Native validation additionally bounds depth to 8, total filter nodes to 64 and encoded spec to 64 KiB; source and label are normalized before publication.",
	"if": {
		"properties": {
			"result": {
				"properties": {
					"operation": {
						"const": "get"
					}
				}
			}
		}
	},
	"then": {
		"properties": {
			"result": {
				"properties": {
					"kind": {
						"not": {
							"const": "unknown"
						}
					}
				}
			}
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"result": {
						"properties": {
							"kind": {
								"const": "exchange-failed"
							},
							"operation": {
								"enum": ["set", "clear"]
							}
						}
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"reason": {
								"enum": [
									"session-unavailable",
									"request-encoding",
									"request-deadline",
									"request-not-submitted"
