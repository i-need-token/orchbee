					"type": "object",
					"required": ["op", "field", "values"],
					"additionalProperties": false,
					"properties": {
						"op": {
							"const": "in"
						},
						"field": {
							"type": "object",
							"required": ["token"],
							"additionalProperties": false,
							"properties": {
								"token": {
									"type": "string",
									"pattern": "^[A-Za-z0-9_-]{1,32}$"
								}
							}
						},
						"values": {
							"type": "array",
							"minItems": 1,
							"maxItems": 32,
							"items": {
								"type": "string"
							}
						}
					}
				}
			]
		},
		"spec": {
			"type": "object",
			"required": ["source"],
			"additionalProperties": false,
			"properties": {
				"source": {
					"type": "string",
					"pattern": "^[A-Za-z0-9:._-]{1,120}$"
				},
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 32,
					"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
				},
				"filter": {
					"$ref": "#/$defs/filter"
				},
				"sort": {
					"type": "array",
					"maxItems": 8,
					"items": {
						"type": "object",
						"required": ["field"],
						"additionalProperties": false,
						"properties": {
							"field": {
								"oneOf": [
									{
										"enum": [
											"workspace_order",
											"tab_order",
											"pane_order",
											"attention",
											"status",
											"agent",
											"seen",
											"state_change_seq"
										]
									},
									{
										"type": "object",
										"required": ["token"],
										"additionalProperties": false,
										"properties": {
											"token": {
												"type": "string",
												"pattern": "^[A-Za-z0-9_-]{1,32}$"
											}
										}
									}
								]
							},
							"order": {
								"enum": ["asc", "desc"]
							}
						}
					}
				}
			}
		}
