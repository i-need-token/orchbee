							"const": "eq"
						},
						"field": {
							"type": "object",
							"required": ["token"],
							"additionalProperties": false,
							"properties": {
								"token": {
									"type": "string",
									"pattern": "^[A-Za-z0-9_-]{1,32}$"
								}
							}
						},
						"value": {
							"type": "string"
						}
					}
				},
