{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.view",
	"title": "Source-owned native Agent view receipt",
	"$defs": {
		"filter": {
			"oneOf": [
				{
					"type": "object",
					"required": ["op", "filters"],
					"additionalProperties": false,
					"properties": {
						"op": {
							"const": "all"
						},
						"filters": {
							"type": "array",
							"minItems": 1,
							"maxItems": 63,
							"items": {
								"$ref": "#/$defs/filter"
							}
						}
					}
				},
				{
					"type": "object",
					"required": ["op", "filters"],
					"additionalProperties": false,
					"properties": {
