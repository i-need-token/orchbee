							"type": "array",
							"minItems": 1,
							"maxItems": 32,
							"items": {
								"type": "boolean"
							}
						}
					}
				},
				{
					"type": "object",
					"required": ["op", "field", "value"],
					"additionalProperties": false,
					"properties": {
						"op": {
							"const": "eq"
						},
						"field": {
							"const": "state_change_seq"
