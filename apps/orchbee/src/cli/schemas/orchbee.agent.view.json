	"type": "object",
	"required": ["schema", "version", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.view"
		},
		"version": {
			"const": 1
		},
		"result": {
			"oneOf": [
				{
					"type": "object",
					"required": [
						"kind",
						"snapshot",
						"requestId",
						"sessionId",
						"operation",
						"interrupted",
						"cleanupFailed"
					],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "available"
						},
						"snapshot": {
							"type": "object",
							"required": ["revision", "spec"],
							"additionalProperties": false,
							"properties": {
								"revision": {
									"type": "string",
									"pattern": "^(0|[1-9][0-9]{0,19})$"
								},
								"spec": {
									"oneOf": [
										{
											"type": "null"
										},
										{
											"$ref": "#/$defs/spec"
										}
									]
								}
							}
						},
						"requestId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"sessionId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"operation": {
							"enum": ["get", "set", "clear"]
						},
						"interrupted": {
							"type": "boolean"
						},
						"cleanupFailed": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"required": [
						"kind",
						"reason",
						"requestId",
						"sessionId",
						"operation",
						"interrupted",
						"cleanupFailed"
					],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"enum": [
								"denied",
								"unavailable",
								"sessionMismatch",
								"invalidRequest",
								"pluginNotFound",
								"pluginDisabled",
								"sourceUnavailable",
								"revisionExhausted"
							]
						},
						"requestId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"sessionId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"operation": {
							"enum": ["get", "set", "clear"]
						},
						"interrupted": {
							"type": "boolean"
						},
						"cleanupFailed": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"required": [
						"kind",
						"reason",
						"requestId",
						"sessionId",
						"operation",
						"interrupted",
						"cleanupFailed"
					],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"reason": {
							"enum": [
								"request-write",
								"response-read",
								"response-deadline",
								"response-correlation",
								"response-protocol"
							]
						},
						"requestId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"sessionId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"operation": {
							"enum": ["get", "set", "clear"]
						},
						"interrupted": {
							"type": "boolean"
						},
						"cleanupFailed": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"required": [
						"kind",
						"reason",
						"requestId",
						"sessionId",
						"operation",
						"interrupted",
						"cleanupFailed"
					],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "exchange-failed"
						},
						"reason": {
							"enum": [
								"session-unavailable",
								"request-encoding",
								"request-deadline",
								"request-not-submitted",
								"request-write",
								"response-read",
								"response-deadline",
								"response-correlation",
								"response-protocol"
							]
						},
						"requestId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"sessionId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"operation": {
							"enum": ["get", "set", "clear"]
						},
						"interrupted": {
							"type": "boolean"
						},
						"cleanupFailed": {
							"type": "boolean"
						}
					}
				}
			]
		}
