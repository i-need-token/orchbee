									"required": ["context"],
									"additionalProperties": false,
									"properties": {
										"context": {
											"const": "current_tab_id"
										}
									}
								}
							]
						}
					}
				},
				{
					"type": "object",
					"required": ["op", "field", "values"],
					"additionalProperties": false,
					"properties": {
						"op": {
							"const": "in"
						},
						"field": {
							"const": "tab_id"
						},
						"values": {
							"type": "array",
							"minItems": 1,
							"maxItems": 32,
							"items": {
