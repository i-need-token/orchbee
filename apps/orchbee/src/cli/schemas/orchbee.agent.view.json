				{
					"type": "object",
					"required": ["op", "field", "values"],
					"additionalProperties": false,
					"properties": {
						"op": {
							"const": "in"
						},
						"field": {
							"const": "agent"
						},
						"values": {
							"type": "array",
							"minItems": 1,
							"maxItems": 32,
							"items": {
								"type": "string"
							}
						}
					}
				},
				{
					"type": "object",
					"required": ["op", "field", "value"],
					"additionalProperties": false,
					"properties": {
						"op": {
							"const": "eq"
						},
						"field": {
							"const": "seen"
						},
						"value": {
