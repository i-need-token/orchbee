{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.selection",
	"title": "Read-only terminal selection receipt",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.selection"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/snapshotSource"
		},
		"result": {
			"type": "object",
			"required": [
				"terminal",
				"anchor",
				"cursor",
				"contentRevision",
				"contentGeneration",
				"hostEpoch",
				"text"
			],
			"additionalProperties": false,
			"properties": {
				"terminal": {
					"$ref": "#/$defs/terminal"
				},
				"anchor": {
					"$ref": "#/$defs/point"
				},
				"cursor": {
					"$ref": "#/$defs/point"
				},
				"contentRevision": {
					"$ref": "#/$defs/decimal"
				},
				"contentGeneration": {
					"$ref": "#/$defs/positiveDecimal"
				},
				"hostEpoch": {
					"$ref": "#/$defs/id"
				},
				"text": {
					"type": "string"
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "sessionId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "workbench-snapshot"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			}
		},
		"point": {
			"type": "object",
			"required": ["row", "col"],
			"additionalProperties": false,
			"properties": {
				"row": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				},
				"col": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			}
		}
	}
}
