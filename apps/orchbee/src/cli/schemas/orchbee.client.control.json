{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.client.control",
	"title": "Native Client control observation",
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.client.control"
		},
		"version": {
			"const": 1
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["sessionId", "operationId", "observation", "wait"],
			"properties": {
				"sessionId": {
					"anyOf": [
						{
							"$ref": "#/$defs/sessionId"
						},
						{
							"type": "null"
						}
					]
				},
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"observation": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "server"
								},
								"reply": {
									"type": "object",
									"properties": {
										"protocolVersion": {
											"const": 1
										},
										"requestId": {
											"$ref": "#/$defs/requestId"
										},
										"sessionId": {
											"$ref": "#/$defs/sessionId"
										},
										"outcome": {
											"$ref": "#/$defs/outcome"
										}
									},
									"required": ["protocolVersion", "requestId", "sessionId", "outcome"],
									"additionalProperties": false
								}
							},
							"required": ["kind", "reply"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "unknown"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "not-submitted"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "unobserved"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						}
					]
				},
				"wait": {
					"anyOf": [
						{
							"enum": ["detached", "timed-out", "cancelled", "transport-lost", "observation-failed"]
						},
						{
							"type": "null"
						}
					]
				}
			}
		}
	},
	"required": ["schema", "version", "result"],
	"additionalProperties": false,
	"$defs": {
		"sessionId": {
			"title": "SessionId",
			"$ref": "#/$defs/identity"
		},
		"requestId": {
			"title": "WorkbenchRequestId",
			"$ref": "#/$defs/identity"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				},
				"splitRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/revision"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"intent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "context"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						}
					},
					"required": ["kind", "terminalContextId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"enabled": {
							"type": "boolean"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "enabled"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "toggle-zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "focus-direction"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "direction"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "resize"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"direction": {
							"enum": ["left", "right", "up", "down"]
						},
						"amount": {
							"$ref": "#/$defs/resizeAmount"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "direction", "amount"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "set-split-ratio"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"path": {
							"$ref": "#/$defs/splitPath"
						},
						"ratio": {
							"$ref": "#/$defs/splitRatio"
						},
						"expectedSplit": {
							"type": "object",
							"additionalProperties": false,
							"required": ["splitId", "firstSlotId", "secondSlotId"],
							"properties": {
								"splitId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"firstSlotId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"secondSlotId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								}
							}
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "path", "ratio"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "agent-attention"
						},
						"sessionIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"minLength": 1,
								"maxLength": 128,
								"pattern": "^[A-Za-z0-9:._-]+$"
							}
						}
					},
					"required": ["kind", "sessionIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "selections"
						},
						"terminalContextIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 128,
							"uniqueItems": true,
							"items": {
								"$ref": "#/$defs/terminalContextId"
							}
						}
					},
					"required": ["kind", "terminalContextIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "viewports"
						},
						"panelIds": {
							"type": "array",
							"minItems": 1,
							"maxItems": 16,
							"uniqueItems": true,
							"items": {
								"type": "string",
								"pattern": "^[0-9a-f]{32}$",
								"not": {
									"const": "00000000000000000000000000000000"
								}
							}
						}
					},
					"required": ["kind", "panelIds"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal-agent-attention"
						},
						"bindings": {
							"type": "array",
							"minItems": 1,
							"maxItems": 100,
							"uniqueItems": true,
							"items": {
								"$ref": "#/$defs/physicalBinding"
							}
						}
					},
					"required": ["kind", "bindings"]
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "agent-focus"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"presentationId": {
							"$ref": "#/$defs/physicalIdentity"
						},
						"target": {
							"oneOf": [
								{
									"type": "object",
									"properties": {
										"kind": {
											"const": "session"
										},
										"sessionId": {
											"type": "string",
											"minLength": 1,
											"maxLength": 128,
											"pattern": "^[A-Za-z0-9:._-]+$"
										}
									},
									"required": ["kind", "sessionId"],
									"additionalProperties": false
								},
								{
									"type": "object",
									"properties": {
										"kind": {
											"const": "terminal"
										},
										"binding": {
											"$ref": "#/$defs/physicalBinding"
										}
									},
									"required": ["kind", "binding"],
									"additionalProperties": false
								}
							]
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "presentationId", "target"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "presentation"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": [
						"kind",
						"terminalContextId",
						"tabId",
						"panelId",
						"presentationId",
						"expectedBinding",
						"returnTo",
						"previouslyZoomed"
					],
					"properties": {
						"kind": {
							"const": "overlay"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"presentationId": {
							"$ref": "#/$defs/identity"
						},
						"expectedBinding": {
							"type": "object",
							"additionalProperties": false,
							"required": ["workerId", "terminalId"],
							"properties": {
								"workerId": {
									"$ref": "#/$defs/identity"
								},
								"terminalId": {
									"$ref": "#/$defs/identity"
								}
							}
						},
						"returnTo": {
							"type": "object",
							"additionalProperties": false,
							"required": ["panelId", "presentationId", "binding"],
							"properties": {
								"panelId": {
									"$ref": "#/$defs/panelId"
								},
								"presentationId": {
									"$ref": "#/$defs/identity"
								},
								"binding": {
									"anyOf": [
										{
											"type": "object",
											"additionalProperties": false,
											"required": ["workerId", "terminalId"],
											"properties": {
												"workerId": {
													"$ref": "#/$defs/identity"
												},
												"terminalId": {
													"$ref": "#/$defs/identity"
												}
											}
										},
										{
											"type": "null"
										}
									]
								}
							}
						},
						"previouslyZoomed": {
							"type": "boolean"
						}
					}
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "popup-open"
						},
						"spec": {
							"$ref": "#/$defs/popupSpec"
						}
					},
					"required": ["kind", "spec"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "popup-close"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "editor-open"
						},
						"spec": {
							"$ref": "#/$defs/editorSpec"
						}
					},
					"required": ["kind", "spec"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "command-popup-open"
						},
						"spec": {
							"$ref": "#/$defs/configuredPopupSpec"
						}
					},
					"required": ["kind", "spec"],
					"additionalProperties": false
				}
			]
		},
		"control": {
			"type": "object",
			"properties": {
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"expectedViewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"minimumWorkbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"intent": {
					"$ref": "#/$defs/intent"
				}
			},
			"required": [
				"operationId",
				"clientId",
				"expectedViewRevision",
				"minimumWorkbenchRevision",
				"intent"
			],
			"additionalProperties": false
		},
		"reason": {
			"enum": [
				"busy",
				"modal-open",
				"insufficient-space",
				"stale-view",
				"target-unavailable",
				"projection-unavailable",
				"interrupted",
				"client-disconnected",
				"expired",
				"unsupported"
			]
		},
		"status": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "queued"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "delivered"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "applied"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "incomplete"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						},
						"view": {
							"anyOf": [
								{
									"$ref": "#/$defs/view"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "reason", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-unchanged"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-toggled"
						},
						"view": {
							"$ref": "#/$defs/view"
						},
						"previouslyZoomed": {
							"type": "boolean"
						}
					},
					"required": ["kind", "view", "previouslyZoomed"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout-read"
						},
						"layout": {
							"$ref": "#/$defs/layout"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "layout", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "direction-focused"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "panelId", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "direction-unchanged"
						},
						"layoutRevision": {
							"$ref": "#/$defs/revision"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "layoutRevision", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "layout-adjusted"
						},
						"adjustment": {
							"$ref": "#/$defs/layoutAdjustment"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "adjustment", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
