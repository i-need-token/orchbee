{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.client.control",
	"title": "Native Client control observation",
	"type": "object",
	"properties": {
		"schema": {
			"const": "orchbee.client.control"
		},
		"version": {
			"const": 1
		},
		"siteId": {
			"anyOf": [
				{
					"$ref": "#/$defs/siteId"
				},
				{
					"type": "null"
				}
			]
		},
		"operationId": {
			"$ref": "#/$defs/requestId"
		},
		"observation": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "server"
						},
						"reply": {
							"type": "object",
							"properties": {
								"protocolVersion": {
									"const": 1
								},
								"requestId": {
									"$ref": "#/$defs/requestId"
								},
								"siteId": {
									"$ref": "#/$defs/siteId"
								},
								"outcome": {
									"$ref": "#/$defs/outcome"
								}
							},
							"required": ["protocolVersion", "requestId", "siteId", "outcome"],
							"additionalProperties": false
						}
					},
					"required": ["kind", "reply"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unknown"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-submitted"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unobserved"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				}
			]
		},
		"wait": {
			"anyOf": [
				{
					"enum": ["detached", "timed-out", "cancelled", "transport-lost", "observation-failed"]
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": ["schema", "version", "siteId", "operationId", "observation", "wait"],
	"additionalProperties": false,
	"$defs": {
		"siteId": {
			"title": "SiteId",
			"$ref": "#/$defs/identity"
		},
		"requestId": {
			"title": "WorkbenchRequestId",
			"$ref": "#/$defs/identity"
		},
		"terminalContextId": {
			"title": "WorkbenchTerminalContextId",
			"$ref": "#/$defs/identity"
		},
		"tabId": {
			"title": "WorkbenchTabId",
			"$ref": "#/$defs/identity"
		},
		"panelId": {
			"title": "WorkbenchPanelId",
			"$ref": "#/$defs/identity"
		},
		"revision": {
			"title": "WorkbenchRevision",
			"type": "string",
			"minLength": 1,
			"maxLength": 20,
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"format": "orchbee-uint64"
		},
		"clientId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"sequence": {
			"type": "string",
			"pattern": "^[1-9][0-9]{0,19}$"
		},
		"phase": {
			"enum": ["starting", "ready", "busy", "unavailable"]
		},
		"selection": {
			"type": "object",
			"properties": {
				"terminalContextId": {
					"$ref": "#/$defs/terminalContextId"
				},
				"tabId": {
					"anyOf": [
						{
							"$ref": "#/$defs/tabId"
						},
						{
							"type": "null"
						}
					]
				},
				"panelId": {
					"anyOf": [
						{
							"$ref": "#/$defs/panelId"
						},
						{
							"type": "null"
						}
					]
				},
				"zoomed": {
					"type": "boolean"
				},
				"panelCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				}
			},
			"required": ["terminalContextId", "tabId", "panelId", "zoomed", "panelCount"],
			"additionalProperties": false
		},
		"view": {
			"type": "object",
			"properties": {
				"workbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"phase": {
					"$ref": "#/$defs/phase"
				},
				"selection": {
					"anyOf": [
						{
							"$ref": "#/$defs/selection"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["workbenchRevision", "phase", "selection"],
			"additionalProperties": false
		},
		"intent": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "context"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						}
					},
					"required": ["kind", "terminalContextId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "tab"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "panel"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						},
						"enabled": {
							"type": "boolean"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId", "enabled"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "toggle-zoom"
						},
						"terminalContextId": {
							"$ref": "#/$defs/terminalContextId"
						},
						"tabId": {
							"$ref": "#/$defs/tabId"
						},
						"panelId": {
							"$ref": "#/$defs/panelId"
						}
					},
					"required": ["kind", "terminalContextId", "tabId", "panelId"],
					"additionalProperties": false
				}
			]
		},
		"control": {
			"type": "object",
			"properties": {
				"operationId": {
					"$ref": "#/$defs/requestId"
				},
				"clientId": {
					"$ref": "#/$defs/clientId"
				},
				"expectedViewRevision": {
					"$ref": "#/$defs/sequence"
				},
				"minimumWorkbenchRevision": {
					"$ref": "#/$defs/revision"
				},
				"intent": {
					"$ref": "#/$defs/intent"
				}
			},
			"required": [
				"operationId",
				"clientId",
				"expectedViewRevision",
				"minimumWorkbenchRevision",
				"intent"
			],
			"additionalProperties": false
		},
		"reason": {
			"enum": [
				"busy",
				"stale-view",
				"target-unavailable",
				"projection-unavailable",
				"interrupted",
				"client-disconnected",
				"expired",
				"unsupported"
			]
		},
		"status": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "queued"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "delivered"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "applied"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "incomplete"
						},
						"reason": {
							"$ref": "#/$defs/reason"
						},
						"view": {
							"anyOf": [
								{
									"$ref": "#/$defs/view"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"required": ["kind", "reason", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-unchanged"
						},
						"view": {
							"$ref": "#/$defs/view"
						}
					},
					"required": ["kind", "view"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "zoom-toggled"
						},
						"view": {
							"$ref": "#/$defs/view"
						},
						"previouslyZoomed": {
							"type": "boolean"
						}
					},
					"required": ["kind", "view", "previouslyZoomed"],
					"additionalProperties": false
				}
			]
		},
		"operation": {
			"type": "object",
			"properties": {
				"command": {
					"$ref": "#/$defs/control"
				},
				"status": {
					"$ref": "#/$defs/status"
				}
			},
			"required": ["command", "status"],
			"additionalProperties": false
		},
		"outcome": {
			"oneOf": [
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "operation"
						},
						"operation": {
							"$ref": "#/$defs/operation"
						}
					},
					"required": ["kind", "operation"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "not-found"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "conflict"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "denied"
						}
					},
					"required": ["kind"],
					"additionalProperties": false
				},
				{
					"type": "object",
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": [
								"client-unavailable",
								"server-busy",
								"receipt-capacity",
								"unsupported",
								"sequence-exhausted"
							]
						}
					},
					"required": ["kind", "reason"],
					"additionalProperties": false
				}
			]
		},
		"identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		}
	}
}
