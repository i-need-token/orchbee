				"repositoryRoot": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])",
					"not": {
						"pattern": "\u0000"
					}
				},
				"commonDirectory": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])",
