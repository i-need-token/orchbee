{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.machine",
	"title": "Saved remote machine command receipt",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.machine"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "saved-machines"
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"profileId",
				"revision",
				"profiles",
				"changed",
				"committed",
				"remote",
				"remoteVersion",
				"machines",
				"error",
				"interrupted",
				"operation"
			],
			"properties": {
				"profileId": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						{
							"type": "null"
						}
					]
				},
				"revision": {
					"anyOf": [
						{
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						{
							"type": "null"
						}
					]
				},
				"profiles": {
					"anyOf": [
						{
							"type": "array",
							"maxItems": 64,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": [
									"id",
									"label",
									"connection",
									"session",
									"enabled",
									"remoteInstall",
									"color"
								],
								"properties": {
									"id": {
										"type": "string",
										"pattern": "^[0-9a-f]{32}$"
									},
									"label": {
										"type": "string",
										"minLength": 1,
										"maxLength": 128
									},
									"connection": {
										"oneOf": [
											{
												"type": "object",
												"additionalProperties": false,
												"required": ["kind", "target"],
												"properties": {
													"kind": {
														"const": "ssh"
													},
													"target": {
														"type": "string",
														"minLength": 1,
														"maxLength": 1024
													}
												}
											},
											{
												"$ref": "#/$defs/unsupported"
											}
										]
									},
									"session": {
										"type": "string",
										"pattern": "^(?!\\.)(?!.*\\.$)[A-Za-z0-9._-]{1,64}$"
									},
									"enabled": {
										"type": "boolean"
									},
									"remoteInstall": {
										"enum": ["managed", "manual"]
									},
									"color": {
										"$ref": "#/$defs/color"
									}
								}
							}
						},
						{
							"type": "null"
						}
					]
				},
				"changed": {
					"type": "boolean"
				},
				"committed": {
					"type": "boolean"
				},
				"remote": {
					"enum": ["not-contacted", "unchanged", "possibly-started", "ready"]
				},
				"remoteVersion": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"pattern": "^[!-~]+$"
						},
						{
							"type": "null"
						}
					]
				},
				"machines": {
					"anyOf": [
						{
							"type": "array",
							"minItems": 1,
							"maxItems": 65,
							"items": {
								"$ref": "#/$defs/machine"
							}
						},
						{
							"type": "null"
						}
					]
				},
				"error": {
					"enum": [
						null,
						"configuration",
						"invalid-catalog",
						"storage",
						"busy",
						"not-found",
						"ambiguous-machine",
						"reserved-name",
						"capacity",
						"revision-exhausted",
						"not-yet-available",
						"session-stop-failed",
						"disabled-machine",
						"unsupported-machine",
						"hub-unavailable",
						"ssh-unavailable",
						"ssh-failed",
						"host-unreachable",
						"host-untrusted",
						"host-key-changed",
						"auth-required",
						"auth-failed",
						"remote-protocol",
						"remote-not-installed",
						"remote-unsupported",
						"remote-install-failed",
						"version-incompatible",
						"remote-other-environment",
						"remote-not-ready",
						"cancelled",
						"timeout",
						"physical-unknown",
						"internal"
					]
				},
				"interrupted": {
					"type": "boolean"
				},
				"operation": {
					"enum": [
						"list",
						"add",
						"rename",
						"set-color",
						"remove",
						"enable",
						"disable",
						"connect",
						"disconnect"
					]
				}
			},
			"if": {
				"properties": {
					"changed": {
						"const": true
					}
				}
			},
			"then": {
				"properties": {
					"committed": {
						"const": true
					},
					"revision": {
						"type": "integer"
					},
					"profiles": {
						"type": "array"
					}
				}
			},
			"else": {
				"properties": {
					"committed": {
						"const": false
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"operation": {
								"const": "list"
							},
							"error": {
								"const": null
							}
						}
					},
					"then": {
						"properties": {
							"machines": {
								"type": "array"
							}
						}
					},
					"else": {
						"properties": {
							"machines": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"error": {
								"const": null
							}
						}
					},
					"then": {
						"properties": {
							"revision": {
								"type": "integer"
							},
							"profiles": {
								"type": "array"
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"machine": {
			"type": "object",
			"additionalProperties": false,
			"required": ["local", "id", "label", "color", "state", "capacity"],
			"properties": {
				"local": {
					"type": "boolean"
				},
				"id": {
					"type": ["string", "null"],
					"pattern": "^[0-9a-f]{32}$"
				},
				"label": {
					"type": ["string", "null"],
					"minLength": 1,
					"maxLength": 128
				},
				"color": {
					"anyOf": [
						{
							"$ref": "#/$defs/color"
						},
						{
							"type": "null"
						}
					]
				},
				"state": {
					"enum": [
						null,
						"disabled",
						"connecting",
						"online",
						"reconnecting",
						"offline",
						"unresponsive",
						"needs-login",
						"login-failed",
						"untrusted",
						"key-changed",
						"not-installed",
						"unsupported",
						"needs-update",
						"local-needs-update",
						"incompatible",
						"unknown"
					]
				},
				"capacity": {
					"oneOf": [
						{
							"const": "unknown"
						},
						{
							"$ref": "#/$defs/capacity"
						}
					]
				}
			},
			"if": {
				"properties": {
					"local": {
						"const": true
					}
				}
			},
			"then": {
				"properties": {
					"id": {
						"type": "null"
					},
					"label": {
						"type": "null"
					},
					"color": {
						"type": "null"
					},
					"state": {
						"type": "null"
					}
				}
			},
			"else": {
				"properties": {
					"id": {
						"type": "string"
					},
					"label": {
						"type": "string"
					},
					"color": {
						"type": "string"
					},
					"state": {
						"type": "string"
					}
				}
			}
		},
		"color": {
			"oneOf": [
				{
					"enum": [
						"cyan",
						"teal",
						"sky",
						"blue",
						"indigo",
						"violet",
						"purple",
						"magenta",
						"pink",
						"brown",
						"slate",
						"grey"
					]
				},
				{ "type": "string", "pattern": "^#[0-9a-f]{6}$" }
			]
		},
		"capacity": {
			"type": "object",
			"additionalProperties": false,
			"required": ["cpu", "memory", "disk", "sampledAt"],
			"properties": {
				"cpu": {
					"oneOf": [
						{
							"const": "unknown"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["logical", "freePercent"],
							"properties": {
								"logical": {
									"type": "integer",
									"minimum": 1,
									"maximum": 9007199254740991
								},
								"freePercent": {
									"type": "integer",
									"minimum": 0,
									"maximum": 100
								}
							}
						}
					]
				},
				"memory": {
					"oneOf": [
						{
							"const": "unknown"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["totalBytes", "freeBytes"],
							"properties": {
								"totalBytes": {
									"type": "integer",
									"minimum": 1,
									"maximum": 9007199254740991
								},
								"freeBytes": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								}
							}
						}
					]
				},
				"disk": {
					"oneOf": [
						{
							"const": "unknown"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["path", "totalBytes", "freeBytes"],
							"properties": {
								"path": {
									"type": "string",
									"minLength": 1,
									"maxLength": 4096
								},
								"totalBytes": {
									"type": "integer",
									"minimum": 1,
									"maximum": 9007199254740991
								},
								"freeBytes": {
									"type": "integer",
									"minimum": 0,
									"maximum": 9007199254740991
								}
							}
						}
					]
				},
				"sampledAt": {
					"type": "integer",
					"minimum": 0,
					"maximum": 9007199254740991
				}
			}
		},
		"unsupported": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "unsupported"
				}
			}
		}
	}
}
