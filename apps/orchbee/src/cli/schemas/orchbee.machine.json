{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.machine",
	"title": "Saved remote machine command receipt",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.machine"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "saved-machines"
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"profileId",
				"revision",
				"profiles",
				"changed",
				"committed",
				"remote",
				"remoteVersion",
				"error",
				"interrupted",
				"operation"
			],
			"properties": {
				"profileId": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						{
							"type": "null"
						}
					]
				},
				"revision": {
					"anyOf": [
						{
							"type": "integer",
							"minimum": 0,
							"maximum": 9007199254740991
						},
						{
							"type": "null"
						}
					]
				},
				"profiles": {
					"anyOf": [
						{
							"type": "array",
							"maxItems": 64,
							"items": {
								"type": "object",
								"additionalProperties": false,
								"required": ["id", "label", "connection", "session", "enabled", "remoteInstall"],
								"properties": {
									"id": {
										"type": "string",
										"pattern": "^[0-9a-f]{32}$"
									},
									"label": {
										"type": "string",
										"minLength": 1,
										"maxLength": 128
									},
									"connection": {
										"oneOf": [
											{
												"type": "object",
												"additionalProperties": false,
												"required": ["kind", "target"],
												"properties": {
													"kind": {
														"const": "ssh"
													},
													"target": {
														"type": "string",
														"minLength": 1,
														"maxLength": 1024
													}
												}
											},
											{
												"$ref": "#/$defs/unsupported"
											}
										]
									},
									"session": {
										"type": "string",
										"pattern": "^(?!\\.)(?!.*\\.$)[A-Za-z0-9._-]{1,64}$"
									},
									"enabled": {
										"type": "boolean"
									},
									"remoteInstall": {
										"enum": ["managed", "manual"]
									}
								}
							}
						},
						{
							"type": "null"
						}
					]
				},
				"changed": {
					"type": "boolean"
				},
				"committed": {
					"type": "boolean"
				},
				"remote": {
					"enum": ["not-contacted", "unchanged", "possibly-started", "ready"]
				},
				"remoteVersion": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 64,
							"pattern": "^[!-~]+$"
						},
						{
							"type": "null"
						}
					]
				},
				"error": {
					"enum": [
						null,
						"configuration",
						"invalid-catalog",
						"storage",
						"busy",
						"not-found",
						"ambiguous-machine",
						"capacity",
						"revision-exhausted",
						"not-yet-available",
						"disabled-machine",
						"unsupported-machine",
						"hub-unavailable",
						"ssh-unavailable",
						"ssh-failed",
						"host-unreachable",
						"host-untrusted",
						"host-key-changed",
						"auth-required",
						"auth-failed",
						"remote-protocol",
						"remote-not-installed",
						"remote-unsupported",
						"remote-install-failed",
						"version-incompatible",
						"remote-other-environment",
						"remote-not-ready",
						"cancelled",
						"timeout",
						"physical-unknown",
						"internal"
					]
				},
				"interrupted": {
					"type": "boolean"
				},
				"operation": {
					"enum": ["list", "add", "rename", "remove", "enable", "disable", "connect", "disconnect"]
				}
			},
			"if": {
				"properties": {
					"changed": {
						"const": true
					}
				}
			},
			"then": {
				"properties": {
					"committed": {
						"const": true
					},
					"revision": {
						"type": "integer"
					},
					"profiles": {
						"type": "array"
					}
				}
			},
			"else": {
				"properties": {
					"committed": {
						"const": false
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"error": {
								"const": null
							}
						}
					},
					"then": {
						"properties": {
							"revision": {
								"type": "integer"
							},
							"profiles": {
								"type": "array"
							}
						}
					}
				}
			]
		}
	},
	"$defs": {
		"unsupported": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "unsupported"
				}
			}
		}
	}
}
