{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.explain",
	"title": "orchbee agent explain envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "orchbee.agent.explain" },
		"version": { "const": 1 },
		"source": { "$ref": "#/$defs/agentReadSource" },
		"result": {
			"type": "object",
			"required": ["kind", "revision", "session", "explanation"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "found" },
				"revision": { "$ref": "#/$defs/safeInteger" },
				"session": { "$ref": "#/$defs/sessionDetail" },
				"explanation": { "$ref": "#/$defs/explanation" }
			}
		}
	},
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "agent-read" },
				"requestId": { "$ref": "#/$defs/hexId" }
			}
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"opaqueId": { "type": "string", "pattern": "^[0-9A-Za-z._:-]{1,128}$" },
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": { "const": "00000000000000000000000000000000" }
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"capability": {
			"enum": [
				"activity",
				"approvals",
				"authentication",
				"progress",
				"questions",
				"sessionLifecycle",
				"subagents",
				"turnLifecycle"
			]
		},
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"visibility": { "enum": ["hidden", "unknown", "visible"] },
		"fidelity": { "enum": ["basic", "heuristic", "rich"] },
		"freshness": { "enum": ["disconnected", "fresh", "stale"] },
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"turnPhase": { "enum": ["queued", "waiting-external", "working"] },
		"attentionKind": {
			"enum": ["approval", "authentication", "question", "unclassified"]
		},
		"outcomeKind": {
			"enum": ["canceled", "failed", "interrupted", "succeeded"]
		},
		"lifecycle": { "enum": ["ended", "live"] },
		"statusBasis": {
			"enum": [
				"active-turn",
				"affirmative-idle",
				"attention-request",
				"limited-activity-hint",
				"session-ended",
				"turn-outcome",
				"unobserved-turn-state"
			]
		},
		"freshnessMeaning": {
			"enum": [
				"current-observation",
				"last-observation-may-be-outdated",
				"no-trusted-current-route"
			]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": { "$ref": "#/$defs/opaqueId" }
			}
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": { "$ref": "#/$defs/opaqueId" },
				"navigable": { "type": "boolean" },
				"presentationId": { "$ref": "#/$defs/hexId" },
				"visibility": { "$ref": "#/$defs/visibility" }
			}
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": { "$ref": "#/$defs/fidelity" },
				"freshness": { "$ref": "#/$defs/freshness" },
				"generation": { "$ref": "#/$defs/safeInteger" },
				"sequence": { "$ref": "#/$defs/safeInteger" },
				"source": { "$ref": "#/$defs/observationSource" }
			}
		},
		"turnState": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "unknown" } }
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "idle" } }
				},
				{
					"required": ["activity", "phase", "turnId"],
					"additionalProperties": false,
					"properties": {
						"kind": { "const": "active" },
						"activity": {
							"oneOf": [{ "$ref": "#/$defs/activity" }, { "type": "null" }]
						},
						"phase": { "$ref": "#/$defs/turnPhase" },
						"turnId": { "$ref": "#/$defs/opaqueId" }
					}
				}
			]
		},
		"attentionRequest": {
			"type": "object",
			"required": ["actionPath", "kind", "requestId", "turnId"],
			"additionalProperties": false,
			"properties": {
				"actionPath": { "const": "navigate-only" },
				"kind": { "$ref": "#/$defs/attentionKind" },
				"requestId": { "$ref": "#/$defs/opaqueId" },
				"turnId": {
					"oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }]
				}
			}
		},
		"turnOutcome": {
			"type": "object",
			"required": ["eventId", "kind", "turnId"],
			"additionalProperties": false,
			"properties": {
				"eventId": { "$ref": "#/$defs/opaqueId" },
				"kind": { "$ref": "#/$defs/outcomeKind" },
				"turnId": { "$ref": "#/$defs/opaqueId" }
			}
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": { "const": "needs-attention" },
						"count": { "$ref": "#/$defs/positiveInteger" }
					}
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "failed" } }
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "succeeded" } }
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "canceled" } }
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "interrupted" } }
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": { "const": "working" },
						"activity": {
							"oneOf": [{ "$ref": "#/$defs/activity" }, { "type": "null" }]
						},
						"phase": { "$ref": "#/$defs/turnPhase" }
					}
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "idle" } }
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": { "const": "unknown" },
						"activityHint": {
							"oneOf": [{ "$ref": "#/$defs/activity" }, { "type": "null" }]
						}
					}
				},
				{
					"additionalProperties": false,
					"properties": { "kind": { "const": "ended" } }
				}
			]
		},
		"sessionDetail": {
			"type": "object",
			"required": ["snapshot", "status"],
			"additionalProperties": false,
			"properties": {
				"snapshot": {
					"type": "object",
					"required": [
						"activityHint",
						"capabilities",
						"executionLocation",
						"lastOutcome",
						"lifecycle",
						"observation",
						"parentSessionId",
						"pendingRequests",
						"presentationAttachments",
						"providerId",
						"sessionId",
						"turn"
					],
					"additionalProperties": false,
					"properties": {
						"activityHint": {
							"oneOf": [{ "$ref": "#/$defs/activity" }, { "type": "null" }]
						},
						"capabilities": {
							"type": "array",
							"maxItems": 10,
							"items": { "$ref": "#/$defs/capability" },
							"uniqueItems": true
						},
						"executionLocation": { "$ref": "#/$defs/executionLocation" },
						"lastOutcome": {
							"oneOf": [{ "$ref": "#/$defs/turnOutcome" }, { "type": "null" }]
						},
						"lifecycle": { "$ref": "#/$defs/lifecycle" },
						"observation": { "$ref": "#/$defs/observation" },
						"parentSessionId": {
							"oneOf": [{ "$ref": "#/$defs/opaqueId" }, { "type": "null" }]
						},
						"pendingRequests": {
							"type": "array",
							"maxItems": 128,
							"items": { "$ref": "#/$defs/attentionRequest" }
						},
						"presentationAttachments": {
							"type": "array",
							"maxItems": 32,
							"items": { "$ref": "#/$defs/presentationAttachment" }
						},
						"providerId": { "$ref": "#/$defs/providerId" },
						"sessionId": { "$ref": "#/$defs/opaqueId" },
						"turn": { "$ref": "#/$defs/turnState" }
					}
				},
				"status": { "$ref": "#/$defs/semanticStatus" }
			}
		},
		"explanation": {
			"type": "object",
			"required": [
				"actionPath",
				"capabilityCeiling",
				"contentAvailable",
				"fidelity",
				"freshness",
				"freshnessMeaning",
				"generation",
				"sequence",
				"source",
				"status",
				"statusBasis"
			],
			"additionalProperties": false,
			"properties": {
				"actionPath": { "const": "navigate-only" },
				"capabilityCeiling": {
					"type": "array",
					"maxItems": 10,
					"items": { "$ref": "#/$defs/capability" },
					"uniqueItems": true
				},
				"contentAvailable": { "const": false },
				"fidelity": { "$ref": "#/$defs/fidelity" },
				"freshness": { "$ref": "#/$defs/freshness" },
				"freshnessMeaning": { "$ref": "#/$defs/freshnessMeaning" },
				"generation": { "$ref": "#/$defs/safeInteger" },
				"sequence": { "$ref": "#/$defs/safeInteger" },
				"source": { "$ref": "#/$defs/observationSource" },
				"status": { "$ref": "#/$defs/semanticStatus" },
				"statusBasis": { "$ref": "#/$defs/statusBasis" }
			}
		}
	}
}
