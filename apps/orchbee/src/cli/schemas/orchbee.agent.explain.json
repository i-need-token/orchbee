{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.explain",
	"title": "orchbee agent explain envelope",
	"$defs": {
		"agentReadSource": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"positiveInteger": {
			"type": "integer",
			"minimum": 1,
			"maximum": 9007199254740991
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"capability": {
			"enum": [
				"activity",
				"approvals",
				"authentication",
				"progress",
				"questions",
				"sessionLifecycle",
				"subagents",
				"turnLifecycle"
			]
		},
		"activity": {
			"enum": [
				"command",
				"compacting",
				"editing",
				"other",
				"retrying",
				"subagent",
				"thinking",
				"tool"
			]
		},
		"visibility": {
			"enum": ["hidden", "unknown", "visible"]
		},
		"fidelity": {
			"enum": ["basic", "heuristic", "rich"]
		},
		"freshness": {
			"enum": ["disconnected", "fresh", "stale"]
		},
		"observationSource": {
			"enum": ["heuristic", "hook", "native", "terminal"]
		},
		"turnPhase": {
			"enum": ["queued", "waiting-external", "working"]
		},
		"attentionKind": {
			"enum": ["approval", "authentication", "question", "unclassified"]
		},
		"outcomeKind": {
			"enum": ["canceled", "failed", "interrupted", "succeeded"]
		},
		"lifecycle": {
			"enum": ["ended", "live"]
		},
		"statusBasis": {
			"enum": [
				"active-turn",
				"affirmative-idle",
				"attention-request",
				"limited-activity-hint",
				"session-ended",
				"turn-outcome",
				"unobserved-turn-state"
			]
		},
		"freshnessMeaning": {
			"enum": [
				"current-observation",
				"last-observation-may-be-outdated",
				"no-trusted-current-route"
			]
		},
		"executionLocation": {
			"type": "object",
			"required": ["executionLocationId"],
			"additionalProperties": false,
			"properties": {
				"executionLocationId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"presentationAttachment": {
			"type": "object",
			"required": ["generation", "navigable", "presentationId", "visibility"],
			"additionalProperties": false,
			"properties": {
				"generation": {
					"$ref": "#/$defs/opaqueId"
				},
				"navigable": {
					"type": "boolean"
				},
				"presentationId": {
					"$ref": "#/$defs/hexId"
				},
				"visibility": {
					"$ref": "#/$defs/visibility"
				}
			}
		},
		"observation": {
			"type": "object",
			"required": ["fidelity", "freshness", "generation", "sequence", "source"],
			"additionalProperties": false,
			"properties": {
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				}
			}
		},
		"turnState": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					},
					"type": "object"
				},
				{
					"required": ["activity", "phase", "turnId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "active"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						},
						"turnId": {
							"$ref": "#/$defs/opaqueId"
						}
					},
					"type": "object"
				}
			]
		},
		"attentionRequest": {
			"type": "object",
			"required": ["actionPath", "kind", "requestId", "turnId"],
			"additionalProperties": false,
			"properties": {
				"actionPath": {
					"const": "navigate-only"
				},
				"kind": {
					"$ref": "#/$defs/attentionKind"
				},
				"requestId": {
					"$ref": "#/$defs/opaqueId"
				},
				"turnId": {
					"oneOf": [
						{
							"$ref": "#/$defs/opaqueId"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"turnOutcome": {
			"type": "object",
			"required": ["eventId", "kind", "turnId"],
			"additionalProperties": false,
			"properties": {
				"eventId": {
					"$ref": "#/$defs/opaqueId"
				},
				"kind": {
					"$ref": "#/$defs/outcomeKind"
				},
				"turnId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"semanticStatus": {
			"type": "object",
			"required": ["kind"],
			"oneOf": [
				{
					"required": ["count"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "needs-attention"
						},
						"count": {
							"$ref": "#/$defs/positiveInteger"
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "succeeded"
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "canceled"
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "interrupted"
						}
					},
					"type": "object"
				},
				{
					"required": ["activity", "phase"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "working"
						},
						"activity": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"phase": {
							"$ref": "#/$defs/turnPhase"
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "idle"
						}
					},
					"type": "object"
				},
				{
					"required": ["activityHint"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unknown"
						},
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						}
					},
					"type": "object"
				},
				{
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "ended"
						}
					},
					"type": "object"
				}
			]
		},
		"sessionDetail": {
			"type": "object",
			"required": ["snapshot", "status"],
			"additionalProperties": false,
			"properties": {
				"snapshot": {
					"type": "object",
					"required": [
						"activityHint",
						"capabilities",
						"executionLocation",
						"lastOutcome",
						"lifecycle",
						"observation",
						"parentSessionId",
						"pendingRequests",
						"presentationAttachments",
						"providerId",
						"sessionId",
						"turn"
					],
					"additionalProperties": false,
					"properties": {
						"activityHint": {
							"oneOf": [
								{
									"$ref": "#/$defs/activity"
								},
								{
									"type": "null"
								}
							]
						},
						"capabilities": {
							"type": "array",
							"maxItems": 10,
							"items": {
								"$ref": "#/$defs/capability"
							},
							"uniqueItems": true
						},
						"executionLocation": {
							"$ref": "#/$defs/executionLocation"
						},
						"lastOutcome": {
							"oneOf": [
								{
									"$ref": "#/$defs/turnOutcome"
								},
								{
									"type": "null"
								}
							]
						},
						"lifecycle": {
							"$ref": "#/$defs/lifecycle"
						},
						"observation": {
							"$ref": "#/$defs/observation"
						},
						"parentSessionId": {
							"oneOf": [
								{
									"$ref": "#/$defs/opaqueId"
								},
								{
									"type": "null"
								}
							]
						},
						"pendingRequests": {
							"type": "array",
							"maxItems": 128,
							"items": {
								"$ref": "#/$defs/attentionRequest"
							}
						},
						"presentationAttachments": {
							"type": "array",
							"maxItems": 32,
							"items": {
								"$ref": "#/$defs/presentationAttachment"
							}
						},
						"providerId": {
							"$ref": "#/$defs/providerId"
						},
						"sessionId": {
							"$ref": "#/$defs/opaqueId"
						},
						"turn": {
							"$ref": "#/$defs/turnState"
						}
					}
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				}
			}
		},
		"explanation": {
			"type": "object",
			"required": [
				"actionPath",
				"capabilityCeiling",
				"contentAvailable",
				"fidelity",
				"freshness",
				"freshnessMeaning",
				"generation",
				"sequence",
				"source",
				"status",
				"statusBasis"
			],
			"additionalProperties": false,
			"properties": {
				"actionPath": {
					"const": "navigate-only"
				},
				"capabilityCeiling": {
					"type": "array",
					"maxItems": 10,
					"items": {
						"$ref": "#/$defs/capability"
					},
					"uniqueItems": true
				},
				"contentAvailable": {
					"const": false
				},
				"fidelity": {
					"$ref": "#/$defs/fidelity"
				},
				"freshness": {
					"$ref": "#/$defs/freshness"
				},
				"freshnessMeaning": {
					"$ref": "#/$defs/freshnessMeaning"
				},
				"generation": {
					"$ref": "#/$defs/safeInteger"
				},
				"sequence": {
					"$ref": "#/$defs/safeInteger"
				},
				"source": {
					"$ref": "#/$defs/observationSource"
				},
				"status": {
					"$ref": "#/$defs/semanticStatus"
				},
				"statusBasis": {
					"$ref": "#/$defs/statusBasis"
				}
			}
		},
		"physical_terminalBinding": {
			"type": "object",
			"additionalProperties": false,
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"properties": {
				"presentationId": {
					"$ref": "#/$defs/physical_identity"
				},
				"generation": {
					"$ref": "#/$defs/physical_identity"
				},
				"hostEpoch": {
					"$ref": "#/$defs/physical_identity"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/physical_identity"
				}
			}
		},
		"physical_identity": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"physical_view": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"agent": {
					"anyOf": [
						{
							"$ref": "#/$defs/physical_normalizedAgent"
						},
						{
							"type": "null"
						}
					]
				},
				"state": {
					"$ref": "#/$defs/physical_state"
				},
				"authoritySource": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"message": {
					"anyOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"required": ["agent", "state", "authoritySource", "message"]
		},
		"physical_normalizedAgent": {
			"type": "string",
			"minLength": 1,
			"not": {
				"pattern": "^[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]|[\\u0009-\\u000d\\u0020\\u0085\\u00a0\\u1680\\u2000-\\u200a\\u2028\\u2029\\u202f\\u205f\\u3000]$(?![\\s\\S])"
			}
		},
		"physical_state": {
			"enum": ["idle", "working", "blocked", "done", "error", "unknown"]
		},
		"physical_revision": {
			"type": "string",
			"pattern": "^(?:0|[1-9][0-9]{0,19})$",
			"maxLength": 20,
			"format": "orchbee-uint64"
		},
		"screenRule": {
			"type": "object",
			"required": ["id", "priority", "region", "state"],
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"priority": {
					"type": "integer",
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"region": {
					"type": "string",
					"minLength": 1,
					"maxLength": 128
				},
				"state": {
					"$ref": "#/$defs/physical_state"
				}
			}
		},
		"screenEvidence": {
			"type": "object",
			"required": [
				"contains",
				"regex",
				"lineRegex",
				"allCount",
				"anyCount",
				"notCount",
				"regionBytes",
				"regionPreview"
			],
			"additionalProperties": false,
			"properties": {
				"contains": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"type": "string",
						"maxLength": 512
					}
				},
				"regex": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"type": "string",
						"maxLength": 512
					}
				},
				"lineRegex": {
					"type": "array",
					"maxItems": 32,
					"items": {
						"type": "string",
						"maxLength": 512
					}
				},
				"allCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 512
				},
				"anyCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 512
				},
				"notCount": {
					"type": "integer",
					"minimum": 0,
					"maximum": 512
				},
				"regionBytes": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65536
				},
				"regionPreview": {
					"type": "string",
					"maxLength": 243
				}
			}
		},
		"screenExplanation": {
			"type": "object",
			"required": [
				"agent",
				"state",
				"manifestSource",
				"manifestVersion",
				"matchedRule",
				"visibleIdle",
				"visibleBlocker",
				"visibleWorking",
				"skipStateUpdate",
				"skippedUpdateReason",
				"fallbackReason",
				"evaluatedRules",
				"manifest"
			],
			"additionalProperties": false,
			"properties": {
				"agent": {
					"enum": [
						"pi",
						"claude",
						"codex",
						"gemini",
						"cursor",
						"devin",
						"agy",
						"cline",
						"omp",
						"mastracode",
						"opencode",
						"copilot",
						"kimi",
						"kiro",
						"droid",
						"amp",
						"grok",
						"hermes",
						"kilo",
						"qodercli",
						"qwen",
						"letta",
						"maki",
						"muse"
					]
				},
				"state": {
					"$ref": "#/$defs/physical_state"
				},
				"manifestSource": {
					"enum": ["bundled", "local-override", "remote-cache"]
				},
				"manifestVersion": {
					"oneOf": [
						{
							"type": "string",
							"maxLength": 128
						},
						{
							"type": "null"
						}
					]
				},
				"matchedRule": {
					"oneOf": [
						{
							"$ref": "#/$defs/screenRule"
						},
						{
							"type": "null"
						}
					]
				},
				"visibleIdle": {
					"type": "boolean"
				},
				"visibleBlocker": {
					"type": "boolean"
				},
				"visibleWorking": {
					"type": "boolean"
				},
				"skipStateUpdate": {
					"type": "boolean"
				},
				"skippedUpdateReason": {
					"oneOf": [
						{
							"type": "string",
							"pattern": "^matched-rule:.+"
						},
						{
							"type": "null"
						}
					]
				},
				"fallbackReason": {
					"enum": ["no-matching-state-evidence", null]
				},
				"evaluatedRules": {
					"type": "array",
					"maxItems": 128,
					"items": {
						"type": "object",
						"required": ["rule", "matched", "evidence"],
						"additionalProperties": false,
						"properties": {
							"rule": {
								"$ref": "#/$defs/screenRule"
							},
							"matched": {
								"type": "boolean"
							},
							"evidence": {
								"$ref": "#/$defs/screenEvidence"
							}
						}
					}
				},
				"manifest": {
					"anyOf": [
						{
							"$ref": "#/$defs/manifestInfo"
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"terminalExplanation": {
			"type": "object",
			"required": ["binding", "view", "explanation", "sample"],
			"additionalProperties": false,
			"properties": {
				"binding": {
					"$ref": "#/$defs/physical_terminalBinding"
				},
				"view": {
					"$ref": "#/$defs/physical_view"
				},
				"explanation": {
					"$ref": "#/$defs/screenExplanation"
				},
				"sample": {
					"type": "object",
					"required": ["frameSequence", "frameGeneration", "frameRevision", "rootPid", "agentPid"],
					"additionalProperties": false,
					"properties": {
						"frameSequence": {
							"$ref": "#/$defs/physical_revision",
							"not": {
								"const": "0"
							}
						},
						"frameGeneration": {
							"$ref": "#/$defs/physical_revision",
							"not": {
								"const": "0"
							}
						},
						"frameRevision": {
							"$ref": "#/$defs/physical_revision"
						},
						"rootPid": {
							"type": "integer",
							"minimum": 1,
							"maximum": 4294967295
						},
						"agentPid": {
							"oneOf": [
								{
									"type": "integer",
									"minimum": 1,
									"maximum": 4294967295
								},
								{
									"type": "null"
								}
							]
						}
					}
				}
			}
		},
		"manifestInfo": {
			"type": "object",
			"required": [
				"source",
				"path",
				"cachedRemoteVersion",
				"localOverrideShadowingRemote",
				"warnings"
			],
			"additionalProperties": false,
			"properties": {
				"source": {
					"enum": ["bundled", "local-override", "remote-cache"]
				},
				"path": {
					"type": ["string", "null"],
					"minLength": 1,
					"maxLength": 32768
				},
				"cachedRemoteVersion": {
					"type": ["string", "null"],
					"maxLength": 128,
					"pattern": "^[0-9]+(?:\\.[0-9]+)*$"
				},
				"localOverrideShadowingRemote": {
					"type": "boolean"
				},
				"warnings": {
					"type": "array",
					"maxItems": 2,
					"items": {
						"type": "object",
						"required": ["source", "kind"],
						"additionalProperties": false,
						"properties": {
							"source": {
