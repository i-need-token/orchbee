{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.plugin.provision",
	"title": "Windows native plugin source installation and removal receipts",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "operation", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.plugin.provision"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "local-configuration"
				}
			}
		},
		"operation": {
			"enum": ["install", "uninstall"]
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["operationId", "report", "interrupted", "cleanupFailed"],
			"properties": {
				"operationId": {
					"type": "string",
					"pattern": "^(?!0{32}$)[a-f0-9]{32}$"
				},
				"report": {
					"$ref": "#/$defs/report"
				},
				"interrupted": {
					"type": "boolean"
				},
				"cleanupFailed": {
					"type": "boolean"
				}
			}
		}
	},
	"$defs": {
		"platforms": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"type": "array",
					"maxItems": 3,
					"items": {
						"enum": ["windows", "macos", "linux"]
					},
					"minItems": 1
				}
			]
		},
		"id": {
			"type": "string",
			"minLength": 1,
			"maxLength": 120,
			"pattern": "^[A-Za-z0-9:._-]+$"
		},
		"localId": {
			"type": "string",
			"minLength": 1,
			"maxLength": 120,
			"pattern": "^[A-Za-z0-9:_-]+$"
		},
		"argv": {
			"type": "array",
			"maxItems": 128,
			"items": {
				"type": "string",
				"minLength": 1,
				"maxLength": 4096
			},
			"minItems": 1
		},
		"command": {
			"type": "object",
			"additionalProperties": false,
			"required": ["platforms", "command"],
			"properties": {
				"platforms": {
					"$ref": "#/$defs/platforms"
				},
				"command": {
					"$ref": "#/$defs/argv"
				}
			}
		},
		"action": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "description", "contexts", "platforms", "command"],
			"properties": {
				"id": {
					"$ref": "#/$defs/localId"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"description": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					]
				},
				"contexts": {
					"type": "array",
					"maxItems": 5,
					"items": {
						"enum": ["global", "workspace", "tab", "pane", "selection"]
					}
				},
				"platforms": {
					"$ref": "#/$defs/platforms"
				},
				"command": {
					"$ref": "#/$defs/argv"
				}
			}
		},
		"event": {
			"type": "object",
			"additionalProperties": false,
			"required": ["on", "platforms", "command"],
			"properties": {
				"on": {
					"type": "string",
					"minLength": 1,
					"maxLength": 120
				},
				"platforms": {
					"$ref": "#/$defs/platforms"
				},
				"command": {
					"$ref": "#/$defs/argv"
				}
			}
		},
		"size": {
			"anyOf": [
				{
					"type": "null"
				},
				{
					"oneOf": [
						{
							"type": "integer",
							"minimum": 1,
							"maximum": 4096
						},
						{
							"type": "string",
							"pattern": "^(?:[1-9][0-9]?|100)%$"
						}
					]
				}
			]
		},
		"pane": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"title",
				"description",
				"platforms",
				"placement",
				"width",
				"height",
				"command"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/localId"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"description": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					]
				},
				"platforms": {
					"$ref": "#/$defs/platforms"
				},
				"placement": {
					"enum": ["overlay", "popup", "split", "tab", "zoomed"]
				},
				"width": {
					"$ref": "#/$defs/size"
				},
				"height": {
					"$ref": "#/$defs/size"
				},
				"command": {
					"$ref": "#/$defs/argv"
				}
			}
		},
		"linkHandler": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "title", "pattern", "action", "platforms"],
			"properties": {
				"id": {
					"$ref": "#/$defs/localId"
				},
				"title": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"pattern": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				},
				"action": {
					"$ref": "#/$defs/localId"
				},
				"platforms": {
					"$ref": "#/$defs/platforms"
				}
			}
		},
		"manifest": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"id",
				"name",
				"version",
				"min_orchbee_version",
				"description",
				"platforms",
				"build",
				"startup",
				"actions",
				"events",
				"panes",
				"link_handlers"
			],
			"properties": {
				"id": {
					"$ref": "#/$defs/id"
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256
				},
				"version": {
					"type": "string",
					"minLength": 1,
					"maxLength": 120
				},
				"min_orchbee_version": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 120
						}
					]
				},
				"description": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						}
					]
				},
				"platforms": {
					"$ref": "#/$defs/platforms"
				},
				"build": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/command"
					}
				},
				"startup": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/command"
					}
				},
				"actions": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/action"
					}
				},
				"events": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/event"
					}
				},
				"panes": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/pane"
					}
				},
				"link_handlers": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/linkHandler"
					}
				}
			}
		},
		"error": {
			"enum": [
				"invalid-manifest",
				"invalid-identifier",
				"invalid-path",
				"invalid-registry",
				"manifest-unavailable",
				"plugin-not-found",
				"limit-exceeded",
				"busy",
				"storage-unavailable"
			]
		},
		"entry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["manifestPath", "pluginRoot", "enabled", "manifest", "warning", "source"],
			"properties": {
				"manifestPath": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				},
				"pluginRoot": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				},
				"enabled": {
					"type": "boolean"
				},
				"manifest": {
					"$ref": "#/$defs/manifest"
				},
				"warning": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/error"
						}
					]
				},
				"source": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/managedSource"
						}
					]
				}
			}
		},
		"managedSource": {
			"type": "object",
			"additionalProperties": false,
			"required": ["github", "requestedRef", "resolvedCommit", "installationId"],
			"properties": {
				"github": {
					"type": "object",
					"additionalProperties": false,
					"required": ["repository", "subdir"],
					"properties": {
						"repository": {
							"type": "string",
							"minLength": 3,
							"maxLength": 241
						},
						"subdir": {
							"type": ["string", "null"],
							"maxLength": 1024
						}
					}
				},
				"requestedRef": {
					"type": ["string", "null"],
					"minLength": 1,
					"maxLength": 240
				},
				"resolvedCommit": {
					"type": "string",
					"pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
				},
				"installationId": {
					"type": "string",
					"pattern": "^(?!0{32}$)[a-f0-9]{32}$"
				}
			}
		},
		"failure": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "registry"
						},
						"reason": {
							"$ref": "#/$defs/error"
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind", "reason"],
					"properties": {
						"kind": {
							"const": "command"
						},
						"reason": {
							"enum": [
								"exit-failure",
								"spawn-unavailable",
								"spawn-failed",
								"io",
								"cancelled",
								"timeout",
								"physical-unknown"
							]
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["kind"],
					"properties": {
						"kind": {
							"enum": [
								"manifest-changed",
								"linked-conflict",
								"cleanup-incomplete",
								"physical-unknown"
							]
						}
					}
				}
			]
		},
		"output": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"command",
				"exitCode",
				"failure",
				"stdout",
				"stderr",
				"stdoutTruncated",
				"stderrTruncated"
			],
			"properties": {
				"command": {
					"$ref": "#/$defs/argv"
				},
				"exitCode": {
					"type": ["integer", "null"],
					"minimum": -2147483648,
					"maximum": 2147483647
				},
				"failure": {
					"enum": [
						null,
						"exit-failure",
						"spawn-unavailable",
						"spawn-failed",
						"io",
						"cancelled",
						"timeout",
						"physical-unknown"
					]
				},
				"stdout": {
					"type": "string",
					"maxLength": 196608
				},
				"stderr": {
					"type": "string",
					"maxLength": 196608
				},
				"stdoutTruncated": {
					"type": "boolean"
				},
				"stderrTruncated": {
					"type": "boolean"
				}
			}
		},
		"report": {
			"type": "object",
			"additionalProperties": false,
			"required": ["stage", "plugin", "changed", "cleanupPending", "failure", "output"],
			"properties": {
				"stage": {
					"enum": ["prepare", "checkout", "inspect", "build", "commit", "cleanup", "done"]
				},
				"plugin": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/entry"
						}
					]
				},
				"changed": {
					"type": "boolean"
				},
				"cleanupPending": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"type": "string",
						"minLength": 1,
						"maxLength": 8192
					}
				},
				"failure": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/failure"
						}
					]
				},
				"output": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"$ref": "#/$defs/output"
						}
					]
				}
			}
		}
	}
}
