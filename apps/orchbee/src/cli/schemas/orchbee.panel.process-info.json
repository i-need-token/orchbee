{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.panel.process-info",
	"title": "orchbee Panel process information envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.panel.process-info"
		},
		"version": {
			"const": 1
		},
		"source": {
			"$ref": "#/$defs/source"
		},
		"result": {
			"type": "object",
			"required": ["terminal", "scope", "rootPid", "processes", "foreground"],
			"additionalProperties": false,
			"properties": {
				"terminal": {
					"$ref": "#/$defs/terminal"
				},
				"scope": {
					"const": "windows-job"
				},
				"rootPid": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"processes": {
					"type": "array",
					"maxItems": 64,
					"items": {
						"$ref": "#/$defs/process"
					}
				},
				"foreground": {
					"type": "object",
					"required": ["kind", "pid", "providerId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"enum": ["agent-chain", "root", "ambiguous", "unavailable"]
						},
						"pid": {
							"type": ["integer", "null"],
							"minimum": 1,
							"maximum": 4294967295
						},
						"providerId": {
							"type": ["string", "null"],
							"pattern": "^[0-9A-Za-z._:-]{1,128}$"
						}
					},
					"oneOf": [
						{
							"properties": {
								"kind": {
									"const": "agent-chain"
								},
								"pid": {
									"type": "integer"
								},
								"providerId": {
									"type": "string"
								}
							}
						},
						{
							"properties": {
								"kind": {
									"const": "root"
								},
								"pid": {
									"type": "integer"
								},
								"providerId": {
									"type": "null"
								}
							}
						},
						{
							"properties": {
								"kind": {
									"const": "ambiguous"
								},
								"pid": {
									"type": "null"
								},
								"providerId": {
									"type": "null"
								}
							}
						},
						{
							"properties": {
								"kind": {
									"const": "unavailable"
								},
								"pid": {
									"type": "null"
								},
								"providerId": {
									"type": "null"
								}
							}
						}
					]
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				}
			}
		},
		"process": {
			"type": "object",
			"required": [
				"pid",
				"parentPid",
				"creationTime",
				"image",
				"commandLine",
				"currentDirectory",
				"argv",
				"providerId"
			],
			"additionalProperties": false,
			"properties": {
				"pid": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"parentPid": {
					"oneOf": [
						{
							"type": "integer",
							"minimum": 1,
							"maximum": 4294967295
						},
						{
							"type": "null"
						}
					]
				},
				"creationTime": {
					"$ref": "#/$defs/positiveDecimal"
				},
				"image": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"commandLine": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"currentDirectory": {
					"type": ["string", "null"],
					"maxLength": 4096,
					"pattern": "^[^\\u0000]*$"
				},
				"argv": {
					"type": ["array", "null"],
					"maxItems": 4096,
					"items": {
						"type": "string",
						"maxLength": 4096,
						"pattern": "^[^\\u0000]*$"
					}
				},
				"providerId": {
					"type": ["string", "null"],
					"pattern": "^[0-9A-Za-z._:-]{1,128}$"
				}
			}
		},
		"source": {
			"type": "object",
			"required": [
				"kind",
				"sessionId",
				"snapshotRevision",
				"requestId",
				"hostRequestId",
				"hostEpoch",
				"attachmentId",
				"hostTerminalId"
			],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal-process-query"
				},
				"sessionId": {
					"$ref": "#/$defs/id"
				},
				"snapshotRevision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"requestId": {
					"$ref": "#/$defs/id"
				},
				"hostRequestId": {
					"$ref": "#/$defs/id"
				},
				"hostEpoch": {
					"$ref": "#/$defs/id"
				},
				"attachmentId": {
					"$ref": "#/$defs/id"
				},
				"hostTerminalId": {
					"$ref": "#/$defs/id"
				}
			}
		}
	}
}
