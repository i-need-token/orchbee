										},
										{
											"properties": {
												"host": {
													"$ref": "#/$defs/socketFail"
												}
											},
											"required": ["host"]
										}
									]
								},
								"anyOf": [
									{
										"properties": {
											"client": {
												"$ref": "#/$defs/socketPass"
											}
										},
										"required": ["client"]
									},
