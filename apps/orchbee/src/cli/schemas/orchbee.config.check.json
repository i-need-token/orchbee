{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.config.check",
	"title": "orchbee config check envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.config.check"
		},
		"version": {
			"enum": [1, 2, 3, 4, 5, 6]
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["ok", "checks"],
			"additionalProperties": false,
			"properties": {
				"ok": {
					"type": "boolean"
				},
				"checks": {
					"type": "array",
					"minItems": 5,
					"maxItems": 6,
					"prefixItems": [
						{
							"$ref": "#/$defs/runtimeBaseCheck"
						},
						{
							"$ref": "#/$defs/runtimeDirectoryCheck"
						},
						{
							"$ref": "#/$defs/cohortCheck"
						},
						{
							"$ref": "#/$defs/localeCheck"
						},
						{
							"$ref": "#/$defs/socketsCheck"
						},
						{
							"anyOf": [
								{
									"$ref": "#/$defs/userConfigCheck"
								},
								{
									"$ref": "#/$defs/userConfigCheckV3"
								},
								{
									"$ref": "#/$defs/userConfigCheckV4"
								},
								{
									"$ref": "#/$defs/userConfigCheckV5"
								},
								{
									"$ref": "#/$defs/userConfigCheckV6"
								}
							]
						}
					],
					"items": false
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"checks": {
								"contains": {
									"type": "object",
									"required": ["status"],
									"properties": {
										"status": {
											"const": "fail"
										}
									}
								}
							}
						},
						"required": ["checks"]
					},
					"then": {
						"properties": {
							"ok": {
								"const": false
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"checks": {
								"not": {
									"contains": {
										"type": "object",
										"required": ["status"],
										"properties": {
											"status": {
												"const": "fail"
											}
										}
									}
								}
							}
						},
						"required": ["checks"]
					},
					"then": {
						"properties": {
							"ok": {
								"const": true
							}
						}
					}
				}
			]
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"const": 1
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"checks": {
								"minItems": 5,
								"maxItems": 5
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"const": 2
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"checks": {
								"minItems": 6,
								"maxItems": 6,
								"prefixItems": [
									true,
									true,
									true,
									true,
									true,
									{
										"$ref": "#/$defs/userConfigCheck"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"const": 3
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"checks": {
								"minItems": 6,
								"maxItems": 6,
								"prefixItems": [
									true,
									true,
									true,
									true,
									true,
									{
										"$ref": "#/$defs/userConfigCheckV3"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"const": 4
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"checks": {
								"minItems": 6,
								"maxItems": 6,
								"prefixItems": [
									true,
									true,
									true,
									true,
									true,
									{
										"$ref": "#/$defs/userConfigCheckV4"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"const": 5
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"checks": {
								"minItems": 6,
								"maxItems": 6,
								"prefixItems": [
									true,
									true,
									true,
									true,
									true,
									{
										"$ref": "#/$defs/userConfigCheckV5"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"version": {
						"const": 6
					}
				}
			},
			"then": {
				"properties": {
					"result": {
						"properties": {
							"checks": {
								"minItems": 6,
								"maxItems": 6,
								"prefixItems": [
									true,
									true,
									true,
									true,
									true,
									{
										"$ref": "#/$defs/userConfigCheckV6"
									}
								]
							}
						}
					}
				}
			}
		}
	],
	"$defs": {
		"userConfigCheck": {
			"type": "object",
			"required": ["name", "status", "details"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"const": "user-config"
				},
				"status": {
					"enum": ["pass", "fail"]
				},
				"details": {
					"type": "object"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["path", "exists", "newCwd", "worktreeDirectory"],
								"additionalProperties": false,
								"properties": {
									"path": {
										"type": ["string", "null"],
										"minLength": 1,
										"maxLength": 4096
									},
									"exists": {
										"type": "boolean"
									},
									"newCwd": {
										"type": "string",
										"minLength": 1,
										"maxLength": 4096
									},
									"worktreeDirectory": {
										"type": ["string", "null"],
										"minLength": 1,
										"maxLength": 4096
									}
								}
							}
						}
					},
					"else": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["field", "reason"],
								"additionalProperties": false,
								"properties": {
									"field": {
										"enum": [
											"file",
											"ORCHBEE_CONFIG_FILE",
											"APPDATA",
											"terminal.new_cwd",
											"worktrees.directory"
										]
									},
									"reason": {
										"enum": [
											"invalid-path",
											"missing",
											"io-error",
											"not-file",
											"too-large",
											"invalid-utf8",
											"invalid-toml",
											"unknown-key",
											"wrong-type",
											"source-query-failed",
											"source-query-interrupted"
										]
									}
								}
							}
						}
					}
				}
			]
		},
		"userConfigCheckV3": {
			"type": "object",
			"required": ["name", "status", "details"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"const": "user-config"
				},
				"status": {
					"enum": ["pass", "fail"]
				},
				"details": {
					"type": "object"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"required": [
									"path",
									"exists",
									"newCwd",
									"worktreeDirectory",
									"resumeAgentsOnRestore",
									"resumeAgentsOnRestoreSource"
								],
								"additionalProperties": false,
								"properties": {
									"path": {
										"type": ["string", "null"],
										"minLength": 1,
										"maxLength": 4096
									},
									"exists": {
										"type": "boolean"
									},
									"resumeAgentsOnRestore": {
										"type": "boolean"
									},
									"resumeAgentsOnRestoreSource": {
										"enum": ["default", "file", "environment"]
									},
									"newCwd": {
										"type": "string",
										"minLength": 1,
										"maxLength": 4096
									},
									"worktreeDirectory": {
										"type": ["string", "null"],
										"minLength": 1,
										"maxLength": 4096
									}
								}
							}
						}
					},
					"else": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["field", "reason"],
								"additionalProperties": false,
								"properties": {
									"field": {
										"enum": [
											"file",
											"ORCHBEE_CONFIG_FILE",
											"APPDATA",
											"terminal.new_cwd",
											"worktrees.directory",
											"session.resume_agents_on_restore",
											"ORCHBEE_RESUME_AGENTS_ON_RESTORE"
										]
									},
									"reason": {
										"enum": [
											"invalid-path",
											"invalid-boolean",
											"missing",
											"io-error",
											"not-file",
											"too-large",
											"invalid-utf8",
											"invalid-toml",
											"unknown-key",
											"wrong-type",
											"source-query-failed",
											"source-query-interrupted"
										]
									}
								}
							}
						}
					}
				}
			]
		},
		"path": {
			"oneOf": [
				{
					"required": ["path"],
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"required": ["pathBytesHex"],
					"properties": {
						"pathBytesHex": {
							"type": "string",
							"pattern": "^([0-9a-f]{2})+$"
						}
					}
				}
			]
		},
		"runtimeBaseCheck": {
			"type": "object",
			"required": ["name", "status", "details"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"const": "runtime-base"
				},
				"status": {
					"enum": ["pass", "fail"]
				},
				"details": {
					"type": "object"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["exists"],
								"additionalProperties": false,
								"properties": {
									"path": {
										"type": "string",
										"minLength": 1
									},
									"pathBytesHex": {
										"type": "string",
										"pattern": "^([0-9a-f]{2})+$"
									},
									"exists": {
										"const": true
									}
								},
								"oneOf": [
									{
										"required": ["path"]
									},
									{
										"required": ["pathBytesHex"]
									}
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "fail"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"additionalProperties": false,
								"required": ["reason"],
								"allOf": [
									{
										"$ref": "#/$defs/path"
									},
									{
										"if": {
											"properties": {
												"reason": {
													"const": "absent"
												}
											},
											"required": ["reason"]
										},
										"then": {
											"required": ["exists"],
											"properties": {
												"exists": {
													"const": false
												}
											}
										}
									},
									{
										"if": {
											"properties": {
												"reason": {
													"enum": ["invalid-path", "io-error"]
												}
											},
											"required": ["reason"]
										},
										"then": {
											"not": {
												"required": ["exists"]
											}
										}
									},
									{
										"if": {
											"properties": {
												"reason": {
													"const": "unsafe"
												}
											},
											"required": ["reason"]
										},
										"then": {
											"required": ["exists"],
											"properties": {
												"exists": {
													"const": true
												}
											}
										}
									}
								],
								"properties": {
									"path": {
										"type": "string",
										"minLength": 1
									},
									"pathBytesHex": {
										"type": "string",
										"pattern": "^([0-9a-f]{2})+$"
									},
									"reason": {
										"enum": ["absent", "invalid-path", "io-error", "unsafe"]
									},
									"exists": {
										"type": "boolean"
									}
								}
							}
						}
					}
				}
			]
		},
		"runtimeDirectoryCheck": {
			"type": "object",
			"required": ["name", "status", "details"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"const": "runtime-directory"
				},
				"status": {
					"enum": ["pass", "fail", "not-applicable"]
				},
				"details": {
					"type": "object"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["exists"],
								"additionalProperties": false,
								"properties": {
									"path": {
										"type": "string",
										"minLength": 1
									},
									"pathBytesHex": {
										"type": "string",
										"pattern": "^([0-9a-f]{2})+$"
									},
									"exists": {
										"const": true
									}
								},
								"oneOf": [
									{
										"required": ["path"]
									},
									{
										"required": ["pathBytesHex"]
									}
								]
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "fail"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"additionalProperties": false,
								"required": ["reason"],
								"allOf": [
									{
										"$ref": "#/$defs/path"
									},
									{
										"if": {
											"properties": {
												"reason": {
													"const": "io-error"
												}
											},
											"required": ["reason"]
										},
										"then": {
											"not": {
												"required": ["exists"]
											}
										}
									},
									{
										"if": {
											"properties": {
												"reason": {
													"const": "unsafe"
												}
											},
											"required": ["reason"]
										},
										"then": {
											"required": ["exists"],
											"properties": {
												"exists": {
													"const": true
												}
											}
										}
									}
								],
								"properties": {
									"path": {
										"type": "string",
										"minLength": 1
									},
									"pathBytesHex": {
										"type": "string",
										"pattern": "^([0-9a-f]{2})+$"
									},
									"reason": {
										"enum": ["io-error", "unsafe"]
									},
									"exists": {
										"type": "boolean"
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "not-applicable"
							}
						},
						"required": ["status"]
					},
					"then": {
						"properties": {
							"details": {
								"oneOf": [
									{
										"type": "object",
										"additionalProperties": false
									},
									{
										"type": "object",
										"required": ["exists", "reason"],
										"additionalProperties": false,
										"allOf": [
											{
												"$ref": "#/$defs/path"
											}
										],
										"properties": {
											"path": {
												"type": "string",
												"minLength": 1
											},
											"pathBytesHex": {
												"type": "string",
												"pattern": "^([0-9a-f]{2})+$"
											},
											"reason": {
												"const": "absent"
											},
											"exists": {
												"const": false
											}
										}
									}
								]
							}
						}
					}
				}
			]
		},
		"cohortCheck": {
			"type": "object",
			"required": ["name", "status", "details"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"const": "cohort"
				},
				"status": {
					"enum": ["pass", "fail"]
				},
				"details": {
					"type": "object"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"status": {
								"const": "pass"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["verified"],
								"additionalProperties": false,
								"properties": {
									"verified": {
										"const": true
									}
								}
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"status": {
								"const": "fail"
							}
						}
					},
					"then": {
						"properties": {
							"details": {
								"type": "object",
								"required": ["verified", "reason"],
								"additionalProperties": false,
								"properties": {
									"verified": {
										"const": false
									},
									"reason": {
										"enum": ["deadline", "invalid-cohort"]
									}
								}
							}
						}
					}
				}
			]
		},
		"localeCheck": {
			"type": "object",
			"required": ["name", "status", "details"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"const": "locale"
				},
				"status": {
					"const": "pass"
				},
				"details": {
					"type": "object",
					"required": ["locale", "source"],
					"additionalProperties": false,
					"properties": {
						"locale": {
							"enum": ["en-US", "zh-CN"]
						},
						"source": {
							"enum": ["LC_ALL", "LC_MESSAGES", "LANG", "default"]
						}
					}
				}
			}
		},
		"socketEntry": {
			"oneOf": [
				{
					"type": "object",
					"required": ["presence", "status"],
					"additionalProperties": false,
					"properties": {
						"presence": {
							"const": "present"
						},
						"status": {
							"const": "pass"
						}
					}
				},
				{
					"type": "object",
					"required": ["presence", "status", "reason"],
					"additionalProperties": false,
					"properties": {
						"presence": {
							"const": "present"
						},
						"status": {
							"const": "fail"
						},
						"reason": {
							"enum": ["io-error", "unsafe"]
						}
					}
				},
				{
					"type": "object",
					"required": ["presence", "status"],
					"additionalProperties": false,
					"properties": {
						"presence": {
							"const": "absent"
						},
						"status": {
							"const": "not-applicable"
						}
					}
				},
				{
					"type": "object",
					"required": ["presence", "status", "reason"],
					"additionalProperties": false,
					"properties": {
						"presence": {
							"const": "unchecked"
						},
						"status": {
							"const": "not-applicable"
						},
