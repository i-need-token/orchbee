{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.server.configuration",
	"title": "Session configuration publication receipt",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.server.configuration"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["action", "reply", "interrupted", "cleanupFailed"],
			"additionalProperties": false,
			"properties": {
				"action": {
					"enum": ["current", "reload"]
				},
				"reply": {
					"anyOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"required": ["protocolVersion", "requestId", "sessionId", "outcome"],
							"additionalProperties": false,
							"properties": {
								"protocolVersion": {
									"const": 1
								},
								"requestId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"sessionId": {
									"type": "string",
									"pattern": "^[0-9a-f]{32}$"
								},
								"outcome": {
									"oneOf": [
										{
											"type": "object",
											"required": ["kind", "snapshot"],
											"additionalProperties": false,
											"properties": {
												"kind": {
													"const": "current"
												},
												"snapshot": {
													"type": "object",
													"required": [
														"revision",
														"diagnostics",
														"keysProfile",
														"restartRequired",
														"manifestCheck",
														"defaultShell",
														"shellMode",
														"windowTitle",
														"notificationProfile",
														"agentSidebarProfile",
														"spacesSidebarProfile",
														"themeName"
													],
													"additionalProperties": false,
													"properties": {
														"revision": {
															"type": "string",
															"pattern": "^(0|[1-9][0-9]{0,19})$"
														},
														"keysProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 65536
														},
														"restartRequired": {
															"type": "array",
															"uniqueItems": true,
															"maxItems": 3,
															"items": {
																"enum": ["terminal.default_shell", "terminal.shell_mode"]
															}
														},
														"manifestCheck": {
															"type": "boolean"
														},
														"defaultShell": {
															"type": "string",
															"maxLength": 4096,
															"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
														},
														"shellMode": {
															"enum": ["auto", "login", "non_login"]
														},
														"windowTitle": {
															"type": "string",
															"maxLength": 4096
														},
														"notificationProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 16384
														},
														"agentSidebarProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 32768
														},
														"spacesSidebarProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 32768
														},
														"diagnostics": {
															"type": "object",
															"required": ["items", "omittedCount"],
															"additionalProperties": false,
															"properties": {
																"items": {
																	"type": "array",
																	"maxItems": 128,
																	"uniqueItems": true,
																	"items": {
																		"type": "object",
																		"required": ["field", "reason", "disposition"],
																		"additionalProperties": false,
																		"properties": {
																			"field": {
																				"type": "string",
																				"minLength": 1,
																				"maxLength": 256,
																				"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
																			},
																			"reason": {
																				"type": "string",
																				"minLength": 1,
																				"maxLength": 64,
																				"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
																			},
																			"disposition": {
																				"enum": ["defaulted", "disabled", "ignored"]
																			}
																		}
																	}
																},
																"omittedCount": {
																	"type": "integer",
																	"minimum": 0,
																	"maximum": 65536
																}
															}
														},
														"themeName": {
															"enum": ["terminal-native", "one-light", "one-dark"]
														}
													}
												}
											}
										},
										{
											"type": "object",
											"required": ["kind", "snapshot", "changed"],
											"additionalProperties": false,
											"properties": {
												"kind": {
													"const": "reloaded"
												},
												"snapshot": {
													"type": "object",
													"required": [
														"revision",
														"diagnostics",
														"keysProfile",
														"restartRequired",
														"manifestCheck",
														"defaultShell",
														"shellMode",
														"windowTitle",
														"notificationProfile",
														"agentSidebarProfile",
														"spacesSidebarProfile",
														"themeName"
													],
													"additionalProperties": false,
													"properties": {
														"revision": {
															"type": "string",
															"pattern": "^(0|[1-9][0-9]{0,19})$"
														},
														"keysProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 65536
														},
														"restartRequired": {
															"type": "array",
															"uniqueItems": true,
															"maxItems": 3,
															"items": {
																"enum": ["terminal.default_shell", "terminal.shell_mode"]
															}
														},
														"manifestCheck": {
															"type": "boolean"
														},
														"defaultShell": {
															"type": "string",
															"maxLength": 4096,
															"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
														},
														"shellMode": {
															"enum": ["auto", "login", "non_login"]
														},
														"windowTitle": {
															"type": "string",
															"maxLength": 4096
														},
														"notificationProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 16384
														},
														"agentSidebarProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 32768
														},
														"spacesSidebarProfile": {
															"type": "string",
															"minLength": 1,
															"maxLength": 32768
														},
														"diagnostics": {
															"type": "object",
															"required": ["items", "omittedCount"],
															"additionalProperties": false,
															"properties": {
																"items": {
																	"type": "array",
																	"maxItems": 128,
																	"uniqueItems": true,
																	"items": {
																		"type": "object",
																		"required": ["field", "reason", "disposition"],
																		"additionalProperties": false,
																		"properties": {
																			"field": {
																				"type": "string",
																				"minLength": 1,
																				"maxLength": 256,
																				"pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
																			},
																			"reason": {
																				"type": "string",
																				"minLength": 1,
																				"maxLength": 64,
																				"pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
																			},
																			"disposition": {
																				"enum": ["defaulted", "disabled", "ignored"]
																			}
																		}
																	}
																},
																"omittedCount": {
																	"type": "integer",
																	"minimum": 0,
																	"maximum": 65536
																}
															}
														},
														"themeName": {
															"enum": ["terminal-native", "one-light", "one-dark"]
														}
													}
												},
												"changed": {
													"type": "boolean"
												}
											}
										},
										{
											"type": "object",
											"required": ["kind", "reason", "field", "detail"],
											"additionalProperties": false,
											"properties": {
												"kind": {
													"const": "failed"
												},
												"reason": {
													"enum": [
														"denied",
														"unavailable",
														"session-mismatch",
														"busy",
														"load-failed",
														"revision-exhausted"
													]
												},
												"field": {
													"type": ["string", "null"],
													"minLength": 1,
													"maxLength": 128
												},
												"detail": {
													"type": ["string", "null"],
													"minLength": 1,
													"maxLength": 128
												}
											},
											"if": {
												"properties": {
													"reason": {
														"not": {
															"const": "load-failed"
														}
													}
												}
											},
											"then": {
												"properties": {
													"field": {
														"type": "null"
													},
													"detail": {
														"type": "null"
													}
												}
											},
											"oneOf": [
												{
													"properties": {
														"field": {
															"type": "null"
														},
														"detail": {
															"type": "null"
														}
													}
												},
												{
													"properties": {
														"field": {
															"type": "string"
														},
														"detail": {
															"type": "string"
														}
													}
												}
											]
										}
									]
								}
							}
						}
					]
				},
				"interrupted": {
					"type": "boolean"
				},
				"cleanupFailed": {
					"type": "boolean"
				}
			},
			"if": {
				"properties": {
					"action": {
						"const": "current"
					}
				}
			},
			"then": {
				"properties": {
					"reply": {
						"properties": {
							"outcome": {
								"properties": {
									"kind": {
										"enum": ["current", "failed"]
									}
								}
							}
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"action": {
								"const": "reload"
							}
						}
					},
					"then": {
						"properties": {
							"reply": {
								"properties": {
									"outcome": {
										"properties": {
											"kind": {
												"enum": ["reloaded", "failed"]
											}
										}
									}
								}
							}
						}
					}
				}
			]
		}
	}
}
