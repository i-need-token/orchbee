{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.start",
	"title": "orchbee agent start envelope",
	"type": "object",
	"required": ["schema", "version", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.start"
		},
		"version": {
			"const": 1
		},
		"result": {
			"type": "object",
			"required": [
				"kind",
				"confirmation",
				"name",
				"providerId",
				"reservationId",
				"elapsedMs",
				"submission",
				"interactiveReady",
				"place",
				"panelId"
			],
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"properties": {
							"confirmation": {
								"const": "session"
							}
						}
					},
					"then": {
						"required": ["sessionId"]
					},
					"else": {
						"not": {
							"required": ["sessionId"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"confirmation": {
								"enum": ["sent", "launched"]
							}
						}
					},
					"then": {
						"properties": {
							"name": {
								"type": "null"
							},
							"reservationId": {
								"type": "null"
							},
							"interactiveReady": {
								"const": false
							}
						}
					},
					"else": {
						"properties": {
							"name": {
								"$ref": "#/$defs/agentName"
							},
							"reservationId": {
								"$ref": "#/$defs/hexId"
							},
							"interactiveReady": {
								"const": true
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"confirmation": {
								"const": "launched"
							}
						}
					},
					"then": {
						"properties": {
							"submission": {
								"type": "null"
							},
							"place": {
								"enum": ["new-tab", "split-right", "split-down"]
							}
						}
					},
					"else": {
						"properties": {
							"submission": {
								"$ref": "#/$defs/sendReceipt"
							}
						}
					}
				}
			],
			"properties": {
				"kind": {
					"const": "started"
				},
				"confirmation": {
					"enum": ["session", "observed", "sent", "launched"]
				},
				"place": {
					"enum": ["new-tab", "here", "split-right", "split-down"]
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"panelId": {
					"$ref": "#/$defs/hexId"
				},
				"name": {
					"oneOf": [
						{
							"$ref": "#/$defs/agentName"
						},
						{
							"type": "null"
						}
					]
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"reservationId": {
					"oneOf": [
						{
							"$ref": "#/$defs/hexId"
						},
						{
							"type": "null"
						}
					]
				},
				"elapsedMs": {
					"$ref": "#/$defs/safeInteger"
				},
				"submission": {
					"oneOf": [
						{
							"$ref": "#/$defs/sendReceipt"
						},
						{
							"type": "null"
						}
					]
				},
				"interactiveReady": {
					"type": "boolean"
				}
			}
		}
	},
	"$defs": {
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"sendReceipt": {
			"title": "orchbee terminal send result envelope",
			"type": "object",
			"required": ["schema", "version", "source", "result"],
			"additionalProperties": false,
			"properties": {
				"schema": {
					"const": "orchbee.terminal.send"
				},
				"version": {
					"const": 1
				},
				"source": {
					"$ref": "#/$defs/sendReceipt/$defs/sendSource"
				},
				"result": {
					"type": "object",
					"required": [
						"action",
						"requestId",
						"sessionId",
						"workerId",
						"terminalId",
						"inputStatus",
						"cleanupStatus",
						"payloadKind",
						"records",
						"recordsAccepted",
						"firstStoppedRecord",
						"acceptedEncodedBytes"
					],
					"additionalProperties": false,
					"properties": {
						"action": {
							"const": "terminal.send"
						},
						"requestId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"sessionId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"workerId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"terminalId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"payloadKind": {
							"enum": ["text", "key", "bytes", "paste", "sequence"]
						},
						"recordBytes": {
							"type": "integer",
							"minimum": 1,
							"maximum": 1048576
						},
						"inputStatus": {
							"enum": ["accepted", "not-submitted", "rejected", "unknown", "partial-accepted"]
						},
						"cleanupStatus": {
							"enum": ["not-needed", "confirmed", "unconfirmed"]
						},
						"reason": {
							"enum": [
								"host-input-backpressure",
								"host-input-invalid",
								"host-input-limit-exceeded",
								"host-input-unavailable",
								"host-protocol-fault",
								"host-rejected",
								"host-unavailable",
								"server-busy",
								"stale-host-epoch",
								"stale-worker-generation",
								"terminal-runtime-unavailable",
								"terminal-unavailable",
								"worker-unavailable",
								"input-budget-exhausted"
							]
						},
						"target": {
							"type": "object",
							"required": ["workerGeneration", "hostEpoch", "hostTerminalId"],
							"additionalProperties": false,
							"properties": {
								"workerGeneration": {
									"type": "string",
									"pattern": "^[1-9][0-9]*$"
								},
								"hostEpoch": {
									"$ref": "#/$defs/sendReceipt/$defs/id"
								},
								"hostTerminalId": {
									"$ref": "#/$defs/sendReceipt/$defs/id"
								}
							}
						},
						"records": {
							"type": "integer",
							"minimum": 1,
							"maximum": 64
						},
						"recordsAccepted": {
							"type": "integer",
							"minimum": 0,
							"maximum": 64
						},
						"firstStoppedRecord": {
							"type": "integer",
							"minimum": 0,
							"maximum": 64
						},
						"acceptedEncodedBytes": {
							"type": "integer",
							"minimum": 0,
							"maximum": 67108864
						}
					},
					"if": {
						"properties": {
							"inputStatus": {
								"enum": ["not-submitted", "rejected", "partial-accepted"]
							}
						},
						"required": ["inputStatus"]
					},
					"then": {
						"required": ["reason"]
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"inputStatus": {
										"enum": ["accepted", "unknown"]
									}
								},
								"required": ["inputStatus"]
							},
							"then": {
								"required": ["target"]
							}
						},
						{
							"if": {
								"properties": {
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								},
								"required": ["cleanupStatus"]
							},
							"then": {
								"required": ["target"]
							}
						},
						{
							"if": {
								"properties": {
									"payloadKind": {
										"enum": ["text", "bytes", "paste"]
									}
								},
								"required": ["payloadKind"]
							},
							"then": {
								"required": ["recordBytes"]
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "partial-accepted"
									}
								}
							},
							"then": {
								"required": ["target"],
								"properties": {
									"recordsAccepted": {
										"minimum": 1
									},
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "accepted"
									}
								}
							},
							"then": {
								"properties": {
									"recordsAccepted": {
										"minimum": 1
									},
									"cleanupStatus": {
										"enum": ["confirmed", "unconfirmed"]
									}
								}
							}
						},
						{
							"if": {
								"properties": {
									"inputStatus": {
										"const": "unknown"
									}
								}
							},
							"then": {
								"properties": {
									"cleanupStatus": {
										"enum": ["not-needed", "unconfirmed"]
									}
								}
							}
						}
					]
				}
			},
			"$defs": {
				"id": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				},
				"sendSource": {
					"type": "object",
					"required": ["kind", "sessionId", "requestId", "snapshotRevision"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal.send"
						},
						"sessionId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"requestId": {
							"$ref": "#/$defs/sendReceipt/$defs/id"
						},
						"snapshotRevision": {
							"type": "string",
							"pattern": "^(0|[1-9][0-9]*)$"
						}
					}
				}
			}
		},
		"agentName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]{0,31}$"
		},
		"providerId": {
			"type": "string",
			"pattern": "^[0-9a-z]([0-9a-z.-]{0,62}[0-9a-z])?$"
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		}
	}
}
