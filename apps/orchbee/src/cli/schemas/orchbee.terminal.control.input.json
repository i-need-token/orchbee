{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.control.input",
	"title": "Windows terminal control stdin NDJSON command (2 MiB per line; decoded input at most 256 KiB)",
	"oneOf": [
		{
			"type": "object",
			"properties": {
				"type": {
					"const": "terminal.input"
				},
				"text": {
					"type": "string",
					"maxLength": 262144
				},
				"bytes": {
					"type": "string",
					"maxLength": 349528,
					"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
				}
			},
			"required": ["type"],
			"additionalProperties": false,
			"oneOf": [
				{
					"required": ["text"],
					"not": {
						"required": ["bytes"]
					}
				},
				{
					"required": ["bytes"],
					"not": {
						"required": ["text"]
					}
				}
			]
		},
		{
			"type": "object",
			"properties": {
				"type": {
					"const": "terminal.resize"
				},
				"cols": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"rows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"cell_width_px": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				},
				"cell_height_px": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				}
			},
			"required": ["type", "cols", "rows"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"type": {
					"const": "terminal.scroll"
				},
				"direction": {
					"enum": ["up", "down"]
				},
				"lines": {
					"type": "integer",
					"minimum": 1,
					"maximum": 65535
				},
				"source": {
					"enum": ["wheel", "page_key"]
				},
				"column": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"row": {
					"type": "integer",
					"minimum": 0,
					"maximum": 65535
				},
				"modifiers": {
					"minimum": 0,
					"maximum": 63,
					"type": "integer"
				}
			},
			"required": ["type", "direction", "lines"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"type": {
					"const": "terminal.release"
				}
			},
			"required": ["type"],
			"additionalProperties": false
		}
	]
}
