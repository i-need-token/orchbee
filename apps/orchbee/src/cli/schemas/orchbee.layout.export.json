{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.layout.export",
	"title": "Windows portable layout export",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.layout.export"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "siteId", "revision", "clientId", "viewRevision"],
			"properties": {
				"kind": {
					"const": "layout-observation"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"$ref": "#/$defs/decimal"
				},
				"clientId": {
					"$ref": "#/$defs/id"
				},
				"viewRevision": {
					"$ref": "#/$defs/decimal",
					"description": "Client view revision used to fence the read request, not a later publication revision."
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["layout"],
			"properties": {
				"layout": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"workspaceId",
						"terminalContextId",
						"tabId",
						"zoomed",
						"focusedPanelId",
						"root"
					],
					"properties": {
						"workspaceId": {
							"oneOf": [
								{
									"$ref": "#/$defs/id"
								},
								{
									"type": "null"
								}
							]
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"zoomed": {
							"type": "boolean"
						},
						"focusedPanelId": {
							"oneOf": [
								{
									"$ref": "#/$defs/id"
								},
								{
									"type": "null"
								}
							]
						},
						"root": {
							"$ref": "#/$defs/node"
						}
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"node": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "panelId", "env"],
					"properties": {
						"type": {
							"const": "panel"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"label": {
							"type": "string",
							"minLength": 1,
							"maxLength": 512
						},
						"cwd": {
							"type": "string",
							"minLength": 1,
							"maxLength": 4096
						},
						"command": {
							"type": "array",
							"minItems": 1,
							"maxItems": 129,
							"prefixItems": [
								{
									"title": "Absolute launch executable",
									"type": "string",
									"minLength": 1,
									"maxLength": 2048,
									"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$",
									"$comment": "The authoritative executable plus arguments bound is 2048 UTF-8 bytes."
								}
							],
							"items": {
								"type": "string",
								"pattern": "^[^\\u0000]*$",
								"maxLength": 2048
							},
							"$comment": "A variadic argv tuple: one absolute executable followed by zero to 128 literal arguments."
						},
						"env": {
							"type": "object",
							"const": {}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "direction", "ratio", "first", "second"],
					"properties": {
						"type": {
							"const": "split"
						},
						"direction": {
							"enum": ["right", "down"]
						},
						"ratio": {
							"type": "number",
							"minimum": 0.1,
							"maximum": 0.9
						},
						"first": {
							"$ref": "#/$defs/node"
						},
						"second": {
							"$ref": "#/$defs/node"
						}
					}
				}
			]
		}
	},
	"$comment": "The projector enforces at most24 leaves, depth16, exact canonical identities, 2048 combined UTF-8 command bytes and a1MiB document limit. cwd is a sequential observation; env is always empty."
}
