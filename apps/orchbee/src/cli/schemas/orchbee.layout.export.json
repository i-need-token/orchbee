{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.layout.export",
	"title": "Windows portable layout export",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.layout.export"
		},
		"version": {
			"enum": [2, 3]
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind", "siteId", "revision", "clientId", "viewRevision"],
			"properties": {
				"kind": {
					"const": "layout-observation"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"$ref": "#/$defs/decimal"
				},
				"clientId": {
					"anyOf": [
						{
							"$ref": "#/$defs/id"
						},
						{
							"type": "null"
						}
					]
				},
				"viewRevision": {
					"anyOf": [
						{
							"$ref": "#/$defs/decimal"
						},
						{
							"type": "null"
						}
					]
				},
				"scope": {
					"const": "shared"
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": ["layout"],
			"properties": {
				"layout": {
					"type": "object",
					"additionalProperties": false,
					"required": [
						"workspaceId",
						"terminalContextId",
						"tabId",
						"zoomed",
						"focusedPanelId",
						"root"
					],
					"properties": {
						"workspaceId": {
							"oneOf": [
								{
									"$ref": "#/$defs/id"
								},
								{
									"type": "null"
								}
							]
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"zoomed": {
							"type": ["boolean", "null"]
						},
						"focusedPanelId": {
							"oneOf": [
								{
									"$ref": "#/$defs/id"
								},
								{
									"type": "null"
								}
							]
						},
						"root": {
							"$ref": "#/$defs/node"
						}
					}
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"node": {
			"oneOf": [
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "panelId", "rightClick", "primary", "children"],
					"properties": {
						"type": {
							"const": "panel"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"rightClick": {
							"enum": ["orchbee", "panel"]
						},
						"primary": {
							"$ref": "#/$defs/member"
						},
						"children": {
							"type": "array",
							"maxItems": 16,
							"items": {
								"$ref": "#/$defs/member"
							}
						}
					}
				},
				{
					"type": "object",
					"additionalProperties": false,
					"required": ["type", "direction", "ratio", "first", "second"],
					"properties": {
						"type": {
							"const": "split"
						},
						"direction": {
							"enum": ["right", "down"]
						},
						"ratio": {
							"type": "number",
							"minimum": 0.1,
							"maximum": 0.9
						},
						"first": {
							"$ref": "#/$defs/node"
						},
						"second": {
							"$ref": "#/$defs/node"
						}
					}
				}
			]
		},
		"member": {
			"type": "object",
			"additionalProperties": false,
			"required": ["presentationId", "name", "start", "env"],
			"properties": {
				"label": {
					"type": "string",
					"minLength": 1,
					"maxLength": 512
				},
				"cwd": {
					"type": "string",
					"minLength": 1,
					"maxLength": 4096
				},
				"command": {
					"type": "array",
					"minItems": 1,
					"maxItems": 129,
					"prefixItems": [
						{
							"title": "Absolute launch executable",
							"type": "string",
							"minLength": 1,
							"maxLength": 30720,
							"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$",
							"$comment": "The authoritative executable plus arguments bound is 30720 UTF-8 bytes and worst-case JSON string-content bytes."
						}
					],
					"items": {
						"type": "string",
						"pattern": "^[^\\u0000]*$",
						"maxLength": 30720
					},
					"$comment": "A variadic argv tuple: one absolute executable followed by zero to 128 literal arguments."
				},
				"env": {
					"type": "object",
					"const": {}
				},
				"presentationId": {
					"$ref": "#/$defs/id"
				},
				"name": {
					"type": "string",
					"minLength": 1,
					"maxLength": 512
				},
				"start": {
					"type": "boolean"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"start": {
								"const": false
							}
						}
					},
					"then": {
						"not": {
							"anyOf": [
								{
									"required": ["cwd"]
								},
								{
									"required": ["command"]
								}
							]
						}
					}
				}
			]
		}
	},
	"$comment": "Exact primary/child observations preserve unbound start:false members. At most 24 Panels and 16 levels, with 16 children per Panel; total 1 MiB and runtime byte bounds are enforced by the CLI.",
	"allOf": [
		{
			"if": {
				"properties": {
					"version": {
						"const": 2
					}
				}
			},
			"then": {
				"properties": {
					"source": {
						"not": {
							"required": ["scope"]
						},
						"properties": {
							"clientId": {
								"$ref": "#/$defs/id"
							},
							"viewRevision": {
								"$ref": "#/$defs/decimal"
							}
						}
					},
					"result": {
						"properties": {
							"layout": {
								"properties": {
									"zoomed": {
										"type": "boolean"
									}
								}
							}
						}
					}
				}
			},
			"else": {
				"properties": {
					"source": {
						"required": ["scope"],
						"properties": {
							"clientId": {
								"type": "null"
							},
							"viewRevision": {
								"type": "null"
							}
						}
					},
					"result": {
						"properties": {
							"layout": {
								"properties": {
									"zoomed": {
										"type": "null"
									},
									"focusedPanelId": {
										"type": "null"
									}
								}
							}
						}
					}
				}
			}
		}
	]
}
