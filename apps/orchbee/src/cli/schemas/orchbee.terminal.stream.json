{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.stream",
	"title": "Windows terminal stream NDJSON record",
	"oneOf": [
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 2
				},
				"kind": {
					"const": "opened"
				},
				"mode": {
					"enum": ["observe", "control"]
				},
				"source": {
					"type": "object",
					"properties": {
						"siteId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"revision": {
							"type": "string",
							"pattern": "^(0|[1-9][0-9]*)$"
						},
						"terminalId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"workerId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"viewerId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"attachmentId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"hostEpoch": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						}
					},
					"required": [
						"siteId",
						"revision",
						"terminalId",
						"workerId",
						"viewerId",
						"attachmentId",
						"hostEpoch"
					],
					"additionalProperties": false
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"controllerId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$"
				}
			},
			"required": ["schema", "version", "kind", "mode", "source", "width", "height"],
			"additionalProperties": false,
			"allOf": [
				{
					"if": {
						"properties": {
							"mode": {
								"const": "control"
							}
						}
					},
					"then": {
						"required": ["controllerId"]
					},
					"else": {
						"not": {
							"required": ["controllerId"]
						}
					}
				}
			]
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 2
				},
				"kind": {
					"const": "frame"
				},
				"encoding": {
					"const": "ansi"
				},
				"full": {
					"const": true
				},
				"sequence": {
					"type": "string",
					"pattern": "^[1-9][0-9]*$"
				},
				"generation": {
					"type": "string",
					"pattern": "^[1-9][0-9]*$"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"sourceWidth": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"sourceHeight": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"bytes": {
					"type": "string",
					"maxLength": 6990508,
					"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
				}
			},
			"required": [
				"schema",
				"version",
				"kind",
				"encoding",
				"full",
				"sequence",
				"generation",
				"revision",
				"width",
				"height",
				"sourceWidth",
				"sourceHeight",
				"bytes"
			],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 2
				},
				"kind": {
					"const": "reset"
				},
				"reason": {
					"enum": [
						"projection-blocked",
						"activity-stale",
						"base-mismatch",
						"decoder-rejected",
						"dimensions-mismatch",
						"generation-mismatch",
						"identity-mismatch",
						"sequence-gap",
						"store-reset",
						"history-pending",
						"history-recovering",
						"resynchronize"
					]
				}
			},
			"required": ["schema", "version", "kind", "reason"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 2
				},
				"kind": {
					"const": "closed"
				},
				"reason": {
					"enum": [
						"ambiguous",
						"cancelled",
						"check-failed",
						"denied",
						"incompatible",
						"internal-failure",
						"invalid-identifier",
						"invalid-usage",
						"not-found",
						"outcome-unknown",
						"output-too-large",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"session-capacity",
						"timeout",
						"transport-loss",
						"stdin-eof",
						"released"
					]
				},
				"cleanup": {
					"enum": ["not-attached", "session-released", "detached"]
				}
			},
			"required": ["schema", "version", "kind", "reason", "cleanup"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 2
				},
				"kind": {
					"const": "control"
				},
				"ordinal": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"operation": {
					"enum": ["acquire", "parse", "input", "resize", "scroll"]
				},
				"outcome": {
					"oneOf": [
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "input-accepted"
								},
								"acceptedBytes": {
									"type": "integer",
									"minimum": 0,
									"maximum": 262144
								}
							},
							"required": ["kind", "acceptedBytes"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "scroll-accepted"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "rejected"
								},
								"reason": {
									"type": "string",
									"minLength": 1,
									"maxLength": 80
								}
							},
							"required": ["kind", "reason"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "unavailable"
								},
								"reason": {
									"type": "string",
									"minLength": 1,
									"maxLength": 80
								}
							},
							"required": ["kind", "reason"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "outcome-unknown"
								}
							},
							"required": ["kind"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "failed"
								},
								"reason": {
									"type": "string",
									"minLength": 1,
									"maxLength": 80
								},
								"acceptedBytes": {
									"type": "integer",
									"minimum": 0,
									"maximum": 262144
								},
								"deliveryMayBeUnknown": {
									"const": true
								}
							},
							"required": ["kind", "reason", "acceptedBytes", "deliveryMayBeUnknown"],
							"additionalProperties": false
						},
						{
							"type": "object",
							"properties": {
								"kind": {
									"const": "resized"
								},
								"geometry": {
									"type": "object",
									"properties": {
										"columns": {
											"type": "integer",
											"minimum": 1,
											"maximum": 4096
										},
										"rows": {
											"type": "integer",
											"minimum": 1,
											"maximum": 4096
										},
										"cellPixelWidth": {
											"type": "integer",
											"minimum": 0,
											"maximum": 4096
										},
										"cellPixelHeight": {
											"type": "integer",
											"minimum": 0,
											"maximum": 4096
										}
									},
									"required": ["columns", "rows", "cellPixelWidth", "cellPixelHeight"],
									"additionalProperties": false
								}
							},
							"required": ["kind", "geometry"],
							"additionalProperties": false
						}
					]
				}
			},
			"required": ["schema", "version", "kind", "ordinal", "operation", "outcome"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 2
				},
				"kind": {
					"const": "history"
				},
				"encoding": {
					"const": "ansi"
				},
				"full": {
					"const": true
				},
				"sequence": {
					"type": "string",
					"pattern": "^[1-9][0-9]*$"
				},
				"generation": {
					"type": "string",
					"pattern": "^[1-9][0-9]*$"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"bytes": {
					"type": "string",
					"maxLength": 6990508,
					"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
				},
				"startRow": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"totalRows": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				}
			},
			"required": [
				"schema",
				"version",
				"kind",
				"encoding",
				"full",
				"sequence",
				"generation",
				"revision",
				"width",
				"height",
				"bytes",
				"startRow",
				"totalRows"
			],
			"additionalProperties": false
		}
	]
}
