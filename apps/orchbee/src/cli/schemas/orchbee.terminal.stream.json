{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.stream",
	"title": "Windows terminal stream NDJSON record",
	"oneOf": [
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 1
				},
				"kind": {
					"const": "opened"
				},
				"mode": {
					"const": "observe"
				},
				"source": {
					"type": "object",
					"properties": {
						"siteId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"revision": {
							"type": "string",
							"pattern": "^(0|[1-9][0-9]*)$"
						},
						"terminalId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"workerId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"viewerId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"attachmentId": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						},
						"hostEpoch": {
							"type": "string",
							"pattern": "^[0-9a-f]{32}$"
						}
					},
					"required": [
						"siteId",
						"revision",
						"terminalId",
						"workerId",
						"viewerId",
						"attachmentId",
						"hostEpoch"
					],
					"additionalProperties": false
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				}
			},
			"required": ["schema", "version", "kind", "mode", "source", "width", "height"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 1
				},
				"kind": {
					"const": "frame"
				},
				"encoding": {
					"const": "ansi"
				},
				"full": {
					"const": true
				},
				"sequence": {
					"type": "string",
					"pattern": "^[1-9][0-9]*$"
				},
				"generation": {
					"type": "string",
					"pattern": "^[1-9][0-9]*$"
				},
				"revision": {
					"type": "string",
					"pattern": "^(0|[1-9][0-9]*)$"
				},
				"width": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"height": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"sourceWidth": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"sourceHeight": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"bytes": {
					"type": "string",
					"maxLength": 6990508,
					"pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
				}
			},
			"required": [
				"schema",
				"version",
				"kind",
				"encoding",
				"full",
				"sequence",
				"generation",
				"revision",
				"width",
				"height",
				"sourceWidth",
				"sourceHeight",
				"bytes"
			],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 1
				},
				"kind": {
					"const": "reset"
				},
				"reason": {
					"enum": [
						"projection-blocked",
						"activity-stale",
						"base-mismatch",
						"decoder-rejected",
						"dimensions-mismatch",
						"generation-mismatch",
						"identity-mismatch",
						"sequence-gap",
						"store-reset"
					]
				}
			},
			"required": ["schema", "version", "kind", "reason"],
			"additionalProperties": false
		},
		{
			"type": "object",
			"properties": {
				"schema": {
					"const": "orchbee.terminal.stream"
				},
				"version": {
					"const": 1
				},
				"kind": {
					"const": "closed"
				},
				"reason": {
					"enum": [
						"ambiguous",
						"cancelled",
						"check-failed",
						"denied",
						"incompatible",
						"internal-failure",
						"invalid-identifier",
						"invalid-usage",
						"not-found",
						"outcome-unknown",
						"output-too-large",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"session-capacity",
						"timeout",
						"transport-loss"
					]
				},
				"cleanup": {
					"enum": ["not-attached", "session-released", "detached"]
				}
			},
			"required": ["schema", "version", "kind", "reason", "cleanup"],
			"additionalProperties": false
		}
	]
}
