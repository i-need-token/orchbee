{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.get",
	"title": "orchbee terminal get envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.terminal.get"
		},
		"version": {
			"const": 4
		},
		"source": {
			"$ref": "#/$defs/launchReadSource"
		},
		"result": {
			"type": "object",
			"required": ["terminal"],
			"additionalProperties": false,
			"properties": {
				"terminal": {
					"$ref": "#/$defs/terminal"
				}
			}
		}
	},
	"$defs": {
		"id": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"decimal": {
			"type": "string",
			"pattern": "^(0|[1-9][0-9]*)$"
		},
		"positiveDecimal": {
			"type": "string",
			"pattern": "^[1-9][0-9]*$"
		},
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo", "launch"],
			"additionalProperties": false,
			"properties": {
				"terminalId": {
					"$ref": "#/$defs/id"
				},
				"workerId": {
					"$ref": "#/$defs/id"
				},
				"launch": {
					"$ref": "#/$defs/launch"
				},
				"launchSelection": {
					"$ref": "#/$defs/launchSelection"
				},
				"launchProfile": {
					"type": "object",
					"required": ["profileId", "catalogRevision"],
					"additionalProperties": false,
					"properties": {
						"profileId": {
							"type": "string",
							"pattern": "^[0-9A-Za-z][0-9A-Za-z._:-]{0,127}$"
						},
						"catalogRevision": {
							"$ref": "#/$defs/decimal"
						}
					}
				},
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": {
							"$ref": "#/$defs/id"
						},
						"panelId": {
							"$ref": "#/$defs/id"
						},
						"tabId": {
							"$ref": "#/$defs/id"
						},
						"terminalContextId": {
							"$ref": "#/$defs/id"
						}
					}
				}
			},
			"allOf": [
				{
					"if": {
						"required": ["launch"],
						"properties": {
							"launch": {
								"type": "object",
								"required": ["state"],
								"properties": {
									"state": {
										"const": "not-tracked"
									}
								}
							}
						}
					},
					"then": {
						"properties": {
							"launchSelection": false
						}
					}
				}
			]
		},
		"launchSelection": {
			"type": "object",
			"additionalProperties": false,
			"required": ["exec", "args"],
			"properties": {
				"exec": {
					"title": "Absolute local-platform working directory intent",
					"type": "string",
					"minLength": 1,
					"maxLength": 30720,
					"pattern": "^(?:/|(?:\\\\\\\\\\?\\\\)?[A-Za-z]:[/\\\\])[^\\u0000]*$",
					"$comment": "The combined executable/arguments bound is 30720 UTF-8 bytes and 30720 worst-case escaped JSON string-content bytes; code-point limits are necessary but not sufficient."
				},
				"args": {
					"type": "array",
					"maxItems": 128,
					"items": {
						"type": "string",
						"pattern": "^[^\\u0000]*$",
						"maxLength": 30720
					}
				}
			},
			"$comment": "Executable and arguments together are at most 30720 UTF-8 bytes and worst-case JSON string-content bytes, enforced by the binding."
		},
		"geometry": {
			"type": "object",
			"required": ["columns", "rows", "cellPixelWidth", "cellPixelHeight"],
			"additionalProperties": false,
			"properties": {
				"columns": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"rows": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4096
				},
				"cellPixelWidth": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				},
				"cellPixelHeight": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4096
				}
			}
		},
		"createAcceptedState": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "awaiting-start"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "geometry"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "started"
						},
						"geometry": {
							"$ref": "#/$defs/geometry"
						}
					}
				}
			]
		},
		"createOutcome": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind", "state"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "accepted"
						},
						"state": {
							"$ref": "#/$defs/createAcceptedState"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "reason"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "rejected"
						},
						"reason": {
							"enum": ["not-authorized", "worker-constraint-unsatisfied", "cwd-not-accepted"]
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "reason"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["no-compatible-worker", "terminal-runtime-unavailable", "server-busy"]
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "reason"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "failed"
						},
						"reason": {
							"const": "terminal-create-failed"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "outcome-unknown"
						}
					}
				}
			]
		},
		"launch": {
			"type": "object",
			"required": ["state", "workerGeneration", "createOutcome", "geometry"],
			"additionalProperties": false,
			"properties": {
				"state": {
					"enum": [
						"creating",
						"awaiting-start",
						"starting",
						"started",
						"unknown",
						"unavailable",
						"not-tracked"
					]
				},
				"workerGeneration": {
					"type": ["string", "null"],
					"pattern": "^[1-9][0-9]*$"
				},
				"createOutcome": {
					"oneOf": [
						{
							"$ref": "#/$defs/createOutcome"
						},
						{
							"type": "null"
						}
					]
				},
				"geometry": {
					"oneOf": [
						{
							"$ref": "#/$defs/geometry"
						},
						{
							"type": "null"
						}
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"state": {
								"const": "started"
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"geometry": {
								"type": "object"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"enum": [
									"creating",
									"awaiting-start",
									"starting",
									"unknown",
									"unavailable",
									"not-tracked"
								]
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"geometry": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"const": "not-tracked"
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"workerGeneration": {
								"type": "null"
							},
							"createOutcome": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"enum": [
									"creating",
									"awaiting-start",
									"starting",
									"started",
									"unknown",
									"unavailable"
								]
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"workerGeneration": {
								"type": "string"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"enum": ["creating", "not-tracked"]
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"createOutcome": {
								"type": "null"
							}
						}
					}
				},
				{
					"if": {
						"properties": {
							"state": {
								"enum": ["awaiting-start", "starting", "started", "unknown", "unavailable"]
							}
						},
						"required": ["state"]
					},
					"then": {
						"properties": {
							"createOutcome": {
								"type": "object"
							}
						}
					}
				}
			]
		},
		"launchReadSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "terminal-launch-read"
				},
				"siteId": {
					"$ref": "#/$defs/id"
				},
				"revision": {
					"$ref": "#/$defs/decimal"
				}
			}
		}
	}
}
