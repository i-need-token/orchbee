{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.terminal.get",
	"title": "orchbee terminal get envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": { "const": "orchbee.terminal.get" },
		"version": { "const": 1 },
		"source": { "$ref": "#/$defs/snapshotSource" },
		"result": {
			"type": "object",
			"required": ["terminal"],
			"additionalProperties": false,
			"properties": {
				"terminal": { "$ref": "#/$defs/terminal" }
			}
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
		"terminal": {
			"type": "object",
			"required": ["terminalId", "workerId", "boundTo"],
			"additionalProperties": false,
			"properties": {
				"terminalId": { "$ref": "#/$defs/id" },
				"workerId": { "$ref": "#/$defs/id" },
				"boundTo": {
					"type": "object",
					"required": ["presentationId", "panelId", "tabId", "terminalContextId"],
					"additionalProperties": false,
					"properties": {
						"presentationId": { "$ref": "#/$defs/id" },
						"panelId": { "$ref": "#/$defs/id" },
						"tabId": { "$ref": "#/$defs/id" },
						"terminalContextId": { "$ref": "#/$defs/id" }
					}
				}
			}
		},
		"snapshotSource": {
			"type": "object",
			"required": ["kind", "siteId", "revision"],
			"additionalProperties": false,
			"properties": {
				"kind": { "const": "workbench-snapshot" },
				"siteId": { "$ref": "#/$defs/id" },
				"revision": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
			}
		}
	}
}
