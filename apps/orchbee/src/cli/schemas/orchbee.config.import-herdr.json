{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.config.import-herdr",
	"title": "Explicit offline Windows Herdr configuration import result",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "version", "source", "result"],
	"properties": {
		"schema": {
			"const": "orchbee.config.import-herdr"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "local-configuration"
				}
			}
		},
		"result": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"state",
				"sourcePath",
				"destinationPath",
				"candidateBytes",
				"fields",
				"omittedCount",
				"created",
				"recoveryRequired",
				"error"
			],
			"properties": {
				"state": {
					"enum": ["preview", "created", "failed"]
				},
				"sourcePath": {
					"type": ["string", "null"],
					"maxLength": 8192
				},
				"destinationPath": {
					"type": ["string", "null"],
					"maxLength": 8192
				},
				"candidateBytes": {
					"type": ["integer", "null"],
					"minimum": 0,
					"maximum": 65536
				},
				"fields": {
					"type": "array",
					"maxItems": 128,
					"items": {
						"type": "object",
						"additionalProperties": false,
						"required": ["field", "targetFields", "disposition", "reason"],
						"properties": {
							"field": {
								"type": "string",
								"minLength": 1,
								"maxLength": 256
							},
							"targetFields": {
								"type": "array",
								"maxItems": 2,
								"items": {
									"type": "string",
									"minLength": 1,
									"maxLength": 256
								}
							},
							"disposition": {
								"enum": ["mapped", "defaulted", "disabled", "ignored", "unsupported"]
							},
							"reason": {
								"type": "string",
								"minLength": 1,
								"maxLength": 64,
								"pattern": "^[a-z][a-z0-9-]*$"
							}
						}
					}
				},
				"omittedCount": {
					"type": "integer",
					"minimum": 0
				},
				"created": {
					"type": "boolean"
				},
				"recoveryRequired": {
					"type": "boolean"
				},
				"error": {
					"oneOf": [
						{
							"type": "null"
						},
						{
							"type": "object",
							"additionalProperties": false,
							"required": ["stage", "reason"],
							"properties": {
								"stage": {
									"enum": [
										"source",
										"destination",
										"candidate",
										"create",
										"protect",
										"write",
										"synchronize"
									]
								},
								"reason": {
									"type": "string",
									"minLength": 1,
									"maxLength": 64,
									"pattern": "^[a-z][a-z0-9-]*$"
								}
							}
						}
					]
				},
				"candidateToml": {
					"type": "string",
					"maxLength": 65536
				}
			},
			"oneOf": [
				{
					"required": ["candidateToml"],
					"properties": {
						"sourcePath": {
							"type": "string",
							"minLength": 1
						},
						"destinationPath": {
							"type": "string",
							"minLength": 1
						},
						"candidateBytes": {
							"type": "integer",
							"minimum": 1
						},
						"error": {
							"type": "null"
						},
						"recoveryRequired": {
							"const": false
						},
						"state": {
							"const": "preview"
						},
						"created": {
							"const": false
						},
						"candidateToml": {}
					}
				},
				{
					"not": {
						"required": ["candidateToml"],
						"properties": {
							"candidateToml": {}
						}
					},
					"properties": {
						"sourcePath": {
							"type": "string",
							"minLength": 1
						},
						"destinationPath": {
							"type": "string",
							"minLength": 1
						},
						"candidateBytes": {
							"type": "integer",
							"minimum": 1
						},
						"error": {
							"type": "null"
						},
						"recoveryRequired": {
							"const": false
						},
						"state": {
							"const": "created"
						},
						"created": {
							"const": true
						}
					}
				},
				{
					"not": {
						"required": ["candidateToml"],
						"properties": {
							"candidateToml": {}
						}
					},
					"properties": {
						"state": {
							"const": "failed"
						},
						"error": {
							"type": "object",
							"additionalProperties": false,
							"required": ["stage", "reason"],
							"properties": {
								"stage": {
									"enum": [
										"source",
										"destination",
										"candidate",
										"create",
										"protect",
										"write",
										"synchronize"
									]
								},
								"reason": {
									"type": "string",
									"minLength": 1,
									"maxLength": 64,
									"pattern": "^[a-z][a-z0-9-]*$"
								}
							}
						}
					},
					"allOf": [
						{
							"if": {
								"properties": {
									"created": {
										"const": true
									}
								}
							},
							"then": {
								"properties": {
									"recoveryRequired": {
										"const": true
									},
									"error": {
										"type": "object",
										"additionalProperties": false,
										"required": ["stage", "reason"],
										"properties": {
											"stage": {
												"enum": ["protect", "write", "synchronize"]
											},
											"reason": {
												"type": "string",
												"minLength": 1,
												"maxLength": 64,
												"pattern": "^[a-z][a-z0-9-]*$"
											}
										}
									}
								}
							},
							"else": {
								"properties": {
									"recoveryRequired": {
										"const": false
									},
									"error": {
										"type": "object",
										"additionalProperties": false,
										"required": ["stage", "reason"],
										"properties": {
											"stage": {
												"enum": ["source", "destination", "candidate", "create"]
											},
											"reason": {
												"type": "string",
												"minLength": 1,
												"maxLength": 64,
												"pattern": "^[a-z][a-z0-9-]*$"
											}
										}
									}
								}
							}
						}
					]
				}
			]
		}
	}
}
