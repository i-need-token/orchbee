{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.agent.names",
	"title": "orchbee agent names envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.agent.names"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-names"
				},
				"requestId": {
					"$ref": "#/$defs/obapRequestId"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["kind", "bindings", "pending"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "listed-targets"
				},
				"bindings": {
					"type": "array",
					"maxItems": 512,
					"items": {
						"$ref": "#/$defs/namedTarget"
					}
				},
				"pending": {
					"type": "array",
					"maxItems": 512,
					"items": {
						"$ref": "#/$defs/launchReservation"
					}
				}
			}
		}
	},
	"$defs": {
		"agentName": {
			"type": "string",
			"pattern": "^[a-z][a-z0-9_-]{0,31}$"
		},
		"sessionId": {
			"$ref": "#/$defs/opaqueIdentity"
		},
		"opaqueIdentity": {
			"type": "string",
			"pattern": "^[A-Za-z0-9._:-]{1,128}$"
		},
		"obapRequestId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$"
		},
		"launchBinding": {
			"type": "object",
			"required": ["presentationId", "generation", "hostEpoch", "hostTerminalId"],
			"additionalProperties": false,
			"properties": {
				"presentationId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"generation": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostEpoch": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				},
				"hostTerminalId": {
					"type": "string",
					"pattern": "^[0-9a-f]{32}$",
					"not": {
						"const": "00000000000000000000000000000000"
					}
				}
			}
		},
		"launchReservation": {
			"type": "object",
			"required": [
				"reservationId",
				"name",
				"providerId",
				"binding",
				"remainingMs",
				"settleRemainingMs"
			],
			"additionalProperties": false,
			"properties": {
				"reservationId": {
					"$ref": "#/$defs/obapRequestId"
				},
				"name": {
					"$ref": "#/$defs/agentName"
				},
				"providerId": {
					"$ref": "#/$defs/providerId"
				},
				"binding": {
					"$ref": "#/$defs/launchBinding"
				},
				"remainingMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 300000
				},
				"settleRemainingMs": {
					"type": "integer",
					"minimum": 0,
					"maximum": 3000
				}
			}
		},
		"providerId": {
			"type": "string",
			"pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$",
			"maxLength": 64
		},
		"nameTarget": {
			"oneOf": [
				{
					"type": "object",
					"required": ["kind", "sessionId"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "session"
						},
						"sessionId": {
							"$ref": "#/$defs/sessionId"
						}
					}
				},
				{
					"type": "object",
					"required": ["kind", "binding"],
					"additionalProperties": false,
					"properties": {
						"kind": {
							"const": "terminal"
						},
						"binding": {
							"$ref": "#/$defs/launchBinding"
						}
					}
				}
			]
		},
		"namedTarget": {
			"type": "object",
			"required": ["name", "target"],
			"additionalProperties": false,
			"properties": {
				"name": {
					"$ref": "#/$defs/agentName"
				},
				"target": {
					"$ref": "#/$defs/nameTarget"
				}
			}
		}
	}
}
