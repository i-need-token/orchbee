{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.agent",
	"title": "orchbee cli agent read failure envelope",
	"type": "object",
	"required": ["schema", "version", "failure"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.cli.failure.agent"
		},
		"version": {
			"enum": [1, 2]
		},
		"failure": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"cancelled",
						"denied",
						"internal-failure",
						"not-found",
						"protocol-invalid",
						"rejected",
						"service-unavailable",
						"timeout",
						"transport-loss"
					]
				},
				"details": {
					"type": "object"
				}
			}
		},
		"source": {
			"$ref": "#/$defs/source"
		}
	},
	"allOf": [
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"const": "not-found"
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"required": ["details"],
						"properties": {
							"details": {
								"$ref": "#/$defs/notFoundDetails"
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"const": "denied"
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"required": ["details"],
						"properties": {
							"details": {
								"$ref": "#/$defs/deniedDetails"
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"const": "rejected"
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"required": ["details"],
						"properties": {
							"details": {
								"oneOf": [
									{
										"$ref": "#/$defs/rejectedDetails"
									},
									{
										"$ref": "#/$defs/revisionAheadDetails"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"const": "service-unavailable"
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"required": ["details"],
						"properties": {
							"details": {
								"$ref": "#/$defs/unavailableDetails"
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"const": "timeout"
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"required": ["details"],
						"properties": {
							"details": {
								"oneOf": [
									{
										"$ref": "#/$defs/timeoutDetails"
									},
									{
										"$ref": "#/$defs/waitTimeoutDetails"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"enum": ["cancelled", "protocol-invalid", "transport-loss"]
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"required": ["details"],
						"properties": {
							"details": {
								"$ref": "#/$defs/commonDetails"
							}
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"kind": {
								"const": "internal-failure"
							}
						},
						"required": ["kind"]
					}
				}
			},
			"then": {
				"properties": {
					"failure": {
						"not": {
							"required": ["details"]
						}
					}
				}
			}
		},
		{
			"if": {
				"properties": {
					"failure": {
						"properties": {
							"details": {
								"properties": {
									"timeoutMs": {
										"type": "null"
									}
								},
								"required": ["timeoutMs"]
							}
						},
						"required": ["details"]
					}
				},
				"required": ["failure"]
			},
			"then": {
				"properties": {
					"version": {
						"const": 2
					}
				}
			},
			"else": {
				"properties": {
					"version": {
						"const": 1
					}
				}
			}
		}
	],
	"$defs": {
		"hexId": {
			"type": "string",
			"pattern": "^[0-9a-f]{32}$",
			"not": {
				"const": "00000000000000000000000000000000"
			}
		},
		"opaqueId": {
			"type": "string",
			"pattern": "^[0-9A-Za-z._:-]{1,128}$"
		},
		"safeInteger": {
			"type": "integer",
			"minimum": 0,
			"maximum": 9007199254740991
		},
		"operation": {
			"enum": ["explain", "get", "list", "wait", "changes"]
		},
		"statusKind": {
			"enum": [
				"needs-attention",
				"failed",
				"succeeded",
				"canceled",
				"interrupted",
				"working",
				"idle",
				"unknown",
				"ended"
			]
		},
		"commonDetails": {
			"type": "object",
			"required": ["stage", "operation"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"$ref": "#/$defs/operation"
				}
			}
		},
		"notFoundDetails": {
			"type": "object",
			"required": ["stage", "operation", "sessionId"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"enum": ["explain", "get", "wait"]
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				}
			}
		},
		"deniedDetails": {
			"type": "object",
			"required": ["stage", "operation", "reason"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"$ref": "#/$defs/operation"
				},
				"reason": {
					"const": "read-denied"
				}
			}
		},
		"rejectedDetails": {
			"oneOf": [
				{
					"type": "object",
					"required": ["stage", "operation", "reason"],
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "agent-read"
						},
						"operation": {
							"const": "list"
						},
						"reason": {
							"enum": ["cursor-invalid", "cursor-stale"]
						}
					}
				},
				{
					"type": "object",
					"required": ["stage", "operation", "reason"],
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "agent-read"
						},
						"operation": {
							"const": "changes"
						},
						"reason": {
							"const": "cursor-invalid"
						}
					}
				},
				{
					"type": "object",
					"required": ["stage", "operation", "reason"],
					"additionalProperties": false,
					"properties": {
						"stage": {
							"const": "agent-read"
						},
						"operation": {
							"const": "wait"
						},
						"reason": {
							"enum": ["history-lost", "session-ended"]
						}
					}
				}
			]
		},
		"revisionAheadDetails": {
			"type": "object",
			"required": ["stage", "operation", "sessionId", "afterRevision", "revision"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"const": "wait"
				},
				"sessionId": {
					"$ref": "#/$defs/opaqueId"
				},
				"afterRevision": {
					"$ref": "#/$defs/safeInteger"
				},
				"revision": {
					"$ref": "#/$defs/safeInteger"
				}
			}
		},
		"unavailableDetails": {
			"type": "object",
			"required": ["stage", "operation", "reason"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"$ref": "#/$defs/operation"
				},
				"reason": {
					"const": "runtime-unavailable"
				}
			}
		},
		"timeoutDetails": {
			"type": "object",
			"required": ["stage", "operation", "timeoutMs"],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"enum": ["explain", "get", "list", "changes"]
				},
				"timeoutMs": {
					"const": 5000
				}
			}
		},
		"waitTimeoutDetails": {
			"type": "object",
			"required": [
				"stage",
				"operation",
				"timeoutMs",
				"elapsedMs",
				"reason",
				"completedObservations"
			],
			"additionalProperties": false,
			"properties": {
				"stage": {
					"const": "agent-read"
				},
				"operation": {
					"const": "wait"
				},
				"timeoutMs": {
					"type": ["integer", "null"],
					"minimum": 1,
					"maximum": 3600000
				},
				"elapsedMs": {
					"$ref": "#/$defs/safeInteger"
				},
				"reason": {
					"enum": ["read-deadline", "wait-deadline"]
				},
				"readBudgetMs": {
					"type": "integer",
					"minimum": 1,
					"maximum": 5000
				},
				"completedObservations": {
					"$ref": "#/$defs/safeInteger"
				},
				"lastStatusKind": {
					"$ref": "#/$defs/statusKind"
				},
				"lastFreshness": {
					"enum": ["disconnected", "fresh", "stale"]
				},
				"lastRevision": {
					"$ref": "#/$defs/safeInteger"
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"reason": {
								"const": "read-deadline"
							}
						},
						"required": ["reason"]
					},
					"then": {
						"required": ["readBudgetMs"]
					}
				},
				{
					"if": {
						"properties": {
							"reason": {
								"const": "wait-deadline"
							}
						},
						"required": ["reason"]
					},
					"then": {
						"not": {
							"required": ["readBudgetMs"]
						}
					}
				},
				{
					"if": {
						"properties": {
							"completedObservations": {
								"const": 0
							}
						},
						"required": ["completedObservations"]
					},
					"then": {
						"not": {
							"anyOf": [
								{
									"required": ["lastStatusKind"]
								},
								{
									"required": ["lastFreshness"]
								},
								{
									"required": ["lastRevision"]
								}
							]
						}
					}
				},
				{
					"if": {
						"properties": {
							"completedObservations": {
								"minimum": 1
							}
						},
						"required": ["completedObservations"]
					},
					"then": {
						"required": ["lastStatusKind", "lastFreshness", "lastRevision"]
					}
				}
			]
		},
		"source": {
			"type": "object",
			"required": ["kind", "requestId"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "agent-read"
				},
				"requestId": {
					"$ref": "#/$defs/hexId"
				}
			}
		}
	}
}
