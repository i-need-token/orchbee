{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.cli.failure.configuration",
	"title": "Windows CLI configuration preparation failure",
	"type": "object",
	"required": ["schema", "version", "failure"],
	"additionalProperties": false,
	"properties": {
		"source": {
			"type": "object",
			"additionalProperties": false,
			"required": ["kind"],
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"schema": {
			"const": "orchbee.cli.failure.configuration"
		},
		"version": {
			"const": 1
		},
		"failure": {
			"type": "object",
			"required": ["kind", "details"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"enum": [
						"check-failed",
						"timeout",
						"cancelled",
						"transport-loss",
						"internal-failure",
						"protocol-invalid",
						"service-unavailable"
					]
				},
				"details": {
					"$ref": "#/$defs/configurationFailureDetails"
				}
			}
		}
	},
	"$defs": {
		"configurationFailureDetails": {
			"type": "object",
			"required": ["field", "reason"],
			"additionalProperties": false,
			"properties": {
				"field": {
					"type": "string",
					"minLength": 1,
					"maxLength": 256,
					"pattern": "^(?:[A-Z][A-Z0-9_]*|[a-z][a-z0-9_]*(?:[.\\[][^\\u0000-\\u001f\\u007f-\\u009f]*)?)$"
				},
				"reason": {
					"enum": [
						"invalid-path",
						"missing",
						"io-error",
						"not-file",
						"too-large",
						"invalid-utf8",
						"invalid-toml",
						"unknown-key",
						"wrong-type",
						"invalid-value",
						"invalid-mode",
						"value-too-long",
						"invalid-channel",
						"unknown-profile",
						"unclosed-brace",
						"unknown-token",
						"unmatched-brace",
						"invalid-binding",
						"reserved-binding",
						"unsafe-binding",
						"duplicate-binding",
						"too-many-bindings",
						"invalid-layout",
						"invalid-color",
						"invalid-token",
						"invalid-rules",
						"invalid-agent",
						"invalid-delay",
						"too-many-agents",
						"source-query-failed",
						"source-query-interrupted",
						"read-only",
						"file-in-use",
						"locked",
						"changed"
					]
				},
				"line": {
					"type": "integer",
					"minimum": 1
				},
				"column": {
					"type": "integer",
					"minimum": 1
				}
			},
			"if": {
				"properties": {
					"reason": {
						"enum": ["invalid-toml", "invalid-utf8"]
					}
				},
				"required": ["reason"]
			},
			"then": {
				"required": ["line", "column"]
			},
			"else": {
				"not": {
					"anyOf": [
						{
							"required": ["line"]
						},
						{
							"required": ["column"]
						}
					]
				}
			}
		}
	}
}
