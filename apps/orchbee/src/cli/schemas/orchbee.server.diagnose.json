{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.server.diagnose",
	"title": "orchbee server diagnose envelope",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.server.diagnose"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": [
				"complete",
				"scope",
				"runtimeBase",
				"runtimeDirectory",
				"marker",
				"locks",
				"endpoints",
				"hostScope",
				"unrecognizedRecords",
				"advisories"
			],
			"additionalProperties": false,
			"properties": {
				"complete": {
					"type": "boolean"
				},
				"scope": {
					"anyOf": [
						{
							"type": "string",
							"pattern": "^orchbee-native-[0-9]+$"
						},
						{
							"type": "string",
							"pattern": "^(orchbee-native-[0-9a-f]{32}|orchbee-session-[0-9a-f]{47})$"
						}
					]
				},
				"runtimeBase": {
					"$ref": "#/$defs/row"
				},
				"runtimeDirectory": {
					"$ref": "#/$defs/row"
				},
				"marker": {
					"$ref": "#/$defs/row"
				},
				"locks": {
					"type": "object",
					"required": ["activation", "sessionLifetime"],
					"additionalProperties": false,
					"properties": {
						"activation": {
							"$ref": "#/$defs/row"
						},
						"sessionLifetime": {
							"$ref": "#/$defs/row"
						}
					}
				},
				"endpoints": {
					"type": "object",
					"required": ["client", "worker", "clientPending", "agentObservation", "hostEndpoint"],
					"additionalProperties": false,
					"properties": {
						"client": {
							"$ref": "#/$defs/row"
						},
						"worker": {
							"$ref": "#/$defs/row"
						},
						"clientPending": {
							"$ref": "#/$defs/row"
						},
						"agentObservation": {
							"$ref": "#/$defs/row"
						},
						"hostEndpoint": {
							"$ref": "#/$defs/row"
						}
					}
				},
				"hostScope": {
					"oneOf": [
						{
							"$ref": "#/$defs/row"
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"unrecognizedRecords": {
					"oneOf": [
						{
							"$ref": "#/$defs/unrecognizedRecords"
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"advisories": {
					"type": "array",
					"items": {
						"enum": [
							"activation-recorded",
							"socket-residue",
							"pipe-name-present",
							"unrecognized-records"
						]
					}
				}
			}
		}
	},
	"$defs": {
		"unrecognizedRecords": {
			"type": "object",
			"required": ["state", "reason", "records"],
			"additionalProperties": false,
			"properties": {
				"state": {
					"enum": ["known", "uninspectable"]
				},
				"reason": {
					"anyOf": [
						{
							"enum": [
								"denied",
								"io-error",
								"invalid-path",
								"parent-unavailable",
								"deadline",
								"observation-limit"
							]
						},
						{
							"type": "null"
						}
					]
				},
				"records": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/unrecognizedRecord"
					}
				}
			},
			"if": {
				"properties": {
					"state": {
						"const": "known"
					}
				}
			},
			"then": {
				"properties": {
					"reason": {
						"type": "null"
					}
				}
			},
			"else": {
				"properties": {
					"reason": {
						"type": "string"
					},
					"records": {
						"maxItems": 0
					}
				}
			}
		},
		"unrecognizedRecord": {
			"type": "object",
			"required": ["record", "reason", "path", "pathUtf16"],
			"additionalProperties": false,
			"properties": {
				"record": {
					"enum": ["runtime-directory", "catalog-record", "deletion-intent"]
				},
				"reason": {
					"enum": ["obsolete-identity", "unreadable"]
				},
				"path": {
					"anyOf": [
						{
							"type": "string",
							"minLength": 1
						},
						{
							"type": "null"
						}
					]
				},
				"pathUtf16": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						},
						{
							"type": "null"
						}
					]
				}
			}
		},
		"row": {
			"type": "object",
			"required": [
				"state",
				"reason",
				"kind",
				"ownerMatch",
				"mode",
				"size",
				"linkCount",
				"path",
				"pathBytesHex",
				"private",
				"pathUtf16",
				"activation",
				"stopRequestId"
			],
			"additionalProperties": false,
			"properties": {
				"state": {
					"anyOf": [
						{
							"enum": ["known", "absent", "unsafe", "uninspectable", "free", "held"]
						},
						{
							"enum": ["known", "absent", "uninspectable", "free", "held", "unsafe"]
						}
					]
				},
				"reason": {
					"oneOf": [
						{
							"anyOf": [
								{
									"anyOf": [
										{
											"enum": [
												"symlink",
												"invalid-kind",
												"foreign-owner",
												"invalid-mode",
												"invalid-size",
												"invalid-link-count",
												"invalid-lock",
												"denied",
												"io-error",
												"invalid-path",
												"identity-changed",
												"unsafe-parent",
												"parent-unavailable",
												"deadline"
											]
										},
										{
											"enum": [
												"denied",
												"io-error",
												"invalid-path",
												"parent-unavailable",
												"deadline",
												"observation-limit"
											]
										}
									]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"kind": {
					"oneOf": [
						{
							"anyOf": [
								{
									"enum": ["socket", "regular", "directory", "symlink", "other"]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"ownerMatch": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "boolean"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"mode": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "string",
									"pattern": "^[0-7]{4,}$"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"size": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"linkCount": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "integer",
									"minimum": 0
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"path": {
					"oneOf": [
						{
							"anyOf": [
								{
									"anyOf": [
										{
											"type": "string",
											"minLength": 1
										},
										{
											"type": "string"
										}
									]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"pathBytesHex": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "string",
									"pattern": "^([0-9a-f]{2})+$"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"private": {
					"oneOf": [
						{
							"anyOf": [
								{
									"const": true
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"pathUtf16": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "array",
									"items": {
										"type": "integer",
										"minimum": 0,
										"maximum": 65535
									}
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"activation": {
					"oneOf": [
						{
							"anyOf": [
								{
									"enum": ["active", "stopped"]
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				},
				"stopRequestId": {
					"oneOf": [
						{
							"anyOf": [
								{
									"type": "string",
									"pattern": "^(?!0{32}$)[0-9a-f]{32}$"
								},
								{
									"type": "null"
								},
								{
									"const": "unknown"
								}
							]
						},
						{
							"$ref": "#/$defs/unsupported"
						}
					]
				}
			},
			"allOf": [
				{
					"if": {
						"properties": {
							"activation": {
								"const": "stopped"
							}
						}
					},
					"then": {
						"properties": {
							"stopRequestId": {
								"type": "string",
								"pattern": "^(?!0{32}$)[0-9a-f]{32}$"
							}
						}
					}
				}
			]
		},
		"unsupported": {
			"type": "object",
			"properties": {
				"kind": {
					"const": "unsupported"
				}
			},
			"required": ["kind"],
			"additionalProperties": false
		}
	}
}
