{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.status.server",
	"title": "Local Session processes",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.status.server"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": ["scope", "runtimeDirectory", "endpoint", "server", "clientVersion"],
			"additionalProperties": false,
			"properties": {
				"scope": {
					"type": "string",
					"pattern": "^(orchbee-native-[0-9a-f]{32}|orchbee-session-[0-9a-f]{47})$"
				},
				"runtimeDirectory": {
					"$ref": "#/$defs/path"
				},
				"endpoint": {
					"oneOf": [
						{
							"$ref": "#/$defs/path"
						},
						{
							"type": "null"
						}
					]
				},
				"server": {
					"oneOf": [
						{
							"type": "object",
							"required": ["state", "reason"],
							"additionalProperties": false,
							"properties": {
								"state": {
									"const": "not-running"
								},
								"reason": {
									"enum": ["runtime-absent", "endpoint-absent"]
								}
							}
						},
						{
							"type": "object",
							"required": ["state", "restartKeepsTerminals", "processes"],
							"additionalProperties": false,
							"properties": {
								"state": {
									"const": "running"
								},
								"restartKeepsTerminals": {
									"type": ["boolean", "null"]
								},
								"processes": {
									"type": "array",
									"minItems": 1,
									"maxItems": 258,
									"items": {
										"$ref": "#/$defs/process"
									}
								}
							}
						}
					]
				},
				"clientVersion": {
					"$ref": "#/$defs/version"
				}
			}
		}
	},
	"$defs": {
		"path": {
			"oneOf": [
				{
					"type": "object",
					"required": ["path"],
					"additionalProperties": false,
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["pathUtf16"],
					"additionalProperties": false,
					"properties": {
						"pathUtf16": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			]
		},
		"version": {
			"type": "string",
			"minLength": 1,
			"maxLength": 64,
			"pattern": "^[!-~]+$"
		},
		"process": {
			"type": "object",
			"required": ["role", "version", "processId", "state", "terminals"],
			"additionalProperties": false,
			"properties": {
				"role": {
					"enum": ["server", "worker", "terminal-host", "unknown"]
				},
				"version": {
					"$ref": "#/$defs/version"
				},
				"processId": {
					"type": "integer",
					"minimum": 1,
					"maximum": 4294967295
				},
				"state": {
					"enum": ["ready", "draining", "stopping", "unknown"]
				},
				"terminals": {
					"type": "integer",
					"minimum": 0,
					"maximum": 4294967295
				}
			}
		}
	}
}
