{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "orchbee.status.server",
	"title": "Windows runtime server metadata",
	"type": "object",
	"required": ["schema", "version", "source", "result"],
	"additionalProperties": false,
	"properties": {
		"schema": {
			"const": "orchbee.status.server"
		},
		"version": {
			"const": 1
		},
		"source": {
			"type": "object",
			"required": ["kind"],
			"additionalProperties": false,
			"properties": {
				"kind": {
					"const": "local-runtime"
				}
			}
		},
		"result": {
			"type": "object",
			"required": [
				"scope",
				"runtimeDirectory",
				"endpoint",
				"server",
				"clientVersion",
				"clientProtocols",
				"localCohort",
				"compatibility"
			],
			"additionalProperties": false,
			"properties": {
				"scope": {
					"type": "string",
					"pattern": "^(orchbee-native-[0-9a-f]{32}|orchbee-session-[0-9a-f]{47})$"
				},
				"runtimeDirectory": {
					"$ref": "#/$defs/path"
				},
				"endpoint": {
					"oneOf": [
						{
							"$ref": "#/$defs/path"
						},
						{
							"type": "null"
						}
					]
				},
				"server": {
					"oneOf": [
						{
							"type": "object",
							"required": ["state", "reason"],
							"additionalProperties": false,
							"properties": {
								"state": {
									"const": "not-running"
								},
								"reason": {
									"enum": ["runtime-absent", "endpoint-absent"]
								}
							}
						},
						{
							"type": "object",
							"required": [
								"state",
								"version",
								"processId",
								"cohort",
								"protocols",
								"mode",
								"stopping",
								"capabilities"
							],
							"additionalProperties": false,
							"properties": {
								"state": {
									"const": "running"
								},
								"version": {
									"type": "string",
									"minLength": 1,
									"maxLength": 64,
									"pattern": "^[!-~]+$"
								},
								"processId": {
									"type": "integer",
									"minimum": 1,
									"maximum": 4294967295
								},
								"cohort": {
									"type": "string",
									"minLength": 1,
									"maxLength": 64,
									"pattern": "^[\\u0000-\\u007f]+$"
								},
								"protocols": {
									"$ref": "#/$defs/protocols"
								},
								"mode": {
									"enum": ["managed", "unmanaged"]
								},
								"stopping": {
									"type": "boolean"
								},
								"capabilities": {
									"type": "object",
									"required": [
										"terminalRenderRows",
										"clientViewControl",
										"agentObservation",
										"liveHandoff",
										"managedStop",
										"unknownBits"
									],
									"additionalProperties": false,
									"properties": {
										"terminalRenderRows": {
											"type": "boolean"
										},
										"clientViewControl": {
											"type": "boolean"
										},
										"agentObservation": {
											"type": "boolean"
										},
										"liveHandoff": {
											"type": "boolean"
										},
										"managedStop": {
											"type": "boolean"
										},
										"unknownBits": {
											"type": "integer",
											"minimum": 0,
											"maximum": 4294967295
										}
									}
								}
							}
						}
					]
				},
				"clientVersion": {
					"type": "string",
					"minLength": 1,
					"maxLength": 64,
					"pattern": "^[!-~]+$"
				},
				"clientProtocols": {
					"$ref": "#/$defs/protocols"
				},
				"localCohort": {
					"$ref": "#/$defs/cohort"
				},
				"compatibility": {
					"type": "object",
					"required": [
						"admissionProtocol",
						"terminalProtocol",
						"cohort",
						"compatible",
						"restartRequired"
					],
					"additionalProperties": false,
					"properties": {
						"terminalProtocol": {
							"type": ["boolean", "null"]
						},
						"cohort": {
							"type": ["boolean", "null"]
						},
						"compatible": {
							"type": ["boolean", "null"]
						},
						"restartRequired": {
							"type": ["boolean", "null"]
						},
						"admissionProtocol": {
							"type": ["boolean", "null"]
						}
					}
				}
			}
		}
	},
	"$defs": {
		"path": {
			"oneOf": [
				{
					"type": "object",
					"required": ["path"],
					"additionalProperties": false,
					"properties": {
						"path": {
							"type": "string",
							"minLength": 1
						}
					}
				},
				{
					"type": "object",
					"required": ["pathUtf16"],
					"additionalProperties": false,
					"properties": {
						"pathUtf16": {
							"type": "array",
							"minItems": 1,
							"items": {
								"type": "integer",
								"minimum": 0,
								"maximum": 65535
							}
						}
					}
				}
			]
		},
		"protocols": {
			"type": "object",
			"required": ["admission", "terminal"],
			"additionalProperties": false,
			"properties": {
				"admission": {
					"const": 1
				},
				"terminal": {
					"type": "integer",
					"minimum": 1,
					"maximum": 255
				}
			}
		},
		"cohort": {
			"oneOf": [
				{
					"type": "object",
					"required": ["state", "identity"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "available"
						},
						"identity": {
							"type": "string",
							"pattern": "^[0-9a-f]{64}$"
						}
					}
				},
				{
					"type": "object",
					"required": ["state", "reason"],
					"additionalProperties": false,
					"properties": {
						"state": {
							"const": "unavailable"
						},
						"reason": {
							"enum": ["missing", "invalid", "denied", "timed-out", "io-error"]
						}
					}
				}
			]
		}
	}
}
