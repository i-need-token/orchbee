{
	"name": "@orchbee/cli",
	"version": "0.1.0",
	"private": true,
	"description": "Product-owned Orchbee semantic command-line client",
	"type": "module",
	"main": "./dist/main/cli-core.cjs",
	"scripts": {
		"build": "rsbuild build --log-level error",
		"start": "node ./dist/main/orchbee-cli.cjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@orchbee/agent": "workspace:^",
		"@orchbee/semantic-command-protocol": "workspace:^",
		"@orchbee/workbench": "workspace:^"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:",
		"@types/node": "catalog:",
		"vitest": "catalog:"
	}
}
