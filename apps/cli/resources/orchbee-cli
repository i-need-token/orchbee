#!/bin/sh

launcher_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P) || exit 6
cli_entry="$launcher_directory/orchbee-cli.cjs"
native_addon="$launcher_directory/orchbee-semantic-command-endpoint.node"

if [ -f "$cli_entry" ]; then
	case "$(uname -s)" in
		Darwin) executable="$launcher_directory/../MacOS/Orchbee" ;;
		*) executable="$launcher_directory/../Orchbee" ;;
	esac
	ELECTRON_RUN_AS_NODE=1
	export ELECTRON_RUN_AS_NODE
else
	executable=node
	cli_entry="$launcher_directory/../dist/main/orchbee-cli.cjs"
	native_addon="$launcher_directory/../../desktop/zig-out/lib/orchbee-semantic-command-endpoint.node"
fi

ORCHBEE_CLI_NATIVE_ADDON_PATH=$native_addon
export ORCHBEE_CLI_NATIVE_ADDON_PATH
exec "$executable" "$cli_entry" "$@"
