{
	"name": "@orchbee/server",
	"version": "0.1.0",
	"private": true,
	"description": "Loopback-only foundation for the Orchbee application backend",
	"type": "module",
	"main": "./dist/main/server.cjs",
	"scripts": {
		"dev": "rsbuild build --watch",
		"build": "rsbuild build --log-level error",
		"start": "node ./dist/main/server.cjs",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@fastify/static": "catalog:",
		"@fastify/websocket": "catalog:",
		"fastify": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:",
		"@types/node": "catalog:",
		"@types/ws": "catalog:",
		"vitest": "catalog:",
		"ws": "catalog:"
	}
}
