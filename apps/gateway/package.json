{
	"name": "@orchbee/gateway",
	"version": "0.1.0",
	"private": true,
	"description": "On-demand Cookie-authenticated Browser Gateway utility process",
	"type": "module",
	"main": "./dist/main/gateway.cjs",
	"scripts": {
		"dev": "rsbuild build --watch",
		"build": "rsbuild build --log-level error",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:tla": "node ../../scripts/tla/run-models.mjs --workspace apps/gateway",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@orchbee/gateway-protocol": "workspace:^",
		"@orchbee/remote-client-protocol": "workspace:*",
		"@orchbee/workbench": "workspace:^",
		"@orchbee/workbench-client-protocol": "workspace:^",
		"ws": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:",
		"@types/node": "catalog:",
		"@types/ws": "catalog:",
		"electron": "42.8.0",
		"vitest": "catalog:"
	}
}
