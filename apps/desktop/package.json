{
	"name": "@orchbee/desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Sandboxed Electron client and scoped local broker for the Orchbee Terminal Host",
	"type": "module",
	"main": "./dist/main/main.cjs",
	"scripts": {
		"benchmark": "node scripts/benchmark-throughput.mjs",
		"dev": "rsbuild dev",
		"build": "rsbuild build --log-level error",
		"start": "electron dist/main/main.cjs",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit",
		"test:unit": "vitest run",
		"test:tla": "node scripts/run-tla.mjs",
		"test:watch": "vitest",
		"test:system": "playwright test --config playwright.config.ts"
	},
	"dependencies": {
		"@orchbee/actions": "workspace:^",
		"@orchbee/i18n": "workspace:^",
		"@orchbee/tab-strip": "workspace:^",
		"@orchbee/terminal": "workspace:^",
		"@orchbee/terminal-protocol": "workspace:^",
		"@orchbee/ui": "workspace:^",
		"@orchbee/workbench": "workspace:^",
		"electron": "42.8.0",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@rsbuild/core": "catalog:",
		"@rsbuild/plugin-react": "catalog:",
		"@rsbuild/plugin-source-build": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"storybook-react-rsbuild": "catalog:",
		"vitest": "catalog:"
	}
}
