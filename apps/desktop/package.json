{
	"name": "@orchbee/desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Sandboxed Electron client and scoped local broker for the Orchbee Terminal Host",
	"type": "module",
	"main": "./dist/main/main.cjs",
	"scripts": {
		"benchmark": "node scripts/benchmark-throughput.mjs",
		"build:package-inputs": "pnpm --filter @orchbee/terminal-host build && pnpm --filter @orchbee/server... build && pnpm --filter @orchbee/gateway... build && pnpm --filter @orchbee/web... build && pnpm --filter @orchbee/cli... build && pnpm --filter @orchbee/desktop... build",
		"build:native": "node scripts/build-posix-host-endpoint.mjs && node scripts/build-semantic-command-endpoint.mjs",
		"dev": "pnpm --filter @orchbee/ssh-environment-protocol build && rsbuild dev --config-loader jiti",
		"build": "rsbuild build --log-level error && pnpm build:native",
		"package:dev": "pnpm build:package-inputs && node scripts/package.mjs --profile dev",
		"package:local": "pnpm build:package-inputs && node scripts/package.mjs --profile local",
		"package:release": "pnpm build:package-inputs && node scripts/package.mjs --profile release",
		"start": "electron dist/main/main.cjs",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit && pnpm test:native && pnpm test:benchmark && pnpm test:release-package",
		"test:benchmark": "node --test scripts/terminal-benchmark-interactions.test.mjs",
		"test:native": "node scripts/test-posix-host-endpoint.mjs && node scripts/test-semantic-command-endpoint.mjs",
		"test:release-package": "pnpm --filter @orchbee/ssh-environment-protocol build && node --test scripts/ssh-environment-release-package.test.mjs scripts/development-ssh-environment-release.test.mjs",
		"test:unit": "vitest run",
		"test:tla": "node ../../scripts/tla/run-models.mjs --workspace apps/desktop",
		"test:watch": "vitest",
		"test:system": "playwright test --config playwright.config.ts",
		"test:system:ssh-project-enrollment": "node scripts/run-ssh-project-enrollment-system-test.mjs",
		"test:system:manual:native-window": "playwright test --config playwright.manual-native-window.config.ts"
	},
	"dependencies": {
		"@electron/packager": "catalog:",
		"@orchbee/actions": "workspace:^",
		"@orchbee/agent": "workspace:^",
		"@orchbee/desktop-client-protocol": "workspace:^",
		"@orchbee/gateway-protocol": "workspace:^",
		"@orchbee/i18n": "workspace:^",
		"@orchbee/remote-client-protocol": "workspace:^",
		"@orchbee/semantic-command-protocol": "workspace:^",
		"@orchbee/ssh-environment-protocol": "workspace:^",
		"@orchbee/terminal-protocol": "workspace:^",
		"@orchbee/workbench": "workspace:^",
		"@orchbee/workbench-client-protocol": "workspace:^",
		"electron": "42.8.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@playwright/test": "1.61.1",
		"@rsbuild/core": "catalog:",
		"@rsbuild/plugin-source-build": "catalog:",
		"@types/node": "catalog:",
		"fast-check": "4.9.0",
		"node-api-headers": "1.9.0",
		"vitest": "catalog:"
	}
}
