{
	"name": "orchbee-agent-observation",
	"version": "0.4.10",
	"private": true,
	"description": "Locally sanitizes Cline lifecycle events for Orchbee Agent status observation",
	"type": "module",
	"exports": {
		".": "./cline/orchbee-agent-observation.js"
	},
	"cline": {
		"plugins": [
			{
				"paths": [
					"./cline/orchbee-agent-observation.js"
				],
				"capabilities": [
					"hooks"
				]
			}
		]
	},
	"orchbeeAgentObservation": {
		"contractVersion": 3
	}
}
