{
	"version": 1,
	"hooks": {
		"SessionStart": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"UserPromptSubmit": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"PostToolUse": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"PostToolUseFailure": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"Notification": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"matcher": "permission_prompt|elicitation_dialog",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"PreCompact": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"Stop": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"ErrorOccurred": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 2,
				"type": "command"
			}
		],
		"SessionEnd": [
			{
				"command": "command -v node >/dev/null 2>&1 && [ -r \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${COPILOT_PLUGIN_ROOT}/scripts/forward-hook.mjs\" github-copilot >/dev/null 2>&1 || :",
				"timeoutSec": 1,
				"type": "command"
			}
		]
	}
}
