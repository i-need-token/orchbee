{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${GROK_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${GROK_PLUGIN_ROOT}/scripts/forward-hook.mjs\" grok >/dev/null 2>&1 || :",
						"timeout": 2
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${GROK_PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${GROK_PLUGIN_ROOT}/scripts/forward-hook.mjs\" grok >/dev/null 2>&1 || :",
						"timeout": 2
					}
