{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh",
						"args": [
							"-c",
							"command -v node >/dev/null 2>&1 && [ -r \"$1\" ] && node \"$1\" \"$2\" >/dev/null 2>&1 || :",
							"orchbee-agent-observation",
							"${CLAUDE_PLUGIN_ROOT}/scripts/forward-hook.mjs",
							"claude-code"
						],
						"timeout": 2
					}
				]
			}
