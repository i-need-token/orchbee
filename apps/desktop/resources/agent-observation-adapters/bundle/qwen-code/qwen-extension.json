{
	"description": {
		"en": "Locally sanitizes Qwen Code lifecycle hooks for Orchbee Agent status observation",
		"zh": "在本地清理 Qwen Code 生命周期 Hook，用于 Orchbee Agent 状态观测"
	},
	"displayName": {
		"en": "Orchbee Agent Observation",
		"zh": "Orchbee Agent 状态观测"
	},
	"name": "orchbee-agent-observation",
	"version": "0.4.8",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"UserPromptSubmit": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PostToolUseFailure": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PermissionRequest": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PermissionDenied": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"Notification": [
			{
				"matcher": "permission_prompt|idle_prompt",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PreCompact": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PostCompact": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"SubagentStart": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"SubagentStop": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"StopFailure": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 1000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		]
	}
}
