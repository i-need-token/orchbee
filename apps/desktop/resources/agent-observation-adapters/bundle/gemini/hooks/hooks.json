{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"BeforeAgent": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"BeforeTool": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"AfterTool": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"PreCompress": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"AfterAgent": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 2000,
						"type": "command"
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${extensionPath}/scripts/forward-hook.mjs\" ] && node \"${extensionPath}/scripts/forward-hook.mjs\" gemini >/dev/null 2>&1 || :",
						"timeout": 1000,
						"type": "command"
					}
				]
			}
		]
	}
