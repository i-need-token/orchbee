{
	"name": "@orchbee/website",
	"version": "0.1.0",
	"private": true,
	"description": "The static, localized Orchbee product website",
	"type": "module",
	"scripts": {
		"dev": "rsbuild dev",
		"build": "rsbuild build && node scripts/generate-pages.mjs",
		"preview": "rsbuild preview",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@orchbee/design-tokens": "workspace:*",
		"@orchbee/i18n": "workspace:*",
		"react": "catalog:",
		"react-dom": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/core": "catalog:",
		"@rsbuild/plugin-react": "catalog:",
		"@rsbuild/plugin-source-build": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
