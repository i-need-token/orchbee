// Cloudflare delivery for the built static site: an assets-only Worker with no script.
// See README.md "Static delivery" for the build and deploy commands.
{
	"name": "orchbee-website",
	"compatibility_date": "2026-11-12",
	"assets": {
		"directory": "./dist",
		// /zh-CN redirects to /zh-CN/, and /zh-CN/ serves zh-CN/index.html.
		"html_handling": "auto-trailing-slash",
		// A missing path gets the nearest 404.html above it, with status 404.
		"not_found_handling": "404-page",
	},
	// Both host names serve the same files; the pages name https://orchbee.com as canonical.
	"routes": [
		{ "pattern": "orchbee.com", "custom_domain": true },
		{ "pattern": "www.orchbee.com", "custom_domain": true },
	],
	"workers_dev": false,
	"preview_urls": false,
}
