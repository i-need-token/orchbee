{
	"name": "@orchbee/web",
	"version": "0.1.0",
	"private": true,
	"description": "Browser product application for the Orchbee workbench",
	"type": "module",
	"scripts": {
		"dev": "rsbuild dev",
		"build": "rsbuild build --log-level error",
		"typecheck": "tsc --noEmit",
