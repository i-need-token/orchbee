[
	{
		"name": "selected pins participate only in direct close",
		"tabs": [
			{ "id": "1", "pinned": true, "group": null },
			{ "id": "2", "pinned": false, "group": "10" },
			{ "id": "3", "pinned": false, "group": "10" },
			{ "id": "4", "pinned": false, "group": null },
			{ "id": "5", "pinned": false, "group": null }
		],
		"selected": ["1", "3"],
		"target": "1",
		"expected": {
			"selected": ["1", "3"],
			"other": ["2", "4", "5"],
			"trailing": ["4", "5"],
			"group": []
		}
	},
	{
		"name": "background target excludes selection from command scope",
		"tabs": [
			{ "id": "1", "pinned": true, "group": null },
			{ "id": "2", "pinned": false, "group": "10" },
			{ "id": "3", "pinned": false, "group": "10" },
			{ "id": "4", "pinned": false, "group": null },
			{ "id": "5", "pinned": false, "group": null }
		],
		"selected": ["1", "4"],
		"target": "2",
		"expected": {
			"selected": ["2"],
			"other": ["3", "4", "5"],
			"trailing": ["3", "4", "5"],
			"group": ["2", "3"]
		}
	},
	{
		"name": "rightmost selected member bounds trailing close",
		"tabs": [
			{ "id": "1", "pinned": false, "group": null },
			{ "id": "2", "pinned": false, "group": "10" },
			{ "id": "3", "pinned": false, "group": "10" },
			{ "id": "4", "pinned": false, "group": null }
		],
		"selected": ["4", "2"],
		"target": "2",
		"expected": { "selected": ["2", "4"], "other": ["1", "3"], "trailing": [], "group": ["2", "3"] }
	},
	{
		"name": "all pinned has no relative close",
		"tabs": [
			{ "id": "1", "pinned": true, "group": null },
			{ "id": "2", "pinned": true, "group": null }
		],
		"selected": ["1", "2"],
		"target": "2",
		"expected": { "selected": ["1", "2"], "other": [], "trailing": [], "group": [] }
	},
	{
		"name": "group includes unmarked middle and final members",
		"tabs": [
			{ "id": "1", "pinned": true, "group": null },
			{ "id": "2", "pinned": false, "group": "10" },
			{ "id": "3", "pinned": false, "group": "10" },
			{ "id": "4", "pinned": false, "group": "10" },
			{ "id": "5", "pinned": false, "group": "11" }
		],
		"selected": ["1", "3"],
		"target": "3",
		"expected": {
			"selected": ["1", "3"],
			"other": ["2", "4", "5"],
			"trailing": ["4", "5"],
			"group": ["2", "3", "4"]
		}
	},
	{
		"name": "singleton has only direct close",
		"tabs": [{ "id": "1", "pinned": false, "group": null }],
		"selected": [],
		"target": "1",
		"expected": { "selected": ["1"], "other": [], "trailing": [], "group": [] }
	},
	{
		"name": "stale target never falls back to selected tabs",
		"tabs": [{ "id": "1", "pinned": false, "group": null }],
		"selected": ["1"],
		"target": "99",
		"expected": { "selected": [], "other": [], "trailing": [], "group": [] }
	},
	{
		"name": "empty context has no implicit target",
		"tabs": [],
		"selected": [],
		"target": "1",
		"expected": { "selected": [], "other": [], "trailing": [], "group": [] }
	}
]
