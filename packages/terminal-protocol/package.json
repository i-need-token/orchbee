{
	"name": "@orchbee/terminal-protocol",
	"version": "0.2.0",
	"private": true,
	"description": "Transport-neutral Terminal Host wire contract and codecs",
	"files": [
		"dist",
		"fixtures",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@orchbee/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./fixtures/canonical.json": "./fixtures/canonical.json",
		"./fixtures/control-conformance-v0.0.19.json": "./fixtures/control-conformance-v0.0.19.json",
		"./fixtures/focus-input-v0.0.19.bin": "./fixtures/focus-input-v0.0.19.bin",
		"./fixtures/ghostty-alternate-surface-v0.0.3.bin": "./fixtures/ghostty-alternate-surface-v0.0.3.bin",
		"./fixtures/ghostty-surface-v0.0.3.bin": "./fixtures/ghostty-surface-v0.0.3.bin",
		"./fixtures/key-input-v0.0.19.bin": "./fixtures/key-input-v0.0.19.bin",
		"./fixtures/malformed-frame-v0.0.3.json": "./fixtures/malformed-frame-v0.0.3.json",
		"./fixtures/malformed-row-window-v0.0.2.json": "./fixtures/malformed-row-window-v0.0.2.json",
		"./fixtures/mouse-input-v0.0.19.bin": "./fixtures/mouse-input-v0.0.19.bin",
		"./fixtures/paste-input-v0.0.19.bin": "./fixtures/paste-input-v0.0.19.bin",
		"./fixtures/terminal-frame-v0.0.3.bin": "./fixtures/terminal-frame-v0.0.3.bin",
		"./fixtures/terminal-failed-v0.0.19.json": "./fixtures/terminal-failed-v0.0.19.json",
		"./fixtures/terminal-projection-buffer-v0.0.2.bin": "./fixtures/terminal-projection-buffer-v0.0.2.bin",
		"./fixtures/terminal-row-window-v0.0.2.bin": "./fixtures/terminal-row-window-v0.0.2.bin",
		"./fixtures/text-input-v0.0.19.bin": "./fixtures/text-input-v0.0.19.bin",
		"./fixtures/transport-envelope-v0.0.19.bin": "./fixtures/transport-envelope-v0.0.19.bin",
		"./fixtures/utf8-bom-conformance-v0.0.19.json": "./fixtures/utf8-bom-conformance-v0.0.19.json",
		"./fixtures/write-input-v0.0.19.bin": "./fixtures/write-input-v0.0.19.bin"
	},
	"scripts": {
		"build": "rslib build --log-level error",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit && pnpm test:fixtures",
		"test:fixtures": "node scripts/generate-fixtures.mjs --check",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"fixtures:generate": "node scripts/generate-fixtures.mjs",
		"test:exports": "node ../../scripts/check-package-exports.mjs .",
		"verify:correctness": "pnpm typecheck && pnpm build && pnpm test && pnpm test:exports"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rslib/core": "catalog:",
		"@types/node": "catalog:",
		"fast-check": "4.9.0",
		"vitest": "catalog:"
	}
}
