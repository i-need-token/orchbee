{
	"name": "@orchbee/terminal-protocol",
	"version": "0.2.0",
	"private": true,
	"description": "Transport-neutral Terminal Host wire contract and codecs",
	"files": [
		"dist",
		"fixtures",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@orchbee/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./fixtures/canonical.json": "./fixtures/canonical.json",
		"./fixtures/control-conformance.json": "./fixtures/control-conformance.json",
		"./fixtures/focus-input.bin": "./fixtures/focus-input.bin",
		"./fixtures/ghostty-alternate-surface.bin": "./fixtures/ghostty-alternate-surface.bin",
		"./fixtures/ghostty-render-row-window.bin": "./fixtures/ghostty-render-row-window.bin",
		"./fixtures/ghostty-surface.bin": "./fixtures/ghostty-surface.bin",
		"./fixtures/key-input.bin": "./fixtures/key-input.bin",
		"./fixtures/malformed-frame.json": "./fixtures/malformed-frame.json",
		"./fixtures/malformed-row-window.json": "./fixtures/malformed-row-window.json",
		"./fixtures/mouse-input.bin": "./fixtures/mouse-input.bin",
		"./fixtures/packed-projection-conformance.json": "./fixtures/packed-projection-conformance.json",
		"./fixtures/paste-auto-input.bin": "./fixtures/paste-auto-input.bin",
		"./fixtures/paste-input.bin": "./fixtures/paste-input.bin",
		"./fixtures/selection-export-chunk.bin": "./fixtures/selection-export-chunk.bin",
		"./fixtures/terminal-frame.bin": "./fixtures/terminal-frame.bin",
		"./fixtures/terminal-failed.json": "./fixtures/terminal-failed.json",
		"./fixtures/terminal-projection-buffer.bin": "./fixtures/terminal-projection-buffer.bin",
		"./fixtures/terminal-row-window.bin": "./fixtures/terminal-row-window.bin",
		"./fixtures/text-input.bin": "./fixtures/text-input.bin",
		"./fixtures/transport-envelope.bin": "./fixtures/transport-envelope.bin",
		"./fixtures/utf8-bom-conformance.json": "./fixtures/utf8-bom-conformance.json",
		"./fixtures/write-input.bin": "./fixtures/write-input.bin"
	},
	"scripts": {
		"build": "rslib build --log-level error",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit && pnpm test:fixtures",
		"test:fixtures": "node scripts/generate-fixtures.mjs --check",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"fixtures:generate": "node scripts/generate-fixtures.mjs",
		"test:exports": "node ../../scripts/check-package-exports.mjs .",
		"verify:correctness": "pnpm typecheck && pnpm build && pnpm test && pnpm test:exports"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rslib/core": "catalog:",
		"@types/node": "catalog:",
		"fast-check": "4.9.0",
		"vitest": "catalog:"
	}
}
