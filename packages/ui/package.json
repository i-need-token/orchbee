{
	"name": "@orchbee/ui",
	"version": "0.1.0",
	"private": true,
	"description": "Reusable shadcn components backed by Base UI",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#hooks": "./src/hooks/index.ts",
		"#hooks/*": "./src/hooks/*.ts",
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./components": {
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js",
			"require": "./dist/components/index.cjs"
		},
		"./styles.css": "./dist/styles.css"
	},
	"scripts": {
		"build": "rslib build",
		"component:add": "shadcn add",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:exports": "node ../../scripts/check-package-exports.mjs ."
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@shadcn/react": "^0.2.1",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"cmdk": "^1.1.1",
		"date-fns": "^4.4.0",
		"embla-carousel-react": "^8.6.0",
		"input-otp": "^1.4.2",
		"lucide-react": "^1.24.0",
		"next-themes": "^0.4.6",
		"react-day-picker": "^10.0.1",
		"react-resizable-panels": "^4.12.2",
		"recharts": "3.8.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/plugin-react": "catalog:",
		"@rsbuild/plugin-tailwindcss": "catalog:",
		"@rslib/core": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	}
}
