{
	"name": "@orchbee/ui",
	"version": "0.1.0",
	"private": true,
	"description": "Reusable shadcn components backed by Base UI",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"./src/styles.ts"
	],
	"imports": {
		"#components/*": "./src/components/*.tsx",
		"#hooks/*": "./src/hooks/*.ts",
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"exports": {
		"./components": {
			"@orchbee/source": "./src/components/index.ts",
			"types": "./dist/components/index.d.ts",
			"import": "./dist/components/index.js",
			"require": "./dist/components/index.cjs"
		},
		"./styles.css": {
			"@orchbee/source": "./src/styles.ts",
			"default": "./dist/styles.css"
		}
	},
	"scripts": {
		"build": "rslib build --log-level error",
		"component:add": "shadcn add",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:exports": "node ../../scripts/check-package-exports.mjs ."
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"@orchbee/design-tokens": "workspace:^",
		"@vscode/codicons": "catalog:",
		"class-variance-authority": "catalog:",
		"clsx": "catalog:",
		"lucide-react": "catalog:",
		"react-resizable-panels": "^4.12.2",
		"tailwind-merge": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/plugin-react": "catalog:",
		"@rsbuild/plugin-tailwindcss": "catalog:",
		"@rslib/core": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"shadcn": "catalog:",
		"storybook": "catalog:",
		"storybook-react-rsbuild": "catalog:",
		"tailwindcss": "catalog:",
		"tw-animate-css": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	}
}
