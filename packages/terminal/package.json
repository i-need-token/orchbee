{
	"name": "@orchbee/terminal",
	"version": "0.1.0",
	"description": "Source-neutral projected Terminal Host client surface with WebGPU and Canvas rendering",
	"keywords": [
		"client",
		"projected-terminal",
		"terminal",
		"webgpu"
	],
	"files": [
		"dist",
		"docs",
		"src",
		"!src/**/__tests__",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@orchbee/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"benchmark:renderer": "vitest bench --run src/rendering/__tests__/renderer.bench.ts",
		"build": "rslib build --log-level error",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:exports": "node ../../scripts/check-package-exports.mjs . && node scripts/check-public-api.mjs"
	},
	"dependencies": {
		"@orchbee/terminal-protocol": "workspace:^",
		"get-east-asian-width": "1.6.0"
	},
	"devDependencies": {
		"@rslib/core": "catalog:",
		"@types/node": "^26.1.1",
		"@webgpu/types": "^0.1.71",
		"fast-check": "4.9.0",
		"vitest": "catalog:"
	}
}
