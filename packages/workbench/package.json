{
	"name": "@orchbee/workbench",
	"version": "0.1.0",
	"private": true,
	"description": "Shared product shell for Orchbee applications",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css",
		"./src/styles.ts"
	],
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@orchbee/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./terminal-presentation": {
			"@orchbee/source": "./src/terminal-presentation/index.ts",
			"types": "./dist/terminal-presentation/index.d.ts",
			"import": "./dist/terminal-presentation/index.js",
			"require": "./dist/terminal-presentation/index.cjs"
		},
		"./document": {
			"@orchbee/source": "./src/workbench/document/index.ts",
			"types": "./dist/workbench/document/index.d.ts",
			"import": "./dist/document/index.js",
			"require": "./dist/document/index.cjs"
		},
		"./styles.css": {
			"@orchbee/source": "./src/styles.ts",
			"default": "./dist/index.css"
		}
	},
	"scripts": {
		"build": "rslib build --log-level error",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "pnpm test:unit",
		"test:unit": "vitest run",
		"test:watch": "vitest",
		"test:tla": "node scripts/run-tla.mjs",
		"test:exports": "node ../../scripts/check-package-exports.mjs ."
	},
	"dependencies": {
		"@orchbee/actions": "workspace:^",
		"@orchbee/foundation": "workspace:^",
		"@orchbee/i18n": "workspace:^",
		"@orchbee/tab-strip": "workspace:^",
		"@orchbee/ui": "workspace:^",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rsbuild/plugin-react": "catalog:",
		"@rslib/core": "catalog:",
		"@testing-library/react": "16.3.2",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"fast-check": "4.9.0",
		"jsdom": "29.1.1",
		"react": "catalog:",
		"react-dom": "catalog:",
		"storybook-react-rsbuild": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"react": "catalog:",
		"react-dom": "catalog:"
	}
}
