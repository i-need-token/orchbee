{
	"name": "@orchbee/agent",
	"version": "0.1.0",
	"private": true,
	"description": "Provider-neutral observed Agent lifecycle and attention model for Orchbee",
	"files": [
		"dist",
		"!dist/__tests__/conformance",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"imports": {
		"#conformance-reference": "./dist/__tests__/conformance/agent-reference.js"
	},
	"exports": {
		".": {
			"@orchbee/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "rslib build --log-level error",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:exports": "node ../../scripts/check-package-exports.mjs .",
		"conformance:generate": "pnpm conformance:build && node conformance/generate-corpus.mjs",
		"test:conformance": "pnpm conformance:build && node conformance/generate-corpus.mjs --check",
		"verify:correctness": "pnpm typecheck && pnpm test && pnpm build && pnpm test:exports",
		"conformance:build": "pnpm build && node conformance/build-reference.mjs"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rslib/core": "catalog:",
		"fast-check": "4.9.0",
		"vitest": "catalog:"
	}
}
