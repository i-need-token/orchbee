{
	"name": "@orchbee/desktop-client-protocol",
	"version": "0.1.0",
	"private": true,
	"description": "Electron-specific Desktop bootstrap and application-lifetime protocols",
	"files": [
		"dist",
		"README.md"
	],
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"@orchbee/source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "rslib build --log-level error",
		"dev": "rslib build --watch",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:exports": "node ../../scripts/check-package-exports.mjs ."
	},
	"dependencies": {
		"@orchbee/workbench": "workspace:^",
		"@orchbee/workbench-client-protocol": "workspace:^",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rslib/core": "catalog:",
		"vitest": "catalog:"
	}
}
