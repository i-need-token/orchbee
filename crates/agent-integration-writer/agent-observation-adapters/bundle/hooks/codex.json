{
	"description": "Content-free Orchbee Agent status observation for Codex",
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "command -v node >/dev/null 2>&1 && [ -r \"${PLUGIN_ROOT}/scripts/forward-hook.mjs\" ] && node \"${PLUGIN_ROOT}/scripts/forward-hook.mjs\" codex >/dev/null 2>&1 || :",
						"timeout": 2,
						"type": "command",
						"commandWindows": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\""
					}
				]
			}
